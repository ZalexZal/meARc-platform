---
import Base from '../../layouts/Base.astro';
import { brandName } from '../../i18n/ui';
import AuthForm from '../../components/AuthForm.astro';
import { langFromUrl, useTranslations } from '../../i18n/ui';
const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
---
<Base title={t('auth.signup.title') + ' — ' + brandName[lang]}>
  <AuthForm lang={lang} mode="signup" />
</Base>
