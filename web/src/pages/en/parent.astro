---
import Base from '../../layouts/Base.astro';
import { brandName } from '../../i18n/ui';
import Consent from '../../components/Consent.astro';
import { langFromUrl, useTranslations } from '../../i18n/ui';
const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
---
<Base title={t('par.title') + ' — ' + brandName[lang]}>
  <Consent lang={lang} />
</Base>
