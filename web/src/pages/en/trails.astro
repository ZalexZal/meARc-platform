---
import Base from '../../layouts/Base.astro';
import { brandName } from '../../i18n/ui';
import TrailList from '../../components/TrailList.astro';
import GetApp from '../../components/GetApp.astro';
import { langFromUrl, useTranslations } from '../../i18n/ui';
const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
---
<Base title={t('games.title') + ' — ' + brandName[lang]}>
  <TrailList lang={lang} />
  <GetApp lang={lang} />
</Base>
