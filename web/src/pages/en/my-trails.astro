---
import Base from '../../layouts/Base.astro';
import { brandName } from '../../i18n/ui';
import MyTrails from '../../components/MyTrails.astro';
import { langFromUrl, useTranslations } from '../../i18n/ui';
const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
---
<Base title={t('mine.title') + ' — ' + brandName[lang]}>
  <MyTrails lang={lang} />
</Base>
