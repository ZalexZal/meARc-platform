---
import Base from '../layouts/Base.astro';
import { brandName } from '../i18n/ui';
import Reset from '../components/Reset.astro';
import { langFromUrl, useTranslations } from '../i18n/ui';
const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
---
<Base title={t('reset.title') + ' — ' + brandName[lang]}>
  <Reset lang={lang} />
</Base>
