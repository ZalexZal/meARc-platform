---
import Base from '../layouts/Base.astro';
import PageBand from '../components/PageBand.astro';
---
<!-- Netlify serves this for any path that is not a page. Both languages,
     because a missing page has no language of its own. It is the map
     with no stop on it: you walked somewhere the trail does not go. -->
<Base title="404 — AR Trail">
  <PageBand eyebrow="404" title="Тази страница я няма." lede="This page does not exist.">
    <div class="flex flex-wrap gap-3">
      <a class="btn btn-primary" href="/">Начало</a>
      <a class="btn btn-quiet" href="/en/">Home</a>
    </div>
  </PageBand>
</Base>
