---
import Base from '../layouts/Base.astro';
---
<!-- Netlify serves this for any path that is not a page. Both languages,
     because a missing page has no language of its own. -->
<Base title="404 — AR Trail">
  <section class="mx-auto max-w-2xl px-4 py-28 sm:px-6">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 text-3xl sm:text-4xl">Тази страница я няма.</h1>
    <p class="mt-3 text-[var(--ink-dim)]">This page does not exist.</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a class="btn btn-primary" href="/">Начало</a>
      <a class="btn btn-quiet" href="/en/">Home</a>
    </div>
  </section>
</Base>
