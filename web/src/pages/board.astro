---
import Base from '../layouts/Base.astro';
import { brandName } from '../i18n/ui';
import Board from '../components/Board.astro';
import { langFromUrl, useTranslations } from '../i18n/ui';
const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
---
<Base title={t('ed.board') + ' — ' + brandName[lang]}>
  <Board lang={lang} />
</Base>
