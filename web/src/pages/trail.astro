---
import Base from '../layouts/Base.astro';
import TrailEditor from '../components/TrailEditor.astro';
import { langFromUrl, useTranslations } from '../i18n/ui';
const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
---
<Base title={t('ed.stops') + ' — AR Trail'}>
  <TrailEditor lang={lang} />
</Base>
