---
import Base from '../layouts/Base.astro';
import { brandName } from '../i18n/ui';
import Confirmed from '../components/Confirmed.astro';
import { langFromUrl, useTranslations } from '../i18n/ui';
const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
---
<Base title={t('conf.title') + ' — ' + brandName[lang]}>
  <Confirmed lang={lang} />
</Base>
