---
import '../styles/global.css';
import { langFromUrl, useTranslations, localise, type UIKey } from '../i18n/ui';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const lang = langFromUrl(Astro.url);
const t = useTranslations(lang);
const href = localise(lang);

const { title, description } = Astro.props;
const pageTitle = title ?? t('meta.title' as UIKey);
const pageDescription = description ?? t('meta.description' as UIKey);

// The same page in the other language, so the switch lands on the equivalent
// page rather than dumping everyone on the home page.
const path = Astro.url.pathname.replace(/^\/en/, '') || '/';
// The 404 page has no English twin; its switch goes to the other home.
const other = path.startsWith('/404')
  ? '/en/'
  : lang === 'bg' ? `/en${path === '/' ? '' : path}` : path;
---

<!doctype html>
<html lang={lang} data-theme-default>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Inter+Tight:wght@500;600;700&family=JetBrains+Mono:wght@500&display=swap"
    />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={lang === 'bg' ? 'меАРк' : 'meARc'} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="meARc" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" hreflang="bg" href={new URL(path, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(`/en${path === '/' ? '' : path}`, Astro.site)} />

    <script is:inline src="/theme.js"></script>
  </head>

  <!-- A column the height of the screen, so a short page still ends on the
       footer's map rather than on a strip of page below it. -->
  <body class="flex min-h-svh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-3 focus:rounded-lg focus:bg-[var(--surface)] focus:px-4 focus:py-3 focus:text-[var(--ink)] focus:shadow-lg"
    >
      {lang === 'bg' ? 'Към съдържанието' : 'Skip to content'}
    </a>

    <Header lang={lang} otherHref={other} />
    <main id="main" class="flex-1"><slot /></main>
    <Footer lang={lang} />

    <button class="to-top" type="button" aria-label={t('ui.toTop')} title={t('ui.toTop')} data-to-top>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M5.5 11.5L12 5l6.5 6.5" /></svg>
    </button>

    <div class="cookie-bar" role="region" aria-label={t('cookie.privacy')} hidden data-cookie-bar>
      <p><strong>{t('cookie.lead')}</strong> <span>{t('cookie.body')}</span></p>
      <div class="cookie-bar-actions">
        <a class="btn btn-ghost btn-sm" href={href('/privacy')}>{t('cookie.privacy')}</a>
        <button class="btn btn-primary btn-sm" type="button" data-cookie-ok>{t('cookie.ok')}</button>
      </div>
    </div>

    <script>
      // Creator or viewer: an account that never answered is sent to answer,
      // from whichever page it opens. See roleGate for who is left alone.
      import { roleGate } from '../lib/session';
      roleGate();
    </script>

    <script>
      // Sections marked data-reveal arrive as they scroll into view. theme.js
      // hid them before the first paint; this is the half that shows them, and
      // the class tells theme.js not to show them all at once as a fallback.
      document.documentElement.classList.add('reveal-ready');
      const arrive = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-in');
          arrive.unobserve(entry.target);
        }
      }, { rootMargin: '0px 0px -10% 0px' });
      document.querySelectorAll('[data-reveal], [data-reveal-group]').forEach((el) => arrive.observe(el));

      // The header takes the colours of whatever it is over: the map's over
      // the map, the reader's theme over everything else.
      const header = document.querySelector('[data-site-header]');
      let queued = false;
      const matchHeader = () => {
        queued = false;
        if (!header) return;
        const under = document.elementsFromPoint(12, header.getBoundingClientRect().bottom + 4)
          .find((el) => !header.contains(el));
        header.classList.toggle('map', Boolean(under?.closest('.map')));
      };
      const queue = () => { if (!queued) { queued = true; requestAnimationFrame(matchHeader); } };
      addEventListener('scroll', queue, { passive: true });
      addEventListener('resize', queue);
      matchHeader();

      // Back to top, with a ring that fills as you read down the page. --lift
      // raises it over whatever owns the bottom of the screen at the time: the
      // cookie notice, or the builder's step bar while it is stuck there.
      const toTop = document.querySelector('[data-to-top]') as HTMLElement | null;
      const cookieBar = document.querySelector('[data-cookie-bar]') as HTMLElement | null;
      let topQueued = false;
      const placeTop = () => {
        topQueued = false;
        if (!toTop) return;
        const room = document.documentElement.scrollHeight - innerHeight;
        toTop.classList.toggle('is-shown', scrollY > innerHeight * 1.5);
        toTop.style.setProperty('--read', String(room > 0 ? Math.min(1, scrollY / room) : 0));
        let lift = cookieBar?.classList.contains('is-shown') ? cookieBar.offsetHeight + 12 : 0;
        const foot = document.querySelector('[data-wiz-foot]')?.getBoundingClientRect();
        if (foot && foot.height && foot.top < innerHeight && foot.bottom >= innerHeight - 2) {
          lift = Math.max(lift, innerHeight - foot.top + 4);
        }
        toTop.style.setProperty('--lift', `${lift}px`);
        // Like the header: the map's colours over the map, the reader's theme elsewhere.
        for (const el of [toTop, cookieBar]) {
          if (!el || el.hidden) continue;
          // Where it sits, or where it is about to: the notice is checked
          // while it is still sliding up from below the screen.
          const r = el.getBoundingClientRect();
          const onMap = document.elementsFromPoint(r.left + r.width / 2, Math.min(r.top + r.height / 2, innerHeight - 8))
            .some((x) => !el.contains(x) && !toTop.contains(x) && !cookieBar?.contains(x) && x.closest('.map'));
          el.classList.toggle('map', onMap);
        }
      };
      const queueTop = () => { if (!topQueued) { topQueued = true; requestAnimationFrame(placeTop); } };
      addEventListener('scroll', queueTop, { passive: true });
      addEventListener('resize', queueTop);
      placeTop();
      toTop?.addEventListener('click', () => {
        scrollTo({ top: 0, behavior: 'smooth' });
        // Keyboard focus goes back up with the page, not left at the bottom.
        const main = document.getElementById('main');
        main?.setAttribute('tabindex', '-1');
        main?.focus({ preventScroll: true });
      });

      // The cookie notice: what the browser keeps, said once. Remembered in
      // the same storage it describes; with storage blocked it simply shows
      // again next time, which costs nothing.
      let cookiesSeen = false;
      try { cookiesSeen = localStorage.getItem('artrail-cookies-ok') === '1'; } catch (e) {}
      if (cookieBar && !cookiesSeen) {
        cookieBar.hidden = false;
        setTimeout(() => { cookieBar.classList.add('is-shown'); queueTop(); }, 1000);
        cookieBar.querySelector('[data-cookie-ok]')?.addEventListener('click', () => {
          try { localStorage.setItem('artrail-cookies-ok', '1'); } catch (e) {}
          cookieBar.classList.remove('is-shown');
          queueTop();
          setTimeout(() => { cookieBar.hidden = true; }, 500);
        });
      }

      // The toggle writes an explicit choice, which then beats the OS setting in
      // both directions - the reason the stylesheet carries a data-theme block
      // as well as a media query. A processed script, not is:inline: Astro's
      // Content-Security-Policy only covers the scripts it builds.
      document.addEventListener('click', (event) => {
        const button = (event.target as Element | null)?.closest('[data-theme-toggle]');
        if (!button) return;

        const root = document.documentElement;
        const current =
          root.getAttribute('data-theme') ??
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';

        root.setAttribute('data-theme', next);
        try { localStorage.setItem('artrail-theme', next); } catch (e) {}
      });
    </script>
  </body>
</html>
