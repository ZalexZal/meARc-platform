---
// The wait, drawn as the hero in miniature: three stops on a trail, a pulse
// walking from one to the next and each lighting as it arrives. The words stay
// under it, for screen readers and for anyone who wants to read them.
interface Props {
  label: string;
  class?: string;
  [attribute: string]: unknown;
}
const { label, class: className = '', ...rest } = Astro.props;
const trail = 'M14 21 C 30 4, 46 4, 60 16 S 90 30, 106 11';
---

<div class:list={['loader', className]} role="status" {...rest}>
  <svg class="loader-trail" viewBox="0 0 120 32" aria-hidden="true">
    <path class="loader-line" d={trail} />
    <circle class="loader-pulse" r="2.6">
      <animateMotion dur="1.8s" repeatCount="indefinite" path={trail} />
    </circle>
    <circle class="loader-stop" cx="14" cy="21" r="4.5" style="--at: 0" />
    <circle class="loader-stop" cx="60" cy="16" r="4.5" style="--at: 1" />
    <circle class="loader-stop" cx="106" cy="11" r="4.5" style="--at: 2" />
  </svg>
  <span class="loader-label">{label}</span>
</div>
