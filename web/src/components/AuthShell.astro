---
/**
 * Signing in, signing up and the other one-question pages stand on the night
 * map: the form is the one lit thing on it. Pulled up under the header like the
 * home page, so the header floats over the map.
 */
---

<div class="auth-shell night" data-auth-shell>
  <canvas data-auth-canvas aria-hidden="true"></canvas>
  <div class="auth-in"><slot /></div>
</div>

<script>
  import { startNightMap } from '../lib/nightmap';

  const shell = document.querySelector<HTMLElement>('[data-auth-shell]');
  const canvas = shell?.querySelector<HTMLCanvasElement>('[data-auth-canvas]');
  if (shell && canvas) startNightMap({ host: shell, canvas, seed: 41, walker: false });
</script>

<style>
  .auth-shell {
    position: relative; isolation: isolate; overflow: hidden;
    margin-top: -64px; padding-top: 64px;
    min-height: max(40rem, 100svh);
    background: #080d10;
  }
  .auth-shell > canvas { position: absolute; inset: 0; z-index: -2; display: block; }
  .auth-shell::before {
    content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(ellipse 46rem 40rem at 50% 45%, rgba(8,13,16,.9), rgba(8,13,16,.55) 60%, rgba(8,13,16,.25));
  }
  .auth-in { position: relative; }
</style>
