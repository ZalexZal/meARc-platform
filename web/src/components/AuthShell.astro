---
/**
 * Signing in, signing up and the other one-question pages stand on the
 * map: the form is the one lit thing on it. Pulled up under the header like the
 * home page, so the header floats over the map.
 */
---

<div class="auth-shell map" data-auth-shell>
  <div class="auth-in"><slot /></div>
</div>

<script>
  import { startTown } from '../lib/town';

  const shell = document.querySelector<HTMLElement>('[data-auth-shell]');
  if (shell) startTown({ host: shell, seed: 41, tilt: 52, walkers: 3, pointer: false, anchor: [0.5, 0.62], anchorMobile: [0.5, 0.7] });
</script>

<style>
  .auth-shell {
    position: relative; isolation: isolate; overflow: hidden;
    margin-top: -64px; padding-top: 64px;
    min-height: max(40rem, 100svh);
    background: var(--map-ground);
  }
  .auth-shell::before {
    content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(ellipse 46rem 40rem at 50% 45%, rgba(var(--map-ground-rgb), .9), rgba(var(--map-ground-rgb), .55) 60%, rgba(var(--map-ground-rgb), .25));
  }
  .auth-in { position: relative; }
</style>
