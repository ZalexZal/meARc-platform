---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

const pairs = [
  ['faq.q1', 'faq.a1'], ['faq.q2', 'faq.a2'], ['faq.q3', 'faq.a3'],
  ['faq.q4', 'faq.a4'], ['faq.q5', 'faq.a5'],
] as const;
---

<section id="faq" class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-28">
  <header class="max-w-2xl">
    <p class="eyebrow">{t('faq.eyebrow')}</p>
    <h2 class="mt-3 text-3xl sm:text-4xl">{t('faq.title')}</h2>
  </header>

  <div class="mt-10 max-w-3xl divide-y divide-[var(--line-soft)] border-y border-[var(--line-soft)]">
    {pairs.map(([q, a]) => (
      <details class="group py-5">
        <summary
          class="flex cursor-pointer list-none items-start justify-between gap-6 text-left text-base font-medium"
        >
          <span>{t(q)}</span>
          <span
            class="mt-1 shrink-0 text-[var(--ink-faint)] transition-transform duration-200 group-open:rotate-45"
            aria-hidden="true"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M8 3v10M3 8h10" stroke-linecap="round" />
            </svg>
          </span>
        </summary>
        <p class="mt-3 max-w-2xl pr-10 text-sm leading-relaxed text-[var(--ink-dim)]">{t(a)}</p>
      </details>
    ))}
  </div>
</section>
