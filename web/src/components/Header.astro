---
import { useTranslations, localise, type Lang, type UIKey } from '../i18n/ui';

interface Props { lang: Lang; otherHref: string; }
const { lang, otherHref } = Astro.props;
const t = useTranslations(lang);
const href = localise(lang);

const links: { label: UIKey; to: string }[] = [
  { label: 'nav.how',   to: '/#how' },
  { label: 'nav.games', to: '/trails' },
  { label: 'nav.play',  to: '/play' },
  { label: 'nav.faq',   to: '/#faq' },
];

// Which link is the page you are on. The two anchors on the home page are
// never "here": they are places on a page, not pages.
const here = Astro.url.pathname.replace(/^\/en/, '').replace(/\/$/, '') || '/';
const current = (to: string) => !to.includes('#') && here === to;
---

<!-- One way in for a creator. "Build a trail" used to sit beside My trails and
     led to a page that only asked for a name; the name is now asked on My
     trails itself, where the trails already are. -->
<header class="site-header" data-site-header>
  <div class="bar">
    <a href={href('/')} class="logo" aria-label="AR Trail">
      <!-- A pin standing on a ring: the marker and the distance around it. -->
      <svg width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true">
        <ellipse cx="13" cy="20.5" rx="7.5" ry="3" stroke="currentColor" stroke-opacity=".45" stroke-width="1.2" />
        <path d="M13 3.5c-3.3 0-6 2.6-6 5.9 0 4.4 6 9.6 6 9.6s6-5.2 6-9.6c0-3.3-2.7-5.9-6-5.9Z" fill="var(--signal)" />
        <circle cx="13" cy="9.3" r="2.1" fill="var(--signal-ink)" />
      </svg>
      <!-- The wordmark stands down on the narrowest phones, where "Регистрация"
           would otherwise push the row off the side. -->
      <span class="word">AR&nbsp;Trail</span>
    </a>

    <nav class="nav" aria-label={t('nav.menu')}>
      {links.map((l) => (
        <a href={href(l.to)} aria-current={current(l.to) ? 'page' : undefined}>{t(l.label)}</a>
      ))}
      <a href={href('/my-trails')} data-auth-in hidden aria-current={here === '/my-trails' || here === '/trail' ? 'page' : undefined}>
        {t('nav.mine')}
      </a>
    </nav>

    <div class="tools">
      <details class="menu" data-menu>
        <summary class="icon-btn" aria-label={t('nav.menu')}>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </summary>
        <nav class="menu-pop" aria-label={t('nav.menu')}>
          {links.map((l) => <a href={href(l.to)}>{t(l.label)}</a>)}
          <a href={href('/my-trails')} data-auth-in hidden class="strong">{t('nav.mine')}</a>
          <a href={href('/signin')} data-auth-out hidden class="strong">{t('nav.signin')}</a>
        </nav>
      </details>

      <button type="button" data-theme-toggle class="icon-btn" aria-label={t('nav.theme')}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" stroke-linejoin="round" />
        </svg>
      </button>

      <a href={otherHref} class="icon-btn lang" aria-label={t('nav.lang')} hreflang={lang === 'bg' ? 'en' : 'bg'}>
        {lang === 'bg' ? 'EN' : 'BG'}
      </a>

      <!-- Both sets ship; the script keeps the right one, so nobody sees
           "Sign up" flash while already signed in. -->
      <span class="contents" data-auth-out hidden>
        <a href={href('/signin')} class="btn btn-quiet btn-sm hide-sm">{t('nav.signin')}</a>
        <a href={href('/signup')} class="btn btn-primary btn-sm">{t('nav.signup')}</a>
      </span>
      <span class="contents" data-auth-in hidden>
        <a href={href('/account')} class="me-chip" aria-label={t('nav.account')}>
          <span class="me-face" data-me-initials aria-hidden="true">·</span>
          <span class="me-name" data-me-name>{t('nav.account')}</span>
        </a>
      </span>
    </div>
  </div>
</header>

<script>
  import { who } from '../lib/session';

  // A tap anywhere else closes the phone menu, the way a menu is expected to.
  const menu = document.querySelector('[data-menu]') as HTMLDetailsElement | null;
  document.addEventListener('click', (event) => {
    if (menu?.open && !menu.contains(event.target as Node)) menu.open = false;
  });

  // Neither pair is visible until this decides, so nobody sees the wrong one.
  const { user, anonymous } = await who();
  const signedIn = Boolean(user) && !anonymous;
  document.querySelectorAll(signedIn ? '[data-auth-in]' : '[data-auth-out]')
    .forEach((el) => el.removeAttribute('hidden'));

  if (signedIn && user) {
    const name: string = user.user_metadata?.display_name || '';
    const parts = name.trim().split(/\s+/).filter(Boolean);
    const initials = parts.length
      ? (parts[0][0] + (parts[1]?.[0] ?? '')).toUpperCase()
      : (user.email ?? '?').slice(0, 1).toUpperCase();

    document.querySelectorAll('[data-me-initials]').forEach((el) => (el.textContent = initials));
    if (name) document.querySelectorAll('[data-me-name]').forEach((el) => (el.textContent = name));
  }
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 40;
    border-bottom: 1px solid var(--line-soft);
    background: color-mix(in srgb, var(--ground) 76%, transparent);
    -webkit-backdrop-filter: saturate(160%) blur(16px);
    backdrop-filter: saturate(160%) blur(16px);
    color: var(--ink);
    transition: background-color .35s ease, border-color .35s ease, color .35s ease;
  }
  .bar {
    position: relative;
    max-width: 76rem; margin: 0 auto; height: 64px; padding: 0 1rem;
    display: flex; align-items: center; gap: .5rem;
  }
  @media (min-width: 640px) { .bar { padding: 0 1.5rem; } }
  .logo {
    display: flex; align-items: center; gap: .625rem; flex-shrink: 0;
    font-family: var(--font-display); font-weight: 600; font-size: 15px; letter-spacing: -.01em;
  }
  .word { display: none; }
  @media (min-width: 420px) { .word { display: inline; } }

  .nav { display: none; margin-left: 1.25rem; gap: 2px; }
  @media (min-width: 900px) { .nav { display: flex; } }
  .nav a {
    padding: .625rem .75rem; border-radius: 999px;
    color: var(--ink-dim); font-size: var(--text-sm); font-weight: 500;
    transition: color .18s ease, background-color .18s ease;
  }
  .nav a:hover { color: var(--ink); background: var(--surface-2); }
  .nav a[aria-current="page"] { color: var(--ink); background: var(--surface-2); font-weight: 600; }

  .tools { margin-left: auto; display: flex; align-items: center; gap: .375rem; }
  .icon-btn {
    width: 44px; height: 44px; display: grid; place-items: center; flex-shrink: 0;
    border-radius: 999px; color: var(--ink-dim); cursor: pointer;
    font-size: var(--text-xs); font-weight: 600;
    transition: color .18s ease, background-color .18s ease;
  }
  .icon-btn:hover { color: var(--ink); background: var(--surface-2); }
  .lang { min-width: 44px; width: auto; padding: 0 .5rem; }

  .menu { display: block; }
  @media (min-width: 900px) { .menu { display: none; } }
  .menu summary { list-style: none; }
  .menu summary::-webkit-details-marker { display: none; }
  /* Anchored to the bar, not to the button: from the button it opened off the
     left edge of a phone. */
  .menu-pop {
    position: absolute; left: 1rem; right: 1rem; top: 60px; z-index: 50;
    display: flex; flex-direction: column; padding: .5rem;
    border-radius: 20px; border: 1px solid var(--line);
    background: color-mix(in srgb, var(--ground) 94%, transparent);
    -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px);
    box-shadow: 0 24px 50px -24px rgba(0, 0, 0, .55);
  }
  @media (min-width: 640px) { .menu-pop { left: auto; width: 18rem; } }
  .menu-pop a { padding: .875rem .75rem; border-radius: 14px; font-size: 15px; }
  .menu-pop a:hover { background: var(--surface-2); }
  .menu-pop a.strong { color: var(--signal); font-weight: 600; }

  .hide-sm { display: none; }
  @media (min-width: 640px) { .hide-sm { display: inline-flex; } }

  /* You, not a button called Profile: initials and a name, the same mark the
     app puts on its You tab. */
  .me-chip {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; max-width: 14rem;
    border: 1px solid var(--line); border-radius: 999px; padding: 4px 14px 4px 4px;
    font-weight: 500; font-size: .9rem; color: var(--ink);
  }
  .me-chip:hover { background: var(--surface-2); }
  .me-face {
    width: 34px; height: 34px; border-radius: 50%; flex: none; display: grid; place-items: center;
    background: var(--signal); color: var(--signal-ink);
    font-family: var(--font-display); font-weight: 800; font-size: .72rem;
  }
  .me-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  @media (max-width: 640px) { .me-name { display: none; } .me-chip { padding-right: 4px; } }
</style>
