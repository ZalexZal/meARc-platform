---
import { useTranslations, localise, type Lang, type UIKey } from '../i18n/ui';

interface Props { lang: Lang; otherHref: string; }
const { lang, otherHref } = Astro.props;
const t = useTranslations(lang);
const href = localise(lang);

const links: { label: UIKey; to: string }[] = [
  { label: 'nav.how',   to: '/#how' },
  { label: 'nav.games', to: '/trails' },
  { label: 'nav.faq',   to: '/#faq' },
];
---

<header
  class="sticky top-0 z-40 border-b border-[var(--line-soft)] bg-[color-mix(in_srgb,var(--ground)_88%,transparent)] backdrop-blur-md"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-3 px-4 sm:px-6">
    <a href={href('/')} class="flex items-center gap-2.5 shrink-0" aria-label="AR Trail">
      <!-- A pin standing on a ring: the marker and the distance around it, which
           is the whole product in one glyph. -->
      <svg width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true">
        <ellipse cx="13" cy="20.5" rx="7.5" ry="3" stroke="var(--ink-faint)" stroke-width="1.2" />
        <path
          d="M13 3.5c-3.3 0-6 2.6-6 5.9 0 4.4 6 9.6 6 9.6s6-5.2 6-9.6c0-3.3-2.7-5.9-6-5.9Z"
          fill="var(--signal)"
        />
        <circle cx="13" cy="9.3" r="2.1" fill="var(--signal-ink)" />
      </svg>
      <!-- The wordmark stands down on the narrowest phones. "Регистрация" is
           half again as wide as "Sign up", and on a 390px screen in Bulgarian
           the row overflowed by 53px - the whole header pushed off the side.
           The pin still identifies the site, and it is the half that survives
           being small. -->
      <span
        class="hidden font-[family-name:var(--font-display)] text-[15px] font-semibold tracking-tight min-[420px]:inline"
      >
        AR&nbsp;Trail
      </span>
    </a>

    <nav class="ml-4 hidden items-center gap-1 md:flex" aria-label={t('nav.menu')}>
      {links.map((l) => (
        <a
          href={href(l.to)}
          class="rounded-lg px-3 py-2 text-sm text-[var(--ink-dim)] transition-colors hover:bg-[var(--surface-2)] hover:text-[var(--ink)]"
        >
          {t(l.label)}
        </a>
      ))}

      <!-- Only for somebody who has trails. It is revealed by the same script
           that picks the buttons on the right, so a signed-out visitor never
           sees a link to a page that would only bounce them to the sign-in. -->
      <a
        href={href('/my-trails')}
        data-auth-in
        hidden
        class="rounded-lg px-3 py-2 text-sm text-[var(--ink-dim)] transition-colors hover:bg-[var(--surface-2)] hover:text-[var(--ink)]"
      >
        {t('nav.mine')}
      </a>
    </nav>

    <div class="ml-auto flex items-center gap-1.5">
      <button
        type="button"
        data-theme-toggle
        class="grid h-11 w-11 place-items-center rounded-lg text-[var(--ink-dim)] transition-colors hover:bg-[var(--surface-2)] hover:text-[var(--ink)]"
        aria-label={t('nav.theme')}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" stroke-linejoin="round" />
        </svg>
      </button>

      <a
        href={otherHref}
        class="grid h-11 min-w-11 place-items-center rounded-lg px-2 text-xs font-semibold text-[var(--ink-dim)] transition-colors hover:bg-[var(--surface-2)] hover:text-[var(--ink)]"
        aria-label={t('nav.lang')}
        hreflang={lang === 'bg' ? 'en' : 'bg'}
      >
        {lang === 'bg' ? 'EN' : 'BG'}
      </a>

      <!-- Both sets ship; the script below keeps the right one. Rendering the
           signed-out pair and swapping after load would flash "Sign up" at
           somebody who is already signed in, on every page. -->
      <span class="contents" data-auth-out hidden>
        <a href={href('/signin')} class="btn btn-quiet hidden sm:inline-flex">{t('nav.signin')}</a>
        <a href={href('/signup')} class="btn btn-primary">{t('nav.signup')}</a>
      </span>
      <span class="contents" data-auth-in hidden>
        <a href={href('/account')} class="btn btn-quiet">{t('nav.account')}</a>
        <a href={href('/create')} class="btn btn-primary hidden sm:inline-flex">{t('nav.create')}</a>
      </span>
    </div>
  </div>
</header>

<script>
  import { who } from '../lib/session';

  // Neither pair is visible until this decides, so nobody sees the wrong one.
  const { user, anonymous } = await who();
  const signedIn = Boolean(user) && !anonymous;
  // querySelectorAll, not querySelector. The nav gained a second [data-auth-in]
  // and the old single-element version revealed whichever came first in the
  // document - so the buttons on the right stayed hidden behind the new link.
  document.querySelectorAll(signedIn ? '[data-auth-in]' : '[data-auth-out]')
    .forEach((el) => el.removeAttribute('hidden'));
</script>
