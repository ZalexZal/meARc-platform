---
import { useTranslations, localise, type Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const href = localise(lang);

/**
 * The stop editor, in tabs.
 *
 * It was one column of eighteen fields and it got worse with every field the
 * schema gained. The builder behind ctf.myedulink.eu splits the same job across
 * Basics / Place / Answer / Hints / Media, and it is easier to use for a plain
 * reason: at any moment you are answering one kind of question about the stop
 * rather than scrolling past four kinds to reach the fifth.
 *
 * The map and the stop list stay outside the tabs. They are how you choose what
 * you are editing, so they cannot live inside one of the things being chosen.
 */
const tabs = [
  { id: 'basics', label: t('tab.basics') },
  { id: 'place',  label: t('tab.place') },
  { id: 'answer', label: t('tab.answer') },
  { id: 'hints',  label: t('tab.hints') },
  { id: 'media',  label: t('tab.media') },
];

const strings = {
  lang,
  saved: t('ed.saved'), saving: t('ed.saving'),
  notYours: t('ed.notYours'), draft: t('ed.draft'), published: t('ed.published'),
  publish: t('ed.publish'), unpublish: t('ed.unpublish'),
  accept: t('ed.accept'), reject: t('ed.reject'), you: t('board.you'),
  rank: t('board.rank'), team: t('board.team'), bPoints: t('board.points'),
  bSolved: t('board.solved'), time: t('board.time'),
  overlap: t('ed.overlap'), remove: t('ed.remove'), hintCost: t('ed.hintCost'),
  uploading: t('ed.uploading'), tooBig: t('ed.tooBig'),
  mediaUsed: t('ed.mediaUsed'), mediaFull: t('ed.mediaFull'),
  mediaWontFit: t('ed.mediaWontFit'),
  reorderFailed: t('ed.reorderFailed'),
  teamSizeHint: t('ed.teamSizeHint'),
  impNoHeader: t('imp.noHeader'), impNoRows: t('imp.noRows'),
  impNeedName: t('imp.needName'), impBadCoords: t('imp.badCoords'),
  impBadKind: t('imp.badKind'), impNeedAccepted: t('imp.needAccepted'),
  impBadOnWrong: t('imp.badOnWrong'), impDupe: t('imp.dupe'),
  impRow: t('imp.row'), impReady: t('imp.ready'), impProblems: t('imp.problems'),
  impImport: t('imp.import'), impImporting: t('imp.importing'),
  impDone: t('imp.done'), impFailed: t('imp.failed'),
  lvDraft: t('vis.private'), lvDraftHint: t('vis.privateHint'),
  lvCode: t('vis.unlisted'), lvCodeHint: t('vis.unlistedHint'),
  lvPublic: t('vis.public'), lvPublicHint: t('vis.publicHint'),
  lvAsk: t('vis.publicAsk'), lvAskHint: t('vis.publicAskHint'),
  lvWaiting: t('mine.pending'), lvWaitingBody: t('mine.pendingBody'),
  lvNote: t('mine.reviewNote'), copy: t('pub.copy'), copied: t('pub.copied'),
  colourNone: t('ed.colourNone'),
  boardHref: href('/board'),
};
---

<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6" hidden data-guarded>
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div class="min-w-0">
      <a class="eyebrow hover:text-[var(--ink)]" href={href('/account')}>← {t('acct.title')}</a>
      <h1 class="mt-2 truncate text-2xl sm:text-3xl" data-trail-name></h1>
      <p class="mt-1 flex flex-wrap items-center gap-x-3 text-xs">
        <span class="eyebrow" data-trail-mode></span>
        <span class="eyebrow" data-trail-status></span>
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <div class="card flex items-center gap-2 px-3 py-2">
        <span class="eyebrow">{t('ed.code')}</span>
        <code class="data text-xl font-medium tracking-widest text-[var(--signal)]"
              data-trail-code></code>
        <button class="btn btn-ghost btn-sm" type="button" data-copy-code>{t('pub.copy')}</button>
        <button class="text-xs text-[var(--ink-faint)] underline-offset-2 hover:text-[var(--ink)] hover:underline"
                type="button" data-rotate title={t('ed.rotateHint')}>{t('ed.rotate')}</button>
      </div>
      <!-- Beside the code, because both are things you set once for the whole
           trail and then read out to a room. -->
      <label class="card flex items-center gap-2 px-3 py-2 text-xs"
             title={t('ed.teamSizeHint')}>
        <span class="eyebrow">{t('ed.teamSize')}</span>
        <input class="data w-12 bg-transparent text-base font-medium text-[var(--ink)] outline-none"
               data-team-size inputmode="numeric" maxlength="2" />
      </label>

      <!-- The same three rungs My trails offers. There used to be a Publish
           button here that wrote the same two columns with different words, so a
           trail could be "published" on one screen and "only me" on the other,
           and both were telling the truth about a different column. -->
      <div>
        <div class="tabs" data-levels>
          <button class="tab" type="button" data-level="draft">{t('vis.private')}</button>
          <button class="tab" type="button" data-level="code">{t('vis.unlisted')}</button>
          <button class="tab" type="button" data-level="public"></button>
        </div>
        <p class="mt-1.5 max-w-xs text-xs text-[var(--ink-faint)]" data-level-hint></p>
        <p class="mt-1.5 hidden max-w-xs text-xs text-[var(--lamp)]" data-level-note></p>
      </div>
    </div>
  </header>

  <div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)]">
    <!-- Choosing what to edit. Outside the tabs, because this is how a stop
         gets picked and it cannot live inside one of the things being picked. -->
    <div class="lg:sticky lg:top-20 lg:self-start">
      <div class="card overflow-hidden" style="padding:0">
        <div class="h-[340px] w-full sm:h-[420px]" data-map></div>
      </div>
      <p class="mt-2 text-xs text-[var(--ink-faint)]">{t('ed.placeHint')}</p>

      <p class="mt-3 hidden rounded-lg border border-[var(--lamp)] bg-[var(--lamp-wash)] px-3 py-2 text-xs text-[var(--lamp)]"
         data-overlap></p>

      <h2 class="mt-6 text-sm font-semibold">
        {t('ed.stops')} <span class="data text-[var(--ink-faint)]" data-stop-count></span>
      </h2>
      <p class="mt-2 text-sm text-[var(--ink-dim)]" data-stops-empty hidden>{t('ed.noStops')}</p>
      <ul class="mt-2 space-y-1.5" data-stops></ul>

      <!-- Eight stops with a question each is forty fields typed into five tabs.
           A creator who already has them in a spreadsheet should not have to. -->
      <details class="card mt-6 p-4" data-import>
        <summary class="cursor-pointer text-sm font-semibold">{t('imp.title')}</summary>

        <p class="mt-3 text-xs text-[var(--ink-dim)]">{t('imp.lede')}</p>

        <button class="btn btn-quiet btn-sm mt-3" type="button" data-imp-template>
          {t('imp.template')}
        </button>

        <label class="field-row mt-4">
          <span class="field-name">{t('imp.paste')}</span>
          <textarea class="field data" rows="5" data-imp-text
                    placeholder="name_bg	name_en	text_bg	..."></textarea>
        </label>

        <label class="field-row mt-3">
          <span class="field-name">{t('imp.file')}</span>
          <input class="field" type="file" accept=".csv,text/csv" data-imp-file />
        </label>

        <div class="mt-3 flex flex-wrap gap-2">
          <button class="btn btn-quiet btn-sm" type="button" data-imp-check>{t('imp.check')}</button>
          <button class="btn btn-primary btn-sm hidden" type="button" data-imp-go></button>
          <span class="self-center text-xs text-[var(--ink-dim)]" data-imp-status></span>
        </div>

        <ul class="mt-3 space-y-1 text-xs" data-imp-report></ul>
      </details>
    </div>

    <div>
      <p class="empty" data-no-selection>{t('ed.selectStop')}</p>

      <form class="hidden" data-marker-form novalidate>
        <!-- A segmented control rather than an underline. Five tabs on a laptop
             read as a row of segments; the same five as underlined text read as
             a sentence somebody has bolded a word in. -->
        <div class="tabs" role="tablist">
            {tabs.map((tab, i) => (
              <button
                type="button" role="tab" data-tab={tab.id}
                aria-selected={i === 0 ? 'true' : 'false'}
                class="tab"
              >
                {tab.label}
                {tab.id === 'hints' && <span class="data ml-1 text-2xs" data-count-hints></span>}
                {tab.id === 'media' && <span class="data ml-1 text-2xs" data-count-media></span>}
              </button>
            ))}
        </div>

        <div class="space-y-4 pt-6" data-panel="basics">
          <div class="grid gap-3 sm:grid-cols-2">
            <label class="block text-sm">
              <span class="mb-1 block font-medium">{t('ed.titleBg')} *</span>
              <input class="field" name="titleBg" maxlength="80" />
            </label>
            <label class="block text-sm">
              <span class="mb-1 block font-medium">{t('ed.titleEn')}</span>
              <input class="field" name="titleEn" maxlength="80" />
            </label>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            <label class="block text-sm">
              <span class="mb-1 block font-medium">{t('ed.bodyBg')}</span>
              <textarea class="field" name="bodyBg" rows="5" maxlength="900"></textarea>
            </label>
            <label class="block text-sm">
              <span class="mb-1 block font-medium">{t('ed.bodyEn')}</span>
              <textarea class="field" name="bodyEn" rows="5" maxlength="900"></textarea>
            </label>
          </div>
          <p class="text-xs text-[var(--ink-faint)]">{t('ed.required')}</p>

          <div>
            <span class="mb-1 block text-sm font-medium">{t('ed.colour')}</span>

            <div class="flex items-center gap-4">
              <div class="min-w-0 flex-1">
                <div class="hue" data-hue role="slider" tabindex="0"
                     aria-label={t('ed.colour')} aria-valuemin="0" aria-valuemax="359">
                  <span class="hue-handle" data-hue-handle hidden></span>
                </div>
                <p class="data mt-1.5 text-xs text-[var(--ink-faint)]" data-hue-value></p>
              </div>

              <!-- The same dot on a pale street and a dark one, since that is
                   the only question a creator is really asking. -->
              <span class="hue-proof" style="background:#e9edee">
                <span data-hue-proof-light></span>
              </span>
              <span class="hue-proof" style="background:#1b2226">
                <span data-hue-proof-dark></span>
              </span>
            </div>

            <p class="mt-2 text-xs text-[var(--ink-faint)]">{t('ed.colourHint')}</p>
          </div>
        </div>

        <div class="hidden space-y-4 pt-6" data-panel="place">
          <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
            <label class="block text-sm">
              <span class="mb-1 block font-medium">{t('ed.lat')} *</span>
              <input class="field data" name="lat" inputmode="decimal" />
            </label>
            <label class="block text-sm">
              <span class="mb-1 block font-medium">{t('ed.lng')} *</span>
              <input class="field data" name="lng" inputmode="decimal" />
            </label>
            <label class="block text-sm">
              <span class="mb-1 block font-medium">{t('ed.radius')}</span>
              <input class="field data" name="radius" inputmode="numeric" />
            </label>
          </div>
          <p class="text-xs text-[var(--ink-faint)]">{t('ed.radiusHint')}</p>
          <p class="text-xs text-[var(--ink-faint)]">{t('ed.stepHint')}</p>
        </div>

        <div class="hidden space-y-4 pt-6" data-panel="answer">
          <div data-when-asked>
            <p class="text-sm font-medium">{t('ed.question')}</p>
            <div class="mt-2 grid gap-3 sm:grid-cols-2">
              <textarea class="field" name="questionBg" rows="2" maxlength="400"
                        placeholder="BG"></textarea>
              <textarea class="field" name="questionEn" rows="2" maxlength="400"
                        placeholder="EN"></textarea>
            </div>
            <p class="mt-1 text-xs text-[var(--ink-faint)]">{t('ed.questionHint')}</p>
          </div>

          <div class="grid gap-3 sm:grid-cols-2">
            <label class="block text-sm">
              <span class="mb-1 block font-medium">{t('ed.answerKind')}</span>
              <select class="field" name="kind">
                <option value="none">{t('ed.answerNone')}</option>
                <option value="exact">{t('ed.answerExact')}</option>
                <option value="choice">{t('ed.answerChoice')}</option>
                <option value="free">{t('ed.answerFree')}</option>
              </select>
            </label>
            <div class="grid grid-cols-2 gap-3" data-when-scored>
              <label class="block text-sm">
                <span class="mb-1 block font-medium">{t('ed.pointsLabel')}</span>
                <input class="field data" name="points" inputmode="numeric" value="10" />
              </label>
              <label class="block text-sm">
                <span class="mb-1 block font-medium">{t('ed.cooldown')}</span>
                <input class="field data" name="cooldown" inputmode="numeric" value="60" />
              </label>
            </div>
          </div>

          <p class="hidden text-xs text-[var(--ink-faint)]" data-cooldown-hint>{t('ed.cooldownHint')}</p>

          <div data-when-asked-rule>
            <div class="grid gap-3 sm:grid-cols-2">
              <label class="block text-sm">
                <span class="mb-1 block font-medium">{t('ed.onWrong')}</span>
                <select class="field" name="onWrong">
                  <option value="retry">{t('ed.wrongRetry')}</option>
                  <option value="lock">{t('ed.wrongLock')}</option>
                  <option value="deduct">{t('ed.wrongDeduct')}</option>
                  <option value="skip">{t('ed.wrongSkip')}</option>
                </select>
              </label>
              <label class="block text-sm" data-when-deduct>
                <span class="mb-1 block font-medium">{t('ed.deductPoints')}</span>
                <input class="field data" name="deduct" inputmode="numeric" value="5" />
              </label>
            </div>
            <p class="mt-1 text-xs text-[var(--ink-faint)]">{t('ed.onWrongHint')}</p>
          </div>

          <div class="hidden" data-when-exact>
            <label class="block text-sm">
              <span class="mb-1 block font-medium">{t('ed.accepted')}</span>
              <textarea class="field" name="accepted" rows="4"></textarea>
            </label>
            <p class="mt-1 text-xs text-[var(--ink-faint)]">{t('ed.acceptedHint')}</p>
          </div>

          <!-- The options themselves. Their absence is what made this question
               type unusable: a correct index with nothing to index into. -->
          <div class="hidden" data-when-choice>
            <p class="mb-2 text-sm font-medium">{t('ed.choices')}</p>
            <div class="space-y-2" data-choices></div>
            <button class="btn btn-quiet btn-sm mt-2" type="button" data-add-choice>{t('ed.addChoice')}</button>
            <p class="mt-2 text-xs text-[var(--ink-faint)]">{t('ed.choicesHint')}</p>
          </div>

          <div class="hidden space-y-3 border-t border-[var(--line-soft)] pt-4" data-when-answered>
            <p class="text-sm font-medium">{t('ed.after')}</p>
            <div class="grid gap-3 sm:grid-cols-2">
              <textarea class="field" name="afterBg" rows="3" maxlength="600" placeholder="BG"></textarea>
              <textarea class="field" name="afterEn" rows="3" maxlength="600" placeholder="EN"></textarea>
            </div>
            <p class="text-xs text-[var(--ink-faint)]">{t('ed.afterHint')}</p>
          </div>
        </div>

        <div class="hidden space-y-4 pt-6" data-panel="hints">
          <p class="text-sm text-[var(--ink-dim)]" data-hints-empty>{t('ed.noHints')}</p>
          <ul class="space-y-2" data-hints></ul>

          <div class="card space-y-3 p-4">
            <div class="grid gap-3 sm:grid-cols-2">
              <label class="block text-sm">
                <span class="mb-1 block font-medium">{t('ed.hintText')} · BG</span>
                <input class="field" data-hint-bg maxlength="200" />
              </label>
              <label class="block text-sm">
                <span class="mb-1 block font-medium">{t('ed.hintText')} · EN</span>
                <input class="field" data-hint-en maxlength="200" />
              </label>
            </div>
            <label class="block text-sm">
              <span class="mb-1 block font-medium">{t('ed.hintCost')}</span>
              <input class="field data" data-hint-cost inputmode="numeric" value="0" />
            </label>
            <button class="btn btn-quiet w-full" type="button" data-add-hint>{t('ed.addHint')}</button>
          </div>
          <p class="text-xs text-[var(--ink-faint)]">{t('ed.hintsHint')}</p>
        </div>

        <div class="hidden space-y-4 pt-6" data-panel="media">
          <p class="text-sm text-[var(--ink-dim)]" data-media-empty>{t('ed.noMedia')}</p>
          <ul class="space-y-2" data-media></ul>

          <!-- Two across until there is real room for three: the browser writes
               "No file chosen" beside the button and owns that text, so the
               only way to stop it truncating to "N...sen" is to give it width. -->
          <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
            <div class="card p-4">
              <p class="eyebrow">{t('ed.addPhoto')}</p>
              <input class="field mt-2" type="file" accept="image/*" data-file-image />
            </div>
            <div class="card p-4">
              <p class="eyebrow">{t('ed.addAudio')}</p>
              <input class="field mt-2" type="file" accept="audio/*" data-file-audio />
            </div>
            <div class="card p-4">
              <p class="eyebrow">{t('ed.addVideo')}</p>
              <div class="mt-2 flex gap-2">
                <input class="field" data-video-url placeholder={t('ed.videoUrl')} />
                <button class="btn btn-quiet btn-sm shrink-0" type="button" data-add-video>+</button>
              </div>
            </div>
          </div>
          <p class="text-xs text-[var(--ink-faint)]">{t('ed.mediaHint')}</p>

          <!-- A trail's share of the storage. Drawn before anyone chooses a
               file, because "that did not fit" after a two-minute upload on a
               phone is the wrong moment to find out. -->
          <div class="mt-1" data-media-usage hidden>
            <div class="meter"><span style="width:0%" data-media-fill></span></div>
            <p class="data mt-1.5 text-xs text-[var(--ink-faint)]" data-media-used></p>
          </div>

          <p class="hidden text-sm text-[var(--signal)]" data-upload-status></p>
        </div>

        <!-- Outside the tabs. A save button on one tab and not another is how
             half a form gets lost. -->
        <p class="mt-6 hidden rounded-lg border border-[var(--alert)] bg-[var(--alert-wash)] px-3 py-2 text-sm text-[var(--alert)]"
           data-marker-error role="alert"></p>

        <div class="mt-6 flex gap-2 border-t border-[var(--line-soft)] pt-5">
          <button class="btn btn-primary flex-1" type="submit" data-marker-save>{t('ed.save')}</button>
          <button class="btn btn-quiet" type="button" data-marker-delete
                  style="border-color:var(--alert);color:var(--alert)">{t('ed.delete')}</button>
        </div>
      </form>
    </div>
  </div>

  <section class="mt-14">
    <h2 class="text-lg">
      {t('ed.review')}
      <span class="data ml-1 text-sm" data-review-count style="color:var(--lamp)"></span>
    </h2>
    <p class="mt-3 text-sm text-[var(--ink-dim)]" data-review-empty hidden>{t('ed.reviewEmpty')}</p>
    <ul class="mt-4 space-y-3" data-review></ul>
  </section>

  <section class="mt-14">
    <div class="flex items-center justify-between gap-3">
      <h2 class="text-lg">{t('ed.board')}</h2>
      <a class="text-sm text-[var(--signal)] underline-offset-2 hover:underline" data-board-link>{t('games.open')}</a>
    </div>
    <p class="mt-3 text-sm text-[var(--ink-dim)]" data-board-empty hidden>{t('ed.boardEmpty')}</p>
    <div class="scroll-x mt-4"><table class="w-full text-sm" data-board></table></div>
  </section>
</section>

<p class="mx-auto max-w-7xl px-4 py-24 text-center text-[var(--ink-dim)]" data-editor-loading>
  {t('games.loading')}
</p>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/maplibre-gl/5.6.0/maplibre-gl.css" />

<script type="application/json" data-editor-strings set:html={JSON.stringify(strings)}></script>

<script>
  import { db } from '../lib/supabase';
  import { requireUser, reveal, param, escapeHtml, text, duration } from '../lib/session';
  import { levelOf, isPending, isListed, setLevel } from '../lib/publishing';

  /**
   * MapLibre is loaded from a CDN rather than bundled, which is a decision and
   * not laziness.
   *
   * It resolves its tile-parsing worker through `new URL(..., import.meta.url)`.
   * Astro 7 builds with Rolldown, which rewrites that URL, and the worker then
   * never starts. Nothing reports it: the style downloads, 111 layers parse, the
   * canvas is correctly sized, and the map requests zero tiles while painting
   * the style's own background colour - which reads as an empty map rather than
   * a broken one.
   *
   * `optimizeDeps.exclude` fixed the dev server and left the build broken in
   * exactly the same silent way, which is worse than not fixing it: it looked
   * repaired everywhere I was looking. Version 6 ships ESM only, so there is no
   * pre-bundled file to import instead.
   *
   * Loaded here rather than as a tag, so the map cannot be constructed before
   * the library exists.
   */
  const MAPLIBRE = 'https://cdnjs.cloudflare.com/ajax/libs/maplibre-gl/5.6.0/maplibre-gl.js';

  async function loadMapLibre(): Promise<any> {
    if ((window as any).maplibregl) return (window as any).maplibregl;
    await new Promise<void>((resolve, reject) => {
      const tag = document.createElement('script');
      tag.src = MAPLIBRE;
      tag.crossOrigin = 'anonymous';
      tag.onload = () => resolve();
      tag.onerror = () => reject(new Error('maplibre failed to load'));
      document.head.appendChild(tag);
    });
    return (window as any).maplibregl;
  }

  const S = JSON.parse(document.querySelector('[data-editor-strings]')!.textContent || '{}');
  const q = (s: string) => document.querySelector(s);
  const qa = (s: string) => Array.from(document.querySelectorAll(s));

  await requireUser({ needsReal: true });
  const client = db()!;
  const worldId = param('id');
  if (!worldId) { location.replace('/account'); throw new Error('no id'); }

  const { data: mine } = await client.rpc('my_worlds');
  const owned = (mine ?? []).find((w: any) => w.id === worldId);
  if (!owned) { q('[data-editor-loading]')!.textContent = S.notYours; throw new Error('not yours'); }

  text(q('[data-trail-name]'), owned.name);
  text(q('[data-trail-mode]'), owned.mode);
  text(q('[data-trail-code]'), owned.join_code);
  q('[data-board-link]')!.setAttribute('href', `${S.boardHref}?id=${encodeURIComponent(worldId)}`);

  // Read from the row rather than from my_worlds: adding a column there means
  // dropping and recreating the function, and nothing else wanted it.
  const sizeBox = q('[data-team-size]') as HTMLInputElement;
  const teamSize = await client.from('worlds').select('team_size').eq('id', worldId).single();
  sizeBox.value = String(teamSize.data?.team_size ?? 4);

  sizeBox.addEventListener('change', async () => {
    const wanted = Math.round(Number(sizeBox.value));

    // The database has the same bounds and would refuse; catching it here is
    // what stops the box showing a number the trail is not actually using.
    if (!Number.isFinite(wanted) || wanted < 1 || wanted > 12) {
      const current = await client.from('worlds').select('team_size').eq('id', worldId).single();
      sizeBox.value = String(current.data?.team_size ?? 4);
      return;
    }

    const { error } = await client.from('worlds').update({ team_size: wanted }).eq('id', worldId);
    if (error) { alert(error.message); return; }
    sizeBox.value = String(wanted);
  });

  // The row as the server last described it. Every level change reloads it
  // rather than predicting it, because request_listing can refuse.
  let world = { id: worldId, status: owned.status, visibility: owned.visibility,
                review_note: owned.review_note };

  function paintStatus() {
    const here = levelOf(world);
    const waiting = isPending(world);
    const listed = isListed(world);

    text(q('[data-trail-status]'),
         here === 'draft' ? S.lvDraft : here === 'code' ? S.lvCode : S.lvPublic);

    qa('[data-level]').forEach((b) => {
      const level = (b as HTMLElement).dataset.level as 'draft' | 'code' | 'public';
      b.setAttribute('aria-selected', String(here === level));

      if (level === 'public') text(b, listed || waiting ? S.lvPublic : S.lvAsk);
    });

    text(q('[data-level-hint]'),
         waiting ? S.lvWaitingBody
         : here === 'draft' ? S.lvDraftHint
         : here === 'code' ? S.lvCodeHint
         : listed ? S.lvPublicHint : S.lvAskHint);

    // A refusal comes with a sentence. Not showing it leaves somebody pressing
    // the same button again wondering why nothing happened the first time.
    const note = q('[data-level-note]');
    if (note) {
      text(note, world.review_note ? `${S.lvNote} ${world.review_note}` : '');
      note.classList.toggle('hidden', !world.review_note);
    }
  }

  paintStatus();

  q('[data-editor-loading]')?.remove();
  reveal();

  qa('[data-tab]').forEach((button) => {
    button.addEventListener('click', () => {
      const id = (button as HTMLElement).dataset.tab!;
      qa('[data-tab]').forEach((b) => b.setAttribute('aria-selected', String(b === button)));
      qa('[data-panel]').forEach((p) =>
        p.classList.toggle('hidden', (p as HTMLElement).dataset.panel !== id));
    });
  });

  const maplibregl = await loadMapLibre();
  const map = new maplibregl.Map({
    container: q('[data-map]') as HTMLElement,
    style: 'https://tiles.openfreemap.org/styles/liberty',
    center: [26.5060, 42.4841],
    zoom: 15,
  });
  map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');
  requestAnimationFrame(() => map.resize());
  setTimeout(() => map.resize(), 400);
  new ResizeObserver(() => map.resize()).observe(q('[data-map]') as HTMLElement);

  let markers: any[] = [];
  let pins = new Map<string, any>();
  let selected: string | null = null;
  let choices: { bg: string; en: string; correct: boolean }[] = [];

  const form = q('[data-marker-form]') as HTMLFormElement;
  const field = (n: string) =>
    form.elements.namedItem(n) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
  const val = (n: string) => (field(n) as HTMLInputElement).value.trim();
  const num = (n: string) => { const v = val(n); return v === '' ? null : Number(v); };

  function showKindFields() {
    const kind = (field('kind') as HTMLSelectElement).value;
    q('[data-when-exact]')!.classList.toggle('hidden', kind !== 'exact');
    q('[data-when-choice]')!.classList.toggle('hidden', kind !== 'choice');
    (q('[data-when-scored]') as HTMLElement).style.visibility = kind === 'none' ? 'hidden' : '';
    (q('[data-when-asked]') as HTMLElement).hidden = kind === 'none';
    q('[data-when-answered]')!.classList.toggle('hidden', kind === 'none');
    q('[data-cooldown-hint]')!.classList.toggle('hidden', kind === 'none');
    (q('[data-when-asked-rule]') as HTMLElement).hidden = kind === 'none';

    // The amount only means anything under the rule that spends it.
    const rule = (field('onWrong') as HTMLSelectElement)?.value;
    (q('[data-when-deduct]') as HTMLElement).hidden = rule !== 'deduct';
  }

  function drawChoices() {
    const box = q('[data-choices]')!;
    box.innerHTML = choices.map((c, i) => `
      <div class="flex items-center gap-2">
        <input type="checkbox" data-choice-correct="${i}" ${c.correct ? 'checked' : ''} class="h-5 w-5 shrink-0" />
        <span class="data w-4 shrink-0 text-xs text-[var(--ink-faint)]">${i}</span>
        <input class="field" data-choice-bg="${i}" value="${escapeHtml(c.bg)}" placeholder="BG" />
        <input class="field" data-choice-en="${i}" value="${escapeHtml(c.en)}" placeholder="EN" />
        <button type="button" data-choice-del="${i}"
                class="shrink-0 px-2 text-lg text-[var(--ink-faint)] hover:text-[var(--alert)]">×</button>
      </div>`).join('');

    box.querySelectorAll('[data-choice-bg]').forEach((el) => el.addEventListener('input', () => {
      choices[Number((el as HTMLElement).dataset.choiceBg)].bg = (el as HTMLInputElement).value;
    }));
    box.querySelectorAll('[data-choice-en]').forEach((el) => el.addEventListener('input', () => {
      choices[Number((el as HTMLElement).dataset.choiceEn)].en = (el as HTMLInputElement).value;
    }));
    box.querySelectorAll('[data-choice-correct]').forEach((el) => el.addEventListener('change', () => {
      choices[Number((el as HTMLElement).dataset.choiceCorrect)].correct = (el as HTMLInputElement).checked;
    }));
    box.querySelectorAll('[data-choice-del]').forEach((el) => el.addEventListener('click', () => {
      choices.splice(Number((el as HTMLElement).dataset.choiceDel), 1);
      drawChoices();
    }));
  }

  field('kind').addEventListener('change', showKindFields);
  // The deduction box appears and disappears with the rule beside it.
  field('onWrong').addEventListener('change', showKindFields);
  q('[data-add-choice]')?.addEventListener('click', () => {
    choices.push({ bg: '', en: '', correct: false });
    drawChoices();
  });

  async function select(id: string | null) {
    selected = id;
    pins.forEach((pin, pid) => {
      pin.getElement().style.filter = pid === id ? 'drop-shadow(0 0 7px var(--signal))' : '';
    });

    q('[data-no-selection]')!.classList.toggle('hidden', Boolean(id));
    form.classList.toggle('hidden', !id);
    if (!id) return;

    const m = markers.find((x) => x.id === id);
    if (!m) return;

    (field('titleBg') as HTMLInputElement).value = m.content?.bg?.title ?? '';
    (field('titleEn') as HTMLInputElement).value = m.content?.en?.title ?? '';
    (field('bodyBg') as HTMLTextAreaElement).value = m.content?.bg?.body ?? '';
    (field('bodyEn') as HTMLTextAreaElement).value = m.content?.en?.body ?? '';
    (field('lat') as HTMLInputElement).value = String(m.lat ?? '');
    (field('lng') as HTMLInputElement).value = String(m.lng ?? '');
    (field('radius') as HTMLInputElement).value = String(m.radius_m ?? 100);

    // trail_markers already returns colour_hex; nothing has ever written one.
    hue = hexToHue(m.colour_hex ?? null);
    paintHue();
    (field('kind') as HTMLSelectElement).value = m.answer_kind ?? 'none';
    (field('points') as HTMLInputElement).value = String(m.points ?? 10);
    (field('cooldown') as HTMLInputElement).value = String(m.cooldown_seconds ?? 60);
    (field('onWrong') as HTMLSelectElement).value = m.on_wrong ?? 'retry';
    (field('deduct') as HTMLInputElement).value = String(m.deduct_points ?? 5);
    (field('accepted') as HTMLTextAreaElement).value = (m.accepted ?? []).join('\n');
    (field('questionBg') as HTMLTextAreaElement).value = m.content?.bg?.question ?? '';
    (field('questionEn') as HTMLTextAreaElement).value = m.content?.en?.question ?? '';
    (field('afterBg') as HTMLTextAreaElement).value = m.after_text?.bg ?? '';
    (field('afterEn') as HTMLTextAreaElement).value = m.after_text?.en ?? '';

    const bgOpts = m.content?.bg?.choices ?? [];
    const enOpts = m.content?.en?.choices ?? [];
    const correct: number[] = m.correct_choices ?? [];
    choices = bgOpts.map((label: string, i: number) => ({
      bg: label ?? '', en: enOpts[i] ?? '', correct: correct.includes(i),
    }));
    drawChoices();

    showKindFields();
    q('[data-marker-error]')!.classList.add('hidden');
    await Promise.all([loadHints(), loadMedia()]);
  }

  function drawList() {
    const list = q('[data-stops]')!;
    text(q('[data-stop-count]'), markers.length ? `(${markers.length})` : '');
    q('[data-stops-empty]')!.toggleAttribute('hidden', markers.length > 0);

    list.innerHTML = markers.map((m, i) => {
      const title = m.content?.[S.lang]?.title || m.content?.bg?.title || m.content?.en?.title || '—';
      // draggable on the li, not on the button: a draggable button swallows its
      // own click on some browsers, and picking a stop is the commoner action.
      return `<li draggable="true" data-row="${m.id}" class="rounded-lg transition-opacity">
        <button type="button" data-pick="${m.id}"
        class="flex w-full cursor-grab items-center gap-2.5 rounded-lg border border-[var(--line)] px-3 py-2 text-left text-sm transition-colors hover:bg-[var(--surface-2)]">
        <span class="data w-5 shrink-0 text-xs text-[var(--ink-faint)]">${m.step ?? i + 1}</span>
        <span class="min-w-0 flex-1 truncate">${escapeHtml(title)}</span>
        ${Number(m.hint_count) ? `<span class="data shrink-0 text-2xs text-[var(--ink-faint)]">?${m.hint_count}</span>` : ''}
        ${Number(m.media_count) ? `<span class="data shrink-0 text-2xs text-[var(--ink-faint)]">#${m.media_count}</span>` : ''}
        ${m.answer_kind && m.answer_kind !== 'none'
          ? `<span class="data shrink-0 text-xs" style="color:var(--lamp)">${m.points ?? 0}</span>` : ''}
        ${m.status !== 'published' ? `<span class="eyebrow shrink-0">${S.draft}</span>` : ''}
      </button></li>`;
    }).join('');

    wireDragging(list);

    list.querySelectorAll('[data-pick]').forEach((b) =>
      b.addEventListener('click', async () => {
        const id = (b as HTMLElement).dataset.pick!;
        await select(id);
        const m = markers.find((x) => x.id === id);
        if (m) map.easeTo({ center: [m.lng, m.lat], zoom: Math.max(map.getZoom(), 16) });
      }));
  }

  /// Dragging a stop to a new place in the sequence.
  ///
  /// HTML5 drag events rather than a library: the list is a dozen rows of plain
  /// markup and pointer-based reordering is the kind of thing that works on the
  /// desk and not on a phone.
  ///
  /// The whole order goes to the server, not the pair that swapped. A swap
  /// needs the client to work out what moved and leaves the trail half-sorted if
  /// the second write never lands; the sequence the creator is looking at cannot
  /// disagree with itself.
  function wireDragging(list: Element) {
    let from: string | null = null;

    list.querySelectorAll('[data-row]').forEach((row) => {
      const el = row as HTMLElement;

      el.addEventListener('dragstart', (event) => {
        from = el.dataset.row!;
        el.style.opacity = '0.4';
        (event as DragEvent).dataTransfer?.setData('text/plain', from);
      });

      el.addEventListener('dragend', () => { from = null; el.style.opacity = ''; });

      // Both of these have to preventDefault or the drop never fires. dragover
      // fires continuously, so the only work here is the line showing where the
      // row would land.
      el.addEventListener('dragover', (event) => {
        event.preventDefault();
        if (!from || el.dataset.row === from) return;
        const box = el.getBoundingClientRect();
        const above = (event as DragEvent).clientY < box.top + box.height / 2;
        el.style.boxShadow = above
          ? 'inset 0 2px 0 0 var(--signal)'
          : 'inset 0 -2px 0 0 var(--signal)';
      });

      el.addEventListener('dragleave', () => { el.style.boxShadow = ''; });

      el.addEventListener('drop', async (event) => {
        event.preventDefault();
        el.style.boxShadow = '';

        const moved = from;
        const onto = el.dataset.row!;
        if (!moved || moved === onto) return;

        const box = el.getBoundingClientRect();
        const above = (event as DragEvent).clientY < box.top + box.height / 2;

        const order = markers.map((m) => m.id).filter((id) => id !== moved);
        const at = order.indexOf(onto);
        order.splice(above ? at : at + 1, 0, moved);

        // Drawn from the new order before the write, so the row lands under the
        // cursor immediately. load() below replaces this with the server's word.
        markers = order.map((id) => markers.find((m) => m.id === id)!);
        markers.forEach((m, i) => { m.step = i + 1; });
        drawList();

        const { error } = await client.rpc('reorder_markers', {
          p_world: worldId, p_ids: order,
        });

        if (error) { alert(`${S.reorderFailed}\n${error.message}`); }
        await load();
      });
    });
  }

  function drawPins() {
    pins.forEach((p) => p.remove());
    pins = new Map();

    for (const m of markers) {
      const el = document.createElement('div');
      el.style.cssText =
        'width:18px;height:18px;border-radius:50%;cursor:pointer;' +
        `background:${m.colour_hex || '#45C4B0'};border:2px solid #fff;` +
        'box-shadow:0 1px 4px rgba(0,0,0,.5)';

      const pin = new maplibregl.Marker({ element: el, draggable: true })
        .setLngLat([m.lng, m.lat]).addTo(map);
      el.addEventListener('click', (e) => { e.stopPropagation(); select(m.id); });

      pin.on('dragend', async () => {
        const { lng, lat } = pin.getLngLat();
        const { error } = await client.rpc('move_marker', { p_marker: m.id, p_lat: lat, p_lng: lng });
        if (error) { alert(error.message); await load(); return; }
        m.lat = lat; m.lng = lng;
        if (selected === m.id) {
          (field('lat') as HTMLInputElement).value = String(lat);
          (field('lng') as HTMLInputElement).value = String(lng);
        }
      });

      pins.set(m.id, pin);
    }
  }

  function drawPinsWhenReady() {
    if (map.loaded()) drawPins(); else map.once('load', drawPins);
  }

  async function load() {
    const { data, error } = await client.rpc('trail_markers', { p_world: worldId });
    if (error) { alert(error.message); return; }

    const { data: answers } = await client
      .from('marker_answers')
      .select('marker_id,kind,accepted,correct_choices,points,cooldown_seconds,after_text,on_wrong,deduct_points');
    const byId = new Map((answers ?? []).map((a: any) => [a.marker_id, a]));
    markers = (data ?? []).map((m: any) => ({ ...m, ...(byId.get(m.id) ?? {}) }));

    drawList();
    drawPinsWhenReady();
    if (selected && !markers.some((m) => m.id === selected)) await select(null);

    // Said, not enforced: a creator mid-edit will legitimately have two stops
    // on top of each other for a minute, and refusing the save would be worse.
    const { data: clashes } = await client.rpc('overlapping_stops', { p_world: worldId });
    const warn = q('[data-overlap]')!;
    if (clashes && clashes.length) {
      const name = (id: string) => {
        const m = markers.find((x) => x.id === id);
        return m?.content?.[S.lang]?.title || m?.content?.bg?.title || '—';
      };
      text(warn, `${S.overlap} ` + clashes.slice(0, 3)
        .map((c: any) => `${name(c.a)} / ${name(c.b)} (${Math.round(c.metres)} m)`).join(', '));
      warn.classList.remove('hidden');
    } else {
      warn.classList.add('hidden');
    }
  }

  await load();

  map.on('click', async (event) => {
    const { lng, lat } = event.lngLat;
    const { data, error } = await client.rpc('place_marker', {
      p_world: worldId, p_lat: lat, p_lng: lng, p_content: {}, p_status: 'draft',
    });
    if (error) { alert(error.message); return; }
    await load();
    const id = Array.isArray(data) ? data[0]?.id : (data as any)?.id;
    if (id) await select(id);
  });

  // ------------------------------------------------------------------ hints
  async function loadHints() {
    if (!selected) return;
    const { data } = await client.from('marker_hints')
      .select('id,ord,body,cost').eq('marker_id', selected).order('ord');
    const rows = data ?? [];

    text(q('[data-count-hints]'), rows.length ? String(rows.length) : '');
    q('[data-hints-empty]')!.classList.toggle('hidden', rows.length > 0);
    q('[data-hints]')!.innerHTML = rows.map((h: any) => `
      <li class="card flex items-start justify-between gap-3 p-3">
        <div class="min-w-0">
          <p class="text-sm">${escapeHtml(h.body?.bg || h.body?.en || '—')}</p>
          <p class="data mt-0.5 text-2xs text-[var(--ink-faint)]">${h.cost} · ${escapeHtml(S.hintCost)}</p>
        </div>
        <button type="button" data-del-hint="${h.id}"
                class="shrink-0 text-xs text-[var(--alert)] hover:underline">${escapeHtml(S.remove)}</button>
      </li>`).join('');

    q('[data-hints]')!.querySelectorAll('[data-del-hint]').forEach((b) =>
      b.addEventListener('click', async () => {
        await client.from('marker_hints').delete().eq('id', (b as HTMLElement).dataset.delHint!);
        await Promise.all([loadHints(), load()]);
      }));
  }

  q('[data-add-hint]')?.addEventListener('click', async () => {
    if (!selected) return;
    const bg = (q('[data-hint-bg]') as HTMLInputElement).value.trim();
    const en = (q('[data-hint-en]') as HTMLInputElement).value.trim();
    const cost = Number((q('[data-hint-cost]') as HTMLInputElement).value || 0);
    if (!bg && !en) return;

    const existing = (await client.from('marker_hints').select('id').eq('marker_id', selected)).data ?? [];
    const { error } = await client.from('marker_hints').insert({
      marker_id: selected, ord: existing.length + 1, cost,
      body: { ...(bg && { bg }), ...(en && { en }) },
    });
    if (error) { alert(error.message); return; }

    (q('[data-hint-bg]') as HTMLInputElement).value = '';
    (q('[data-hint-en]') as HTMLInputElement).value = '';
    (q('[data-hint-cost]') as HTMLInputElement).value = '0';
    await Promise.all([loadHints(), load()]);
  });

  // ------------------------------------------------------------------ media
  const BUCKET = 'marker-media';
  const MAX_BYTES = 50 * 1024 * 1024;

  /** Whole megabytes below ten, one decimal above: 0.4 MB, 7.2 MB, 143 MB. */
  function megabytes(bytes: number) {
    const mb = bytes / (1024 * 1024);
    return `${mb >= 10 ? Math.round(mb) : Math.round(mb * 10) / 10} MB`;
  }

  const usage = { used: 0, cap: 0 };

  async function loadUsage() {
    if (!worldId) return;

    const { data, error } = await client.rpc('world_media_usage', { p_world: worldId });
    const row = Array.isArray(data) ? data[0] : data;
    if (error || !row) return;

    usage.used = Number(row.used_bytes);
    usage.cap = Number(row.cap_bytes);

    const box = q('[data-media-usage]') as HTMLElement;
    box.hidden = false;

    // Capped at 100 so a trail that slipped over the line by one file draws a
    // full bar rather than one that runs out of its own track.
    const share = usage.cap > 0 ? Math.min(100, (usage.used / usage.cap) * 100) : 0;
    (q('[data-media-fill]') as HTMLElement).style.width = `${share}%`;
    text(q('[data-media-used]'),
         S.mediaUsed.replace('{0}', megabytes(usage.used)).replace('{1}', megabytes(usage.cap)));
  }

  async function loadMedia() {
    if (!selected) return;
    const { data } = await client.from('marker_media')
      .select('id,kind,path,ord').eq('marker_id', selected).order('ord');
    const rows = data ?? [];

    text(q('[data-count-media]'), rows.length ? String(rows.length) : '');
    q('[data-media-empty]')!.classList.toggle('hidden', rows.length > 0);
    q('[data-media]')!.innerHTML = rows.map((m: any) => {
      const url = m.kind === 'link'
        ? m.path
        : client.storage.from(BUCKET).getPublicUrl(m.path).data.publicUrl;
      const preview = m.kind === 'image'
        ? `<img src="${escapeHtml(url)}" alt="" class="h-12 w-16 shrink-0 rounded object-cover" />`
        : `<span class="badge badge-quiet shrink-0">${escapeHtml(m.kind)}</span>`;

      // The stored path is <trail>/<stop>/<timestamp>-<name>, which is three
      // things a creator did not choose and one they did. Only the last is
      // worth showing: a row reading two uuids tells nobody which photo it is.
      const label = m.kind === 'link'
        ? m.path
        : decodeURIComponent((m.path.split('/').pop() ?? m.path).replace(/^\d+-/, ''));

      return `<li class="card flex items-center gap-3 p-3">
        ${preview}
        <a href="${escapeHtml(url)}" target="_blank" rel="noopener"
           class="min-w-0 flex-1 truncate text-xs text-[var(--signal)] hover:underline"
           title="${escapeHtml(m.path)}">${escapeHtml(label)}</a>
        <button type="button" data-del-media="${m.id}" data-path="${m.kind === 'link' ? '' : escapeHtml(m.path)}"
                class="shrink-0 text-xs text-[var(--alert)] hover:underline">${escapeHtml(S.remove)}</button>
      </li>`;
    }).join('');

    q('[data-media]')!.querySelectorAll('[data-del-media]').forEach((b) =>
      b.addEventListener('click', async () => {
        const el = b as HTMLElement;
        if (el.dataset.path) await client.storage.from(BUCKET).remove([el.dataset.path]);
        await client.from('marker_media').delete().eq('id', el.dataset.delMedia!);
        await Promise.all([loadMedia(), load(), loadUsage()]);
      }));
  }

  async function upload(file: File, kind: 'image' | 'audio' | 'video') {
    if (!selected) return;
    const statusEl = q('[data-upload-status]') as HTMLElement;
    const show = (m: string) => { statusEl.textContent = m; statusEl.classList.remove('hidden'); };

    if (file.size > MAX_BYTES) { show(S.tooBig); return; }

    // The insert policy refuses a trail that is already at the line; it cannot
    // refuse one that is under it by a byte, because it does not know how big
    // the incoming file is. This does, so it does the exact arithmetic and says
    // so in words rather than letting the upload run and fail.
    await loadUsage();
    const free = usage.cap - usage.used;

    if (usage.cap > 0 && free <= 0) { show(S.mediaFull); return; }
    if (usage.cap > 0 && file.size > free) {
      show(S.mediaWontFit.replace('{0}', megabytes(free)));
      return;
    }

    show(S.uploading);

    // <world>/<marker>/<file>: the first segment is what the storage policy
    // reads to decide who may write here.
    const safe = file.name.replace(/[^a-zA-Z0-9._-]/g, '_');
    const path = `${worldId}/${selected}/${Date.now()}-${safe}`;

    const { error } = await client.storage.from(BUCKET).upload(path, file, { upsert: false });
    if (error) { show(error.message); return; }

    const existing = (await client.from('marker_media').select('id').eq('marker_id', selected)).data ?? [];
    await client.from('marker_media').insert({
      marker_id: selected, kind, path, ord: existing.length + 1,
    });

    statusEl.classList.add('hidden');
    await Promise.all([loadMedia(), load(), loadUsage()]);
  }

  (q('[data-file-image]') as HTMLInputElement)?.addEventListener('change', (e) => {
    const input = e.target as HTMLInputElement;
    const f = input.files?.[0];
    if (f) upload(f, 'image');
    input.value = '';
  });
  (q('[data-file-audio]') as HTMLInputElement)?.addEventListener('change', (e) => {
    const input = e.target as HTMLInputElement;
    const f = input.files?.[0];
    if (f) upload(f, 'audio');
    input.value = '';
  });
  q('[data-add-video]')?.addEventListener('click', async () => {
    const input = q('[data-video-url]') as HTMLInputElement;
    const url = input.value.trim();
    if (!selected || !url) return;
    const existing = (await client.from('marker_media').select('id').eq('marker_id', selected)).data ?? [];
    await client.from('marker_media').insert({
      marker_id: selected, kind: 'link', path: url, ord: existing.length + 1,
    });
    input.value = '';
    await Promise.all([loadMedia(), load(), loadUsage()]);
  });

  // ------------------------------------------------------------------ saving
  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!selected) return;

    const err = q('[data-marker-error]') as HTMLElement;
    err.classList.add('hidden');
    const button = q('[data-marker-save]') as HTMLButtonElement;
    const label = button.textContent;

    // Sends them to the tab holding the problem, or the message names a field
    // they cannot see.
    const fail = (message: string, tab?: string) => {
      button.disabled = false; button.textContent = label;
      err.textContent = message; err.classList.remove('hidden');
      if (tab) (q(`[data-tab="${tab}"]`) as HTMLButtonElement)?.click();
    };

    button.disabled = true;
    button.textContent = S.saving;

    const lat = num('lat'), lng = num('lng');
    if (lat === null || lng === null || Number.isNaN(lat) || Number.isNaN(lng)) {
      fail(S.lang === 'bg' ? 'Координатите трябва да са числа.' : 'Coordinates must be numbers.', 'place');
      return;
    }
    if (lat < -90 || lat > 90 || lng < -180 || lng > 180) {
      fail(S.lang === 'bg' ? 'Координатите са извън обхват.' : 'Coordinates are out of range.', 'place');
      return;
    }

    const titleBg = val('titleBg');
    if (!titleBg) {
      fail(S.lang === 'bg' ? 'Дай заглавие на български.' : 'Give the stop a Bulgarian title.', 'basics');
      return;
    }

    const kind = (field('kind') as HTMLSelectElement).value;
    const kept = choices.filter((c) => c.bg.trim() || c.en.trim());
    const correct = kept.map((c, i) => (c.correct ? i : -1)).filter((i) => i >= 0);

    const content: Record<string, any> = {
      bg: { title: titleBg, ...(val('bodyBg') && { body: val('bodyBg') }) },
    };
    if (val('titleEn') || val('bodyEn')) {
      content.en = {
        ...(val('titleEn') && { title: val('titleEn') }),
        ...(val('bodyEn') && { body: val('bodyEn') }),
      };
    }
    if (kind !== 'none') {
      if (val('questionBg')) content.bg.question = val('questionBg');
      if (val('questionEn')) {
        content.en = { ...(content.en ?? {}), question: val('questionEn') };
      }
    }

    if (kind === 'choice' && kept.length) {
      content.bg.choices = kept.map((c) => c.bg);
      content.en = { ...(content.en ?? {}), choices: kept.map((c) => c.en || c.bg) };
    }

    const { error: upErr } = await client.from('markers')
      .update({
        content,
        radius_m: num('radius') ?? 100,
        colour_hex: hue === null ? null : hueToHex(hue),
        status: 'published',
      })
      .eq('id', selected);
    if (upErr) { fail(upErr.message); return; }

    const moved = await client.rpc('move_marker', { p_marker: selected, p_lat: lat, p_lng: lng });
    if (moved.error) { fail(moved.error.message, 'place'); return; }

    if (kind === 'none') {
      await client.rpc('clear_marker_answer', { p_marker: selected });
    } else {
      const accepted = (field('accepted') as HTMLTextAreaElement).value
        .split('\n').map((x) => x.trim()).filter(Boolean);

      if (kind === 'exact' && accepted.length === 0) {
        fail(S.lang === 'bg' ? 'Дай поне един приеман отговор.' : 'Give at least one accepted answer.', 'answer');
        return;
      }
      if (kind === 'choice' && kept.length < 2) {
        fail(S.lang === 'bg' ? 'Дай поне две възможности.' : 'Give at least two options.', 'answer');
        return;
      }
      if (kind === 'choice' && correct.length === 0) {
        fail(S.lang === 'bg' ? 'Отбележи поне един верен отговор.' : 'Tick at least one correct option.', 'answer');
        return;
      }

      const after: Record<string, string> = {};
      if (val('afterBg')) after.bg = val('afterBg');
      if (val('afterEn')) after.en = val('afterEn');

      const { error: aErr } = await client.rpc('set_marker_answer', {
        p_marker: selected,
        p_kind: kind,
        p_accepted: kind === 'exact' ? accepted : null,
        p_correct_choices: kind === 'choice' ? correct : null,
        p_points: num('points') ?? 10,
        p_cooldown_seconds: num('cooldown') ?? (kind === 'free' ? 0 : 60),
        p_on_wrong: (field('onWrong') as HTMLSelectElement)?.value || 'retry',
        p_deduct_points: num('deduct') ?? 0,
        p_after_text: after,
      });
      if (aErr) { fail(aErr.message, 'answer'); return; }
    }

    button.disabled = false;
    button.textContent = S.saved;
    setTimeout(() => { button.textContent = label; }, 1400);
    await load();
  });

  q('[data-marker-delete]')?.addEventListener('click', async () => {
    if (!selected) return;
    const { error } = await client.from('markers').delete().eq('id', selected);
    if (error) { alert(error.message); return; }
    await select(null);
    await load();
  });

  q('[data-rotate]')?.addEventListener('click', async () => {
    const { data, error } = await client.rpc('rotate_join_code', { p_world: worldId });
    if (error) { alert(error.message); return; }
    text(q('[data-trail-code]'), data);
  });

  q('[data-levels]')?.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement)?.closest('[data-level]') as HTMLButtonElement | null;
    if (!button || button.disabled) return;

    const wanted = button.dataset.level as 'draft' | 'code' | 'public';
    const failed = await setLevel(client, world, wanted);
    if (failed) { alert(failed); return; }

    const { data: again } = await client
      .from('worlds').select('status,visibility,review_note').eq('id', worldId).single();

    if (again) world = { ...world, ...again };
    paintStatus();
  });

  q('[data-copy-code]')?.addEventListener('click', async (event) => {
    const button = event.currentTarget as HTMLElement;
    try {
      await navigator.clipboard.writeText(q('[data-trail-code]')!.textContent!.trim());
      text(button, S.copied);
      setTimeout(() => text(button, S.copy), 1400);
    } catch { /* the code is on screen; reading it out still works */ }
  });

  // --------------------------------------------------------- review and board
  async function loadReview() {
    const { data, error } = await client.rpc('review_queue', { p_world: worldId });
    const list = q('[data-review]')!;
    const rows = data ?? [];

    text(q('[data-review-count]'), rows.length ? String(rows.length) : '');
    q('[data-review-empty]')!.toggleAttribute('hidden', rows.length > 0);
    if (error || rows.length === 0) { list.innerHTML = ''; return; }

    list.innerHTML = rows.map((r: any) => {
      const title = r.marker_title?.[S.lang]?.title || r.marker_title?.bg?.title || '—';
      return `<li class="card flex flex-wrap items-start justify-between gap-4 p-4">
        <div class="min-w-0 flex-1">
          <p class="eyebrow">${escapeHtml(title)} · ${escapeHtml(r.team_name)}</p>
          <p class="mt-1.5 break-words text-sm">${escapeHtml(r.submitted)}</p>
        </div>
        <div class="flex shrink-0 gap-2">
          <button class="btn btn-primary btn-sm" data-accept="${r.submission_id}">${S.accept}</button>
          <button class="btn btn-danger-quiet btn-sm"
                  data-reject="${r.submission_id}">${S.reject}</button>
        </div>
      </li>`;
    }).join('');

    const decide = async (id: string, correct: boolean) => {
      const { error: rErr } = await client.rpc('review_answer', { p_submission: id, p_correct: correct });
      if (rErr) { alert(rErr.message); return; }
      await Promise.all([loadReview(), loadBoard()]);
    };

    list.querySelectorAll('[data-accept]').forEach((b) =>
      b.addEventListener('click', () => decide((b as HTMLElement).dataset.accept!, true)));
    list.querySelectorAll('[data-reject]').forEach((b) =>
      b.addEventListener('click', () => decide((b as HTMLElement).dataset.reject!, false)));

    // Keyboard-driven: sixty submissions is not sixty dialogs.
    document.onkeydown = (event) => {
      if (event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement) return;
      const first = rows[0];
      if (!first) return;
      if (event.key === 'a') decide(first.submission_id, true);
      if (event.key === 'd') decide(first.submission_id, false);
    };
  }

  async function loadBoard() {
    const { data, error } = await client.rpc('world_leaderboard', { p_world: worldId });
    const table = q('[data-board]') as HTMLTableElement;
    const rows = data ?? [];

    q('[data-board-empty]')!.toggleAttribute('hidden', rows.length > 0);
    if (error || rows.length === 0) { table.innerHTML = ''; return; }

    table.innerHTML = `
      <thead><tr class="border-b border-[var(--line)] text-left text-xs text-[var(--ink-faint)]">
        <th class="py-2 pr-3">${escapeHtml(S.rank)}</th>
        <th class="py-2 pr-3">${escapeHtml(S.team)}</th>
        <th class="py-2 pr-3 text-right">${escapeHtml(S.bPoints)}</th>
        <th class="py-2 pr-3 text-right">${escapeHtml(S.bSolved)}</th>
        <th class="py-2 text-right">${escapeHtml(S.time)}</th>
      </tr></thead>
      <tbody>${rows.map((r: any) => `
        <tr class="border-b border-[var(--line-soft)]">
          <td class="data py-2 pr-3">${r.rank}</td>
          <td class="py-2 pr-3">${escapeHtml(r.team_name)}${r.is_mine ? ` <span class="eyebrow">${S.you}</span>` : ''}</td>
          <td class="data py-2 pr-3 text-right">${r.points}</td>
          <td class="data py-2 pr-3 text-right text-[var(--ink-dim)]">${r.stops_solved}</td>
          <td class="data py-2 text-right text-[var(--ink-dim)]">${duration(r.elapsed_seconds)}</td>
        </tr>`).join('')}</tbody>`;
  }

  await Promise.all([loadReview(), loadBoard()]);

  // Last, not beside load(): everything it reads is declared further down this
  // file, and a const is not readable before its declaration has been reached.
  await loadUsage();

  // ------------------------------------------------------------------ colour
  //
  // Hue is the creator's; saturation and lightness are not. The app rings every
  // marker in whichever of black or white shows against it, so the colour never
  // has to carry its own separation from the map - and holding the weight fixed
  // is what stops one marker on a trail shouting over the rest.

  const HUE_SAT = 62;
  const HUE_LIGHT = 52;

  let hue: number | null = null;

  /** HSL to the #rrggbb the markers table stores. */
  function hueToHex(h: number) {
    const s = HUE_SAT / 100;
    const l = HUE_LIGHT / 100;
    const c = (1 - Math.abs(2 * l - 1)) * s;
    const x = c * (1 - Math.abs(((h / 60) % 2) - 1));
    const m = l - c / 2;

    const [r, g, b] =
      h < 60 ? [c, x, 0] : h < 120 ? [x, c, 0] : h < 180 ? [0, c, x]
      : h < 240 ? [0, x, c] : h < 300 ? [x, 0, c] : [c, 0, x];

    const two = (v: number) =>
      Math.round((v + m) * 255).toString(16).padStart(2, '0');

    return `#${two(r)}${two(g)}${two(b)}`;
  }

  /** The hue of a stored colour, so reopening a stop finds its own handle. */
  function hexToHue(hex: string | null): number | null {
    if (!hex || !/^#[0-9a-f]{6}$/i.test(hex)) return null;

    const r = parseInt(hex.slice(1, 3), 16) / 255;
    const g = parseInt(hex.slice(3, 5), 16) / 255;
    const b = parseInt(hex.slice(5, 7), 16) / 255;

    const max = Math.max(r, g, b);
    const min = Math.min(r, g, b);
    if (max === min) return null;   // a grey has no hue to point at

    const d = max - min;
    const h = max === r ? ((g - b) / d + (g < b ? 6 : 0))
            : max === g ? (b - r) / d + 2
            : (r - g) / d + 4;

    return Math.round(h * 60) % 360;
  }

  function paintHue() {
    const handle = q('[data-hue-handle]') as HTMLElement;
    const strip = q('[data-hue]') as HTMLElement;
    const light = q('[data-hue-proof-light]') as HTMLElement;
    const dark = q('[data-hue-proof-dark]') as HTMLElement;

    if (!handle || !strip) return;

    const chosen = hue !== null;
    handle.hidden = !chosen;
    strip.setAttribute('aria-valuenow', String(hue ?? 0));

    const hex = chosen ? hueToHex(hue!) : 'transparent';

    if (chosen) handle.style.left = `${(hue! / 359) * 100}%`;
    if (light) light.style.background = hex;
    if (dark) dark.style.background = hex;

    text(q('[data-hue-value]'), chosen ? hueToHex(hue!) : S.colourNone);
  }

  function hueFromEvent(event: PointerEvent | MouseEvent) {
    const strip = q('[data-hue]') as HTMLElement;
    const box = strip.getBoundingClientRect();
    const across = Math.min(Math.max(event.clientX - box.left, 0), box.width);

    hue = Math.round((across / Math.max(box.width, 1)) * 359);
    paintHue();
  }

  q('[data-hue]')?.addEventListener('pointerdown', (event) => {
    const strip = event.currentTarget as HTMLElement;
    strip.setPointerCapture((event as PointerEvent).pointerId);
    hueFromEvent(event as PointerEvent);
  });

  q('[data-hue]')?.addEventListener('pointermove', (event) => {
    // Only while dragging. buttons is a bitmask and zero means the pointer is
    // over the strip rather than pressed on it.
    if ((event as PointerEvent).buttons !== 0) hueFromEvent(event as PointerEvent);
  });

  // Arrow keys, because a slider that only takes a pointer is not a slider.
  q('[data-hue]')?.addEventListener('keydown', (event) => {
    const key = (event as KeyboardEvent).key;
    const step = key === 'ArrowLeft' ? -5 : key === 'ArrowRight' ? 5 : 0;
    if (!step) return;

    event.preventDefault();
    hue = ((hue ?? 0) + step + 360) % 360;
    paintHue();
  });

  // ------------------------------------------------------------------ import
  //
  // A spreadsheet is the fastest way anybody has ever entered forty fields, and
  // the builder was asking for them five tabs at a time. One row is one stop.
  //
  // Tab-separated as well as comma-separated, because pasting straight out of
  // Excel gives tabs and telling somebody to "save as CSV first" is a step that
  // exists only to make the parser's life easier.

  const IMPORT_COLUMNS = [
    'name_bg', 'name_en', 'text_bg', 'text_en', 'lat', 'lng', 'radius_m',
    'question_bg', 'question_en', 'kind', 'accepted', 'points',
    'on_wrong', 'deduct', 'wait_seconds', 'hint_bg', 'hint_en', 'hint_cost',
  ];

  const KINDS = ['none', 'exact', 'choice', 'free'];
  const RULES = ['retry', 'lock', 'deduct', 'skip'];

  /**
   * Splits one delimited line, honouring quotes.
   *
   * Written out rather than pulled in: a CSV library is forty kilobytes to
   * handle a quote and a doubled quote, and those are the only two rules a
   * spreadsheet export actually uses.
   */
  function splitLine(line: string, sep: string): string[] {
    const out: string[] = [];
    let field = '';
    let quoted = false;

    for (let i = 0; i < line.length; i++) {
      const ch = line[i];

      if (quoted) {
        if (ch === '"') {
          if (line[i + 1] === '"') { field += '"'; i++; }
          else quoted = false;
        } else field += ch;
      } else if (ch === '"') {
        quoted = true;
      } else if (ch === sep) {
        out.push(field); field = '';
      } else field += ch;
    }

    out.push(field);
    return out.map((f) => f.trim());
  }

  function parseSheet(raw: string) {
    const lines = raw.replace(/\r\n?/g, '\n').split('\n').filter((l) => l.trim().length);
    if (lines.length === 0) return { error: S.impNoHeader, rows: [] as any[] };

    // Whichever the header line has more of. A name with a comma in it is
    // common; a name with a tab in it is not.
    const sep = (lines[0].split('\t').length > lines[0].split(',').length) ? '\t' : ',';
    const header = splitLine(lines[0], sep).map((h) => h.toLowerCase());

    if (!header.includes('name_bg') || !header.includes('lat')) {
      return { error: S.impNoHeader, rows: [] as any[] };
    }
    if (lines.length === 1) return { error: S.impNoRows, rows: [] as any[] };

    const rows = lines.slice(1).map((line, i) => {
      const cells = splitLine(line, sep);
      const row: Record<string, string> = {};
      header.forEach((h, c) => { row[h] = cells[c] ?? ''; });
      return { line: i + 2, row };
    });

    return { error: null as string | null, rows };
  }

  /** Everything wrong with one row, in the creator's language. */
  function checkRow(row: Record<string, string>, existing: Set<string>) {
    const problems: string[] = [];
    const name = (row.name_bg ?? '').trim();

    if (!name) problems.push(S.impNeedName);
    else if (existing.has(name.toLowerCase())) problems.push(S.impDupe);

    const lat = Number(row.lat);
    const lng = Number(row.lng);
    if (!Number.isFinite(lat) || !Number.isFinite(lng)
        || Math.abs(lat) > 90 || Math.abs(lng) > 180) {
      problems.push(S.impBadCoords);
    }

    const kind = (row.kind ?? '').trim().toLowerCase() || 'none';
    if (!KINDS.includes(kind)) problems.push(S.impBadKind);
    if (kind === 'exact' && !(row.accepted ?? '').trim()) problems.push(S.impNeedAccepted);

    const rule = (row.on_wrong ?? '').trim().toLowerCase() || 'retry';
    if (!RULES.includes(rule)) problems.push(S.impBadOnWrong);

    return problems;
  }

  let checked: { line: number; row: Record<string, string> }[] = [];

  function impStatus(message: string) {
    text(q('[data-imp-status]'), message);
  }

  q('[data-imp-template]')?.addEventListener('click', () => {
    // One header row and one filled-in example, because an empty template
    // leaves somebody guessing what "exact" or "lock" are supposed to look like.
    const example = [
      'Безистенът', 'The Bezisten', 'Покрит пазар от 15 век', 'A covered market',
      '42.48412', '26.50598', '25',
      'Кой век?', 'Which century?', 'exact', '15,XV,петнайсети', '40',
      'lock', '0', '60', 'Погледни над вратата', 'Look above the door', '5',
    ];
    const csv = IMPORT_COLUMNS.join(',') + '\n'
      + example.map((v) => (v.includes(',') ? `"${v}"` : v)).join(',') + '\n';

    const url = URL.createObjectURL(new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8' }));
    const a = document.createElement('a');
    a.href = url;
    a.download = 'artrail-stops.csv';
    a.click();
    URL.revokeObjectURL(url);
  });

  (q('[data-imp-file]') as HTMLInputElement)?.addEventListener('change', async (event) => {
    const file = (event.target as HTMLInputElement).files?.[0];
    if (!file) return;
    (q('[data-imp-text]') as HTMLTextAreaElement).value = await file.text();
  });

  q('[data-imp-check]')?.addEventListener('click', () => {
    const raw = (q('[data-imp-text]') as HTMLTextAreaElement).value;
    const report = q('[data-imp-report]')!;
    const go = q('[data-imp-go]') as HTMLButtonElement;

    checked = [];
    report.innerHTML = '';
    go.classList.add('hidden');

    const parsed = parseSheet(raw);
    if (parsed.error) { impStatus(parsed.error); return; }

    // Names already on the trail, so a second paste of the same sheet is caught
    // rather than doubling every stop.
    const existing = new Set(
      markers.map((m: any) => (m.content?.bg?.title ?? '').trim().toLowerCase()).filter(Boolean));

    const bad: string[] = [];

    for (const entry of parsed.rows) {
      const problems = checkRow(entry.row, existing);

      if (problems.length) {
        bad.push(`${S.impRow.replace('{0}', String(entry.line))}: ${problems.join(' · ')}`);
      } else {
        checked.push(entry);
        // A duplicate inside the sheet itself counts too.
        existing.add((entry.row.name_bg ?? '').trim().toLowerCase());
      }
    }

    report.innerHTML = bad
      .map((b) => `<li class="text-[var(--alert)]">${escapeHtml(b)}</li>`).join('');

    impStatus(`${S.impReady.replace('{0}', String(checked.length))}`
      + (bad.length ? ` · ${S.impProblems.replace('{0}', String(bad.length))}` : ''));

    if (checked.length) {
      text(go, S.impImport.replace('{0}', String(checked.length)));
      go.classList.remove('hidden');
    }
  });

  q('[data-imp-go]')?.addEventListener('click', async (event) => {
    const go = event.currentTarget as HTMLButtonElement;
    go.disabled = true;
    impStatus(S.impImporting);

    let made = 0;
    const failed: string[] = [];

    for (const entry of checked) {
      const r = entry.row;
      const kind = (r.kind ?? '').trim().toLowerCase() || 'none';

      const content: Record<string, any> = {
        bg: { title: r.name_bg.trim(), ...(r.text_bg?.trim() && { body: r.text_bg.trim() }) },
      };
      if (r.name_en?.trim() || r.text_en?.trim()) {
        content.en = {
          ...(r.name_en?.trim() && { title: r.name_en.trim() }),
          ...(r.text_en?.trim() && { body: r.text_en.trim() }),
        };
      }
      if (kind !== 'none') {
        if (r.question_bg?.trim()) content.bg.question = r.question_bg.trim();
        if (r.question_en?.trim()) {
          content.en = { ...(content.en ?? {}), question: r.question_en.trim() };
        }
      }

      const placed = await client.rpc('place_marker', {
        p_world: worldId, p_lat: Number(r.lat), p_lng: Number(r.lng),
        p_content: content, p_status: 'published',
      });

      const id = Array.isArray(placed.data) ? placed.data[0]?.id : (placed.data as any)?.id;

      if (placed.error || !id) {
        failed.push(`${S.impRow.replace('{0}', String(entry.line))}: `
          + (placed.error?.message ?? S.impFailed));
        continue;
      }

      const radius = Number(r.radius_m);
      if (Number.isFinite(radius) && radius > 0) {
        await client.from('markers').update({ radius_m: radius }).eq('id', id);
      }

      if (kind !== 'none') {
        const accepted = (r.accepted ?? '').split(',').map((x) => x.trim()).filter(Boolean);
        const answer = await client.rpc('set_marker_answer', {
          p_marker: id,
          p_kind: kind,
          p_accepted: kind === 'exact' ? accepted : null,
          p_points: Number(r.points) || 10,
          p_cooldown_seconds: Number(r.wait_seconds) || null,
          p_on_wrong: (r.on_wrong ?? '').trim().toLowerCase() || 'retry',
          p_deduct_points: Number(r.deduct) || 0,
        });

        if (answer.error) {
          failed.push(`${S.impRow.replace('{0}', String(entry.line))}: ${answer.error.message}`);
        }
      }

      const hintBg = (r.hint_bg ?? '').trim();
      const hintEn = (r.hint_en ?? '').trim();

      if (hintBg || hintEn) {
        await client.from('marker_hints').insert({
          marker_id: id, ord: 1, cost: Number(r.hint_cost) || 0,
          body: { ...(hintBg && { bg: hintBg }), ...(hintEn && { en: hintEn }) },
        });
      }

      made++;
    }

    q('[data-imp-report]')!.innerHTML = failed
      .map((f) => `<li class="text-[var(--alert)]">${escapeHtml(f)}</li>`).join('');

    impStatus(S.impDone.replace('{0}', String(made)).replace('{1}', String(failed.length)));

    checked = [];
    go.classList.add('hidden');
    go.disabled = false;
    (q('[data-imp-text]') as HTMLTextAreaElement).value = '';

    await load();
  });
</script>
