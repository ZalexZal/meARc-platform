    <div class="scroll-x mt-4"><table class="w-full text-sm" data-board></table></div>
  </section>

  <!-- There was no way to remove a trail at all: My trails could only hide
       one. The owner may delete their own row (worlds_delete_owner), and the
       markers, teams and scores go with it. -->
  <section class="mt-14 border-t border-[var(--line)] pt-8" data-delete-trail data-owner-only>
    <h2 class="text-lg">{t('ed.deleteTitle')}</h2>
    <p class="mt-2 max-w-xl text-sm text-[var(--ink-dim)]">{t('ed.deleteBody')}</p>
    <button type="button" class="btn btn-danger-quiet mt-4" data-delete-trail-btn>{t('ed.deleteButton')}</button>
