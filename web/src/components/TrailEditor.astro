    border: 1px solid var(--line); border-radius: 26px; background: var(--surface);
  }
  .wiz.hidden { display: none; }
  .wiz-top { padding: 1.375rem 1.5rem 0; }
  .wiz-id { display: flex; align-items: center; gap: .875rem; }
  .wiz-pin {
    flex: none; width: 44px; height: 44px; border-radius: 14px; display: grid; place-items: center;
    background: var(--signal); color: #fff; font-size: 1rem; font-weight: 600;
    transition: background-color .3s ease;
  }
  .wiz-title { margin-top: 3px; font-size: 1.25rem; line-height: 1.2; letter-spacing: -.02em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .wiz-count { flex: none; font-size: .8125rem; color: var(--ink-faint); }

  .stepper { list-style: none; margin: 1.25rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; }
  .st {
    width: 100%; display: flex; flex-direction: column; gap: 8px; padding: 8px 6px 10px; text-align: left;
    border-radius: 14px; cursor: pointer; transition: background-color .2s ease;
  }
  .st:hover:not(:disabled) { background: var(--surface-2); }
  .st:disabled { cursor: default; }
  .st-bar { display: block; height: 4px; border-radius: 4px; background: var(--line); position: relative; overflow: hidden; }
  .st-bar::after {
    content: ""; position: absolute; inset: 0; background: var(--signal);
    transform: scaleX(0); transform-origin: left; transition: transform .45s cubic-bezier(.2,.8,.2,1);
  }
  .st.is-done .st-bar::after, .st.is-current .st-bar::after { transform: scaleX(1); }
  .st.is-skipped .st-bar { background: repeating-linear-gradient(90deg, var(--line) 0 6px, transparent 6px 10px); }
  .st-row { display: flex; align-items: center; gap: 7px; min-width: 0; }
  .st-n {
    flex: none; width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center;
    border: 1.5px solid var(--line); font: 600 11px var(--font-mono); color: var(--ink-faint);
  }
  .st-check { display: none; }
  .st.is-done .st-num { display: none; }
  .st.is-done .st-check { display: block; }
  .st.is-done .st-n { border-color: var(--signal); color: var(--signal); }
  .st.is-current .st-n { border-color: var(--signal); background: var(--signal); color: var(--signal-ink); }
  .st-l { font-size: .84375rem; font-weight: 600; color: var(--ink-dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .st.is-current .st-l { color: var(--ink); }
  .st:disabled .st-l { color: var(--ink-faint); font-weight: 500; }
  .st-count { font-size: 11px; color: var(--ink-faint); }
  .st-sub { padding-left: 29px; font-size: .71875rem; color: var(--ink-faint); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  @media (max-width: 640px) {
    .wiz-top { padding: 1.125rem 1.125rem 0; }
    .st-sub { display: none; }
    .st-row { flex-direction: column; align-items: flex-start; gap: 5px; }
    .st-l { font-size: .75rem; }
  }

  .wiz-body { flex: 1; padding: 1.5rem; }
  .missing { margin-bottom: 1.25rem; padding: .875rem 1rem; border-radius: 16px; background: var(--lamp-wash); border: 1px solid color-mix(in srgb, var(--lamp) 30%, transparent); }
  .missing[hidden] { display: none; }
  .missing-title { font-size: .8125rem; font-weight: 600; color: var(--lamp); }
  .missing ul { display: flex; flex-wrap: wrap; gap: .375rem; margin-top: .5rem; }
  /* The items are made by the script, so they carry no scope: :global. */
  .missing :global(.miss-go) { min-height: 36px; padding: .375rem .75rem; border-radius: 999px; font-size: .8125rem; color: var(--ink); background: var(--surface); border: 1px solid var(--line); cursor: pointer; }
  .missing :global(.miss-go:hover), .missing :global(.miss-go:focus-visible) { border-color: var(--signal); color: var(--signal); }
  .missing :global(.miss-go.is-optional) { color: var(--ink-dim); }
  .missing :global(.miss-tag) { font-size: .75rem; color: var(--ink-faint); }
  @media (max-width: 640px) { .wiz-body { padding: 1.25rem 1.125rem; } }
  .pane { display: flex; flex-direction: column; gap: 1.25rem; animation: pane-in .42s cubic-bezier(.2,.8,.2,1); }
  .pane.hidden { display: none; }
  @keyframes pane-in { from { opacity: 0; transform: translateX(16px); } to { opacity: 1; transform: none; } }
  .pane-head h3 { font-size: 1.375rem; line-height: 1.2; letter-spacing: -.02em; }
  .pane-head p { margin-top: .375rem; font-size: .96875rem; color: var(--ink-dim); }
  .where {
    display: flex; align-items: center; gap: .75rem; padding: .875rem 1rem; border-radius: 16px;
    background: var(--signal-wash); color: var(--ink); font-size: .9375rem; font-weight: 500;
  }
  .where svg { flex: none; color: var(--signal); }

  .kinds { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .5rem; }
  @media (max-width: 760px) { .kinds { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .kind-opt {
    display: flex; flex-direction: column; gap: .2rem; padding: .875rem; cursor: pointer;
    border: 1px solid var(--line); border-radius: 16px; transition: border-color .2s ease, background-color .2s ease;
  }
  .kind-opt:hover { border-color: var(--ink-faint); }
  .kind-opt:has(input:checked) { border-color: var(--signal); background: var(--signal-wash); }
  .kind-opt:has(input:focus-visible) { outline: 2px solid var(--signal); outline-offset: 2px; }
  .kind-name { font-weight: 600; font-size: .90625rem; }
  .kind-body { font-size: .8125rem; color: var(--ink-dim); }

  .add-box { padding: 1rem; border-radius: 18px; border: 1px dashed var(--line); }

  /* The creator's own model: its preview beside its size and facing. */
  .model-box { display: flex; flex-direction: column; gap: 1rem; padding: 1rem; border-radius: 18px; border: 1px solid var(--line); background: var(--ground); }
  .model-box.hidden { display: none; }
  .model-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1rem; align-items: start; }
  @media (max-width: 640px) { .model-grid { grid-template-columns: minmax(0, 1fr); } }
  .model-stage {
    position: relative; aspect-ratio: 1; border-radius: 16px; overflow: hidden;
    background: radial-gradient(circle at 50% 40%, var(--surface), var(--surface-2));
    border: 1px solid var(--line-soft);
  }
  .model-stage :global(model-viewer) { position: absolute; inset: 0; width: 100%; height: 100%; --poster-color: transparent; }
  .model-empty { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: .5rem; color: var(--ink-faint); font-size: .8125rem; }
  .credit-opt { flex-direction: row; align-items: center; padding: .625rem .875rem; }

  .ready { align-items: flex-start; padding: 2rem 0 1rem; }
  .ready h3 { font-size: 1.5rem; letter-spacing: -.02em; }
  .ready-check {
    width: 64px; height: 64px; border-radius: 20px; display: grid; place-items: center;
    background: color-mix(in srgb, var(--tier-1) 16%, transparent); color: var(--tier-1);
    animation: ready-pop .5s cubic-bezier(.3,1.6,.5,1);
  }
  @keyframes ready-pop { from { transform: scale(.5); opacity: 0; } to { transform: none; opacity: 1; } }

  .wiz-error {
    margin: 0 1.5rem 1rem; padding: .625rem .875rem; border-radius: 14px;
    background: var(--alert-wash); color: var(--alert); font-size: .875rem; font-weight: 500;
  }
  .wiz-foot {
    display: flex; align-items: center; gap: .5rem; padding: 1rem 1.25rem 1.125rem 1.5rem;
    border-top: 1px solid var(--line-soft); background: var(--surface);
    position: sticky; bottom: 0; z-index: 2;
  }
  .wiz-foot.hidden { display: none; }
  .wiz-skip {
    min-height: 46px; padding: 0 1rem; border-radius: 999px; cursor: pointer;
    font-size: .9375rem; font-weight: 600; color: var(--ink-dim);
  }
  .wiz-skip:hover { color: var(--ink); background: var(--surface-2); }
  .wiz-skip.hidden { display: none; }
  .wiz-flash {
    margin-left: auto; font-size: .84375rem; font-weight: 600; color: var(--tier-1);
    opacity: 0; transform: translateY(4px); transition: opacity .25s ease, transform .25s ease;
  }
  .wiz-flash:global(.is-on) { opacity: 1; transform: none; }
  .wiz-next { min-width: 8.5rem; }
  .wiz-danger { display: flex; justify-content: flex-end; padding: 0 1.25rem 1rem; background: var(--surface); }
  .hide-xs { display: inline; }
  @media (max-width: 420px) { .hide-xs { display: none; } .wiz-next { min-width: 0; flex: 1; } }
