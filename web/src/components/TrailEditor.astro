<Loading label={t('games.loading')} class="mx-auto max-w-7xl px-4 py-24" data-editor-loading />

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/maplibre-gl/5.6.0/maplibre-gl.css" />

<script type="application/json" data-editor-strings set:html={JSON.stringify(strings)}></script>

<script>
  import { db } from '../lib/supabase';
  import { requireUser, reveal, param, escapeHtml, text, duration } from '../lib/session';
  import { levelOf, isPending, isListed, setLevel } from '../lib/publishing';
  import { inspectGlb, type GlbInfo, type GlbProblem } from '../lib/glb';

  /**
   * MapLibre is loaded from a CDN rather than bundled, which is a decision and
   * not laziness.
   *
   * It resolves its tile-parsing worker through `new URL(..., import.meta.url)`.
   * Astro 7 builds with Rolldown, which rewrites that URL, and the worker then
   * never starts. Nothing reports it: the style downloads, 111 layers parse, the
   * canvas is correctly sized, and the map requests zero tiles while painting
   * the style's own background colour - which reads as an empty map rather than
   * a broken one.
   *
   * `optimizeDeps.exclude` fixed the dev server and left the build broken in
   * exactly the same silent way, which is worse than not fixing it: it looked
   * repaired everywhere I was looking. Version 6 ships ESM only, so there is no
   * pre-bundled file to import instead.
   *
   * Loaded here rather than as a tag, so the map cannot be constructed before
   * the library exists.
   */
  const MAPLIBRE = 'https://cdnjs.cloudflare.com/ajax/libs/maplibre-gl/5.6.0/maplibre-gl.js';

  async function loadMapLibre(): Promise<any> {
    if ((window as any).maplibregl) return (window as any).maplibregl;
    await new Promise<void>((resolve, reject) => {
      const tag = document.createElement('script');
      tag.src = MAPLIBRE;
      tag.crossOrigin = 'anonymous';
      tag.onload = () => resolve();
      tag.onerror = () => reject(new Error('maplibre failed to load'));
      document.head.appendChild(tag);
    });
    return (window as any).maplibregl;
  }

  const S = JSON.parse(document.querySelector('[data-editor-strings]')!.textContent || '{}');
  const q = (s: string) => document.querySelector(s);
  const qa = (s: string) => Array.from(document.querySelectorAll(s));

  await requireUser({ needsReal: true });
  const client = db()!;
  const worldId = param('id');
  if (!worldId) { location.replace(location.pathname.startsWith('/en/') ? '/en/my-trails' : '/my-trails'); throw new Error('no id'); }

  const { data: mine } = await client.rpc('my_worlds');
  const owned = (mine ?? []).find((w: any) => w.id === worldId);
  if (!owned) { q('[data-editor-loading]')!.textContent = S.notYours; throw new Error('not yours'); }

  text(q('[data-trail-name]'), owned.name);

  // An editor gets the stops and nothing about the trail itself. RLS already
  // refuses them; hiding the controls is so they are not offered a refusal.
  const isOwner = owned.role === 'owner';
  if (!isOwner) {
    qa('[data-owner-only]').forEach((el) => ((el as HTMLElement).hidden = true));
    q('[data-you-edit]')?.classList.remove('hidden');
    q('[data-editor-leave]')?.classList.remove('hidden');
  }

  // Deleting. The files first, while media_paths can still find them - the
  // same order the moderators' Remove uses - then the row, which takes the
  // markers, teams and scores with it.
  q('[data-delete-trail-btn]')?.addEventListener('click', async () => {
    if (!confirm(S.deleteConfirm.replace('{0}', owned.name))) return;
    const button = q('[data-delete-trail-btn]') as HTMLButtonElement;
    const msg = q('[data-delete-trail-msg]') as HTMLElement;
    button.disabled = true;
    const { data: paths } = await client.rpc('media_paths', { p_world: worldId });
    if (paths?.length) await client.storage.from('marker-media').remove(paths);
    const { error, count } = await client.from('worlds').delete({ count: 'exact' }).eq('id', worldId);
    if (error || !count) {
      button.disabled = false;
      msg.textContent = error?.message ?? S.deleteNotOwner;
      msg.classList.remove('hidden');
      return;
    }
    location.href = S.lang === 'en' ? '/en/my-trails' : '/my-trails';
  });
  // The mode's name, not its database code - "ctf" is not a word.
  text(q('[data-trail-mode]'), S.modes?.[owned.mode] ?? owned.mode);
  text(q('[data-trail-code]'), owned.join_code);
  q('[data-board-link]')!.setAttribute('href', `${S.boardHref}?id=${encodeURIComponent(worldId)}`);

  // Read from the row rather than from my_worlds: adding columns there means
  // dropping and recreating the function, and nothing else wanted them.
  const sizeBox = q('[data-team-size]') as HTMLInputElement;
  const settings = await client.from('worlds')
    .select('team_size,reveal_one_at_a_time,mode,finish_bonus_xp').eq('id', worldId).single();
  sizeBox.value = String(settings.data?.team_size ?? 4);
  const bonusBox = q('[data-finish-bonus]') as HTMLInputElement;
  bonusBox.value = String(settings.data?.finish_bonus_xp ?? 0);

  // ctf and guide are the ordered pair; the other two have no next marker, so
  // there is nothing for this switch to withhold.
  const ordered = ['ctf', 'guide'].includes(settings.data?.mode ?? 'guide');
  const revealBox = q('[data-reveal]') as HTMLInputElement;
  const revealRow = q('[data-reveal-row]') as HTMLElement;

  revealBox.checked = Boolean(settings.data?.reveal_one_at_a_time);
  revealBox.disabled = !ordered;
  revealRow.classList.toggle('opacity-50', !ordered);
  if (!ordered) revealRow.title = S.revealOff;

  revealBox.addEventListener('change', async () => {
    const { error } = await client.from('worlds')
      .update({ reveal_one_at_a_time: revealBox.checked }).eq('id', worldId);

    // Put the tick back if the server refused, rather than showing a state the
    // trail is not in.
    if (error) { revealBox.checked = !revealBox.checked; alert(error.message); }
  });

  sizeBox.addEventListener('change', async () => {
    const wanted = Math.round(Number(sizeBox.value));

    // The database has the same bounds and would refuse; catching it here is
    // what stops the box showing a number the trail is not actually using.
    if (!Number.isFinite(wanted) || wanted < 1 || wanted > 12) {
      const current = await client.from('worlds').select('team_size').eq('id', worldId).single();
      sizeBox.value = String(current.data?.team_size ?? 4);
      return;
    }

    const { error } = await client.from('worlds').update({ team_size: wanted }).eq('id', worldId);
    if (error) { alert(error.message); return; }
    sizeBox.value = String(wanted);
  });

  // The same way: 0 to 500, as the database checks too.
  bonusBox.addEventListener('change', async () => {
    const wanted = Math.round(Number(bonusBox.value || 0));
    if (!Number.isFinite(wanted) || wanted < 0 || wanted > 500) {
      const current = await client.from('worlds').select('finish_bonus_xp').eq('id', worldId).single();
      bonusBox.value = String(current.data?.finish_bonus_xp ?? 0);
      return;
    }
    const { error } = await client.from('worlds').update({ finish_bonus_xp: wanted }).eq('id', worldId);
    if (error) { alert(error.message); return; }
    bonusBox.value = String(wanted);
  });

  // The row as the server last described it. Every level change reloads it
  // rather than predicting it, because request_listing can refuse.
  let world = { id: worldId, status: owned.status, visibility: owned.visibility,
                review_note: owned.review_note };

  function paintStatus() {
    const here = levelOf(world);
    const waiting = isPending(world);
    const listed = isListed(world);

    text(q('[data-trail-status]'),
         here === 'draft' ? S.lvDraft : here === 'code' ? S.lvCode : S.lvPublic);

    qa('[data-level]').forEach((b) => {
      const level = (b as HTMLElement).dataset.level as 'draft' | 'code' | 'public';
      b.setAttribute('aria-selected', String(here === level));

      if (level === 'public') text(b, listed || waiting ? S.lvPublic : S.lvAsk);
    });

    text(q('[data-level-hint]'),
         waiting ? S.lvWaitingBody
         : here === 'draft' ? S.lvDraftHint
         : here === 'code' ? S.lvCodeHint
         : listed ? S.lvPublicHint : S.lvAskHint);

    // A refusal comes with a sentence. Not showing it leaves somebody pressing
    // the same button again wondering why nothing happened the first time.
    const note = q('[data-level-note]');
    if (note) {
      text(note, world.review_note ? `${S.lvNote} ${world.review_note}` : '');
      note.classList.toggle('hidden', !world.review_note);
    }
  }

  paintStatus();

  q('[data-editor-loading]')?.remove();
  reveal();

  const maplibregl = await loadMapLibre();
  const map = new maplibregl.Map({
    container: q('[data-map]') as HTMLElement,
    style: 'https://tiles.openfreemap.org/styles/liberty',
    center: [26.5060, 42.4841],
    zoom: 15,
    // On a phone the map is the full width of the page, so a one-finger drag
    // moved the map and the page could not be scrolled past it to the markers
    // and the form. Two fingers move the map; one scrolls the page.
    cooperativeGestures: matchMedia('(pointer: coarse)').matches,
    // Folded into the (i) button. Open, the credits covered the bottom third of
    // the map on a phone - the part a finger reaches for.
    attributionControl: { compact: true },
  });
  map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');
  requestAnimationFrame(() => map.resize());
  setTimeout(() => map.resize(), 400);
  new ResizeObserver(() => map.resize()).observe(q('[data-map]') as HTMLElement);

  let markers: any[] = [];
  let pins = new Map<string, any>();
  let selected: string | null = null;
  let fitted = false;   // the map has been fitted to the trail's markers
  let choices: { bg: string; en: string; correct: boolean }[] = [];

  // Which version of the selected stop the form was filled from, and whether
  // this tab is in the middle of saving it (so its own echo is not news).
  let formVersion: number | null = null;
  let savingNow = false;

  // Presence is set up further down; until then there is nobody to tell.
  let announce: () => void = () => {};

  function showRemoteChange(on: boolean) {
    const box = q('[data-remote-change]') as HTMLElement;
    box.classList.toggle('hidden', !on);
    box.classList.toggle('flex', on);
  }

  const form = q('[data-marker-form]') as HTMLFormElement;
  const field = (n: string) =>
    form.elements.namedItem(n) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
  const val = (n: string) => (field(n) as HTMLInputElement).value.trim();
  const num = (n: string) => { const v = val(n); return v === '' ? null : Number(v); };

  function showKindFields() {
    const kind = (field('kind') as HTMLSelectElement).value;
    q('[data-when-exact]')!.classList.toggle('hidden', kind !== 'exact');
    q('[data-when-choice]')!.classList.toggle('hidden', kind !== 'choice');
    (q('[data-when-scored]') as HTMLElement).style.visibility = kind === 'none' ? 'hidden' : '';
    (q('[data-when-asked]') as HTMLElement).hidden = kind === 'none';
    q('[data-when-answered]')!.classList.toggle('hidden', kind === 'none');
    q('[data-cooldown-hint]')!.classList.toggle('hidden', kind === 'none');
    (q('[data-when-asked-rule]') as HTMLElement).hidden = kind === 'none';

    // The amount only means anything under the rule that spends it.
    const rule = (field('onWrong') as HTMLSelectElement)?.value;
    (q('[data-when-deduct]') as HTMLElement).hidden = rule !== 'deduct';
  }

  function drawChoices() {
    const box = q('[data-choices]')!;
    box.innerHTML = choices.map((c, i) => `
      <div class="flex items-center gap-2">
        <input type="checkbox" data-choice-correct="${i}" ${c.correct ? 'checked' : ''} class="h-5 w-5 shrink-0" />
        <span class="data w-4 shrink-0 text-xs text-[var(--ink-faint)]">${i}</span>
        <input class="field" data-choice-bg="${i}" value="${escapeHtml(c.bg)}" placeholder="BG" />
        <input class="field" data-choice-en="${i}" value="${escapeHtml(c.en)}" placeholder="EN" />
        <button type="button" data-choice-del="${i}"
                class="shrink-0 px-2 text-lg text-[var(--ink-faint)] hover:text-[var(--alert)]">×</button>
      </div>`).join('');

    box.querySelectorAll('[data-choice-bg]').forEach((el) => el.addEventListener('input', () => {
      choices[Number((el as HTMLElement).dataset.choiceBg)].bg = (el as HTMLInputElement).value;
    }));
    box.querySelectorAll('[data-choice-en]').forEach((el) => el.addEventListener('input', () => {
      choices[Number((el as HTMLElement).dataset.choiceEn)].en = (el as HTMLInputElement).value;
    }));
    box.querySelectorAll('[data-choice-correct]').forEach((el) => el.addEventListener('change', () => {
      choices[Number((el as HTMLElement).dataset.choiceCorrect)].correct = (el as HTMLInputElement).checked;
    }));
    box.querySelectorAll('[data-choice-del]').forEach((el) => el.addEventListener('click', () => {
      dirty = true;
      choices.splice(Number((el as HTMLElement).dataset.choiceDel), 1);
      drawChoices();
    }));
  }

  // The kind is four radios, and a list of radios has no listener of its own,
  // so the form listens for them.
  const onKind = (fn: () => void) => form.addEventListener('change', (e) => {
    if ((e.target as HTMLInputElement)?.name === 'kind') fn();
  });
  onKind(showKindFields);

  // The default follows the kind. A free-text answer is read by a person, so
  // a wait only punishes spelling; the box said 15 for it anyway, and the
  // server was sent 15 unless the creator noticed and changed it.
  onKind(() => {
    const kind = (field('kind') as HTMLSelectElement).value;
    const wait = field('cooldown') as HTMLInputElement;
    if (kind === 'free' && wait.value === '15') wait.value = '0';
    else if (kind !== 'free' && kind !== 'none' && wait.value === '0') wait.value = '15';
  });
  // The deduction box appears and disappears with the rule beside it.
  field('onWrong').addEventListener('change', showKindFields);
  q('[data-add-choice]')?.addEventListener('click', () => {
    dirty = true;
    choices.push({ bg: '', en: '', correct: false });
    drawChoices();
  });

  // ---------------------------------------------------------------- the steps
  // Whether the form holds anything the database does not. Hints and media are
  // written the moment they are added, so their own inputs do not count.
  let dirty = false;
  const markDirty = (e: Event) => {
    const el = e.target as HTMLElement;
    if (el.closest('[data-panel="hints"], [data-panel="media"], [data-import]')) return;
    dirty = true;
  };
  form.addEventListener('input', markDirty);
  form.addEventListener('change', markDirty);

  const STEPS = ['basics', 'place', 'question', 'hints', 'media'] as const;
  const OPTIONAL = new Set([2, 3]);
  let step = 0;
  let ready = false;
  let visited = new Set<number>([0]);
  let doneSteps = new Set<number>();
  let skippedSteps = new Set<number>();
  let flashTimer = 0;

  const stopNumber = (id: string | null) => {
    const i = markers.findIndex((m) => m.id === id);
    return i < 0 ? 1 : (markers[i].step ?? i + 1);
  };

  function flash(message: string) {
    const el = q('[data-wiz-flash]') as HTMLElement;
    text(el, message);
    el.classList.add('is-on');
    clearTimeout(flashTimer);
    flashTimer = window.setTimeout(() => el.classList.remove('is-on'), 1800);
  }

  function paintTitle() {
    const own = S.lang === 'en' ? val('titleEn') : val('titleBg');
    text(q('[data-wiz-title]'), own || val('titleBg') || val('titleEn') || S.wiz.untitled);
  }
  form.addEventListener('input', (e) => {
    const name = (e.target as HTMLInputElement)?.name;
    if (name === 'titleBg' || name === 'titleEn') paintTitle();
  });

  function paintSteps() {
    qa('[data-step]').forEach((b) => {
      const button = b as HTMLButtonElement;
      const i = Number(button.dataset.step);
      const cur = !ready && i === step;
      button.classList.toggle('is-current', cur);
      button.classList.toggle('is-done', doneSteps.has(i));
      button.classList.toggle('is-skipped', skippedSteps.has(i) && !cur);
      button.disabled = !visited.has(i);
      if (cur) button.setAttribute('aria-current', 'step'); else button.removeAttribute('aria-current');
      const sub = button.querySelector('[data-step-sub]') as HTMLElement;
      text(sub, skippedSteps.has(i) && !cur ? S.wiz.skipped : sub.dataset.sub ?? '');
    });
    text(q('[data-wiz-count]'), S.wiz.of.replace('{0}', String(ready ? STEPS.length : step + 1)));
    (q('[data-wiz-prev]') as HTMLButtonElement).disabled = step === 0;
    q('[data-wiz-skip]')!.classList.toggle('hidden', !OPTIONAL.has(step));
    const last = step === STEPS.length - 1;
    text(q('[data-next-label]'), last ? S.wiz.done : S.wiz.next);
    q('[data-next-arrow]')!.toggleAttribute('hidden', last);
    q('[data-wiz-foot]')!.classList.toggle('hidden', ready);
  }

  function show(panel: string) {
    qa('[data-panel]').forEach((p) => p.classList.toggle('hidden', (p as HTMLElement).dataset.panel !== panel));
  }

  /** Keeps the top of the form in view; on a phone it sits below the map. */
  function bringFormIntoView(always: boolean) {
    const top = form.getBoundingClientRect().top;
    if (top < 72 || (always && top > innerHeight * 0.6)) {
      scrollTo({ top: scrollY + top - 80, behavior: 'smooth' });
    }
  }

  /**
   * What the stop still needs. The required items are exactly the ones save()
   * refuses without, so the list and the refusal never disagree; the English
   * title is listed as optional.
   */
  function missingItems() {
    const items: { label: string; panel: typeof STEPS[number]; field: string | null; required: boolean }[] = [];
    if (!val('titleBg')) items.push({ label: S.miss.titleBg, panel: 'basics', field: 'titleBg', required: true });
    const lat = num('lat'), lng = num('lng');
    if (lat === null || lng === null || Number.isNaN(lat) || Number.isNaN(lng)
        || lat < -90 || lat > 90 || lng < -180 || lng > 180) {
      items.push({ label: S.miss.place, panel: 'place', field: 'lat', required: true });
    }
    const kind = (field('kind') as HTMLSelectElement).value;
    if (kind !== 'none' && !val('questionBg') && !val('questionEn')) {
      items.push({ label: S.miss.question, panel: 'question', field: 'questionBg', required: true });
    }
    const kept = choices.filter((c) => c.bg.trim() || c.en.trim());
    if (kind === 'choice' && (kept.length < 2 || !kept.some((c) => c.correct))) {
      items.push({ label: S.miss.choice, panel: 'question', field: null, required: true });
    }
    if (kind === 'exact' && !val('accepted')) {
      items.push({ label: S.miss.accepted, panel: 'question', field: 'accepted', required: true });
    }
    if (!val('titleEn')) items.push({ label: S.miss.titleEn, panel: 'basics', field: 'titleEn', required: false });
    return items;
  }

  function paintMissing() {
    const box = q('[data-missing]') as HTMLElement | null;
    const list = q('[data-missing-list]') as HTMLElement | null;
    if (!box || !list || !selected) return;
    const items = missingItems();
    box.hidden = items.length === 0;
    list.replaceChildren(...items.map((it) => {
      const li = document.createElement('li');
      const go = document.createElement('button');
      go.type = 'button';
      go.className = it.required ? 'miss-go' : 'miss-go is-optional';
      go.textContent = it.label;
      if (!it.required) {
        const tag = document.createElement('span');
        tag.className = 'miss-tag';
        tag.textContent = S.miss.optional;
        go.append(' ', tag);
      }
      go.addEventListener('click', () => {
        goTo(STEPS.indexOf(it.panel));
        if (it.field) (field(it.field) as HTMLElement | null)?.focus();
      });
      li.append(go);
      return li;
    }));
  }
  // Typing, choosing a kind, adding or ticking an option: all recheck it.
  for (const ev of ['input', 'change', 'click']) {
    form.addEventListener(ev, () => setTimeout(paintMissing, 0));
  }

  function goTo(i: number) {
    ready = false;
    step = Math.max(0, Math.min(STEPS.length - 1, i));
    visited.add(step);
    show(STEPS[step]);
    paintSteps();
    q('[data-marker-error]')!.classList.add('hidden');
    paintMissing();
    bringFormIntoView(false);
  }

  function showReady() {
    ready = true;
    show('ready');
    text(q('[data-ready-title]'), S.wiz.ready.replace('{0}', String(stopNumber(selected))));
    const names = [...skippedSteps].sort().map((i) => S.wiz.names[i]);
    text(q('[data-ready-skipped]'), names.length ? S.wiz.skippedList.replace('{0}', names.join(', ')) : '');
    paintSteps();
  }

  /**
   * A stop just placed on the map starts at Basics and opens its steps one by
   * one. A stop that already exists can be entered at any step.
   */
  function startSteps(m: any, fresh: boolean) {
    // A stop just placed is still a draft: its first Next has to publish it.
    dirty = fresh || m.status !== 'published';
    visited = new Set([0, 1, 2, 3, 4]);
    doneSteps = new Set<number>();
    skippedSteps = new Set<number>();
    if (!fresh) {
      if (m.content?.bg?.title) doneSteps.add(0);
      doneSteps.add(1);
      if ((m.answer_kind ?? 'none') !== 'none') doneSteps.add(2);
      if (Number(m.hint_count)) doneSteps.add(3);
      if (Number(m.media_count)) doneSteps.add(4);
    }
    text(q('[data-wiz-kind]'), fresh ? S.wiz.newStop : S.wiz.stop.replace('{0}', String(stopNumber(m.id))));
    text(q('[data-wiz-pin]'), String(stopNumber(m.id)));
    paintTitle();
    goTo(0);
    bringFormIntoView(true);
    if (fresh) (field('titleBg') as HTMLInputElement).focus({ preventScroll: true });
  }

  async function next() {
    if (!selected) return;
    if (!(await save())) return;
    doneSteps.add(step);
    skippedSteps.delete(step);
    flash(S.wiz.saved);
    if (step === STEPS.length - 1) showReady(); else goTo(step + 1);
  }

  form.addEventListener('submit', (event) => { event.preventDefault(); next(); });

  q('[data-wiz-prev]')?.addEventListener('click', async () => {
    if (await save(true)) flash(S.wiz.saved);
    goTo(step - 1);
  });

  // Skipping puts the step back the way it was saved: a question half-chosen
  // and then skipped is not a question.
  q('[data-wiz-skip]')?.addEventListener('click', () => {
    const m = markers.find((x) => x.id === selected);
    if (step === 2 && m) fillAnswer(m);
    if (step === 3) {
      (q('[data-hint-bg]') as HTMLInputElement).value = '';
      (q('[data-hint-en]') as HTMLInputElement).value = '';
    }
    if (!doneSteps.has(step)) skippedSteps.add(step);
    flash(S.wiz.skipped);
    goTo(step + 1);
  });

  qa('[data-step]').forEach((b) => b.addEventListener('click', async () => {
    const i = Number((b as HTMLElement).dataset.step);
    if (i === step && !ready) return;
    // Any step, any time. What can be saved is saved on the way; what cannot
    // stays in the form, and "Still missing" says what it needs.
    if (!ready && (await save(true))) {
      if (i > step) { doneSteps.add(step); skippedSteps.delete(step); }
      flash(S.wiz.saved);
    }
    goTo(i);
  }));

  q('[data-ready-again]')?.addEventListener('click', () => goTo(0));

  /** The question step's fields, from the stop as it was last saved. */
  function fillAnswer(m: any) {
    (field('kind') as HTMLSelectElement).value = m.answer_kind ?? 'none';
    (field('points') as HTMLInputElement).value = String(m.points ?? 10);
    (field('cooldown') as HTMLInputElement).value = String(m.cooldown_seconds ?? 15);
    (field('onWrong') as HTMLSelectElement).value = m.on_wrong ?? 'retry';
    (field('deduct') as HTMLInputElement).value = String(m.deduct_points ?? 5);
    (field('accepted') as HTMLTextAreaElement).value = (m.accepted ?? []).join('\n');
    (field('questionBg') as HTMLTextAreaElement).value = m.content?.bg?.question ?? '';
    (field('questionEn') as HTMLTextAreaElement).value = m.content?.en?.question ?? '';
    (field('afterBg') as HTMLTextAreaElement).value = m.after_text?.bg ?? '';
    (field('afterEn') as HTMLTextAreaElement).value = m.after_text?.en ?? '';

    const bgOpts = m.content?.bg?.choices ?? [];
    const enOpts = m.content?.en?.choices ?? [];
    const correct: number[] = m.correct_choices ?? [];
    choices = bgOpts.map((label: string, i: number) => ({
      bg: label ?? '', en: enOpts[i] ?? '', correct: correct.includes(i),
    }));
    drawChoices();
    showKindFields();
  }

  async function select(id: string | null, fresh = false) {
    selected = id;
    pins.forEach((pin, pid) => {
      pin.getElement().style.filter = pid === id ? 'drop-shadow(0 0 7px var(--signal))' : '';
    });

    q('[data-no-selection]')!.classList.toggle('hidden', Boolean(id));
    form.classList.toggle('hidden', !id);
    if (!id) return;

    const m = markers.find((x) => x.id === id);
    if (!m) return;

    formVersion = m.version;
    showRemoteChange(false);
    announce();

    (field('titleBg') as HTMLInputElement).value = m.content?.bg?.title ?? '';
    (field('titleEn') as HTMLInputElement).value = m.content?.en?.title ?? '';
    (field('bodyBg') as HTMLTextAreaElement).value = m.content?.bg?.body ?? '';
    (field('bodyEn') as HTMLTextAreaElement).value = m.content?.en?.body ?? '';
    (field('lat') as HTMLInputElement).value = String(m.lat ?? '');
    (field('lng') as HTMLInputElement).value = String(m.lng ?? '');
    (field('radius') as HTMLInputElement).value = String(m.radius_m ?? 100);

    // trail_markers already returns colour_hex; nothing has ever written one.
    hue = hexToHue(m.colour_hex ?? null);
    paintHue();
    (field('signBg') as HTMLInputElement).value = m.content?.bg?.sign ?? '';
    (field('signEn') as HTMLInputElement).value = m.content?.en?.sign ?? '';
    setShape(m.style_key);
    fillAnswer(m);

    showKindFields();
    q('[data-marker-error]')!.classList.add('hidden');
    startSteps(m, fresh);
    await Promise.all([loadHints(), loadMedia(), loadModel(m)]);
  }

  function drawList() {
    const list = q('[data-stops]')!;
    text(q('[data-stop-count]'), markers.length ? `(${markers.length})` : '');
    q('[data-stops-empty]')!.toggleAttribute('hidden', markers.length > 0);

    list.innerHTML = markers.map((m, i) => {
      const title = m.content?.[S.lang]?.title || m.content?.bg?.title || m.content?.en?.title || '—';
      // draggable on the li, not on the button: a draggable button swallows its
      // own click on some browsers, and picking a stop is the commoner action.
      return `<li draggable="true" data-row="${m.id}" class="rounded-lg transition-opacity">
        <button type="button" data-pick="${m.id}"
        class="flex w-full cursor-grab items-center gap-2.5 rounded-lg border border-[var(--line)] px-3 py-2 text-left text-sm transition-colors hover:bg-[var(--surface-2)]">
        <span class="data w-5 shrink-0 text-xs text-[var(--ink-faint)]">${m.step ?? i + 1}</span>
        <span class="min-w-0 flex-1 truncate">${escapeHtml(title)}</span>
        ${Number(m.hint_count) ? `<span class="data shrink-0 text-2xs text-[var(--ink-faint)]">?${m.hint_count}</span>` : ''}
        ${Number(m.media_count) ? `<span class="data shrink-0 text-2xs text-[var(--ink-faint)]">#${m.media_count}</span>` : ''}
        ${m.answer_kind && m.answer_kind !== 'none'
          ? `<span class="data shrink-0 text-xs" style="color:var(--lamp)">${m.points ?? 0}</span>` : ''}
        ${m.status !== 'published' ? `<span class="eyebrow shrink-0">${S.draft}</span>` : ''}
      </button></li>`;
    }).join('');

    wireDragging(list);

    list.querySelectorAll('[data-pick]').forEach((b) =>
      b.addEventListener('click', async () => {
        const id = (b as HTMLElement).dataset.pick!;
        await select(id);
        const m = markers.find((x) => x.id === id);
        if (m) map.easeTo({ center: [m.lng, m.lat], zoom: Math.max(map.getZoom(), 16) });
      }));
  }

  /// Dragging a stop to a new place in the sequence.
  ///
  /// HTML5 drag events rather than a library: the list is a dozen rows of plain
  /// markup and pointer-based reordering is the kind of thing that works on the
  /// desk and not on a phone.
  ///
  /// The whole order goes to the server, not the pair that swapped. A swap
  /// needs the client to work out what moved and leaves the trail half-sorted if
  /// the second write never lands; the sequence the creator is looking at cannot
  /// disagree with itself.
  function wireDragging(list: Element) {
    let from: string | null = null;

    list.querySelectorAll('[data-row]').forEach((row) => {
      const el = row as HTMLElement;

      el.addEventListener('dragstart', (event) => {
        from = el.dataset.row!;
        el.style.opacity = '0.4';
        (event as DragEvent).dataTransfer?.setData('text/plain', from);
      });

      el.addEventListener('dragend', () => { from = null; el.style.opacity = ''; });

      // Both of these have to preventDefault or the drop never fires. dragover
      // fires continuously, so the only work here is the line showing where the
      // row would land.
      el.addEventListener('dragover', (event) => {
        event.preventDefault();
        if (!from || el.dataset.row === from) return;
        const box = el.getBoundingClientRect();
        const above = (event as DragEvent).clientY < box.top + box.height / 2;
        el.style.boxShadow = above
          ? 'inset 0 2px 0 0 var(--signal)'
          : 'inset 0 -2px 0 0 var(--signal)';
      });

      el.addEventListener('dragleave', () => { el.style.boxShadow = ''; });

      el.addEventListener('drop', async (event) => {
        event.preventDefault();
        el.style.boxShadow = '';

        const moved = from;
        const onto = el.dataset.row!;
        if (!moved || moved === onto) return;

        const box = el.getBoundingClientRect();
        const above = (event as DragEvent).clientY < box.top + box.height / 2;

        const order = markers.map((m) => m.id).filter((id) => id !== moved);
        const at = order.indexOf(onto);
        order.splice(above ? at : at + 1, 0, moved);

        // Drawn from the new order before the write, so the row lands under the
        // cursor immediately. load() below replaces this with the server's word.
        markers = order.map((id) => markers.find((m) => m.id === id)!);
        markers.forEach((m, i) => { m.step = i + 1; });
        drawList();

        const { error } = await client.rpc('reorder_markers', {
          p_world: worldId, p_ids: order,
        });

        if (error) { alert(`${S.reorderFailed}\n${error.message}`); }
        await load();
      });
    });
  }

  function drawPins() {
    pins.forEach((p) => p.remove());
    pins = new Map();

    for (const m of markers) {
      const el = document.createElement('div');
      el.style.cssText =
        'width:18px;height:18px;border-radius:50%;cursor:pointer;' +
        `background:${m.colour_hex || '#0066CC'};border:2px solid #fff;` +
        'box-shadow:0 1px 4px rgba(0,0,0,.5)';

      const pin = new maplibregl.Marker({ element: el, draggable: true })
        .setLngLat([m.lng, m.lat]).addTo(map);
      el.addEventListener('click', (e) => { e.stopPropagation(); select(m.id); });

      pin.on('dragend', async () => {
        const { lng, lat } = pin.getLngLat();
        if (selected === m.id) savingNow = true;
        const { data, error } = await client.rpc('move_marker', { p_marker: m.id, p_lat: lat, p_lng: lng });
        savingNow = false;
        if (error) { alert(error.message); await load(); return; }
        m.lat = lat; m.lng = lng;
        if (Array.isArray(data) ? data[0]?.version : (data as any)?.version) {
          m.version = Array.isArray(data) ? data[0].version : (data as any).version;
          if (selected === m.id) formVersion = m.version;
        }
        if (selected === m.id) {
          (field('lat') as HTMLInputElement).value = String(lat);
          (field('lng') as HTMLInputElement).value = String(lng);
        }
      });

      pins.set(m.id, pin);
    }

    // Once, on the first draw with anything in it: every trail opened on
    // Yambol, so one built anywhere else showed an empty map of the wrong town.
    if (!fitted && markers.length) {
      fitted = true;
      const bounds = new maplibregl.LngLatBounds();
      markers.forEach((m) => bounds.extend([m.lng, m.lat]));
      map.fitBounds(bounds, { padding: 60, maxZoom: 17, duration: 0 });
    }
  }

  function drawPinsWhenReady() {
    if (map.loaded()) drawPins(); else map.once('load', drawPins);
  }

  async function load() {
    const { data, error } = await client.rpc('trail_markers', { p_world: worldId });
    if (error) { alert(error.message); return; }

    const { data: answers } = await client
      .from('marker_answers')
      .select('marker_id,kind,accepted,correct_choices,points,cooldown_seconds,after_text,on_wrong,deduct_points');
    const byId = new Map((answers ?? []).map((a: any) => [a.marker_id, a]));
    markers = (data ?? []).map((m: any) => ({ ...m, ...(byId.get(m.id) ?? {}) }));

    drawList();
    drawPinsWhenReady();
    if (selected && !markers.some((m) => m.id === selected)) await select(null);

    // Said, not enforced: a creator mid-edit will legitimately have two stops
    // on top of each other for a minute, and refusing the save would be worse.
    const { data: clashes } = await client.rpc('overlapping_stops', { p_world: worldId });
    const warn = q('[data-overlap]')!;
    if (clashes && clashes.length) {
      const name = (id: string) => {
        const m = markers.find((x) => x.id === id);
        return m?.content?.[S.lang]?.title || m?.content?.bg?.title || '—';
      };
      text(warn, `${S.overlap} ` + clashes.slice(0, 3)
        .map((c: any) => `${name(c.a)} / ${name(c.b)} (${Math.round(c.metres)} m)`).join(', '));
      warn.classList.remove('hidden');
    } else {
      warn.classList.add('hidden');
    }
  }

  await load();

  map.on('click', async (event) => {
    const { lng, lat } = event.lngLat;
    const { data, error } = await client.rpc('place_marker', {
      p_world: worldId, p_lat: lat, p_lng: lng, p_content: {}, p_status: 'draft',
    });
    if (error) { alert(error.message); return; }
    await load();
    const id = Array.isArray(data) ? data[0]?.id : (data as any)?.id;
    if (id) await select(id, true);
  });

  // ------------------------------------------------------------------ hints
  async function loadHints() {
    if (!selected) return;
    const { data } = await client.from('marker_hints')
      .select('id,ord,body,cost').eq('marker_id', selected).order('ord');
    const rows = data ?? [];

    text(q('[data-count-hints]'), rows.length ? String(rows.length) : '');
    if (rows.length) { doneSteps.add(3); skippedSteps.delete(3); } else doneSteps.delete(3);
    paintSteps();
    q('[data-hints-empty]')!.classList.toggle('hidden', rows.length > 0);
    q('[data-hints]')!.innerHTML = rows.map((h: any) => `
      <li class="card flex items-start justify-between gap-3 p-3">
        <div class="min-w-0">
          <p class="text-sm">${escapeHtml(h.body?.bg || h.body?.en || '—')}</p>
          <p class="data mt-0.5 text-2xs text-[var(--ink-faint)]">${h.cost} · ${escapeHtml(S.hintCost)}</p>
        </div>
        <button type="button" data-del-hint="${h.id}"
                class="shrink-0 text-xs text-[var(--alert)] hover:underline">${escapeHtml(S.remove)}</button>
      </li>`).join('');

    q('[data-hints]')!.querySelectorAll('[data-del-hint]').forEach((b) =>
      b.addEventListener('click', async () => {
        await client.from('marker_hints').delete().eq('id', (b as HTMLElement).dataset.delHint!);
        await Promise.all([loadHints(), load()]);
      }));
  }

  q('[data-add-hint]')?.addEventListener('click', async () => {
    if (!selected) return;
    const bg = (q('[data-hint-bg]') as HTMLInputElement).value.trim();
    const en = (q('[data-hint-en]') as HTMLInputElement).value.trim();
    const cost = Number((q('[data-hint-cost]') as HTMLInputElement).value || 0);
    if (!bg && !en) return;

    const existing = (await client.from('marker_hints').select('id').eq('marker_id', selected)).data ?? [];
    const { error } = await client.from('marker_hints').insert({
      marker_id: selected, ord: existing.length + 1, cost,
      body: { ...(bg && { bg }), ...(en && { en }) },
    });
    if (error) { alert(error.message); return; }

    (q('[data-hint-bg]') as HTMLInputElement).value = '';
    (q('[data-hint-en]') as HTMLInputElement).value = '';
    (q('[data-hint-cost]') as HTMLInputElement).value = '0';
    await Promise.all([loadHints(), load()]);
  });

  // ------------------------------------------------------------------ media
  const BUCKET = 'marker-media';
  const MAX_BYTES = 50 * 1024 * 1024;

  /** Whole megabytes below ten, one decimal above: 0.4 MB, 7.2 MB, 143 MB. */
  function megabytes(bytes: number) {
    const mb = bytes / (1024 * 1024);
    return `${mb >= 10 ? Math.round(mb) : Math.round(mb * 10) / 10} MB`;
  }

  const usage = { used: 0, cap: 0 };

  async function loadUsage() {
    if (!worldId) return;

    const { data, error } = await client.rpc('world_media_usage', { p_world: worldId });
    const row = Array.isArray(data) ? data[0] : data;
    if (error || !row) return;

    usage.used = Number(row.used_bytes);
    usage.cap = Number(row.cap_bytes);

    const box = q('[data-media-usage]') as HTMLElement;
    box.hidden = false;

    // Capped at 100 so a trail that slipped over the line by one file draws a
    // full bar rather than one that runs out of its own track.
    const share = usage.cap > 0 ? Math.min(100, (usage.used / usage.cap) * 100) : 0;
    (q('[data-media-fill]') as HTMLElement).style.width = `${share}%`;
    text(q('[data-media-used]'),
         S.mediaUsed.replace('{0}', megabytes(usage.used)).replace('{1}', megabytes(usage.cap)));
  }

  async function loadMedia() {
    if (!selected) return;
    const { data } = await client.from('marker_media')
      .select('id,kind,path,ord').eq('marker_id', selected).order('ord');
    const rows = data ?? [];

    text(q('[data-count-media]'), rows.length ? String(rows.length) : '');
    if (rows.length) doneSteps.add(4); else doneSteps.delete(4);
    paintSteps();
    q('[data-media-empty]')!.classList.toggle('hidden', rows.length > 0);
    q('[data-media]')!.innerHTML = rows.map((m: any) => {
      const url = m.kind === 'link'
        ? m.path
        : client.storage.from(BUCKET).getPublicUrl(m.path).data.publicUrl;
      const preview = m.kind === 'image'
        ? `<img src="${escapeHtml(url)}" alt="" class="h-12 w-16 shrink-0 rounded object-cover" />`
        : `<span class="badge badge-quiet shrink-0">${escapeHtml(m.kind)}</span>`;

      // The stored path is <trail>/<stop>/<timestamp>-<name>, which is three
      // things a creator did not choose and one they did. Only the last is
      // worth showing: a row reading two uuids tells nobody which photo it is.
      const label = m.kind === 'link'
        ? m.path
        : decodeURIComponent((m.path.split('/').pop() ?? m.path).replace(/^\d+-/, ''));

      return `<li class="card flex items-center gap-3 p-3">
        ${preview}
        <a href="${escapeHtml(url)}" target="_blank" rel="noopener"
           class="min-w-0 flex-1 truncate text-xs text-[var(--signal)] hover:underline"
           title="${escapeHtml(m.path)}">${escapeHtml(label)}</a>
        <button type="button" data-del-media="${m.id}" data-path="${m.kind === 'link' ? '' : escapeHtml(m.path)}"
                class="shrink-0 text-xs text-[var(--alert)] hover:underline">${escapeHtml(S.remove)}</button>
      </li>`;
    }).join('');

    q('[data-media]')!.querySelectorAll('[data-del-media]').forEach((b) =>
      b.addEventListener('click', async () => {
        const el = b as HTMLElement;
        if (el.dataset.path) await client.storage.from(BUCKET).remove([el.dataset.path]);
        await client.from('marker_media').delete().eq('id', el.dataset.delMedia!);
        await Promise.all([loadMedia(), load(), loadUsage()]);
      }));
  }

  async function upload(file: File, kind: 'image' | 'audio' | 'video') {
    if (!selected) return;
    const statusEl = q('[data-upload-status]') as HTMLElement;
    const show = (m: string) => { statusEl.textContent = m; statusEl.classList.remove('hidden'); };

    if (file.size > MAX_BYTES) { show(S.tooBig); return; }

    // The insert policy refuses a trail that is already at the line; it cannot
    // refuse one that is under it by a byte, because it does not know how big
    // the incoming file is. This does, so it does the exact arithmetic and says
    // so in words rather than letting the upload run and fail.
    await loadUsage();
    const free = usage.cap - usage.used;

    if (usage.cap > 0 && free <= 0) { show(S.mediaFull); return; }
    if (usage.cap > 0 && file.size > free) {
      show(S.mediaWontFit.replace('{0}', megabytes(free)));
      return;
    }

    show(S.uploading);

    // <world>/<marker>/<file>: the first segment is what the storage policy
    // reads to decide who may write here.
    const safe = file.name.replace(/[^a-zA-Z0-9._-]/g, '_');
    const path = `${worldId}/${selected}/${Date.now()}-${safe}`;

    const { error } = await client.storage.from(BUCKET).upload(path, file, { upsert: false });
    if (error) { show(error.message); return; }

    const existing = (await client.from('marker_media').select('id').eq('marker_id', selected)).data ?? [];
    await client.from('marker_media').insert({
      marker_id: selected, kind, path, ord: existing.length + 1,
    });

    statusEl.classList.add('hidden');
    await Promise.all([loadMedia(), load(), loadUsage()]);
  }

  (q('[data-file-image]') as HTMLInputElement)?.addEventListener('change', (e) => {
    const input = e.target as HTMLInputElement;
    const f = input.files?.[0];
    if (f) upload(f, 'image');
    input.value = '';
  });
  (q('[data-file-audio]') as HTMLInputElement)?.addEventListener('change', (e) => {
    const input = e.target as HTMLInputElement;
    const f = input.files?.[0];
    if (f) upload(f, 'audio');
    input.value = '';
  });
  q('[data-add-video]')?.addEventListener('click', async () => {
    const input = q('[data-video-url]') as HTMLInputElement;
    const url = input.value.trim();
    if (!selected || !url) return;
    const existing = (await client.from('marker_media').select('id').eq('marker_id', selected)).data ?? [];
    await client.from('marker_media').insert({
      marker_id: selected, kind: 'link', path: url, ord: existing.length + 1,
    });
    input.value = '';
    await Promise.all([loadMedia(), load(), loadUsage()]);
  });

  // ------------------------------------------------------------------ saving
  // Every step that is left is saved, and Next checks it first. One routine for
  // the whole stop: the steps are a way of showing the form, not five forms.
  // quiet: a step left by Previous or the step bar, where a half-written
  // question is not an error yet - it stays in the form and is checked at Next.
  async function save(quiet = false): Promise<boolean> {
    if (!selected) return false;

    const err = q('[data-marker-error]') as HTMLElement;
    err.classList.add('hidden');
    const button = q('[data-marker-save]') as HTMLButtonElement;
    const labelEl = q('[data-next-label]') as HTMLElement;
    const label = labelEl.textContent;

    // Sends them to the step holding the problem, or the message names a field
    // they cannot see.
    const fail = (message: string, panel?: string) => {
      button.disabled = false; text(labelEl, label);
      if (quiet) return;
      // The step first, then the message: moving to a step clears old ones.
      if (panel) goTo(STEPS.indexOf(panel as typeof STEPS[number]));
      err.textContent = message; err.classList.remove('hidden');
    };

    button.disabled = true;
    text(labelEl, S.saving);

    const lat = num('lat'), lng = num('lng');
    if (lat === null || lng === null || Number.isNaN(lat) || Number.isNaN(lng)) {
      fail(S.lang === 'bg' ? 'Координатите трябва да са числа.' : 'Coordinates must be numbers.', 'place');
      return false;
    }
    if (lat < -90 || lat > 90 || lng < -180 || lng > 180) {
      fail(S.lang === 'bg' ? 'Координатите са извън обхват.' : 'Coordinates are out of range.', 'place');
      return false;
    }

    const titleBg = val('titleBg');
    if (!titleBg) {
      fail(S.lang === 'bg' ? 'Дай заглавие на български.' : 'Give the stop a Bulgarian title.', 'basics');
      return false;
    }

    const kind = (field('kind') as HTMLSelectElement).value;
    const kept = choices.filter((c) => c.bg.trim() || c.en.trim());
    const correct = kept.map((c, i) => (c.correct ? i : -1)).filter((i) => i >= 0);

    // A question with no words. It saved, points and all, and the app - which
    // has nothing to show - left the question off the stop without a word.
    if (kind !== 'none' && !val('questionBg') && !val('questionEn')) {
      fail(S.lang === 'bg' ? 'Напиши въпроса.' : 'Write the question.', 'question');
      return false;
    }
    if (kind === 'choice' && (kept.length < 2 || correct.length === 0)) {
      fail(S.lang === 'bg' ? 'Трябват поне два отговора и поне един верен.'
                           : 'A choice needs at least two options and one ticked as right.', 'question');
      return false;
    }
    if (kind === 'exact' && !val('accepted')) {
      fail(S.lang === 'bg' ? 'Напиши поне един приет отговор.' : 'Write at least one accepted answer.', 'question');
      return false;
    }

    // Checked, and nothing to write. Stepping through a stop must not bump its
    // version each time: a co-editor with the same stop open would be told it
    // had changed when nobody changed it.
    if (chosenShape() === 'model') {
      const problem = modelProblem();
      if (problem) { fail(problem, 'place'); return false; }
    }

    if (!dirty) { button.disabled = false; text(labelEl, label); return true; }

    const content: Record<string, any> = {
      bg: { title: titleBg, ...(val('bodyBg') && { body: val('bodyBg') }) },
    };
    if (val('titleEn') || val('bodyEn')) {
      content.en = {
        ...(val('titleEn') && { title: val('titleEn') }),
        ...(val('bodyEn') && { body: val('bodyEn') }),
      };
    }
    if (kind !== 'none') {
      if (val('questionBg')) content.bg.question = val('questionBg');
      if (val('questionEn')) {
        content.en = { ...(content.en ?? {}), question: val('questionEn') };
      }
    }

    if (kind === 'choice' && kept.length) {
      content.bg.choices = kept.map((c) => c.bg);
      content.en = { ...(content.en ?? {}), choices: kept.map((c) => c.en || c.bg) };
    }

    // A sign's words, only on a sign. Kept out of every other shape so that
    // switching away and back does not resurrect text nobody can see.
    const shape = chosenShape();
    if (shape === 'sign') {
      if (val('signBg')) content.bg.sign = val('signBg');
      if (val('signEn')) content.en = { ...(content.en ?? {}), sign: val('signEn') };
    }

    // Only over the version this form was filled from. If somebody else saved
    // the stop in between, the row's version has moved on, nothing matches, and
    // this save is refused rather than silently writing over theirs.
    const saving = selected;
    savingNow = true;
    const { data: wrote, error: upErr } = await client.from('markers')
      .update({
        content,
        radius_m: num('radius') ?? 100,
        colour_hex: hue === null ? DEFAULT_STOP_COLOUR : hueToHex(hue),
        style_key: shape,
        status: 'published',
      })
      .eq('id', saving)
      .eq('version', formVersion ?? -1)
      .select('version');
    if (upErr) { savingNow = false; fail(upErr.message); return false; }
    if (!wrote || wrote.length === 0) {
      savingNow = false;
      showRemoteChange(true);
      fail(S.conflict);
      return false;
    }
    formVersion = wrote[0].version;

    if (shape === 'model') {
      const problem = await saveModel(saving);
      if (problem) { savingNow = false; fail(problem, 'place'); return false; }
    }

    const moved = await client.rpc('move_marker', { p_marker: selected, p_lat: lat, p_lng: lng });
    if (moved.error) { savingNow = false; fail(moved.error.message, 'place'); return false; }

    if (kind === 'none') {
      await client.rpc('clear_marker_answer', { p_marker: selected });
    } else {
      const accepted = (field('accepted') as HTMLTextAreaElement).value
        .split('\n').map((x) => x.trim()).filter(Boolean);

      // Checked before anything was written - see the top of save.

      const after: Record<string, string> = {};
      if (val('afterBg')) after.bg = val('afterBg');
      if (val('afterEn')) after.en = val('afterEn');

      const { error: aErr } = await client.rpc('set_marker_answer', {
        p_marker: selected,
        p_kind: kind,
        p_accepted: kind === 'exact' ? accepted : null,
        p_correct_choices: kind === 'choice' ? correct : null,
        p_points: num('points') ?? 10,
        p_cooldown_seconds: num('cooldown') ?? (kind === 'free' ? 0 : 15),
        p_on_wrong: (field('onWrong') as HTMLSelectElement)?.value || 'retry',
        p_deduct_points: num('deduct') ?? 0,
        p_after_text: after,
      });
      if (aErr) { savingNow = false; fail(aErr.message, 'question'); return false; }
    }

    button.disabled = false;
    text(labelEl, label);
    await load();
    // move_marker bumped the version again; take whatever the row says now.
    formVersion = markers.find((m) => m.id === saving)?.version ?? formVersion;
    savingNow = false;
    dirty = false;
    return true;
  }

  q('[data-remote-reload]')?.addEventListener('click', async () => {
    const id = selected;
    await load();
    await select(markers.some((m) => m.id === id) ? id : null);
    q('[data-marker-error]')!.classList.add('hidden');
  });

  q('[data-marker-delete]')?.addEventListener('click', async () => {
    if (!selected) return;
    const { data: files } = await client.rpc('media_paths', { p_world: worldId, p_marker: selected });
    if (files?.length) await client.storage.from('marker-media').remove(files);
    const { error } = await client.from('markers').delete().eq('id', selected);
    if (error) { alert(error.message); return; }
    await select(null);
    await load();
  });

  q('[data-rotate]')?.addEventListener('click', async () => {
    const { data, error } = await client.rpc('rotate_join_code', { p_world: worldId });
    if (error) { alert(error.message); return; }
    text(q('[data-trail-code]'), data);
  });

  q('[data-levels]')?.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement)?.closest('[data-level]') as HTMLButtonElement | null;
    if (!button || button.disabled) return;

    const wanted = button.dataset.level as 'draft' | 'code' | 'public';
    const failed = await setLevel(client, world, wanted, S.pubDrafts);
    if (failed) { alert(failed); return; }

    const { data: again } = await client
      .from('worlds').select('status,visibility,review_note').eq('id', worldId).single();

    if (again) world = { ...world, ...again };
    paintStatus();
  });

  q('[data-copy-code]')?.addEventListener('click', async (event) => {
    const button = event.currentTarget as HTMLElement;
    try {
      await navigator.clipboard.writeText(q('[data-trail-code]')!.textContent!.trim());
      text(button, S.copied);
      setTimeout(() => text(button, S.copy), 1400);
    } catch { /* the code is on screen; reading it out still works */ }
  });

  // --------------------------------------------------------- review and board
  async function loadReview() {
    const { data, error } = await client.rpc('review_queue', { p_world: worldId });
    const list = q('[data-review]')!;
    const rows = data ?? [];

    text(q('[data-review-count]'), rows.length ? String(rows.length) : '');
    q('[data-review-empty]')!.toggleAttribute('hidden', rows.length > 0);
    if (error || rows.length === 0) { list.innerHTML = ''; return; }

    list.innerHTML = rows.map((r: any) => {
      const title = r.marker_title?.[S.lang]?.title || r.marker_title?.bg?.title || '—';
      return `<li class="card flex flex-wrap items-start justify-between gap-4 p-4">
        <div class="min-w-0 flex-1">
          <p class="eyebrow">${escapeHtml(title)} · ${escapeHtml(r.team_name)}</p>
          <p class="mt-1.5 break-words text-sm">${escapeHtml(r.submitted)}</p>
        </div>
        <div class="flex shrink-0 flex-wrap gap-2">
          <button class="btn btn-primary btn-sm" data-accept="${r.submission_id}">${S.accept}</button>
          <button class="btn btn-danger-quiet btn-sm"
                  data-reject="${r.submission_id}">${S.reject}</button>
          <button class="btn btn-ghost btn-sm" data-block-player="${r.submission_id}"
                  data-team="${escapeHtml(r.team_name)}">${escapeHtml(S.revBlock)}</button>
        </div>
      </li>`;
    }).join('');

    const decide = async (id: string, correct: boolean) => {
      const { error: rErr } = await client.rpc('review_answer', { p_submission: id, p_correct: correct });
      if (rErr) { alert(rErr.message); return; }
      await Promise.all([loadReview(), loadBoard()]);
    };

    list.querySelectorAll('[data-accept]').forEach((b) =>
      b.addEventListener('click', () => decide((b as HTMLElement).dataset.accept!, true)));
    list.querySelectorAll('[data-reject]').forEach((b) =>
      b.addEventListener('click', () => decide((b as HTMLElement).dataset.reject!, false)));

    // The answer stays in the queue to be judged; the person who sent it
    // leaves the trail and cannot come back.
    list.querySelectorAll('[data-block-player]').forEach((b) =>
      b.addEventListener('click', async () => {
        const el = b as HTMLElement;
        if (!confirm(S.revBlockConfirm.replace('{0}', el.dataset.team ?? ''))) return;
        const { error: bErr } = await client.rpc('block_user',
          { p_kind: 'submission', p_target: el.dataset.blockPlayer });
        if (bErr) { alert(bErr.message); return; }
        el.remove();
      }));

    // Keyboard-driven: sixty submissions is not sixty dialogs.
    document.onkeydown = (event) => {
      if (event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement) return;
      const first = rows[0];
      if (!first) return;
      if (event.key === 'a') decide(first.submission_id, true);
      if (event.key === 'd') decide(first.submission_id, false);
    };
  }

  async function loadBoard() {
    const { data, error } = await client.rpc('world_leaderboard', { p_world: worldId });
    const table = q('[data-board]') as HTMLTableElement;
    const rows = data ?? [];

    q('[data-board-empty]')!.toggleAttribute('hidden', rows.length > 0);
    if (error || rows.length === 0) { table.innerHTML = ''; return; }

    table.innerHTML = `
      <thead><tr class="border-b border-[var(--line)] text-left text-xs text-[var(--ink-faint)]">
        <th class="py-2 pr-3">${escapeHtml(S.rank)}</th>
        <th class="py-2 pr-3">${escapeHtml(S.team)}</th>
        <th class="py-2 pr-3 text-right">${escapeHtml(S.bPoints)}</th>
        <th class="py-2 pr-3 text-right">${escapeHtml(S.bSolved)}</th>
        <th class="py-2 text-right">${escapeHtml(S.time)}</th>
      </tr></thead>
      <tbody>${rows.map((r: any) => `
        <tr class="border-b border-[var(--line-soft)]">
          <td class="data py-2 pr-3">${r.rank}</td>
          <td class="py-2 pr-3">${r.team_name ? escapeHtml(r.team_name) : escapeHtml(S.hidden)}${r.is_mine ? ` <span class="eyebrow">${S.you}</span>` : ''}</td>
          <td class="data py-2 pr-3 text-right">${r.points}</td>
          <td class="data py-2 pr-3 text-right text-[var(--ink-dim)]">${r.stops_solved}</td>
          <td class="data py-2 text-right text-[var(--ink-dim)]">${duration(r.elapsed_seconds)}</td>
        </tr>`).join('')}</tbody>`;
  }

  await Promise.all([loadReview(), loadBoard()]);

  // ---------------------------------------------------------------- editors
  const me = (await client.auth.getUser()).data.user;

  async function loadEditors() {
    const { data } = await client.rpc('trail_editors', { p_world: worldId });
    const list = q('[data-editor-list]')!;
    list.innerHTML = (data ?? []).map((e: any) => `
      <li class="flex items-center justify-between gap-3 border-t border-[var(--line-soft)] py-2.5 text-sm">
        <span class="min-w-0 truncate">${escapeHtml(e.name || e.email || '—')}${
          e.name && e.email ? ` <span class="text-[var(--ink-faint)]">${escapeHtml(e.email)}</span>` : ''}${
          e.is_me ? ` <span class="eyebrow">${escapeHtml(S.you)}</span>` : ''}</span>
        <span class="flex shrink-0 items-center gap-2">
          <span class="eyebrow">${escapeHtml(e.role === 'owner' ? S.ownerWord : S.editorWord)}</span>
          ${isOwner && e.role === 'editor'
            ? `<button type="button" class="btn btn-ghost btn-sm" data-remove-editor="${escapeHtml(e.user_id)}">${escapeHtml(S.remove)}</button>`
            : ''}
        </span>
      </li>`).join('');

    list.querySelectorAll('[data-remove-editor]').forEach((b) => b.addEventListener('click', async () => {
      const { error: rErr } = await client.rpc('remove_editor',
        { p_world: worldId, p_user: (b as HTMLElement).dataset.removeEditor });
      if (rErr) { alert(rErr.message); return; }
      await loadEditors();
    }));
  }

  function showInvite(code: string | null) {
    const box = q('[data-invite-box]') as HTMLElement;
    box.classList.toggle('hidden', !code);
    box.classList.toggle('flex', Boolean(code));
    q('[data-invite-make]')!.classList.toggle('hidden', Boolean(code));
    q('[data-invite-new]')!.classList.toggle('hidden', !code);
    q('[data-invite-stop]')!.classList.toggle('hidden', !code);
    if (code) {
      (q('[data-invite-link]') as HTMLInputElement).value =
        `${location.origin}${S.inviteHref}?code=${encodeURIComponent(code)}`;
    }
  }

  if (isOwner) {
    // Shown if one already exists; made only when asked.
    const { data: existing } = await client.from('editor_invites')
      .select('code').eq('world_id', worldId).maybeSingle();
    showInvite(existing?.code ?? null);

    const make = async (fresh: boolean) => {
      const { data, error: iErr } = await client.rpc('editor_invite', { p_world: worldId, p_new: fresh });
      if (iErr) { alert(iErr.message); return; }
      showInvite(data as string);
    };
    q('[data-invite-make]')?.addEventListener('click', () => make(false));
    q('[data-invite-new]')?.addEventListener('click', () => make(true));
    q('[data-invite-stop]')?.addEventListener('click', async () => {
      const { error: sErr } = await client.rpc('stop_editor_invite', { p_world: worldId });
      if (sErr) { alert(sErr.message); return; }
      showInvite(null);
    });
    q('[data-invite-copy]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget as HTMLElement;
      try {
        await navigator.clipboard.writeText((q('[data-invite-link]') as HTMLInputElement).value);
        text(button, S.copied);
        setTimeout(() => text(button, S.copy), 1400);
      } catch { (q('[data-invite-link]') as HTMLInputElement).select(); }
    });
  }

  q('[data-editor-leave]')?.addEventListener('click', async () => {
    if (!confirm(S.leaveConfirm)) return;
    const { error: lErr } = await client.from('world_members').delete()
      .eq('world_id', worldId).eq('user_id', me?.id ?? '');
    if (lErr) { alert(lErr.message); return; }
    location.href = S.myTrailsHref;
  });

  await loadEditors();

  // ------------------------------------------------------------------- live
  //
  // One channel per trail. Postgres changes arrive only for rows this person's
  // own token may read - the trail's owner and editors - because Realtime runs
  // them past the same row-level security as a select. Presence says who else
  // has the editor open, and which stop.
  // A display name, never the email: anybody who knows a trail's id can join
  // this channel's presence, and a public trail's id is on the library page.
  const myName = (me?.user_metadata?.display_name as string) || S.editorWord;
  let refreshTimer: ReturnType<typeof setTimeout> | null = null;

  const refreshSoon = () => {
    if (refreshTimer) clearTimeout(refreshTimer);
    refreshTimer = setTimeout(async () => { refreshTimer = null; await load(); }, 400);
  };

  const ours = (markerId: string | undefined) => Boolean(markerId) && markers.some((m) => m.id === markerId);

  // A key made up per tab, for the same reason as the name: nothing about
  // the account goes out on a channel strangers can join.
  const tabKey = crypto.randomUUID();
  const channel = client.channel(`trail:${worldId}`, { config: { presence: { key: tabKey } } });

  channel
    .on('postgres_changes', { event: '*', schema: 'public', table: 'markers', filter: `world_id=eq.${worldId}` },
      (change: any) => {
        const row = change.new?.id ? change.new : change.old;
        if (row?.id && row.id === selected && !savingNow) {
          // Deleted under us, or saved by somebody else at a newer version.
          if (change.eventType === 'DELETE' || (change.new?.version ?? 0) > (formVersion ?? 0)) {
            showRemoteChange(true);
          }
        }
        refreshSoon();
      })
    .on('postgres_changes', { event: '*', schema: 'public', table: 'marker_hints' },
      (change: any) => {
        const id = change.new?.marker_id ?? change.old?.marker_id;
        if (id && id === selected) loadHints();
        if (ours(id)) refreshSoon();
      })
    .on('postgres_changes', { event: '*', schema: 'public', table: 'marker_media' },
      (change: any) => {
        const id = change.new?.marker_id ?? change.old?.marker_id;
        if (id && id === selected) loadMedia();
        if (ours(id)) refreshSoon();
      })
    .on('postgres_changes', { event: '*', schema: 'public', table: 'marker_answers' },
      (change: any) => {
        if (ours(change.new?.marker_id ?? change.old?.marker_id)) refreshSoon();
      })
    .on('presence', { event: 'sync' }, () => {
      const others = Object.entries(channel.presenceState())
        .filter(([key]) => key !== tabKey)
        .map(([, metas]: [string, any]) => metas[0]);
      const box = q('[data-presence]') as HTMLElement;
      box.classList.toggle('hidden', others.length === 0);
      box.classList.toggle('flex', others.length > 0);
      box.innerHTML = others.length
        ? `<span>${escapeHtml(S.here)}</span>` + others.map((o: any) => {
            const stop = markers.find((m) => m.id === o.stop);
            const title = stop ? (stop.content?.[S.lang]?.title || stop.content?.bg?.title || '') : '';
            return `<span class="badge badge-quiet">${escapeHtml(o.name || '—')}${title ? ` · ${escapeHtml(title)}` : ''}</span>`;
          }).join('')
        : '';
    })
    .subscribe((status: string) => {
      if (status === 'SUBSCRIBED') announce();
    });

  // Which stop this tab has open, for everybody else's presence line.
  announce = () => { channel.track({ name: myName, stop: selected }).catch(() => {}); };

  // Last, not beside load(): everything it reads is declared further down this
  // file, and a const is not readable before its declaration has been reached.
  await loadUsage();

  // ------------------------------------------------------------------ colour
  //
  // Hue is the creator's; saturation and lightness are not. The app rings every
  // marker in whichever of black or white shows against it, so the colour never
  // has to carry its own separation from the map - and holding the weight fixed
  // is what stops one marker on a trail shouting over the rest.

  const HUE_SAT = 62;
  const HUE_LIGHT = 52;

  let hue: number | null = null;

  // The colour every stop has until its creator picks one (30 October 2026),
  // the brand blue the app also falls back to. hue stays null while it is the
  // default, so the default is what is saved, not the slider's nearest hue.
  const DEFAULT_STOP_COLOUR = '#0066cc';
  const DEFAULT_HUE = 210;

  /** HSL to the #rrggbb the markers table stores. */
  function hueToHex(h: number) {
    const s = HUE_SAT / 100;
    const l = HUE_LIGHT / 100;
    const c = (1 - Math.abs(2 * l - 1)) * s;
    const x = c * (1 - Math.abs(((h / 60) % 2) - 1));
    const m = l - c / 2;

    const [r, g, b] =
      h < 60 ? [c, x, 0] : h < 120 ? [x, c, 0] : h < 180 ? [0, c, x]
      : h < 240 ? [0, x, c] : h < 300 ? [x, 0, c] : [c, 0, x];

    const two = (v: number) =>
      Math.round((v + m) * 255).toString(16).padStart(2, '0');

    return `#${two(r)}${two(g)}${two(b)}`;
  }

  /** The hue of a stored colour, so reopening a stop finds its own handle. */
  function hexToHue(hex: string | null): number | null {
    if (!hex || !/^#[0-9a-f]{6}$/i.test(hex)) return null;

    const r = parseInt(hex.slice(1, 3), 16) / 255;
    const g = parseInt(hex.slice(3, 5), 16) / 255;
    const b = parseInt(hex.slice(5, 7), 16) / 255;

    const max = Math.max(r, g, b);
    const min = Math.min(r, g, b);
    if (max === min) return null;   // a grey has no hue to point at

    const d = max - min;
    const h = max === r ? ((g - b) / d + (g < b ? 6 : 0))
            : max === g ? (b - r) / d + 2
            : (r - g) / d + 4;

    return Math.round(h * 60) % 360;
  }

  function paintHue() {
    const handle = q('[data-hue-handle]') as HTMLElement;
    const strip = q('[data-hue]') as HTMLElement;
    const light = q('[data-hue-proof-light]') as HTMLElement;
    const dark = q('[data-hue-proof-dark]') as HTMLElement;

    if (!handle || !strip) return;

    const chosen = hue !== null;
    handle.hidden = false;
    strip.setAttribute('aria-valuenow', String(hue ?? DEFAULT_HUE));

    const hex = chosen ? hueToHex(hue!) : DEFAULT_STOP_COLOUR;

    handle.style.left = `${((hue ?? DEFAULT_HUE) / 359) * 100}%`;
    if (light) light.style.background = hex;
    if (dark) dark.style.background = hex;

    // The shape cards take the stop's colour, so the choice reads as "this, in
    // the camera".
    (q('[data-shapes]') as HTMLElement)?.style.setProperty('--shape-tint', hex);

    text(q('[data-hue-value]'), chosen ? hex : `${DEFAULT_STOP_COLOUR} · ${S.colourNone}`);
    const badge = q('[data-wiz-pin]') as HTMLElement | null;
    if (badge) badge.style.background = hex;
  }

  const SHAPES = ['pin', 'sphere', 'cone', 'cube', 'sign', 'model'];
  // A spreadsheet row cannot carry a file, so it cannot carry a model.
  const IMPORTABLE = SHAPES.filter((k) => k !== 'model');

  /** The shape the form shows: 'default', empty or unknown all mean the pin. */
  function setShape(key: string | null | undefined) {
    const shape = SHAPES.includes(key ?? '') ? key! : 'pin';
    const radio = form.querySelector(`input[name="shape"][value="${shape}"]`) as HTMLInputElement | null;
    if (radio) radio.checked = true;
    showSignFields();
  }

  function chosenShape(): string {
    return (form.querySelector('input[name="shape"]:checked') as HTMLInputElement | null)?.value ?? 'pin';
  }

  // ------------------------------------------------------------- the model
  // The stop's own 3D model (0055): the row that is saved, a new file waiting to
  // go up with the step, and what the checks found in it.
  let modelRow: any = null;
  let modelFile: File | null = null;
  let modelInfo: GlbInfo | null = null;
  let modelUrl = '';
  let viewer: HTMLElement | null = null;
  const mq = <T extends HTMLElement = HTMLInputElement>(k: string) => q(`[data-model-${k}]`) as unknown as T;
  const LICENCES = ['CC0', 'CC BY 4.0', 'CC BY-SA 4.0'];

  function modelSay(message: string, bad: boolean) {
    const el = mq<HTMLElement>('check');
    el.hidden = !message;
    el.style.color = bad ? 'var(--alert)' : 'var(--ink-dim)';
    text(el, message);
  }

  function problemText(p: GlbProblem) {
    const n = (x: number) => x.toLocaleString(S.lang === 'bg' ? 'bg-BG' : 'en-GB');
    switch (p.kind) {
      case 'tooBig': return S.mdl.tooBig.replace('{0}', megabytes(p.bytes));
      case 'tooManyTriangles': return S.mdl.tooManyTriangles.replace('{0}', n(p.triangles));
      case 'textureTooBig': return S.mdl.textureTooBig.replace('{0}', `${p.width}×${p.height}`);
      case 'compressed': return S.mdl.compressed.replace('{0}', p.extension);
      case 'external': return S.mdl.external;
      case 'noMesh': return S.mdl.noMesh;
      default: return S.mdl.notGlb;
    }
  }

  function summary(bytes: number, triangles: number, animated: boolean) {
    return S.mdl.ok.replace('{0}', megabytes(bytes))
      .replace('{1}', triangles.toLocaleString(S.lang === 'bg' ? 'bg-BG' : 'en-GB'))
      + (animated ? S.mdl.animated : '');
  }

  /** The preview: Google's model-viewer, loaded the first time a model is shown. */
  async function showPreview(url: string) {
    const empty = mq<HTMLElement>('empty');
    if (!url) { viewer?.remove(); viewer = null; empty.hidden = false; return; }
    await import('@google/model-viewer');
    // A new element for each file: changing src on a live one trips an error
    // inside model-viewer's AR part.
    if (viewer && viewer.getAttribute('src') !== url) { viewer.remove(); viewer = null; }
    if (!viewer) {
      viewer = document.createElement('model-viewer');
      for (const [k, v] of [['camera-controls', ''], ['autoplay', ''], ['shadow-intensity', '0.9'], ['loading', 'eager'],
                            ['interaction-prompt', 'none'], ['camera-orbit', '0deg 72deg auto'],
                            ['alt', S.lang === 'bg' ? 'Моделът на спирката' : 'The stop’s model']]) {
        viewer.setAttribute(k, v);
      }
      mq<HTMLElement>('stage').append(viewer);
    }
    empty.hidden = true;
    if (viewer.getAttribute('src') !== url) viewer.setAttribute('src', url);
    turnPreview();
  }

  /** The preview is seen from the south: a model facing south shows its front. */
  function turnPreview() {
    const deg = ((Number(mq('heading').value) || 0) % 360 + 360) % 360;
    viewer?.setAttribute('orientation', `0deg 0deg ${180 - deg}deg`);
    text(mq<HTMLElement>('compass'), ['N', 'NE', 'E', 'SE', 'S', 'SW', 'W', 'NW'][Math.round(deg / 45) % 8]);
  }

  function creditOther() {
    return (form.querySelector('input[name="modelCredit"]:checked') as HTMLInputElement | null)?.value === 'other';
  }
  function showCredit() {
    const box = mq<HTMLElement>('other');
    box.classList.toggle('hidden', !creditOther());
    box.classList.toggle('grid', creditOther());
    mq<HTMLElement>('licence-other-row').classList.toggle('hidden', (mq<HTMLSelectElement>('licence')).value !== 'other');
  }
  function licence() {
    const v = mq<HTMLSelectElement>('licence').value;
    return v === 'other' ? mq('licence-other').value.trim() : v;
  }

  async function loadModel(m: any) {
    modelFile = null; modelInfo = null;
    mq('file').value = '';
    mq('rights').checked = false;
    modelSay('', false);
    const { data } = await client.from('marker_models').select('*').eq('marker_id', m.id).maybeSingle();
    if (selected !== m.id) return;
    modelRow = data ?? null;
    mq('height').value = modelRow ? String(Math.round(modelRow.height_m * 100) / 100) : '';
    mq('heading').value = mq('heading-num').value = String(modelRow?.heading_deg ?? 0);
    const other = modelRow?.credit_source === 'other';
    (form.querySelector(`input[name="modelCredit"][value="${other ? 'other' : 'own'}"]`) as HTMLInputElement).checked = true;
    mq('author').value = modelRow?.credit_author ?? '';
    mq('link').value = modelRow?.credit_link ?? '';
    const lic = modelRow?.credit_licence ?? 'CC0';
    mq<HTMLSelectElement>('licence').value = LICENCES.includes(lic) ? lic : 'other';
    mq('licence-other').value = LICENCES.includes(lic) ? '' : lic;
    showCredit();
    const current = mq<HTMLElement>('current');
    current.hidden = !modelRow;
    if (modelRow) text(current, S.mdl.current.replace('{0}', summary(modelRow.bytes, modelRow.triangles, modelRow.animated)));
    modelUrl = modelRow ? client.storage.from('marker-media').getPublicUrl(modelRow.path).data.publicUrl : '';
    if (chosenShape() === 'model') showPreview(modelUrl);
    else showPreview('');
  }

  function showModelFields() {
    const on = chosenShape() === 'model';
    mq<HTMLElement>('fields').classList.toggle('hidden', !on);
    if (on) showPreview(modelUrl);
  }

  mq('file').addEventListener('change', async () => {
    const input = mq('file');
    const file = input.files?.[0];
    if (!file) return;
    modelSay(S.mdl.checking, false);
    const found = inspectGlb(await file.arrayBuffer());
    if (!found.ok) {
      input.value = ''; modelFile = null; modelInfo = null;
      modelSay(problemText(found.problem), true);
      return;
    }
    modelFile = file; modelInfo = found.info;
    modelSay(summary(file.size, found.info.triangles, found.info.animated), false);
    // Its own size, if it was made at a size that makes sense in a street.
    const h = found.info.height;
    mq('height').value = String(h >= 0.2 && h <= 10 ? Math.round(h * 10) / 10 : 1);
    if (modelUrl.startsWith('blob:')) URL.revokeObjectURL(modelUrl);
    modelUrl = URL.createObjectURL(file);
    showPreview(modelUrl);
  });
  mq('heading').addEventListener('input', () => { mq('heading-num').value = mq('heading').value; turnPreview(); });
  mq('heading-num').addEventListener('input', () => { mq('heading').value = mq('heading-num').value; turnPreview(); });
  form.querySelectorAll('input[name="modelCredit"]').forEach((r) => r.addEventListener('change', showCredit));
  mq<HTMLSelectElement>('licence').addEventListener('change', showCredit);

  /** What is still missing before the model can be saved, or nothing. */
  function modelProblem(): string {
    if (!modelRow && !modelFile) return S.mdl.need;
    const h = Number(mq('height').value);
    if (!(h >= 0.2 && h <= 10)) return S.lang === 'bg' ? 'Височината е между 0,2 и 10 m.' : 'The height is between 0.2 and 10 m.';
    if (creditOther() && (!mq('author').value.trim() || !licence() || !/^https:\/\/\S+$/.test(mq('link').value.trim()))) return S.mdl.needCredit;
    if (modelFile && !mq('rights').checked) return S.mdl.needRights;
    return '';
  }

  /** Uploads a new file if there is one, then writes the row. Null when it worked. */
  async function saveModel(markerId: string): Promise<string | null> {
    const old: string | undefined = modelRow?.path;
    let path = old;
    if (modelFile) {
      modelSay(S.mdl.uploading, false);
      path = `${worldId}/${markerId}/model-${crypto.randomUUID()}.glb`;
      // Typed here: a .glb picked on Windows comes with no type at all, and
      // storage refuses application/octet-stream.
      const body = new Blob([modelFile], { type: 'model/gltf-binary' });
      const up = await client.storage.from('marker-media').upload(path, body, { contentType: 'model/gltf-binary', upsert: false });
      if (up.error) { modelSay('', false); return up.error.message; }
    }
    const other = creditOther();
    const row = {
      marker_id: markerId,
      path,
      triangles: modelInfo?.triangles ?? modelRow.triangles,
      animated: modelInfo?.animated ?? modelRow.animated,
      height_m: Number(mq('height').value),
      heading_deg: ((Math.round(Number(mq('heading').value)) || 0) % 360 + 360) % 360,
      credit_source: other ? 'other' : 'own',
      credit_author: other ? mq('author').value.trim() : null,
      credit_licence: other ? licence() : null,
      credit_link: other ? mq('link').value.trim() : null,
    };
    const { data, error } = await client.from('marker_models').upsert(row, { onConflict: 'marker_id' }).select().single();
    if (error) {
      if (modelFile && path && path !== old) await client.storage.from('marker-media').remove([path]);
      modelSay('', false);
      return error.message;
    }
    // The new file is in; the one it replaced goes.
    if (modelFile && old && old !== path) await client.storage.from('marker-media').remove([old]);
    modelRow = data;
    modelFile = null; modelInfo = null;
    mq('file').value = '';
    mq('rights').checked = false;
    modelSay('', false);
    const current = mq<HTMLElement>('current');
    current.hidden = false;
    text(current, S.mdl.current.replace('{0}', summary(data.bytes, data.triangles, data.animated)));
    loadUsage();
    return null;
  }

  function showSignFields() {
    showModelFields();
    const sign = chosenShape() === 'sign';
    const box = q('[data-sign-fields]') as HTMLElement | null;
    box?.classList.toggle('hidden', !sign);
    box?.classList.toggle('grid', sign);
  }

  form.querySelectorAll('input[name="shape"]').forEach((r) => r.addEventListener('change', showSignFields));

  function hueFromEvent(event: PointerEvent | MouseEvent) {
    const strip = q('[data-hue]') as HTMLElement;
    const box = strip.getBoundingClientRect();
    const across = Math.min(Math.max(event.clientX - box.left, 0), box.width);

    hue = Math.round((across / Math.max(box.width, 1)) * 359);
    dirty = true;
    paintHue();
  }

  q('[data-hue]')?.addEventListener('pointerdown', (event) => {
    const strip = event.currentTarget as HTMLElement;
    strip.setPointerCapture((event as PointerEvent).pointerId);
    hueFromEvent(event as PointerEvent);
  });

  q('[data-hue]')?.addEventListener('pointermove', (event) => {
    // Only while dragging. buttons is a bitmask and zero means the pointer is
    // over the strip rather than pressed on it.
    if ((event as PointerEvent).buttons !== 0) hueFromEvent(event as PointerEvent);
  });

  // Arrow keys, because a slider that only takes a pointer is not a slider.
  q('[data-hue]')?.addEventListener('keydown', (event) => {
    const key = (event as KeyboardEvent).key;
    const step = key === 'ArrowLeft' ? -5 : key === 'ArrowRight' ? 5 : 0;
    if (!step) return;

    event.preventDefault();
    hue = ((hue ?? DEFAULT_HUE) + step + 360) % 360;
    dirty = true;
    paintHue();
  });

  // ------------------------------------------------------------------ import
  //
  // A spreadsheet is the fastest way anybody has ever entered forty fields, and
  // the builder was asking for them five tabs at a time. One row is one stop.
  //
  // Tab-separated as well as comma-separated, because pasting straight out of
  // Excel gives tabs and telling somebody to "save as CSV first" is a step that
  // exists only to make the parser's life easier.

  const IMPORT_COLUMNS = [
    'name_bg', 'name_en', 'text_bg', 'text_en', 'lat', 'lng', 'radius_m',
    'question_bg', 'question_en', 'kind', 'accepted', 'points',
    'on_wrong', 'deduct', 'wait_seconds', 'hint_bg', 'hint_en', 'hint_cost',
    // Optional, last, so a sheet made before shapes existed still imports.
    'shape', 'sign_bg', 'sign_en',
  ];

  const KINDS = ['none', 'exact', 'choice', 'free'];
  const RULES = ['retry', 'lock', 'deduct', 'skip'];

  /**
   * Splits one delimited line, honouring quotes.
   *
   * Written out rather than pulled in: a CSV library is forty kilobytes to
   * handle a quote and a doubled quote, and those are the only two rules a
   * spreadsheet export actually uses.
   */
  function splitLine(line: string, sep: string): string[] {
    const out: string[] = [];
    let field = '';
    let quoted = false;

    for (let i = 0; i < line.length; i++) {
      const ch = line[i];

      if (quoted) {
        if (ch === '"') {
          if (line[i + 1] === '"') { field += '"'; i++; }
          else quoted = false;
        } else field += ch;
      } else if (ch === '"') {
        quoted = true;
      } else if (ch === sep) {
        out.push(field); field = '';
      } else field += ch;
    }

    out.push(field);
    return out.map((f) => f.trim());
  }

  function parseSheet(raw: string) {
    const lines = raw.replace(/\r\n?/g, '\n').split('\n').filter((l) => l.trim().length);
    if (lines.length === 0) return { error: S.impNoHeader, rows: [] as any[] };

    // Whichever the header line has more of. A name with a comma in it is
    // common; a name with a tab in it is not.
    const sep = (lines[0].split('\t').length > lines[0].split(',').length) ? '\t' : ',';
    const header = splitLine(lines[0], sep).map((h) => h.toLowerCase());

    if (!header.includes('name_bg') || !header.includes('lat')) {
      return { error: S.impNoHeader, rows: [] as any[] };
    }
    if (lines.length === 1) return { error: S.impNoRows, rows: [] as any[] };

    const rows = lines.slice(1).map((line, i) => {
      const cells = splitLine(line, sep);
      const row: Record<string, string> = {};
      header.forEach((h, c) => { row[h] = cells[c] ?? ''; });
      return { line: i + 2, row };
    });

    return { error: null as string | null, rows };
  }

  /** Everything wrong with one row, in the creator's language. */
  function checkRow(row: Record<string, string>, existing: Set<string>) {
    const problems: string[] = [];
    const name = (row.name_bg ?? '').trim();

    if (!name) problems.push(S.impNeedName);
    else if (existing.has(name.toLowerCase())) problems.push(S.impDupe);

    const lat = Number(row.lat);
    const lng = Number(row.lng);
    if (!Number.isFinite(lat) || !Number.isFinite(lng)
        || Math.abs(lat) > 90 || Math.abs(lng) > 180) {
      problems.push(S.impBadCoords);
    }

    const kind = (row.kind ?? '').trim().toLowerCase() || 'none';
    if (!KINDS.includes(kind)) problems.push(S.impBadKind);
    if (kind === 'exact' && !(row.accepted ?? '').trim()) problems.push(S.impNeedAccepted);

    const rule = (row.on_wrong ?? '').trim().toLowerCase() || 'retry';
    if (!RULES.includes(rule)) problems.push(S.impBadOnWrong);

    const shape = (row.shape ?? '').trim().toLowerCase() || 'pin';
    if (shape === 'model') problems.push(S.mdl.imp);
    else if (!IMPORTABLE.includes(shape)) problems.push(S.impBadShape);
    if ((row.sign_bg ?? '').trim().length > 80 || (row.sign_en ?? '').trim().length > 80) {
      problems.push(S.impLongSign);
    }

    return problems;
  }

  let checked: { line: number; row: Record<string, string> }[] = [];

  function impStatus(message: string) {
    text(q('[data-imp-status]'), message);
  }

  q('[data-imp-template]')?.addEventListener('click', () => {
    // One header row and one filled-in example, because an empty template
    // leaves somebody guessing what "exact" or "lock" are supposed to look like.
    const example = [
      'Безистенът', 'The Bezisten', 'Покрит пазар от 15 век', 'A covered market',
      '42.48412', '26.50598', '25',
      'Кой век?', 'Which century?', 'exact', '15,XV,петнайсети', '40',
      'lock', '0', '60', 'Погледни над вратата', 'Look above the door', '5',
      'sign', 'Безистенът · 1509–1510', 'The Bezisten · 1509–1510',
    ];
    const csv = IMPORT_COLUMNS.join(',') + '\n'
      + example.map((v) => (v.includes(',') ? `"${v}"` : v)).join(',') + '\n';

    const url = URL.createObjectURL(new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8' }));
    const a = document.createElement('a');
    a.href = url;
    a.download = 'artrail-stops.csv';
    a.click();
    URL.revokeObjectURL(url);
  });

  (q('[data-imp-file]') as HTMLInputElement)?.addEventListener('change', async (event) => {
    const file = (event.target as HTMLInputElement).files?.[0];
    if (!file) return;
    (q('[data-imp-text]') as HTMLTextAreaElement).value = await file.text();
  });

  q('[data-imp-check]')?.addEventListener('click', () => {
    const raw = (q('[data-imp-text]') as HTMLTextAreaElement).value;
    const report = q('[data-imp-report]')!;
    const go = q('[data-imp-go]') as HTMLButtonElement;

    checked = [];
    report.innerHTML = '';
    go.classList.add('hidden');

    const parsed = parseSheet(raw);
    if (parsed.error) { impStatus(parsed.error); return; }

    // Names already on the trail, so a second paste of the same sheet is caught
    // rather than doubling every stop.
    const existing = new Set(
      markers.map((m: any) => (m.content?.bg?.title ?? '').trim().toLowerCase()).filter(Boolean));

    const bad: string[] = [];

    for (const entry of parsed.rows) {
      const problems = checkRow(entry.row, existing);

      if (problems.length) {
        bad.push(`${S.impRow.replace('{0}', String(entry.line))}: ${problems.join(' · ')}`);
      } else {
        checked.push(entry);
        // A duplicate inside the sheet itself counts too.
        existing.add((entry.row.name_bg ?? '').trim().toLowerCase());
      }
    }

    report.innerHTML = bad
      .map((b) => `<li class="text-[var(--alert)]">${escapeHtml(b)}</li>`).join('');

    impStatus(`${S.impReady.replace('{0}', String(checked.length))}`
      + (bad.length ? ` · ${S.impProblems.replace('{0}', String(bad.length))}` : ''));

    if (checked.length) {
      text(go, S.impImport.replace('{0}', String(checked.length)));
      go.classList.remove('hidden');
    }
  });

  q('[data-imp-go]')?.addEventListener('click', async (event) => {
    const go = event.currentTarget as HTMLButtonElement;
    go.disabled = true;
    impStatus(S.impImporting);

    let made = 0;
    const failed: string[] = [];

    for (const entry of checked) {
      const r = entry.row;
      const kind = (r.kind ?? '').trim().toLowerCase() || 'none';

      const content: Record<string, any> = {
        bg: { title: r.name_bg.trim(), ...(r.text_bg?.trim() && { body: r.text_bg.trim() }) },
      };
      if (r.name_en?.trim() || r.text_en?.trim()) {
        content.en = {
          ...(r.name_en?.trim() && { title: r.name_en.trim() }),
          ...(r.text_en?.trim() && { body: r.text_en.trim() }),
        };
      }
      if (kind !== 'none') {
        if (r.question_bg?.trim()) content.bg.question = r.question_bg.trim();
        if (r.question_en?.trim()) {
          content.en = { ...(content.en ?? {}), question: r.question_en.trim() };
        }
      }

      const shape = (r.shape ?? '').trim().toLowerCase() || 'pin';
      if (shape === 'sign') {
        if (r.sign_bg?.trim()) content.bg.sign = r.sign_bg.trim();
        if (r.sign_en?.trim()) content.en = { ...(content.en ?? {}), sign: r.sign_en.trim() };
      }

      const placed = await client.rpc('place_marker', {
        p_world: worldId, p_lat: Number(r.lat), p_lng: Number(r.lng),
        p_content: content, p_status: 'published', p_style_key: shape,
      });

      const id = Array.isArray(placed.data) ? placed.data[0]?.id : (placed.data as any)?.id;

      if (placed.error || !id) {
        failed.push(`${S.impRow.replace('{0}', String(entry.line))}: `
          + (placed.error?.message ?? S.impFailed));
        continue;
      }

      const radius = Number(r.radius_m);
      if (Number.isFinite(radius) && radius > 0) {
        await client.from('markers').update({ radius_m: radius }).eq('id', id);
      }

      if (kind !== 'none') {
        const accepted = (r.accepted ?? '').split(',').map((x) => x.trim()).filter(Boolean);
        const answer = await client.rpc('set_marker_answer', {
          p_marker: id,
          p_kind: kind,
          p_accepted: kind === 'exact' ? accepted : null,
          p_points: Number(r.points) || 10,
          p_cooldown_seconds: Number(r.wait_seconds) || null,
          p_on_wrong: (r.on_wrong ?? '').trim().toLowerCase() || 'retry',
          p_deduct_points: Number(r.deduct) || 0,
        });

        if (answer.error) {
          failed.push(`${S.impRow.replace('{0}', String(entry.line))}: ${answer.error.message}`);
        }
      }

      const hintBg = (r.hint_bg ?? '').trim();
      const hintEn = (r.hint_en ?? '').trim();

      if (hintBg || hintEn) {
        await client.from('marker_hints').insert({
          marker_id: id, ord: 1, cost: Number(r.hint_cost) || 0,
          body: { ...(hintBg && { bg: hintBg }), ...(hintEn && { en: hintEn }) },
        });
      }

      made++;
    }

    q('[data-imp-report]')!.innerHTML = failed
      .map((f) => `<li class="text-[var(--alert)]">${escapeHtml(f)}</li>`).join('');

    impStatus(S.impDone.replace('{0}', String(made)).replace('{1}', String(failed.length)));

    checked = [];
    go.classList.add('hidden');
    go.disabled = false;
    (q('[data-imp-text]') as HTMLTextAreaElement).value = '';

    await load();
  });
</script>

<style>
  /* ------------------------------------------------------------ the steps */
  .wiz {
    /* clip, not hidden: hidden would make the form its own scroller and the
