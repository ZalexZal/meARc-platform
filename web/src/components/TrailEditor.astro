---
import Loading from './Loading.astro';
import AppShot from './AppShot.astro';
import { useTranslations, localise, type Lang } from '../i18n/ui';
import { CATEGORIES, categoryLabel } from '../lib/work';
import BecomeCreator from './BecomeCreator.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const href = localise(lang);

/**
 * The stop editor, in steps.
 *
 * It was one column of eighteen fields, then five tabs with one Save button,
 * and in both a creator had to find the parts for themselves. Now the same five
 * parts come in order - Basics, Place, Question, Hints, Media - with Previous
 * and Next, each step saved as it is left. Question and Hints can be skipped,
 * because a plain tour has neither.
 *
 * The map and the stop list stay outside the steps. They are how you choose
 * what you are editing, so they cannot live inside one of the things chosen.
 */
// 8 Nov 2026: the 3D visual got its own step, second, so the AI that makes
// models is in plain view; hints moved under the question they help with.
const steps = [
  { id: 'basics',   label: t('tab.basics'),   sub: t('wiz.basics.sub') },
  { id: 'visual',   label: t('tab.visual'),   sub: t('wiz.visual.sub') },
  { id: 'place',    label: t('tab.place'),    sub: t('wiz.place.sub') },
  { id: 'question', label: t('tab.question'), sub: t('wiz.optional') },
  { id: 'media',    label: t('tab.media'),    sub: t('wiz.media.sub') },
];

// What a stop asks, as four choices rather than a dropdown: the choice decides
// which half of the step is shown, so it should be seen whole.
const kinds = [
  { value: 'none',   label: t('ed.answerNone'),   body: t('wiz.kind.none') },
  { value: 'exact',  label: t('ed.answerExact'),  body: t('wiz.kind.exact') },
  { value: 'choice', label: t('ed.answerChoice'), body: t('wiz.kind.choice') },
  { value: 'free',   label: t('ed.answerFree').split(' (')[0], body: t('wiz.kind.free') },
];

/**
 * What stands in the street at a stop. The keys are the ones the database
 * accepts (0054) and the app has a prefab for; 'pin' is also what 'default'
 * and an empty value mean. Drawn in currentColor so each card is the stop's
 * own colour once one is picked.
 */
// The five a creator picks from (8 Nov 2026). Sphere and cone are gone from
// the picker; stops that already use them keep them (see setShape).
const shapes = [
  { key: 'pin', label: t('ed.shape.pin'),
    svg: '<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M16 29s-8-8.6-8-15a8 8 0 1 1 16 0c0 6.4-8 15-8 15Z" fill="currentColor" fill-opacity=".25"/><circle cx="16" cy="14" r="3"/></svg>' },
  { key: 'cube', label: t('ed.shape.cube'),
    svg: '<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M16 6 26 11v11l-10 5-10-5V11l10-5Z" fill="currentColor" fill-opacity=".25"/><path d="M6 11l10 5 10-5M16 16v11"/></svg>' },
  { key: 'sign', label: t('ed.shape.sign'),
    svg: '<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="24" height="14" rx="2" fill="currentColor" fill-opacity=".25"/><path d="M9 9h14M9 13h9M16 18v11"/></svg>' },
  // A model made by AI from photos, a video or a description. Saved as 'model'.
  { key: 'ai', label: t('ed.shape.ai'), ai: true,
    svg: '<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M14 4l2.4 6.2L22.6 12.6l-6.2 2.4L14 21.2l-2.4-6.2L5.4 12.6l6.2-2.4L14 4Z" fill="currentColor" fill-opacity=".25"/><path d="M24 19l1.2 3 3 1.2-3 1.2L24 27.4l-1.2-3-3-1.2 3-1.2L24 19Z"/></svg>' },
  // The creator's own model: a .glb or .stl they made or may share (0055).
  { key: 'model', label: t('ed.shape.model'),
    svg: '<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M16 3.5 26.5 9.5v13L16 28.5 5.5 22.5v-13L16 3.5Z" fill="currentColor" fill-opacity=".12"/><path d="M5.5 9.5 16 15.5l10.5-6M16 15.5v13"/></svg>' },
];

const strings = {
  saveFailed: t('err.generic'),
  lang,
  shapeLegacy: t('ed.shapeLegacy'),
  shapeNames: { sphere: t('ed.shape.sphere'), cone: t('ed.shape.cone') },
  ai: {
    toEn: t('ai.toEn'), toBg: t('ai.toBg'), working: t('ai.working'), done: t('ai.done'),
    nothing: t('ai.nothing'), quota: t('ai.quota'), failed: t('ai.failed'), notReady: t('ai.notReady'),
  },
  setOneByOne: t('ed.setOneByOne'), teamSize: t('ed.teamSize'), start: t('ed.start'),
  deleteConfirm: t('ed.deleteConfirm'), deleteNotOwner: t('ed.deleteNotOwner'),
  saved: t('ed.saved'), saving: t('ed.saving'),
  notYours: t('ed.notYours'), draft: t('ed.draft'), published: t('ed.published'),
  publish: t('ed.publish'), unpublish: t('ed.unpublish'),
  accept: t('ed.accept'), reject: t('ed.reject'), you: t('board.you'),
  rank: t('board.rank'), team: t('board.team'), bPoints: t('board.points'),
  bSolved: t('board.solved'), time: t('board.time'),
  overlap: t('ed.overlap'), remove: t('ed.remove'), hintCost: t('ed.hintCost'),
  uploading: t('ed.uploading'), tooBig: t('ed.tooBig'),
  mediaUsed: t('ed.mediaUsed'), mediaFull: t('ed.mediaFull'),
  mediaWontFit: t('ed.mediaWontFit'),
  reorderFailed: t('ed.reorderFailed'),
  teamSizeHint: t('ed.teamSizeHint'),
  impNoHeader: t('imp.noHeader'), impNoRows: t('imp.noRows'),
  impNeedName: t('imp.needName'), impBadCoords: t('imp.badCoords'),
  impBadKind: t('imp.badKind'), impNeedAccepted: t('imp.needAccepted'),
  impBadOnWrong: t('imp.badOnWrong'), impDupe: t('imp.dupe'),
  impBadShape: t('imp.badShape'), impLongSign: t('imp.longSign'),
  impRow: t('imp.row'), impReady: t('imp.ready'), impProblems: t('imp.problems'),
  impImport: t('imp.import'), impImporting: t('imp.importing'),
  impDone: t('imp.done'), impFailed: t('imp.failed'),
  lvDraft: t('vis.private'), lvDraftHint: t('vis.privateHint'),
  lvCode: t('vis.unlisted'), lvCodeHint: t('vis.unlistedHint'),
  lvPublic: t('vis.public'), lvPublicHint: t('vis.publicHint'),
  lvAsk: t('vis.publicAsk'), lvAskHint: t('vis.publicAskHint'),
  lvWaiting: t('mine.pending'), lvWaitingBody: t('mine.pendingBody'),
  lvNote: t('mine.reviewNote'), copy: t('pub.copy'), copied: t('pub.copied'),
  colourNone: t('ed.colourNone'), pubDrafts: t('pub.drafts'),
  miss: {
    title: t('miss.title'), optional: t('miss.optional'), titleBg: t('miss.titleBg'),
    titleEn: t('miss.titleEn'), place: t('miss.place'), question: t('miss.question'),
    choice: t('miss.choice'), accepted: t('miss.accepted'),
  },
  revealOff: t('ed.revealOff'),
  hiddenQuestions: t('ed.hiddenQuestions'),
  plain: { editorsLede: t('ed.editorsLedePlain'), deleteBody: t('ed.deleteBodyPlain'), tip3: t('ed.tip3Plain') },
  categories: Object.fromEntries(CATEGORIES.map((c) => [c, categoryLabel(c, lang)])),
  boardHref: href('/board'),
  hidden: t('board.hidden'), revBlock: t('rev.block'), revBlockConfirm: t('rev.blockConfirm'),
  ownerWord: t('ed.owner'), editorWord: t('ed.editor'), leaveConfirm: t('ed.leaveConfirm'),
  here: t('ed.here'), conflict: t('ed.conflict'), inviteHref: href('/editor-invite'),
  myTrailsHref: href('/my-trails'),
  mdl: {
    checking: t('mdl.checking'), ok: t('mdl.ok'), animated: t('mdl.animated'),
    notGlb: t('mdl.notGlb'), tooBig: t('mdl.tooBig'), tooManyTriangles: t('mdl.tooManyTriangles'),
    textureTooBig: t('mdl.textureTooBig'), compressed: t('mdl.compressed'), external: t('mdl.external'),
    noMesh: t('mdl.noMesh'), current: t('mdl.current'), need: t('mdl.need'), needRights: t('mdl.needRights'),
    needCredit: t('mdl.needCredit'), uploading: t('mdl.uploading'), imp: t('imp.model'),
    stl: t('mdl.stl'), stlBad: t('mdl.stlBad'), choose: t('mdl.choose'),
  },
  ai3d: {
    picture: t('ai3d.picture'), model: t('ai3d.model'), server: t('ai3d.server'), done: t('ai3d.done'),
    quota: t('ai3d.quota'), allowance: t('ai3d.allowance'), busy: t('ai3d.busy'), down: t('ai3d.down'), failed: t('ai3d.failed'),
    signin: t('ai3d.signin'), notReady: t('ai3d.notReady'), pick: t('ai3d.pick'),
    shapes: t('ai3d.shapes'), lowpoly: t('ai3d.lowpoly'), emptyStage: t('ai3d.emptyStage'), needInput: t('ai3d.needInput'), frames: t('ai3d.frames'), videoBad: t('ai3d.videoBad'),
  },
  wiz: {
    next: t('wiz.next'), done: t('wiz.done'), saved: t('wiz.saved'), skipped: t('wiz.skipped'),
    of: t('wiz.of'), newStop: t('wiz.newStop'), stop: t('wiz.stop'), untitled: t('wiz.untitled'),
    ready: t('wiz.ready'), skippedList: t('wiz.skippedList'),
    names: Object.fromEntries(steps.map((st) => [st.id, st.label])),
  },
};
---

<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6" hidden data-guarded>
  <!-- A viewer is never kept out of a trail they own or edit; they are told
       where the tools for their line of work are, once, at the top. -->
  <aside class="viewer-notice" hidden data-viewer-notice>
    <p>{t('role.viewerNotice')}</p>
    <button type="button" class="btn btn-primary btn-sm" data-become-open>{t('role.become')}</button>
  </aside>
  <dialog class="become-dialog" data-become-dialog aria-label={t('role.become')}>
    <BecomeCreator lang={lang} />
    <button type="button" class="btn btn-ghost btn-sm become-close" data-become-close>{t('mod.close')}</button>
  </dialog>
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div class="min-w-0">
      <a class="eyebrow hover:text-[var(--ink)]" href={href('/my-trails')}>← {t('nav.mine')}</a>
      <h1 class="mt-2 truncate text-2xl sm:text-3xl" data-trail-name></h1>
      <p class="mt-1 flex flex-wrap items-center gap-x-3 text-xs">
        <span class="eyebrow" data-trail-mode></span>
        <span class="eyebrow trail-status" data-trail-status></span>
      </p>
      <p class="mt-2 hidden max-w-md text-sm text-[var(--ink-dim)]" data-you-edit>{t('ed.youEdit')}</p>
      <!-- Who else has this trail open right now. Realtime presence: gone the
           moment their tab closes, and never stored anywhere. -->
      <p class="mt-2 hidden flex-wrap items-center gap-1.5 text-xs text-[var(--ink-dim)]" data-presence></p>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <div class="card flex flex-wrap items-center gap-x-2 gap-y-1 px-3 py-2">
        <span class="eyebrow">{t('ed.code')}</span>
        <code class="code text-xl font-medium uppercase tracking-widest text-[var(--signal)]"
              data-trail-code></code>
        <button class="btn btn-ghost btn-sm" type="button" data-copy-code>{t('pub.copy')}</button>
        <button class="text-xs text-[var(--ink-faint)] underline-offset-2 hover:text-[var(--ink)] hover:underline"
                type="button" data-rotate data-owner-only title={t('ed.rotateHint')}>{t('ed.rotate')}</button>
      </div>
      <!-- The same three rungs My trails offers. There used to be a Publish
           button here that wrote the same two columns with different words, so a
           trail could be "published" on one screen and "only me" on the other,
           and both were telling the truth about a different column. -->
      <div data-owner-only>
        <div class="tabs" data-levels>
          <button class="tab" type="button" data-level="draft">{t('vis.private')}</button>
          <button class="tab" type="button" data-level="code">{t('vis.unlisted')}</button>
          <button class="tab" type="button" data-level="public"></button>
        </div>
        <p class="mt-1.5 max-w-xs text-xs text-[var(--ink-faint)]" data-level-hint></p>
        <p class="mt-1.5 hidden max-w-xs text-xs text-[var(--lamp)]" data-level-note></p>
      </div>
    </div>
  </header>

  <!-- The trail in four tabs (design scan, 6 Nov 2026). It was one long page:
       the stops, then editors, review, standings and delete, all at once. -->
  <nav class="tabs ed-tabs mt-6" role="tablist" aria-label={t('ed.stops')} data-ed-tabs>
    <button class="tab" type="button" role="tab" data-ed-tab="stops">{t('ed.stops')}</button>
    <button class="tab" type="button" role="tab" data-ed-tab="share">{lang === 'bg' ? 'Споделяне' : 'Sharing'}</button>
    <button class="tab" type="button" role="tab" data-ed-tab="results">{lang === 'bg' ? 'Резултати' : 'Results'}</button>
    <button class="tab" type="button" role="tab" data-ed-tab="settings" data-owner-only>{lang === 'bg' ? 'Настройки' : 'Settings'}</button>
  </nav>

  <!-- The settings a trail has once, grouped and explained in the open. They
       were five small boxes in the header with their help in tooltips, which
       a phone never shows. A setting this trail cannot use is not drawn. -->
  <details class="card trail-settings mt-6" data-owner-only data-settings data-ed-panel="settings" open>
    <summary>
      <span class="font-semibold">{t('ed.settings')}</span>
      <span class="text-xs text-[var(--ink-dim)]" data-settings-sum></span>
    </summary>
    <div class="trail-settings-grid">
      <div class="set-group" data-reveal-row>
        <p class="eyebrow">{t('ed.setHow')}</p>
        <label class="set-check">
          <input type="checkbox" data-reveal />
          <span>{t('ed.reveal')}</span>
        </label>
        <p class="set-hint">{t('ed.revealHint')}</p>
      </div>
      <div class="set-group" data-team-row>
        <p class="eyebrow">{t('ed.teamSize')}</p>
        <input class="field data w-24" data-team-size inputmode="numeric" maxlength="2" aria-label={t('ed.teamSize')} />
        <p class="set-hint">{t('ed.teamSizeHint')}</p>
      </div>
      <div class="set-group" data-start-row>
        <p class="eyebrow">{t('ed.start')}</p>
        <div class="flex flex-wrap gap-2">
          <select class="field w-auto" data-start-mode aria-label={t('ed.start')}>
            <option value="none">{t('ed.startNone')}</option>
            <option value="manual">{t('ed.startManual')}</option>
            <option value="auto">{t('ed.startAuto')}</option>
          </select>
          <input type="datetime-local" class="field w-auto" data-start-at hidden aria-label={t('ed.startAuto')} />
        </div>
        <p class="set-hint">{t('ed.startHint')}</p>
      </div>
      <!-- What the trail is and where (classification, 9 Nov 2026). The city
           finds itself from the first stop until a person types one. -->
      <div class="set-group">
        <p class="eyebrow">{t('cat.label')}</p>
        <select class="field w-auto" data-category aria-label={t('cat.label')}>
          {CATEGORIES.map((c) => <option value={c}>{categoryLabel(c, lang)}</option>)}
        </select>
      </div>
      <div class="set-group">
        <p class="eyebrow">{t('city.label')}</p>
        <input class="field" data-city list="known-cities" maxlength="80" autocomplete="off"
               placeholder={t('city.none')} aria-label={t('city.label')} />
        <datalist id="known-cities" data-known-cities></datalist>
        <p class="set-hint" data-city-auto hidden>{t('city.auto')}</p>
        <p class="set-hint" data-city-hint>{t('city.hint')}</p>
      </div>
    </div>
  </details>

  <div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)]" data-ed-panel="stops">
    <!-- Choosing what to edit. Outside the tabs, because this is how a stop
         gets picked and it cannot live inside one of the things being picked. -->
    <div class="lg:sticky lg:top-20 lg:self-start">
      <div class="card overflow-hidden" style="padding:0">
        <div class="h-[340px] w-full sm:h-[420px]" data-map></div>
      </div>
      <p class="mt-2 text-xs text-[var(--ink-faint)]">{t('ed.placeHint')}</p>

      <p class="mt-3 hidden rounded-lg border border-[var(--lamp)] bg-[var(--lamp-wash)] px-3 py-2 text-xs text-[var(--lamp)]"
         data-overlap></p>

      <h2 class="mt-6 text-sm font-semibold">
        {t('ed.stops')} <span class="data text-[var(--ink-faint)]" data-stop-count></span>
      </h2>
      <p class="mt-2 text-sm text-[var(--ink-dim)]" data-stops-empty hidden>{t('ed.noStops')}</p>
      <ul class="mt-2 space-y-1.5" data-stops></ul>

      <!-- Eight stops with a question each is forty fields typed into five tabs.
           A creator who already has them in a spreadsheet should not have to. -->
      <details class="card mt-6 p-4" data-import>
        <summary class="cursor-pointer text-sm font-semibold">{t('imp.title')}</summary>

        <p class="mt-3 text-xs text-[var(--ink-dim)]">{t('imp.lede')}</p>

        <button class="btn btn-quiet btn-sm mt-3" type="button" data-imp-template>
          {t('imp.template')}
        </button>

        <label class="field-row mt-4">
          <span class="field-name">{t('imp.paste')}</span>
          <textarea class="field data" rows="5" data-imp-text
                    placeholder="name_bg	name_en	text_bg	..."></textarea>
        </label>

        <label class="field-row mt-3">
          <span class="field-name">{t('imp.file')}</span>
          <input class="field" type="file" accept=".csv,text/csv" data-imp-file />
        </label>

        <div class="mt-3 flex flex-wrap gap-2">
          <button class="btn btn-quiet btn-sm" type="button" data-imp-check>{t('imp.check')}</button>
          <button class="btn btn-primary btn-sm hidden" type="button" data-imp-go></button>
          <span class="self-center text-xs text-[var(--ink-dim)]" data-imp-status></span>
        </div>

        <ul class="mt-3 space-y-1 text-xs" data-imp-report></ul>
      </details>
    </div>

    <div>
      <!-- Nothing chosen yet: how to start, and what a visitor will see,
           instead of one line in an empty box (website sweep, 7 Nov 2026). -->
      <div class="card start-card" data-no-selection>
        <div>
          <h2 class="text-lg">{t('ed.selectStop')}</h2>
          <ol class="start-tips">
            <li><span>1</span>{t('ed.tip1')}</li>
            <li><span>2</span>{t('ed.tip2')}</li>
            <li data-tip3><span>3</span>{t('ed.tip3')}</li>
          </ol>
        </div>
        <figure class="start-shot">
          <AppShot name="sheet" alt="" />
          <figcaption>{t('ed.tipShot')}</figcaption>
        </figure>
      </div>

      <!-- The stop, one question at a time. It was five tabs and a Save button;
           a creator who had not opened the fourth tab never knew it was there.
           The steps come in order, each saved as it is left, and the two that a
           plain tour does not need can be skipped. Since 30 October any step
           can be opened at any time, as in YambolTrails' builder, and "Still
           missing" at the top says what the stop needs before it is ready. -->
      <form class="wiz hidden" data-marker-form novalidate>
        <div class="wiz-top">
          <div class="wiz-id">
            <span class="wiz-pin data" data-wiz-pin>1</span>
            <div class="min-w-0 flex-1">
              <p class="eyebrow" data-wiz-kind>{t('wiz.newStop')}</p>
              <h2 class="wiz-title" data-wiz-title></h2>
            </div>
            <span class="data wiz-count" data-wiz-count></span>
          </div>

          <ol class="stepper" aria-label={t('wiz.newStop')}>
            {steps.map((st, i) => (
              <li>
                <button type="button" class="st" data-step={st.id}>
                  <span class="st-bar" aria-hidden="true"></span>
                  <span class="st-row">
                    <span class="st-n" aria-hidden="true">
                      <span class="st-num">{i + 1}</span>
                      <svg class="st-check" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-10" /></svg>
                    </span>
                    <span class="st-l">{st.label}</span>
                    {st.id === 'question' && <span class="data st-count" data-count-hints></span>}
                    {st.id === 'media' && <span class="data st-count" data-count-media></span>}
                  </span>
                  <span class="st-sub" data-step-sub data-sub={st.sub}>{st.sub}</span>
                </button>
              </li>
            ))}
          </ol>
        </div>

        <div class="note note-lamp mx-5 mt-4 hidden flex-wrap items-center justify-between gap-3 text-sm sm:mx-6" data-remote-change role="status">
          <span>{t('ed.changed')}</span>
          <button type="button" class="btn btn-quiet btn-sm" data-remote-reload>{t('ed.reload')}</button>
        </div>

        <div class="wiz-body">
          <!-- What the stop still needs, each linked to its field. Required items
               are exactly what saving checks; the second language is optional. -->
          <div class="missing" data-missing hidden role="status">
            <p class="missing-title">{t('miss.title')}</p>
            <ul data-missing-list></ul>
          </div>

          <!-- 1 · The basics: words only. -->
          <div class="pane" data-panel="basics">
            <header class="pane-head">
              <h3>{t('wiz.basics.title')}</h3>
              <p>{t('wiz.basics.lede')}</p>
            </header>
            <!-- AI translation of the whole stop in one go (7 Nov 2026): only
                 the empty fields of the other language are filled, and the
                 creator reads them before saving. -->
            <div class="ai-row">
              <button class="btn btn-quiet btn-sm" type="button" data-ai-translate>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h8M8 3v2M6 5c0 4 2.5 7 6 8M10 5c0 3-2 6-6 8M13 21l4-9 4 9M14.5 18h5"/></svg>
                <span data-ai-label>{t('ai.toEn')}</span>
              </button>
              <p class="ai-say" data-ai-say aria-live="polite"></p>
              <p class="ai-note">{t('ai.note')}</p>
            </div>
            <div class="grid gap-3 sm:grid-cols-2">
              <label class="block text-sm">
                <span class="mb-1.5 block font-medium">{t('ed.titleBg')} *</span>
                <input class="field" name="titleBg" maxlength="80" />
              </label>
              <label class="block text-sm">
                <span class="mb-1.5 block font-medium">{t('ed.titleEn')}</span>
                <input class="field" name="titleEn" maxlength="80" />
              </label>
            </div>
            <div class="grid gap-3 sm:grid-cols-2">
              <label class="block text-sm">
                <span class="mb-1.5 block font-medium">{t('ed.bodyBg')}</span>
                <textarea class="field" name="bodyBg" rows="6" maxlength="900"></textarea>
              </label>
              <label class="block text-sm">
                <span class="mb-1.5 block font-medium">{t('ed.bodyEn')}</span>
                <textarea class="field" name="bodyEn" rows="6" maxlength="900"></textarea>
              </label>
            </div>
            <p class="text-xs text-[var(--ink-faint)]">* {t('ed.required')}</p>
          </div>

          <!-- 2 · The 3D visual: what stands on the spot (8 Nov 2026). A pin, a
               cube, a sign, a model made by AI, or the creator's own model -
               the AI kept in plain view rather than inside "a model". -->
          <div class="pane hidden" data-panel="visual">
            <header class="pane-head">
              <h3>{t('wiz.visual.title')}</h3>
              <p>{t('wiz.visual.lede')}</p>
            </header>
            <div>
              <span class="mb-1.5 block text-sm font-medium" id="shape-label">{t('ed.shape')}</span>
              <div class="shape-picker" role="radiogroup" aria-labelledby="shape-label" data-shapes>
                {shapes.map((s) => (
                  <label class:list={['shape-option', { 'shape-ai': s.ai }]}>
                    <input type="radio" name="shape" value={s.key} class="sr-only" />
                    <Fragment set:html={s.svg} />
                    <span class="text-xs">{s.label}</span>
                  </label>
                ))}
              </div>
              <p class="mt-2 text-xs text-[var(--ink-faint)]">{t('ed.shapeHint')}</p>
              <p class="mt-2 hidden text-xs text-[var(--ink-dim)]" data-shape-legacy></p>

              <!-- A sign's words, in both languages. Only for a sign: every
                   other shape has nothing to write on. Empty shows the name. -->
              <div class="mt-3 hidden gap-3 sm:grid-cols-2" data-sign-fields>
                <label class="block text-sm">
                  <span class="mb-1.5 block font-medium">{t('ed.signBg')}</span>
                  <input class="field" name="signBg" maxlength="80" />
                </label>
                <label class="block text-sm">
                  <span class="mb-1.5 block font-medium">{t('ed.signEn')}</span>
                  <input class="field" name="signEn" maxlength="80" />
                </label>
              </div>

              <!-- The creator's own model. Checked in the browser before it is
                   sent (lib/glb.ts), shown turning, sized and faced, and
                   credited. Uploaded when the step is left, like the rest. -->
              <div class="model-box mt-3 hidden" data-model-fields>
                <p class="text-xs text-[var(--ink-dim)]" data-model-hint>{t('mdl.hint')}</p>
                <div class="model-grid">
                  <div class="model-stage" data-model-stage>
                    <p class="model-empty" data-model-empty>
                      <svg width="28" height="28" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M16 3.5 26.5 9.5v13L16 28.5 5.5 22.5v-13L16 3.5Z"/><path d="M5.5 9.5 16 15.5l10.5-6M16 15.5v13"/></svg>
                      <span data-model-empty-label>{t('mdl.choose')}</span>
                    </p>
                  </div>
                  <div class="space-y-3">
                    <!-- Where the model comes from follows the tile (8 Nov 2026):
                         "Insert a 3D model" takes a file (.glb or .stl), "Generate
                         with AI" takes photos and/or a video, and a description. -->
                    <label class="block text-sm" data-src-panel="file">
                      <span class="mb-1.5 block font-medium">{t('mdl.choose')}</span>
                      <input class="field" type="file" accept=".glb,.stl,model/gltf-binary,model/stl" data-model-file />
                    </label>
                    <div class="space-y-3" data-src-panel="ai" hidden>
                      <label class="block text-sm">
                        <span class="mb-1.5 block font-medium">{t('ai3d.media')}</span>
                        <input class="field" type="file" accept="image/jpeg,image/png,image/webp,image/heic,video/mp4,video/quicktime,video/webm" multiple data-ai-media />
                      </label>
                      <p class="text-xs text-[var(--ink-dim)]">{t('ai3d.mediaHint')}</p>
                      <div class="ai-thumbs" data-ai-thumbs></div>
                      <label class="block text-sm">
                        <span class="mb-1.5 block font-medium">{t('ai3d.describe')}</span>
                        <textarea class="field" rows="3" maxlength="300" data-ai-text placeholder={t('ai3d.textPh')}></textarea>
                      </label>
                      <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                        <button class="btn btn-primary btn-sm" type="button" data-ai-make>
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8L12 3ZM19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15Z"/></svg>
                          {t('ai3d.make')}
                        </button>
                        <p class="basis-full text-xs text-[var(--ink-faint)]">{t('ai3d.note')}</p>
                      </div>
                    </div>
                    <p class="text-xs text-[var(--ink-dim)]" data-model-current hidden></p>
                    <p class="text-xs" data-model-check role="status" aria-live="polite" hidden></p>
                    <div class="grid grid-cols-2 gap-3">
                      <label class="block text-sm">
                        <span class="mb-1.5 block font-medium">{t('mdl.height')}</span>
                        <input class="field data" type="number" min="0.2" max="200" step="0.1" data-model-height />
                      </label>
                      <label class="block text-sm">
                        <span class="mb-1.5 block font-medium">{t('mdl.heading')}</span>
                        <span class="flex items-center gap-2">
                          <input class="field data" type="number" min="0" max="359" step="1" data-model-heading-num aria-label={t('mdl.heading')} />
                          <span class="data text-xs text-[var(--ink-faint)]" data-model-compass>N</span>
                        </span>
                      </label>
                    </div>
                    <input class="w-full accent-[var(--signal)]" type="range" min="0" max="359" step="1" data-model-heading aria-label={t('mdl.heading')} />
                    <p class="text-xs text-[var(--ink-faint)]">{t('mdl.heightHint')}</p>
                  </div>
                </div>

                <fieldset class="mt-2 space-y-3" data-model-credit>
                  <legend class="mb-1.5 text-sm font-medium">{t('mdl.credit')}</legend>
                  <div class="flex flex-wrap gap-2">
                    <label class="kind-opt credit-opt"><input class="sr-only" type="radio" name="modelCredit" value="own" checked /><span class="kind-name">{t('mdl.own')}</span></label>
                    <label class="kind-opt credit-opt"><input class="sr-only" type="radio" name="modelCredit" value="other" /><span class="kind-name">{t('mdl.other')}</span></label>
                  </div>
                  <div class="hidden gap-3 sm:grid-cols-3" data-model-other>
                    <label class="block text-sm">
                      <span class="mb-1.5 block font-medium">{t('mdl.author')}</span>
                      <input class="field" maxlength="120" data-model-author />
                    </label>
                    <label class="block text-sm">
                      <span class="mb-1.5 block font-medium">{t('mdl.licence')}</span>
                      <select class="field" data-model-licence>
                        <option value="CC0">CC0</option>
                        <option value="CC BY 4.0">CC BY 4.0</option>
                        <option value="CC BY-SA 4.0">CC BY-SA 4.0</option>
                        <option value="other">{t('mdl.licenceOther')}</option>
                      </select>
                    </label>
                    <label class="block text-sm">
                      <span class="mb-1.5 block font-medium">{t('mdl.link')}</span>
                      <input class="field" type="url" maxlength="300" placeholder="https://" data-model-link />
                    </label>
                    <label class="hidden text-sm sm:col-span-3" data-model-licence-other-row>
                      <span class="mb-1.5 block font-medium">{t('mdl.licenceOther')}</span>
                      <input class="field" maxlength="60" data-model-licence-other />
                    </label>
                  </div>
                  <label class="flex items-start gap-3 text-sm">
                    <input type="checkbox" class="mt-0.5 h-4 w-4 shrink-0" data-model-rights />
                    <span>{t('mdl.rights')}</span>
                  </label>
                </fieldset>
              </div>
            </div>

            <div>
              <span class="mb-1.5 block text-sm font-medium">{t('ed.colour')}</span>
              <div class="flex items-center gap-4">
                <div class="min-w-0 flex-1">
                  <div class="hue" data-hue role="slider" tabindex="0"
                       aria-label={t('ed.colour')} aria-valuemin="0" aria-valuemax="359">
                    <span class="hue-handle" data-hue-handle hidden></span>
                  </div>
                  <p class="data mt-1.5 text-xs text-[var(--ink-faint)]" data-hue-value></p>
                </div>
                <!-- The same dot on a pale street and a dark one, since that
                     is the only question a creator is really asking. -->
                <span class="hue-proof" style="background:#e9edee"><span data-hue-proof-light></span></span>
                <span class="hue-proof" style="background:#1b2226"><span data-hue-proof-dark></span></span>
              </div>
              <p class="mt-2 text-xs text-[var(--ink-faint)]">{t('ed.colourHint')}</p>
            </div>
          </div>

          <!-- 3 · The place: where it stands and how close a walker comes. -->
          <div class="pane hidden" data-panel="place">
            <header class="pane-head">
              <h3>{t('wiz.place.title')}</h3>
              <p>{t('wiz.place.lede')}</p>
            </header>
            <p class="where">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-7.4-7-12a7 7 0 1 1 14 0c0 4.6-7 12-7 12Z" /><circle cx="12" cy="9" r="2.5" /></svg>
              <span>{t('wiz.place.drag')}</span>
            </p>
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
              <label class="block text-sm">
                <span class="mb-1.5 block font-medium">{t('ed.lat')} *</span>
                <input class="field data" name="lat" inputmode="decimal" />
              </label>
              <label class="block text-sm">
                <span class="mb-1.5 block font-medium">{t('ed.lng')} *</span>
                <input class="field data" name="lng" inputmode="decimal" />
              </label>
              <label class="block text-sm">
                <span class="mb-1.5 block font-medium">{t('ed.radius')}</span>
                <input class="field data" name="radius" inputmode="numeric" />
              </label>
            </div>
            <p class="-mt-2 text-xs text-[var(--ink-faint)]">{t('ed.radiusHint')}</p>

          </div>

          <!-- 4 · The question and its hints. Optional: a tour needs none. -->
          <div class="pane hidden" data-panel="question">
            <header class="pane-head">
              <h3>{t('wiz.question.title')} <span class="badge badge-quiet ml-1 align-middle">{t('wiz.optional')}</span></h3>
              <p>{t('wiz.question.lede')}</p>
            </header>

            <div class="kinds" role="radiogroup" aria-label={t('ed.answerKind')}>
              {kinds.map((k) => (
                <label class="kind-opt">
                  <input class="sr-only" type="radio" name="kind" value={k.value} />
                  <span class="kind-name">{k.label}</span>
                  <span class="kind-body">{k.body}</span>
                </label>
              ))}
            </div>

            <div data-when-asked>
              <p class="text-sm font-medium">{t('ed.question')}</p>
              <div class="mt-2 grid gap-3 sm:grid-cols-2">
                <textarea class="field" name="questionBg" rows="2" maxlength="400" placeholder="BG"></textarea>
                <textarea class="field" name="questionEn" rows="2" maxlength="400" placeholder="EN"></textarea>
              </div>
              <p class="mt-1.5 text-xs text-[var(--ink-faint)]">{t('ed.questionHint')}</p>
            </div>

            <div class="hidden" data-when-exact>
              <label class="block text-sm">
                <span class="mb-1.5 block font-medium">{t('ed.accepted')}</span>
                <textarea class="field" name="accepted" rows="4"></textarea>
              </label>
              <p class="mt-1.5 text-xs text-[var(--ink-faint)]">{t('ed.acceptedHint')}</p>
            </div>

            <!-- The options themselves. Their absence is what made this
                 question type unusable: a correct index with nothing to index. -->
            <div class="hidden" data-when-choice>
              <p class="mb-2 text-sm font-medium">{t('ed.choices')}</p>
              <div class="space-y-2" data-choices></div>
              <button class="btn btn-quiet btn-sm mt-2" type="button" data-add-choice>{t('ed.addChoice')}</button>
              <p class="mt-2 text-xs text-[var(--ink-faint)]">{t('ed.choicesHint')}</p>
            </div>

            <div class="grid grid-cols-2 gap-3" data-when-scored>
              <label class="block text-sm" data-points-only>
                <span class="mb-1.5 block font-medium">{t('ed.pointsLabel')}</span>
                <input class="field data" name="points" inputmode="numeric" value="10" />
              </label>
              <label class="block text-sm">
                <span class="mb-1.5 block font-medium">{t('ed.cooldown')}</span>
                <input class="field data" name="cooldown" inputmode="numeric" value="15" />
              </label>
            </div>
            <p class="hidden -mt-2 text-xs text-[var(--ink-faint)]" data-cooldown-hint>{t('ed.cooldownHint')}</p>

            <div data-when-asked-rule>
              <div class="grid gap-3 sm:grid-cols-2">
                <label class="block text-sm">
                  <span class="mb-1.5 block font-medium">{t('ed.onWrong')}</span>
                  <select class="field" name="onWrong">
                    <option value="retry">{t('ed.wrongRetry')}</option>
                    <option value="lock">{t('ed.wrongLock')}</option>
                    <option value="deduct" data-points-only>{t('ed.wrongDeduct')}</option>
                    <option value="skip">{t('ed.wrongSkip')}</option>
                  </select>
                </label>
                <label class="block text-sm" data-when-deduct>
                  <span class="mb-1.5 block font-medium">{t('ed.deductPoints')}</span>
                  <input class="field data" name="deduct" inputmode="numeric" value="5" />
                </label>
              </div>
              <p class="mt-1.5 text-xs text-[var(--ink-faint)]">{t('ed.onWrongHint')}</p>
            </div>

            <div class="hidden space-y-3 border-t border-[var(--line-soft)] pt-4" data-when-answered>
              <p class="text-sm font-medium">{t('ed.after')}</p>
              <div class="grid gap-3 sm:grid-cols-2">
                <textarea class="field" name="afterBg" rows="3" maxlength="600" placeholder="BG"></textarea>
                <textarea class="field" name="afterEn" rows="3" maxlength="600" placeholder="EN"></textarea>
              </div>
              <p class="text-xs text-[var(--ink-faint)]">{t('ed.afterHint')}</p>
            </div>
            <!-- Hints, under the question they help with (8 Nov 2026). Each
                 one is saved the moment it is added. -->
            <section class="hints-box space-y-3" data-hints-box>
            <header class="hints-head">
              <h4>{t('wiz.hints.title')} <span class="badge badge-quiet ml-1 align-middle">{t('wiz.optional')}</span></h4>
              <p>{t('wiz.hints.lede')}</p>
            </header>
            <p class="text-sm text-[var(--ink-dim)]" data-hints-empty>{t('ed.noHints')}</p>
            <ul class="space-y-2" data-hints></ul>

            <div class="add-box space-y-3">
              <div class="grid gap-3 sm:grid-cols-2">
                <label class="block text-sm">
                  <span class="mb-1.5 block font-medium">{t('ed.hintText')} · BG</span>
                  <input class="field" data-hint-bg maxlength="200" />
                </label>
                <label class="block text-sm">
                  <span class="mb-1.5 block font-medium">{t('ed.hintText')} · EN</span>
                  <input class="field" data-hint-en maxlength="200" />
                </label>
              </div>
              <div class="flex flex-wrap items-end gap-3">
                <label class="block w-32 text-sm" data-points-only>
                  <span class="mb-1.5 block font-medium">{t('ed.hintCost')}</span>
                  <input class="field data" data-hint-cost inputmode="numeric" value="0" />
                </label>
                <button class="btn btn-quiet" type="button" data-add-hint>{t('ed.addHint')}</button>
              </div>
            </div>
            <p class="text-xs text-[var(--ink-faint)]" data-points-only>{t('ed.hintsHint')}</p>
            </section>
          </div>

          <!-- 5 · Media. Uploaded the moment a file is chosen. -->
          <div class="pane hidden" data-panel="media">
            <header class="pane-head">
              <h3>{t('wiz.media.title')}</h3>
              <p>{t('wiz.media.lede')}</p>
            </header>
            <p class="text-sm text-[var(--ink-dim)]" data-media-empty>{t('ed.noMedia')}</p>
            <ul class="space-y-2" data-media></ul>

            <!-- Two across until there is real room for three: the browser
                 writes "No file chosen" beside the button and owns that text. -->
            <div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
              <div class="add-box">
                <p class="eyebrow">{t('ed.addPhoto')}</p>
                <input class="field mt-2" type="file" accept="image/*" data-file-image />
              </div>
              <div class="add-box">
                <p class="eyebrow">{t('ed.addAudio')}</p>
                <input class="field mt-2" type="file" accept="audio/*" data-file-audio />
              </div>
              <div class="add-box">
                <p class="eyebrow">{t('ed.addVideo')}</p>
                <div class="mt-2 flex gap-2">
                  <input class="field" data-video-url placeholder={t('ed.videoUrl')} />
                  <button class="btn btn-quiet btn-icon shrink-0" type="button" data-add-video aria-label={t('ed.addVideo')}>+</button>
                </div>
              </div>
            </div>

            <!-- A trail's share of the storage, drawn before anyone chooses a
                 file: "that did not fit" after a long upload is too late. -->
            <div class="mt-1" data-media-usage hidden>
              <div class="meter"><span style="width:0%" data-media-fill></span></div>
              <p class="data mt-1.5 text-xs text-[var(--ink-faint)]" data-media-used></p>
            </div>

            <p class="hidden text-sm text-[var(--signal)]" data-upload-status></p>
          </div>

          <!-- After Done: what to do next, and a way back in. -->
          <div class="pane ready hidden" data-panel="ready">
            <span class="ready-check" aria-hidden="true">
              <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-10" /></svg>
            </span>
            <h3 data-ready-title></h3>
            <p class="text-[var(--ink-dim)]">{t('wiz.readyBody')}</p>
            <p class="text-xs text-[var(--ink-faint)]" data-ready-skipped></p>
            <div class="flex flex-wrap gap-2">
              <button class="btn btn-quiet" type="button" data-ready-again>{t('wiz.again')}</button>
            </div>
          </div>
        </div>

        <p class="wiz-error hidden" data-marker-error role="alert"></p>

        <div class="wiz-foot" data-wiz-foot>
          <button class="btn btn-quiet" type="button" data-wiz-prev>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5 8 12l7 7" /></svg>
            <span class="hide-xs">{t('wiz.prev')}</span>
          </button>
          <button class="wiz-skip hidden" type="button" data-wiz-skip>{t('wiz.skip')}</button>
          <span class="wiz-flash" data-wiz-flash role="status" aria-live="polite"></span>
          <button class="btn btn-primary wiz-next" type="submit" data-marker-save>
            <span data-next-label>{t('wiz.next')}</span>
            <svg data-next-arrow viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
          </button>
        </div>
        <div class="wiz-danger">
          <button class="btn btn-danger-quiet btn-sm" type="button" data-marker-delete>{t('ed.delete')}</button>
        </div>
      </form>
    </div>
  </div>

  <section class="mt-8" data-editors data-ed-panel="share">
    <h2 class="text-lg">{t('ed.editors')}</h2>
    <p class="mt-2 max-w-2xl text-sm text-[var(--ink-dim)]" data-editors-lede>{t('ed.editorsLede')}</p>
    <ul class="mt-4 max-w-2xl" data-editor-list></ul>

    <div class="card mt-4 max-w-2xl space-y-3 p-4" data-owner-only>
      <div class="flex flex-wrap gap-2">
        <button type="button" class="btn btn-quiet btn-sm" data-invite-make>{t('ed.invite')}</button>
        <button type="button" class="btn btn-ghost btn-sm hidden" data-invite-new>{t('ed.inviteNew')}</button>
        <button type="button" class="btn btn-ghost btn-sm hidden" data-invite-stop>{t('ed.inviteStop')}</button>
      </div>
      <div class="hidden gap-2" data-invite-box>
        <input class="field data text-xs" readonly data-invite-link aria-label={t('ed.invite')} />
        <button type="button" class="btn btn-primary btn-sm shrink-0" data-invite-copy>{t('pub.copy')}</button>
      </div>
      <p class="text-xs text-[var(--ink-faint)]">{t('ed.inviteHint')}</p>
    </div>

    <button type="button" class="btn btn-quiet btn-sm mt-4 hidden" data-editor-leave>{t('ed.leave')}</button>
  </section>

  <section class="mt-8" data-ed-panel="results">
    <h2 class="text-lg">
      {t('ed.review')}
      <span class="data ml-1 text-sm" data-review-count style="color:var(--lamp)"></span>
    </h2>
    <p class="mt-3 text-sm text-[var(--ink-dim)]" data-review-empty hidden>{t('ed.reviewEmpty')}</p>
    <ul class="mt-4 space-y-3" data-review></ul>
  </section>

  <section class="mt-14" data-ed-panel="results" data-board-section>
    <div class="flex items-center justify-between gap-3">
      <h2 class="text-lg">{t('ed.board')}</h2>
      <a class="text-sm text-[var(--signal)] underline-offset-2 hover:underline" data-board-link>{t('games.open')}</a>
    </div>
    <p class="mt-3 text-sm text-[var(--ink-dim)]" data-board-empty hidden>{t('ed.boardEmpty')}</p>
    <div class="scroll-x mt-4"><table class="w-full text-sm" data-board></table></div>
  </section>

  <!-- There was no way to remove a trail at all: My trails could only hide
       one. The owner may delete their own row (worlds_delete_owner), and the
       markers, teams and scores go with it. -->
  <section class="mt-14 border-t border-[var(--line)] pt-8" data-delete-trail data-owner-only data-ed-panel="settings">
    <h2 class="text-lg">{t('ed.deleteTitle')}</h2>
    <p class="mt-2 max-w-xl text-sm text-[var(--ink-dim)]" data-delete-body>{t('ed.deleteBody')}</p>
    <button type="button" class="btn btn-danger-quiet mt-4" data-delete-trail-btn>{t('ed.deleteButton')}</button>
    <p class="mt-3 hidden text-sm text-[var(--alert)]" data-delete-trail-msg role="alert"></p>
  </section>
</section>

<Loading label={t('games.loading')} class="mx-auto max-w-7xl px-4 py-24" data-editor-loading />

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/maplibre-gl/5.6.0/maplibre-gl.css" />

<script type="application/json" data-editor-strings set:html={JSON.stringify(strings)}></script>

<script>
  import { db } from '../lib/supabase';
  import { trailLine, isScored } from '../lib/modes';
  import { featuresFor, loadWork, fold, type Category } from '../lib/work';
  import { cityAt, farFrom, type City } from '../lib/place';
  import { requireUser, reveal, param, escapeHtml, text, duration, gateAnswers } from '../lib/session';
  import { wireBecome } from '../lib/become';
  import { levelOf, isPending, isListed, setLevel } from '../lib/publishing';
  import { inspectGlb, type GlbInfo, type GlbProblem } from '../lib/glb';
  import { stlToGlb, isStl } from '../lib/stl';
  import { glbForApp } from '../lib/glbclean';
  import { photoTo3d, describeToShapes, Ai3dError, type Ai3dSource } from '../lib/ai3d';

  /**
   * MapLibre is loaded from a CDN rather than bundled, which is a decision and
   * not laziness.
   *
   * It resolves its tile-parsing worker through `new URL(..., import.meta.url)`.
   * Astro 7 builds with Rolldown, which rewrites that URL, and the worker then
   * never starts. Nothing reports it: the style downloads, 111 layers parse, the
   * canvas is correctly sized, and the map requests zero tiles while painting
   * the style's own background colour - which reads as an empty map rather than
   * a broken one.
   *
   * `optimizeDeps.exclude` fixed the dev server and left the build broken in
   * exactly the same silent way, which is worse than not fixing it: it looked
   * repaired everywhere I was looking. Version 6 ships ESM only, so there is no
   * pre-bundled file to import instead.
   *
   * Loaded here rather than as a tag, so the map cannot be constructed before
   * the library exists.
   */
  const MAPLIBRE = 'https://cdnjs.cloudflare.com/ajax/libs/maplibre-gl/5.6.0/maplibre-gl.js';

  async function loadMapLibre(): Promise<any> {
    if ((window as any).maplibregl) return (window as any).maplibregl;
    await new Promise<void>((resolve, reject) => {
      const tag = document.createElement('script');
      tag.src = MAPLIBRE;
      tag.crossOrigin = 'anonymous';
      tag.onload = () => resolve();
      tag.onerror = () => reject(new Error('maplibre failed to load'));
      document.head.appendChild(tag);
    });
    return (window as any).maplibregl;
  }

  const S = JSON.parse(document.querySelector('[data-editor-strings]')!.textContent || '{}');
  // A stop opened by a person waits for this: until the script below has run
  // to its end, the helpers a stop's form needs are not defined yet (a click
  // during the first load crashed the editor, 7-8 Nov 2026).
  let markReady!: () => void;
  const editorReady = new Promise<void>((resolve) => { markReady = resolve; });
  // Up here, before the first await: a stop opened while the rest of the page
  // is still loading reaches setShape, and SHAPES was not defined yet.
  const SHAPES = ['pin', 'sphere', 'cone', 'cube', 'sign', 'model'];
  // A spreadsheet row cannot carry a file, so it cannot carry a model.
  // The shapes a creator can pick (8 Nov 2026): a spreadsheet row keeps to them.
  const IMPORTABLE = ['pin', 'cube', 'sign'];
  const q = (s: string) => document.querySelector(s);
  const qa = (s: string) => Array.from(document.querySelectorAll(s));

  await requireUser({ needsReal: true });
  const client = db()!;
  const worldId = param('id');
  if (!worldId) { location.replace(location.pathname.startsWith('/en/') ? '/en/my-trails' : '/my-trails'); throw new Error('no id'); }

  const { data: mine } = await client.rpc('my_worlds');
  const owned = (mine ?? []).find((w: any) => w.id === worldId);
  if (!owned) { q('[data-editor-loading]')!.textContent = S.notYours; throw new Error('not yours'); }

  text(q('[data-trail-name]'), owned.name);

  // ------------------------------------------------------- line of work
  // What this person sees follows their own line of work, not the owner's: an
  // editor who is a broker sees a teacher's trail as a broker would. Hiding is
  // complete - the parts are taken out of the page, not folded away - and it is
  // only a preference: nothing here refuses a write the database would accept.
  // A failed read (undefined) and "never asked" (null) both see everything.
  // A viewer sees everything (role is a preference, not a permission): they
  // never lose a tool on a trail they already have, and are offered "Become a
  // creator" to get the set for their own line of work.
  const isViewer = (await gateAnswers())?.role === 'viewer';
  const features = featuresFor(isViewer ? null : ((await loadWork(client as any)) ?? null));
  if (isViewer) {
    const notice = q('[data-viewer-notice]') as HTMLElement;
    const dialog = q('[data-become-dialog]') as HTMLDialogElement;
    notice.hidden = false;
    q('[data-become-open]')?.addEventListener('click', () => dialog.showModal());
    q('[data-become-close]')?.addEventListener('click', () => dialog.close());
    // The tools follow the new line of work, so the builder starts again - but
    // only once an open stop with unsaved edits is saved, with the editor's own
    // save. If that save fails, its message is shown and nothing changes.
    wireBecome(dialog.querySelector('[data-become]') as HTMLFormElement, client as any, S.saveFailed,
      () => location.reload(),
      { before: async () => {
        if (!selected || !dirty) return true;
        if (await save()) return true;
        dialog.close();
        return false;
      } });
  }
  const drop = (sel: string) => qa(sel).forEach((el) => el.remove());
  if (!features.questions) {
    q('[data-step="question"]')?.closest('li')?.remove();
    drop('[data-panel="question"]');
    // The steps that are left count 1, 2, 3, 4.
    qa('[data-step] .st-num').forEach((n, i) => text(n, String(i + 1)));
    text(q('[data-editors-lede]'), S.plain.editorsLede);
  }
  if (!features.results) drop('[data-ed-tab="results"], [data-ed-panel="results"]');
  if (!features.teams) text(q('[data-delete-body]'), S.plain.deleteBody);
  if (!features.order) {
    const tip = q('[data-tip3]');
    if (tip?.lastChild) tip.lastChild.textContent = S.plain.tip3;
  }
  // A broker starts from the AI flow: its two tiles come first.
  if (features.aiFirst) {
    const picker = q('[data-shapes]')!;
    ['model', 'ai'].forEach((k) => {
      const tile = picker.querySelector(`input[value="${k}"]`)?.closest('label');
      if (tile) picker.prepend(tile);
    });
  }

  // An editor gets the stops and nothing about the trail itself. RLS already
  // refuses them; hiding the controls is so they are not offered a refusal.
  const isOwner = owned.role === 'owner';
  if (!isOwner) {
    qa('[data-owner-only]').forEach((el) => ((el as HTMLElement).hidden = true));
    q('[data-you-edit]')?.classList.remove('hidden');
    q('[data-editor-leave]')?.classList.remove('hidden');
  }

  // Deleting. The files first, while media_paths can still find them - the
  // same order the moderators' Remove uses - then the row, which takes the
  // markers, teams and scores with it.
  q('[data-delete-trail-btn]')?.addEventListener('click', async () => {
    if (!confirm(S.deleteConfirm.replace('{0}', owned.name))) return;
    const button = q('[data-delete-trail-btn]') as HTMLButtonElement;
    const msg = q('[data-delete-trail-msg]') as HTMLElement;
    button.disabled = true;
    const { data: paths } = await client.rpc('media_paths', { p_world: worldId });
    if (paths?.length) await client.storage.from('marker-media').remove(paths);
    const { error, count } = await client.from('worlds').delete({ count: 'exact' }).eq('id', worldId);
    if (error || !count) {
      button.disabled = false;
      msg.textContent = error?.message ?? S.deleteNotOwner;
      msg.classList.remove('hidden');
      return;
    }
    location.href = S.lang === 'en' ? '/en/my-trails' : '/my-trails';
  });
  // A trail without teams counts nothing, so its question and hints ask for
  // no points (website sweep, 7 Nov 2026). Questions stay: a lesson can still
  // ask one. A line of work without teams sees no points on any trail.
  const noPoints = !isScored(owned.mode) || !features.teams;
  document.documentElement.classList.toggle('trail-no-points', noPoints);
  if (noPoints) {
    const wrong = document.querySelector('[data-marker-form] [name="onWrong"]') as HTMLSelectElement | null;
    if (wrong?.value === 'deduct') wrong.value = 'retry';
  }
  text(q('[data-trail-code]'), owned.join_code);
  q('[data-board-link]')?.setAttribute('href', `${S.boardHref}?id=${encodeURIComponent(worldId)}`);

  // Read from the row rather than from my_worlds: adding columns there means
  // dropping and recreating the function, and nothing else wanted them.
  const sizeBox = q('[data-team-size]') as HTMLInputElement;
  const settings = await client.from('worlds')
    .select('team_size,reveal_one_at_a_time,mode,start_mode,starts_at,category,city,city_auto').eq('id', worldId).single();
  sizeBox.value = String(settings.data?.team_size ?? 4);

  // What the trail is and where. The line under the name says it in the
  // reader's words; a line of work without teams or order never sees the mode.
  let category: Category = (settings.data?.category ?? owned.category ?? 'other') as Category;
  let city: City | null = (settings.data?.city ?? owned.city ?? null) as City | null;
  let cityAuto = settings.data?.city_auto ?? true;
  const paintHeader = () => text(q('[data-trail-mode]'),
    trailLine(settings.data?.mode ?? owned.mode, category, city, S.lang, features.teams || features.order));
  paintHeader();
  // The start: datetime-local speaks the browser's own time zone, so it is
  // turned into an instant here, and back for display.
  const startMode = q('[data-start-mode]') as HTMLSelectElement;
  const startAt = q('[data-start-at]') as HTMLInputElement;
  const local = (iso: string | null) => {
    if (!iso) return '';
    const d = new Date(iso);
    return new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
  };
  startMode.value = settings.data?.start_mode ?? 'none';
  startAt.value = local(settings.data?.starts_at ?? null);
  startAt.hidden = startMode.value !== 'auto';
  const saveStart = async () => {
    startAt.hidden = startMode.value !== 'auto';
    const row: Record<string, unknown> = { start_mode: startMode.value };
    if (startMode.value === 'auto') {
      if (!startAt.value) return;
      row.starts_at = new Date(startAt.value).toISOString();
    }
    const { error } = await client.from('worlds').update(row).eq('id', worldId);
    if (error) alert(error.message);
  };
  startMode.addEventListener('change', saveStart);
  startAt.addEventListener('change', saveStart);


  // ctf and guide are the ordered pair; the other two have no next marker, so
  // there is nothing for this switch to withhold.
  const ordered = ['ctf', 'guide'].includes(settings.data?.mode ?? 'guide');
  const revealBox = q('[data-reveal]') as HTMLInputElement;
  const revealRow = q('[data-reveal-row]') as HTMLElement;

  // ---------------------------------------------------------------- tabs
  // Which part of the trail is on screen. Kept in the address (#share...) so a
  // reload or a shared link opens the same tab. Standings only exist on a
  // trail with teams.
  const boardSection = q('[data-board-section]') as HTMLElement | null;
  if (boardSection) boardSection.hidden = !isScored(settings.data?.mode ?? 'guide');
  const edTabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-ed-tab]'));
  const showTab = (name: string) => {
    if (!edTabs.some((b) => b.dataset.edTab === name && !b.hidden && b.offsetParent !== null)) name = 'stops';
    edTabs.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.edTab === name)));
    document.querySelectorAll<HTMLElement>('[data-ed-panel]').forEach((el) => {
      el.classList.toggle('ed-off', el.dataset.edPanel !== name);
    });
    if (name === 'stops') window.dispatchEvent(new Event('resize')); // the map measures itself
  };
  edTabs.forEach((b) => b.addEventListener('click', () => {
    history.replaceState(null, '', `${location.pathname}${location.search}#${b.dataset.edTab}`);
    showTab(b.dataset.edTab!);
  }));
  showTab(location.hash.slice(1) || 'stops');

  revealBox.checked = Boolean(settings.data?.reveal_one_at_a_time);
  // Not drawn where it cannot apply: no order, nothing to reveal; no points, no teams.
  revealRow.hidden = !ordered;
  (q('[data-team-row]') as HTMLElement).hidden = !isScored(settings.data?.mode ?? 'guide');
  const paintSettings = () => {
    const parts = [
      features.oneAtATime && ordered && revealBox.checked ? S.setOneByOne : '',
      features.teamSettings && isScored(settings.data?.mode ?? 'guide') ? `${S.teamSize}: ${sizeBox.value}` : '',
      features.teamSettings ? `${S.start}: ${startMode.selectedOptions[0]?.textContent ?? ''}` : '',
      S.categories[category] ?? '',
      city?.[S.lang as 'bg' | 'en'] ?? '',
    ].filter(Boolean);
    text(q('[data-settings-sum]'), parts.join(' · '));
  };
  paintSettings();
  q('[data-settings]')!.addEventListener('change', () => setTimeout(paintSettings, 0));

  revealBox.addEventListener('change', async () => {
    const { error } = await client.from('worlds')
      .update({ reveal_one_at_a_time: revealBox.checked }).eq('id', worldId);

    // Put the tick back if the server refused, rather than showing a state the
    // trail is not in.
    if (error) { revealBox.checked = !revealBox.checked; alert(error.message); }
  });

  sizeBox.addEventListener('change', async () => {
    const wanted = Math.round(Number(sizeBox.value));

    // The database has the same bounds and would refuse; catching it here is
    // what stops the box showing a number the trail is not actually using.
    if (!Number.isFinite(wanted) || wanted < 1 || wanted > 12) {
      const current = await client.from('worlds').select('team_size').eq('id', worldId).single();
      sizeBox.value = String(current.data?.team_size ?? 4);
      return;
    }

    const { error } = await client.from('worlds').update({ team_size: wanted }).eq('id', worldId);
    if (error) { alert(error.message); return; }
    sizeBox.value = String(wanted);
  });

  // Wired above, then taken out for a line of work that never uses them.
  if (!features.teamSettings) drop('[data-team-row], [data-start-row]');
  if (!features.oneAtATime) drop('[data-reveal-row]');

  // ------------------------------------------------------- category and city
  const categoryBox = q('[data-category]') as HTMLSelectElement;
  const cityBox = q('[data-city]') as HTMLInputElement;
  categoryBox.value = category;
  categoryBox.addEventListener('change', async () => {
    const wanted = categoryBox.value as Category;
    const { error } = await client.from('worlds').update({ category: wanted }).eq('id', worldId);
    if (error) { categoryBox.value = category; alert(error.message); return; }
    category = wanted;
    paintHeader(); paintSettings();
  });

  function paintCity() {
    cityBox.value = city?.[S.lang as 'bg' | 'en'] ?? '';
    (q('[data-city-auto]') as HTMLElement).hidden = !cityAuto;
    paintHeader(); paintSettings();
  }
  paintCity();

  // Cities other trails already use, so the same town is spelled one way.
  const knownCities: City[] = [];
  const addKnown = (c: any) => {
    if (c?.key && c.bg && !knownCities.some((k) => k.key === c.key)) knownCities.push(c as City);
  };
  (mine ?? []).forEach((w: any) => addKnown(w.city));
  client.rpc('public_trails').then(({ data }: any) => {
    (data ?? []).forEach((w: any) => addKnown(w.city));
    const list = q('[data-known-cities]')!;
    list.replaceChildren(...knownCities.map((c) => {
      const o = document.createElement('option');
      o.value = c[S.lang as 'bg' | 'en'] || c.bg;
      return o;
    }));
  }, () => {});

  /** The first stop: lowest step, else the first made (the back-fill's rule too). */
  const firstStop = () => markers.filter((m) => Number.isFinite(m.lat) && Number.isFinite(m.lng))
    .map((m, i) => ({ m, i }))
    .sort((a, b) => (a.m.step ?? Infinity) - (b.m.step ?? Infinity) || a.i - b.i)[0]?.m ?? null;

  // A person typing the city takes it out of the machine's hands for good.
  cityBox.addEventListener('change', async () => {
    const name = cityBox.value.trim();
    let next: City | null = null;
    if (name) {
      const known = knownCities.find((c) => fold(c.bg) === fold(name) || fold(c.en) === fold(name));
      const at = firstStop();
      // lat/lng are left out when unknown (no stops, no earlier city), never saved as null.
      const lat = at?.lat ?? city?.lat;
      const lng = at?.lng ?? city?.lng;
      const where = lat != null && lng != null ? { lat, lng } : {};
      next = known ? { ...known }
        : { key: fold(name), bg: name, en: name, ...where } as City;
    }
    const { error } = await client.from('worlds').update({ city: next, city_auto: false }).eq('id', worldId);
    if (error) { alert(error.message); paintCity(); return; }
    city = next; cityAuto = false;
    paintCity();
  });

  // The city from the first stop, in the background: never in the way of a
  // save, silent when Nominatim is down, and one lookup at a time.
  let cityBusy = false;
  async function findCity() {
    if (!isOwner || !cityAuto || cityBusy) return;
    const stops = markers.filter((m) => Number.isFinite(m.lat) && Number.isFinite(m.lng));
    if (!stops.length || (city && !farFrom(city, stops))) return;
    const at = firstStop();
    if (!at) return;
    cityBusy = true;
    try {
      const found = await cityAt(at.lat, at.lng);
      if (!found || !cityAuto) return;
      // Only while still automatic: a person may have typed one meanwhile.
      const { data, error } = await client.from('worlds').update({ city: found })
        .eq('id', worldId).eq('city_auto', true).select('id');
      if (error || !data?.length) return;
      city = found;
      paintCity();
    } catch { /* silent: the city is a nicety */ } finally { cityBusy = false; }
  }


  // The row as the server last described it. Every level change reloads it
  // rather than predicting it, because request_listing can refuse.
  let world = { id: worldId, status: owned.status, visibility: owned.visibility,
                review_note: owned.review_note };

  function paintStatus() {
    const here = levelOf(world);
    const waiting = isPending(world);
    const listed = isListed(world);

    text(q('[data-trail-status]'),
         here === 'draft' ? S.lvDraft : here === 'code' ? S.lvCode : S.lvPublic);

    qa('[data-level]').forEach((b) => {
      const level = (b as HTMLElement).dataset.level as 'draft' | 'code' | 'public';
      b.setAttribute('aria-selected', String(here === level));

      if (level === 'public') text(b, listed || waiting ? S.lvPublic : S.lvAsk);
    });

    text(q('[data-level-hint]'),
         waiting ? S.lvWaitingBody
         : here === 'draft' ? S.lvDraftHint
         : here === 'code' ? S.lvCodeHint
         : listed ? S.lvPublicHint : S.lvAskHint);

    // A refusal comes with a sentence. Not showing it leaves somebody pressing
    // the same button again wondering why nothing happened the first time.
    const note = q('[data-level-note]');
    if (note) {
      text(note, world.review_note ? `${S.lvNote} ${world.review_note}` : '');
      note.classList.toggle('hidden', !world.review_note);
    }
  }

  paintStatus();

  q('[data-editor-loading]')?.remove();
  reveal();

  const maplibregl = await loadMapLibre();
  const map = new maplibregl.Map({
    container: q('[data-map]') as HTMLElement,
    // Liberty in light and dark mode alike (9 Nov 2026): the dark style hid the
    // landmarks a creator places stops by; Alex prefers the bright map.
    style: 'https://tiles.openfreemap.org/styles/liberty',
    center: [26.5060, 42.4841],
    zoom: 15,
    // On a phone the map is the full width of the page, so a one-finger drag
    // moved the map and the page could not be scrolled past it to the markers
    // and the form. Two fingers move the map; one scrolls the page.
    cooperativeGestures: matchMedia('(pointer: coarse)').matches,
    // Folded into the (i) button. Open, the credits covered the bottom third of
    // the map on a phone - the part a finger reaches for.
    attributionControl: { compact: true },
  });
  map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');
  requestAnimationFrame(() => map.resize());
  setTimeout(() => map.resize(), 400);
  new ResizeObserver(() => map.resize()).observe(q('[data-map]') as HTMLElement);

  let markers: any[] = [];
  let pins = new Map<string, any>();
  let selected: string | null = null;
  let fitted = false;   // the map has been fitted to the trail's markers
  let choices: { bg: string; en: string; correct: boolean }[] = [];

  // Which version of the selected stop the form was filled from, and whether
  // this tab is in the middle of saving it (so its own echo is not news).
  let formVersion: number | null = null;
  let savingNow = false;

  // Presence is set up further down; until then there is nobody to tell.
  let announce: () => void = () => {};

  function showRemoteChange(on: boolean) {
    const box = q('[data-remote-change]') as HTMLElement;
    box.classList.toggle('hidden', !on);
    box.classList.toggle('flex', on);
  }

  const form = q('[data-marker-form]') as HTMLFormElement;
  const field = (n: string) =>
    form.elements.namedItem(n) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;
  const val = (n: string) => (field(n) as HTMLInputElement).value.trim();
  const num = (n: string) => { const v = val(n); return v === '' ? null : Number(v); };

  function showKindFields() {
    if (!features.questions) return;
    const kind = (field('kind') as HTMLSelectElement).value || 'none';
    q('[data-when-exact]')!.classList.toggle('hidden', kind !== 'exact');
    q('[data-when-choice]')!.classList.toggle('hidden', kind !== 'choice');
    (q('[data-when-scored]') as HTMLElement).style.visibility = kind === 'none' ? 'hidden' : '';
    (q('[data-when-asked]') as HTMLElement).hidden = kind === 'none';
    q('[data-when-answered]')!.classList.toggle('hidden', kind === 'none');
    q('[data-cooldown-hint]')!.classList.toggle('hidden', kind === 'none');
    (q('[data-when-asked-rule]') as HTMLElement).hidden = kind === 'none';

    // The amount only means anything under the rule that spends it.
    const rule = (field('onWrong') as HTMLSelectElement)?.value;
    (q('[data-when-deduct]') as HTMLElement).hidden = rule !== 'deduct';
  }

  function drawChoices() {
    if (!features.questions) return;
    const box = q('[data-choices]')!;
    box.innerHTML = choices.map((c, i) => `
      <div class="flex items-center gap-2">
        <input type="checkbox" data-choice-correct="${i}" ${c.correct ? 'checked' : ''} class="h-5 w-5 shrink-0" />
        <span class="data w-4 shrink-0 text-xs text-[var(--ink-faint)]">${i}</span>
        <input class="field" data-choice-bg="${i}" value="${escapeHtml(c.bg)}" placeholder="BG" />
        <input class="field" data-choice-en="${i}" value="${escapeHtml(c.en)}" placeholder="EN" />
        <button type="button" data-choice-del="${i}"
                class="shrink-0 px-2 text-lg text-[var(--ink-faint)] hover:text-[var(--alert)]">×</button>
      </div>`).join('');

    box.querySelectorAll('[data-choice-bg]').forEach((el) => el.addEventListener('input', () => {
      choices[Number((el as HTMLElement).dataset.choiceBg)].bg = (el as HTMLInputElement).value;
    }));
    box.querySelectorAll('[data-choice-en]').forEach((el) => el.addEventListener('input', () => {
      choices[Number((el as HTMLElement).dataset.choiceEn)].en = (el as HTMLInputElement).value;
    }));
    box.querySelectorAll('[data-choice-correct]').forEach((el) => el.addEventListener('change', () => {
      choices[Number((el as HTMLElement).dataset.choiceCorrect)].correct = (el as HTMLInputElement).checked;
    }));
    box.querySelectorAll('[data-choice-del]').forEach((el) => el.addEventListener('click', () => {
      dirty = true;
      choices.splice(Number((el as HTMLElement).dataset.choiceDel), 1);
      drawChoices();
    }));
  }

  // The kind is four radios, and a list of radios has no listener of its own,
  // so the form listens for them.
  const onKind = (fn: () => void) => form.addEventListener('change', (e) => {
    if ((e.target as HTMLInputElement)?.name === 'kind') fn();
  });
  onKind(showKindFields);

  // The default follows the kind. A free-text answer is read by a person, so
  // a wait only punishes spelling; the box said 15 for it anyway, and the
  // server was sent 15 unless the creator noticed and changed it.
  onKind(() => {
    const kind = (field('kind') as HTMLSelectElement).value || 'none';
    const wait = field('cooldown') as HTMLInputElement;
    if (kind === 'free' && wait.value === '15') wait.value = '0';
    else if (kind !== 'free' && kind !== 'none' && wait.value === '0') wait.value = '15';
  });
  // The deduction box appears and disappears with the rule beside it.
  field('onWrong')?.addEventListener('change', showKindFields);
  q('[data-add-choice]')?.addEventListener('click', () => {
    dirty = true;
    choices.push({ bg: '', en: '', correct: false });
    drawChoices();
  });

  // ---------------------------------------------------------------- the steps
  // Whether the form holds anything the database does not. Hints and media are
  // written the moment they are added, so their own inputs do not count.
  let dirty = false;
  const markDirty = (e: Event) => {
    const el = e.target as HTMLElement;
    if (el.closest('[data-hints-box], [data-panel="media"], [data-import]')) return;
    dirty = true;
  };
  form.addEventListener('input', markDirty);
  form.addEventListener('change', markDirty);

  // The steps this line of work has; a broker has no Question. Always found by
  // name (STEPS.indexOf), never by a number, since the numbers move.
  type Step = 'basics' | 'visual' | 'place' | 'question' | 'media';
  const STEPS: Step[] = (['basics', 'visual', 'place', 'question', 'media'] as Step[])
    .filter((st) => st !== 'question' || features.questions);
  const QUESTION = STEPS.indexOf('question'), MEDIA = STEPS.indexOf('media');
  const OPTIONAL = new Set([QUESTION]);
  let step = 0;
  let ready = false;
  let visited = new Set<number>([0]);
  let doneSteps = new Set<number>();
  let skippedSteps = new Set<number>();
  let flashTimer = 0;

  const stopNumber = (id: string | null) => {
    const i = markers.findIndex((m) => m.id === id);
    return i < 0 ? 1 : (markers[i].step ?? i + 1);
  };

  function flash(message: string) {
    const el = q('[data-wiz-flash]') as HTMLElement;
    text(el, message);
    el.classList.add('is-on');
    clearTimeout(flashTimer);
    flashTimer = window.setTimeout(() => el.classList.remove('is-on'), 1800);
  }

  function paintTitle() {
    const own = S.lang === 'en' ? val('titleEn') : val('titleBg');
    text(q('[data-wiz-title]'), own || val('titleBg') || val('titleEn') || S.wiz.untitled);
  }
  form.addEventListener('input', (e) => {
    const name = (e.target as HTMLInputElement)?.name;
    if (name === 'titleBg' || name === 'titleEn') paintTitle();
  });

  function paintSteps() {
    qa('[data-step]').forEach((b) => {
      const button = b as HTMLButtonElement;
      const i = STEPS.indexOf(button.dataset.step as Step);
      const cur = !ready && i === step;
      button.classList.toggle('is-current', cur);
      button.classList.toggle('is-done', doneSteps.has(i));
      button.classList.toggle('is-skipped', skippedSteps.has(i) && !cur);
      button.disabled = !visited.has(i);
      if (cur) button.setAttribute('aria-current', 'step'); else button.removeAttribute('aria-current');
      const sub = button.querySelector('[data-step-sub]') as HTMLElement;
      text(sub, skippedSteps.has(i) && !cur ? S.wiz.skipped : sub.dataset.sub ?? '');
    });
    text(q('[data-wiz-count]'), S.wiz.of.replace('{0}', String(ready ? STEPS.length : step + 1)));
    (q('[data-wiz-prev]') as HTMLButtonElement).disabled = step === 0;
    q('[data-wiz-skip]')!.classList.toggle('hidden', !OPTIONAL.has(step));
    const last = step === STEPS.length - 1;
    text(q('[data-next-label]'), last ? S.wiz.done : S.wiz.next);
    q('[data-next-arrow]')!.toggleAttribute('hidden', last);
    q('[data-wiz-foot]')!.classList.toggle('hidden', ready);
  }

  function show(panel: string) {
    qa('[data-panel]').forEach((p) => p.classList.toggle('hidden', (p as HTMLElement).dataset.panel !== panel));
  }

  /** Keeps the top of the form in view; on a phone it sits below the map. */
  function bringFormIntoView(always: boolean) {
    const top = form.getBoundingClientRect().top;
    if (top < 72 || (always && top > innerHeight * 0.6)) {
      scrollTo({ top: scrollY + top - 80, behavior: 'smooth' });
    }
  }

  /**
   * What the stop still needs. The required items are exactly the ones save()
   * refuses without, so the list and the refusal never disagree; the English
   * title is listed as optional.
   */
  function missingItems() {
    const items: { label: string; panel: Step; field: string | null; required: boolean }[] = [];
    if (!val('titleBg')) items.push({ label: S.miss.titleBg, panel: 'basics', field: 'titleBg', required: true });
    const lat = num('lat'), lng = num('lng');
    if (lat === null || lng === null || Number.isNaN(lat) || Number.isNaN(lng)
        || lat < -90 || lat > 90 || lng < -180 || lng > 180) {
      items.push({ label: S.miss.place, panel: 'place', field: 'lat', required: true });
    }
    const kind = features.questions ? (field('kind') as HTMLSelectElement).value || 'none' : 'none';
    if (kind !== 'none' && !val('questionBg') && !val('questionEn')) {
      items.push({ label: S.miss.question, panel: 'question', field: 'questionBg', required: true });
    }
    const kept = choices.filter((c) => c.bg.trim() || c.en.trim());
    if (kind === 'choice' && (kept.length < 2 || !kept.some((c) => c.correct))) {
      items.push({ label: S.miss.choice, panel: 'question', field: null, required: true });
    }
    if (kind === 'exact' && !val('accepted')) {
      items.push({ label: S.miss.accepted, panel: 'question', field: 'accepted', required: true });
    }
    // Only what a stop cannot do without. The English title used to sit here
    // as "optional", which is a nag, not a missing piece (scan, 6 Nov 2026).
    return items;
  }

  function paintMissing() {
    const box = q('[data-missing]') as HTMLElement | null;
    const list = q('[data-missing-list]') as HTMLElement | null;
    if (!box || !list || !selected) return;
    const items = missingItems();
    box.hidden = items.length === 0;
    list.replaceChildren(...items.map((it) => {
      const li = document.createElement('li');
      const go = document.createElement('button');
      go.type = 'button';
      go.className = it.required ? 'miss-go' : 'miss-go is-optional';
      go.textContent = it.label;
      if (!it.required) {
        const tag = document.createElement('span');
        tag.className = 'miss-tag';
        tag.textContent = S.miss.optional;
        go.append(' ', tag);
      }
      go.addEventListener('click', () => {
        goTo(STEPS.indexOf(it.panel));
        if (it.field) (field(it.field) as HTMLElement | null)?.focus();
      });
      li.append(go);
      return li;
    }));
  }
  // Typing, choosing a kind, adding or ticking an option: all recheck it.
  for (const ev of ['input', 'change', 'click']) {
    form.addEventListener(ev, () => setTimeout(paintMissing, 0));
  }

  function goTo(i: number) {
    ready = false;
    step = Math.max(0, Math.min(STEPS.length - 1, i));
    visited.add(step);
    show(STEPS[step]);
    paintSteps();
    q('[data-marker-error]')!.classList.add('hidden');
    paintMissing();
    bringFormIntoView(false);
  }

  function showReady() {
    ready = true;
    show('ready');
    text(q('[data-ready-title]'), S.wiz.ready.replace('{0}', String(stopNumber(selected))));
    const names = [...skippedSteps].sort().map((i) => S.wiz.names[STEPS[i]]);
    text(q('[data-ready-skipped]'), names.length ? S.wiz.skippedList.replace('{0}', names.join(', ')) : '');
    paintSteps();
  }

  /**
   * A stop just placed on the map starts at Basics and opens its steps one by
   * one. A stop that already exists can be entered at any step.
   */
  function startSteps(m: any, fresh: boolean) {
    // A stop just placed is still a draft: its first Next has to publish it.
    dirty = fresh || m.status !== 'published';
    visited = new Set(STEPS.map((_, i) => i));
    doneSteps = new Set<number>();
    skippedSteps = new Set<number>();
    if (!fresh) {
      if (m.content?.bg?.title) doneSteps.add(0);
      doneSteps.add(STEPS.indexOf('visual'));
      doneSteps.add(STEPS.indexOf('place'));
      if (QUESTION >= 0 && ((m.answer_kind ?? 'none') !== 'none' || Number(m.hint_count))) doneSteps.add(QUESTION);
      if (Number(m.media_count)) doneSteps.add(MEDIA);
    }
    text(q('[data-wiz-kind]'), fresh ? S.wiz.newStop : S.wiz.stop.replace('{0}', String(stopNumber(m.id))));
    text(q('[data-wiz-pin]'), String(stopNumber(m.id)));
    paintTitle();
    goTo(0);
    bringFormIntoView(true);
    if (fresh) (field('titleBg') as HTMLInputElement).focus({ preventScroll: true });
  }

  async function next() {
    if (!selected) return;
    if (!(await save())) return;
    doneSteps.add(step);
    skippedSteps.delete(step);
    flash(S.wiz.saved);
    if (step === STEPS.length - 1) showReady(); else goTo(step + 1);
  }

  form.addEventListener('submit', (event) => { event.preventDefault(); next(); });

  q('[data-wiz-prev]')?.addEventListener('click', async () => {
    if (await save(true)) flash(S.wiz.saved);
    goTo(step - 1);
  });

  // Skipping puts the step back the way it was saved: a question half-chosen
  // and then skipped is not a question.
  q('[data-wiz-skip]')?.addEventListener('click', () => {
    const m = markers.find((x) => x.id === selected);
    if (step === QUESTION && m) fillAnswer(m);
    if (step === QUESTION) {
      (q('[data-hint-bg]') as HTMLInputElement).value = '';
      (q('[data-hint-en]') as HTMLInputElement).value = '';
    }
    if (!doneSteps.has(step)) skippedSteps.add(step);
    flash(S.wiz.skipped);
    goTo(step + 1);
  });

  qa('[data-step]').forEach((b) => b.addEventListener('click', async () => {
    const i = STEPS.indexOf((b as HTMLElement).dataset.step as Step);
    if (i < 0 || (i === step && !ready)) return;
    // Any step, any time. What can be saved is saved on the way; what cannot
    // stays in the form, and "Still missing" says what it needs.
    if (!ready && (await save(true))) {
      if (i > step) { doneSteps.add(step); skippedSteps.delete(step); }
      flash(S.wiz.saved);
    }
    goTo(i);
  }));

  q('[data-ready-again]')?.addEventListener('click', () => goTo(0));

  /** The question step's fields, from the stop as it was last saved. */
  function fillAnswer(m: any) {
    if (!features.questions) return;
    (field('kind') as HTMLSelectElement).value = m.answer_kind ?? 'none';
    (field('points') as HTMLInputElement).value = String(m.points ?? 10);
    (field('cooldown') as HTMLInputElement).value = String(m.cooldown_seconds ?? 15);
    (field('onWrong') as HTMLSelectElement).value = m.on_wrong ?? 'retry';
    (field('deduct') as HTMLInputElement).value = String(m.deduct_points ?? 5);
    (field('accepted') as HTMLTextAreaElement).value = (m.accepted ?? []).join('\n');
    (field('questionBg') as HTMLTextAreaElement).value = m.content?.bg?.question ?? '';
    (field('questionEn') as HTMLTextAreaElement).value = m.content?.en?.question ?? '';
    (field('afterBg') as HTMLTextAreaElement).value = m.after_text?.bg ?? '';
    (field('afterEn') as HTMLTextAreaElement).value = m.after_text?.en ?? '';

    const bgOpts = m.content?.bg?.choices ?? [];
    const enOpts = m.content?.en?.choices ?? [];
    const correct: number[] = m.correct_choices ?? [];
    choices = bgOpts.map((label: string, i: number) => ({
      bg: label ?? '', en: enOpts[i] ?? '', correct: correct.includes(i),
    }));
    drawChoices();
    showKindFields();
  }

  async function select(id: string | null, fresh = false) {
    selected = id;
    pins.forEach((p, pid) => p.getElement().classList.toggle('is-on', pid === id));

    q('[data-no-selection]')!.classList.toggle('hidden', Boolean(id));
    form.classList.toggle('hidden', !id);
    if (!id) return;

    const m = markers.find((x) => x.id === id);
    if (!m) return;

    formVersion = m.version;
    showRemoteChange(false);
    announce();

    (field('titleBg') as HTMLInputElement).value = m.content?.bg?.title ?? '';
    (field('titleEn') as HTMLInputElement).value = m.content?.en?.title ?? '';
    (field('bodyBg') as HTMLTextAreaElement).value = m.content?.bg?.body ?? '';
    (field('bodyEn') as HTMLTextAreaElement).value = m.content?.en?.body ?? '';
    (field('lat') as HTMLInputElement).value = String(m.lat ?? '');
    (field('lng') as HTMLInputElement).value = String(m.lng ?? '');
    (field('radius') as HTMLInputElement).value = String(m.radius_m ?? 100);

    // trail_markers already returns colour_hex; nothing has ever written one.
    hue = hexToHue(m.colour_hex ?? null);
    paintHue();
    (field('signBg') as HTMLInputElement).value = m.content?.bg?.sign ?? '';
    (field('signEn') as HTMLInputElement).value = m.content?.en?.sign ?? '';
    setShape(m.style_key);
    fillAnswer(m);

    showKindFields();
    q('[data-marker-error]')!.classList.add('hidden');
    startSteps(m, fresh);
    await Promise.all([loadHints(), loadMedia(), loadModel(m)]);
    text(q('[data-ai-say]'), '');
    paintAiLabel();
  }

  function drawList() {
    const list = q('[data-stops]')!;
    text(q('[data-stop-count]'), markers.length ? `(${markers.length})` : '');
    q('[data-stops-empty]')!.toggleAttribute('hidden', markers.length > 0);

    list.innerHTML = markers.map((m, i) => {
      const title = m.content?.[S.lang]?.title || m.content?.bg?.title || m.content?.en?.title || '—';
      // draggable on the li, not on the button: a draggable button swallows its
      // own click on some browsers, and picking a stop is the commoner action.
      return `<li draggable="true" data-row="${m.id}" class="rounded-lg transition-opacity">
        <button type="button" data-pick="${m.id}"
        class="flex w-full cursor-grab items-center gap-2.5 rounded-lg border border-[var(--line)] px-3 py-2 text-left text-sm transition-colors hover:bg-[var(--surface-2)]">
        <span class="data w-5 shrink-0 text-xs text-[var(--ink-faint)]">${m.step ?? i + 1}</span>
        <span class="min-w-0 flex-1 truncate">${escapeHtml(title)}</span>
        ${features.questions && Number(m.hint_count) ? `<span class="data shrink-0 text-2xs text-[var(--ink-faint)]">?${m.hint_count}</span>` : ''}
        ${Number(m.media_count) ? `<span class="data shrink-0 text-2xs text-[var(--ink-faint)]">#${m.media_count}</span>` : ''}
        ${features.teams && m.answer_kind && m.answer_kind !== 'none'
          ? `<span class="data shrink-0 text-xs" style="color:var(--lamp)">${m.points ?? 0}</span>` : ''}
        ${m.status !== 'published' ? `<span class="eyebrow shrink-0">${S.draft}</span>` : ''}
      </button></li>`;
    }).join('');

    wireDragging(list);

    list.querySelectorAll('[data-pick]').forEach((b) =>
      b.addEventListener('click', async () => {
        const id = (b as HTMLElement).dataset.pick!;
        await editorReady;
        await select(id);
        const m = markers.find((x) => x.id === id);
        if (m) map.easeTo({ center: [m.lng, m.lat], zoom: Math.max(map.getZoom(), 16) });
      }));
  }

  /// Dragging a stop to a new place in the sequence.
  ///
  /// HTML5 drag events rather than a library: the list is a dozen rows of plain
  /// markup and pointer-based reordering is the kind of thing that works on the
  /// desk and not on a phone.
  ///
  /// The whole order goes to the server, not the pair that swapped. A swap
  /// needs the client to work out what moved and leaves the trail half-sorted if
  /// the second write never lands; the sequence the creator is looking at cannot
  /// disagree with itself.
  function wireDragging(list: Element) {
    let from: string | null = null;

    list.querySelectorAll('[data-row]').forEach((row) => {
      const el = row as HTMLElement;

      el.addEventListener('dragstart', (event) => {
        from = el.dataset.row!;
        el.style.opacity = '0.4';
        (event as DragEvent).dataTransfer?.setData('text/plain', from);
      });

      el.addEventListener('dragend', () => { from = null; el.style.opacity = ''; });

      // Both of these have to preventDefault or the drop never fires. dragover
      // fires continuously, so the only work here is the line showing where the
      // row would land.
      el.addEventListener('dragover', (event) => {
        event.preventDefault();
        if (!from || el.dataset.row === from) return;
        const box = el.getBoundingClientRect();
        const above = (event as DragEvent).clientY < box.top + box.height / 2;
        el.style.boxShadow = above
          ? 'inset 0 2px 0 0 var(--signal)'
          : 'inset 0 -2px 0 0 var(--signal)';
      });

      el.addEventListener('dragleave', () => { el.style.boxShadow = ''; });

      el.addEventListener('drop', async (event) => {
        event.preventDefault();
        el.style.boxShadow = '';

        const moved = from;
        const onto = el.dataset.row!;
        if (!moved || moved === onto) return;

        const box = el.getBoundingClientRect();
        const above = (event as DragEvent).clientY < box.top + box.height / 2;

        const order = markers.map((m) => m.id).filter((id) => id !== moved);
        const at = order.indexOf(onto);
        order.splice(above ? at : at + 1, 0, moved);

        // Drawn from the new order before the write, so the row lands under the
        // cursor immediately. load() below replaces this with the server's word.
        markers = order.map((id) => markers.find((m) => m.id === id)!);
        markers.forEach((m, i) => { m.step = i + 1; });
        drawList();

        const { error } = await client.rpc('reorder_markers', {
          p_world: worldId, p_ids: order,
        });

        if (error) { alert(`${S.reorderFailed}\n${error.message}`); }
        await load();
      });
    });
  }

  function drawPins() {
    pins.forEach((p) => p.remove());
    pins = new Map();

    markers.forEach((m, i) => {
      // A numbered pin in the stop's colour, standing on its point (9 Nov
      // 2026): the 18 px dot it was got lost among the map's own blue icons.
      // The head is a child, so it can grow when chosen without fighting the
      // transform maplibre sets on the marker itself.
      const el = document.createElement('div');
      el.className = 'ed-pin' + (m.id === selected ? ' is-on' : '');
      el.style.setProperty('--pin', m.colour_hex || '#0066CC');
      el.title = m.content?.[S.lang]?.title || m.content?.bg?.title || m.content?.en?.title || '';
      const head = document.createElement('span');
      head.className = 'ed-pin-head';
      head.textContent = String(m.step ?? i + 1);
      el.append(head);

      const pin = new maplibregl.Marker({ element: el, draggable: true, anchor: 'bottom' })
        .setLngLat([m.lng, m.lat]).addTo(map);
      el.addEventListener('click', (e) => { e.stopPropagation(); editorReady.then(() => select(m.id)); });

      pin.on('dragend', async () => {
        const { lng, lat } = pin.getLngLat();
        if (selected === m.id) savingNow = true;
        const { data, error } = await client.rpc('move_marker', { p_marker: m.id, p_lat: lat, p_lng: lng });
        savingNow = false;
        if (error) { alert(error.message); await load(); return; }
        m.lat = lat; m.lng = lng;
        if (Array.isArray(data) ? data[0]?.version : (data as any)?.version) {
          m.version = Array.isArray(data) ? data[0].version : (data as any).version;
          if (selected === m.id) formVersion = m.version;
        }
        if (selected === m.id) {
          (field('lat') as HTMLInputElement).value = String(lat);
          (field('lng') as HTMLInputElement).value = String(lng);
        }
        void findCity();
      });

      pins.set(m.id, pin);
    });

    // Once, on the first draw with anything in it: every trail opened on
    // Yambol, so one built anywhere else showed an empty map of the wrong town.
    if (!fitted && markers.length) {
      fitted = true;
      const bounds = new maplibregl.LngLatBounds();
      markers.forEach((m) => bounds.extend([m.lng, m.lat]));
      map.fitBounds(bounds, { padding: 60, maxZoom: 17, duration: 0 });
    }
  }

  /**
   * A trail made before, with questions this line of work does not see: one
   * line says so, rather than letting the questions look gone. Made only when
   * needed, so a trail without questions never carries the word.
   */
  function paintHiddenNote() {
    const want = !features.questions && markers.some((m) => (m.answer_kind ?? 'none') !== 'none');
    let note = q('[data-hidden-note]');
    if (!want) { note?.remove(); return; }
    if (note) return;
    note = document.createElement('p');
    note.setAttribute('data-hidden-note', '');
    note.setAttribute('role', 'note');
    note.className = 'mt-3 rounded-lg border border-[var(--line)] px-3 py-2 text-xs text-[var(--ink-dim)]';
    text(note, S.hiddenQuestions);
    q('[data-overlap]')!.before(note);
  }

  function drawPinsWhenReady() {
    if (map.loaded()) drawPins(); else map.once('load', drawPins);
  }

  async function load() {
    const { data, error } = await client.rpc('trail_markers', { p_world: worldId });
    if (error) { alert(error.message); return; }

    const { data: answers } = await client
      .from('marker_answers')
      .select('marker_id,kind,accepted,correct_choices,points,cooldown_seconds,after_text,on_wrong,deduct_points');
    const byId = new Map((answers ?? []).map((a: any) => [a.marker_id, a]));
    markers = (data ?? []).map((m: any) => ({ ...m, ...(byId.get(m.id) ?? {}) }));

    drawList();
    drawPinsWhenReady();
    paintHiddenNote();
    if (selected && !markers.some((m) => m.id === selected)) await select(null);

    // Said, not enforced: a creator mid-edit will legitimately have two stops
    // on top of each other for a minute, and refusing the save would be worse.
    const { data: clashes } = await client.rpc('overlapping_stops', { p_world: worldId });
    const warn = q('[data-overlap]')!;
    if (clashes && clashes.length) {
      const name = (id: string) => {
        const m = markers.find((x) => x.id === id);
        return m?.content?.[S.lang]?.title || m?.content?.bg?.title || '—';
      };
      text(warn, `${S.overlap} ` + clashes.slice(0, 3)
        .map((c: any) => `${name(c.a)} / ${name(c.b)} (${Math.round(c.metres)} m)`).join(', '));
      warn.classList.remove('hidden');
    } else {
      warn.classList.add('hidden');
    }
  }

  await load();

  map.on('click', async (event) => {
    const { lng, lat } = event.lngLat;
    const { data, error } = await client.rpc('place_marker', {
      p_world: worldId, p_lat: lat, p_lng: lng, p_content: {}, p_status: 'draft',
    });
    if (error) { alert(error.message); return; }
    await load();
    void findCity();
    const id = Array.isArray(data) ? data[0]?.id : (data as any)?.id;
    if (id) await select(id, true);
  });

  // ------------------------------------------------------------ translation
  // One request for the whole stop through the translate Edge Function
  // (supabase/functions/translate). Only empty fields of the other language
  // are filled; hints, which save the moment they are added, are updated in
  // place; everything else waits for the creator to read it and save.
  const PAIRS: Record<string, [string, string]> = {
    title: ['titleBg', 'titleEn'], body: ['bodyBg', 'bodyEn'], sign: ['signBg', 'signEn'],
    question: ['questionBg', 'questionEn'], after: ['afterBg', 'afterEn'],
  };
  const fval = (n: string) => ((form.elements.namedItem(n) as HTMLInputElement | null)?.value ?? '').trim();
  const aiFrom = () => (Object.values(PAIRS).some(([bg]) => fval(bg)) ? 'bg' : 'en') as 'bg' | 'en';
  const aiSay = (msg: string) => text(q('[data-ai-say]'), msg);
  function paintAiLabel() { text(q('[data-ai-label]'), aiFrom() === 'bg' ? S.ai.toEn : S.ai.toBg); }
  form.addEventListener('input', paintAiLabel);

  q('[data-ai-translate]')?.addEventListener('click', async (e) => {
    if (!selected) return;
    const button = e.currentTarget as HTMLButtonElement;
    const from = aiFrom(), to = from === 'bg' ? 'en' : 'bg';
    const side = (pair: [string, string], lang: 'bg' | 'en') => pair[lang === 'bg' ? 0 : 1];

    const fields: Record<string, unknown> = {};
    for (const [key, pair] of Object.entries(PAIRS)) {
      if (fval(side(pair, from)) && !fval(side(pair, to))) fields[key] = fval(side(pair, from));
    }
    if (choices.some((c) => c[from]?.trim() && !c[to]?.trim())) fields.choices = choices.map((c) => c[from] ?? '');
    const hintRows = !features.questions ? [] : ((await client.from('marker_hints').select('id,body').eq('marker_id', selected).order('ord')).data ?? [])
      .filter((h: any) => h.body?.[from] && !h.body?.[to]);
    if (hintRows.length) fields.hints = hintRows.map((h: any) => h.body[from]);
    if (!Object.keys(fields).length) { aiSay(S.ai.nothing); return; }

    button.disabled = true; aiSay(S.ai.working);
    const { data, error } = await client.functions.invoke('translate', { body: { world: worldId, from, to, fields } });
    button.disabled = false;
    if (error || !data?.ok) {
      const reason = data?.reason ?? (await (error as any)?.context?.json?.().catch(() => null))?.reason;
      aiSay(reason === 'quota' ? S.ai.quota : reason === 'not_configured' ? S.ai.notReady : S.ai.failed);
      return;
    }

    const out = data.fields ?? {};
    for (const [key, pair] of Object.entries(PAIRS)) {
      const el = form.elements.namedItem(side(pair, to)) as HTMLInputElement | null;
      if (el && !el.value.trim() && typeof out[key] === 'string') {
        el.value = out[key]; el.dispatchEvent(new Event('input', { bubbles: true }));
      }
    }
    if (Array.isArray(out.choices)) {
      out.choices.forEach((v: string, i: number) => { if (choices[i] && !choices[i][to]?.trim()) choices[i][to] = v; });
      drawChoices();
    }
    if (Array.isArray(out.hints)) {
      await Promise.all(hintRows.map((h: any, i: number) => out.hints[i]
        ? client.from('marker_hints').update({ body: { ...h.body, [to]: out.hints[i] } }).eq('id', h.id)
        : null));
      await loadHints();
    }
    aiSay(S.ai.done);
    paintAiLabel();
  });

  // ------------------------------------------------------------------ hints
  async function loadHints() {
    if (!selected || !features.questions) return;
    const { data } = await client.from('marker_hints')
      .select('id,ord,body,cost').eq('marker_id', selected).order('ord');
    const rows = data ?? [];

    text(q('[data-count-hints]'), rows.length ? String(rows.length) : '');
    // Hints live in the question step now: having some marks it done; having
    // none says nothing about the question itself.
    if (rows.length) { doneSteps.add(QUESTION); skippedSteps.delete(QUESTION); }
    paintSteps();
    q('[data-hints-empty]')!.classList.toggle('hidden', rows.length > 0);
    q('[data-hints]')!.innerHTML = rows.map((h: any) => `
      <li class="card flex items-start justify-between gap-3 p-3">
        <div class="min-w-0">
          <p class="text-sm">${escapeHtml(h.body?.bg || h.body?.en || '—')}</p>
          <p class="data mt-0.5 text-2xs text-[var(--ink-faint)]">${h.cost} · ${escapeHtml(S.hintCost)}</p>
        </div>
        <button type="button" data-del-hint="${h.id}"
                class="shrink-0 text-xs text-[var(--alert)] hover:underline">${escapeHtml(S.remove)}</button>
      </li>`).join('');

    q('[data-hints]')!.querySelectorAll('[data-del-hint]').forEach((b) =>
      b.addEventListener('click', async () => {
        await client.from('marker_hints').delete().eq('id', (b as HTMLElement).dataset.delHint!);
        await Promise.all([loadHints(), load()]);
      }));
  }

  q('[data-add-hint]')?.addEventListener('click', async () => {
    if (!selected) return;
    const bg = (q('[data-hint-bg]') as HTMLInputElement).value.trim();
    const en = (q('[data-hint-en]') as HTMLInputElement).value.trim();
    const cost = Number((q('[data-hint-cost]') as HTMLInputElement).value || 0);
    if (!bg && !en) return;

    const existing = (await client.from('marker_hints').select('id').eq('marker_id', selected)).data ?? [];
    const { error } = await client.from('marker_hints').insert({
      marker_id: selected, ord: existing.length + 1, cost,
      body: { ...(bg && { bg }), ...(en && { en }) },
    });
    if (error) { alert(error.message); return; }

    (q('[data-hint-bg]') as HTMLInputElement).value = '';
    (q('[data-hint-en]') as HTMLInputElement).value = '';
    (q('[data-hint-cost]') as HTMLInputElement).value = '0';
    await Promise.all([loadHints(), load()]);
  });

  // ------------------------------------------------------------------ media
  const BUCKET = 'marker-media';
  const MAX_BYTES = 50 * 1024 * 1024;

  /** Whole megabytes below ten, one decimal above: 0.4 MB, 7.2 MB, 143 MB. */
  function megabytes(bytes: number) {
    const mb = bytes / (1024 * 1024);
    return `${mb >= 10 ? Math.round(mb) : Math.round(mb * 10) / 10} MB`;
  }

  const usage = { used: 0, cap: 0 };

  async function loadUsage() {
    if (!worldId) return;

    const { data, error } = await client.rpc('world_media_usage', { p_world: worldId });
    const row = Array.isArray(data) ? data[0] : data;
    if (error || !row) return;

    usage.used = Number(row.used_bytes);
    usage.cap = Number(row.cap_bytes);

    const box = q('[data-media-usage]') as HTMLElement;
    box.hidden = false;

    // Capped at 100 so a trail that slipped over the line by one file draws a
    // full bar rather than one that runs out of its own track.
    const share = usage.cap > 0 ? Math.min(100, (usage.used / usage.cap) * 100) : 0;
    (q('[data-media-fill]') as HTMLElement).style.width = `${share}%`;
    text(q('[data-media-used]'),
         S.mediaUsed.replace('{0}', megabytes(usage.used)).replace('{1}', megabytes(usage.cap)));
  }

  async function loadMedia() {
    if (!selected) return;
    const { data } = await client.from('marker_media')
      .select('id,kind,path,ord').eq('marker_id', selected).order('ord');
    const rows = data ?? [];

    text(q('[data-count-media]'), rows.length ? String(rows.length) : '');
    if (rows.length) doneSteps.add(MEDIA); else doneSteps.delete(MEDIA);
    paintSteps();
    q('[data-media-empty]')!.classList.toggle('hidden', rows.length > 0);
    q('[data-media]')!.innerHTML = rows.map((m: any) => {
      const url = m.kind === 'link'
        ? m.path
        : client.storage.from(BUCKET).getPublicUrl(m.path).data.publicUrl;
      const preview = m.kind === 'image'
        ? `<img src="${escapeHtml(url)}" alt="" class="h-12 w-16 shrink-0 rounded object-cover" />`
        : `<span class="badge badge-quiet shrink-0">${escapeHtml(m.kind)}</span>`;

      // The stored path is <trail>/<stop>/<timestamp>-<name>, which is three
      // things a creator did not choose and one they did. Only the last is
      // worth showing: a row reading two uuids tells nobody which photo it is.
      const label = m.kind === 'link'
        ? m.path
        : decodeURIComponent((m.path.split('/').pop() ?? m.path).replace(/^\d+-/, ''));

      return `<li class="card flex items-center gap-3 p-3">
        ${preview}
        <a href="${escapeHtml(url)}" target="_blank" rel="noopener"
           class="min-w-0 flex-1 truncate text-xs text-[var(--signal)] hover:underline"
           title="${escapeHtml(m.path)}">${escapeHtml(label)}</a>
        <button type="button" data-del-media="${m.id}" data-path="${m.kind === 'link' ? '' : escapeHtml(m.path)}"
                class="shrink-0 text-xs text-[var(--alert)] hover:underline">${escapeHtml(S.remove)}</button>
      </li>`;
    }).join('');

    q('[data-media]')!.querySelectorAll('[data-del-media]').forEach((b) =>
      b.addEventListener('click', async () => {
        const el = b as HTMLElement;
        if (el.dataset.path) await client.storage.from(BUCKET).remove([el.dataset.path]);
        await client.from('marker_media').delete().eq('id', el.dataset.delMedia!);
        await Promise.all([loadMedia(), load(), loadUsage()]);
      }));
  }

  async function upload(file: File, kind: 'image' | 'audio' | 'video') {
    if (!selected) return;
    const statusEl = q('[data-upload-status]') as HTMLElement;
    const show = (m: string) => { statusEl.textContent = m; statusEl.classList.remove('hidden'); };

    if (file.size > MAX_BYTES) { show(S.tooBig); return; }

    // The insert policy refuses a trail that is already at the line; it cannot
    // refuse one that is under it by a byte, because it does not know how big
    // the incoming file is. This does, so it does the exact arithmetic and says
    // so in words rather than letting the upload run and fail.
    await loadUsage();
    const free = usage.cap - usage.used;

    if (usage.cap > 0 && free <= 0) { show(S.mediaFull); return; }
    if (usage.cap > 0 && file.size > free) {
      show(S.mediaWontFit.replace('{0}', megabytes(free)));
      return;
    }

    show(S.uploading);

    // <world>/<marker>/<file>: the first segment is what the storage policy
    // reads to decide who may write here.
    const safe = file.name.replace(/[^a-zA-Z0-9._-]/g, '_');
    const path = `${worldId}/${selected}/${Date.now()}-${safe}`;

    const { error } = await client.storage.from(BUCKET).upload(path, file, { upsert: false });
    if (error) { show(error.message); return; }

    const existing = (await client.from('marker_media').select('id').eq('marker_id', selected)).data ?? [];
    await client.from('marker_media').insert({
      marker_id: selected, kind, path, ord: existing.length + 1,
    });

    statusEl.classList.add('hidden');
    await Promise.all([loadMedia(), load(), loadUsage()]);
  }

  (q('[data-file-image]') as HTMLInputElement)?.addEventListener('change', (e) => {
    const input = e.target as HTMLInputElement;
    const f = input.files?.[0];
    if (f) upload(f, 'image');
    input.value = '';
  });
  (q('[data-file-audio]') as HTMLInputElement)?.addEventListener('change', (e) => {
    const input = e.target as HTMLInputElement;
    const f = input.files?.[0];
    if (f) upload(f, 'audio');
    input.value = '';
  });
  q('[data-add-video]')?.addEventListener('click', async () => {
    const input = q('[data-video-url]') as HTMLInputElement;
    const url = input.value.trim();
    if (!selected || !url) return;
    const existing = (await client.from('marker_media').select('id').eq('marker_id', selected)).data ?? [];
    await client.from('marker_media').insert({
      marker_id: selected, kind: 'link', path: url, ord: existing.length + 1,
    });
    input.value = '';
    await Promise.all([loadMedia(), load(), loadUsage()]);
  });

  // ------------------------------------------------------------------ saving
  // Every step that is left is saved, and Next checks it first. One routine for
  // the whole stop: the steps are a way of showing the form, not five forms.
  // quiet: a step left by Previous or the step bar, where a half-written
  // question is not an error yet - it stays in the form and is checked at Next.
  async function save(quiet = false): Promise<boolean> {
    if (!selected) return false;

    const err = q('[data-marker-error]') as HTMLElement;
    err.classList.add('hidden');
    const button = q('[data-marker-save]') as HTMLButtonElement;
    const labelEl = q('[data-next-label]') as HTMLElement;
    const label = labelEl.textContent;

    // Sends them to the step holding the problem, or the message names a field
    // they cannot see.
    const fail = (message: string, panel?: string) => {
      button.disabled = false; text(labelEl, label);
      if (quiet) return;
      // The step first, then the message: moving to a step clears old ones.
      if (panel && STEPS.includes(panel as Step)) goTo(STEPS.indexOf(panel as Step));
      err.textContent = message; err.classList.remove('hidden');
    };

    button.disabled = true;
    text(labelEl, S.saving);

    const lat = num('lat'), lng = num('lng');
    if (lat === null || lng === null || Number.isNaN(lat) || Number.isNaN(lng)) {
      fail(S.lang === 'bg' ? 'Координатите трябва да са числа.' : 'Coordinates must be numbers.', 'place');
      return false;
    }
    if (lat < -90 || lat > 90 || lng < -180 || lng > 180) {
      fail(S.lang === 'bg' ? 'Координатите са извън обхват.' : 'Coordinates are out of range.', 'place');
      return false;
    }

    const titleBg = val('titleBg');
    if (!titleBg) {
      fail(S.lang === 'bg' ? 'Дай заглавие на български.' : 'Give the stop a Bulgarian title.', 'basics');
      return false;
    }

    // Radios: before the stop's answer has loaded none is checked and the
    // value is '' - which used to read as "a question" and block the save.
    // Without the Question step there is nothing to read, and nothing is
    // written either: an old trail's questions stay exactly as they were.
    const kind = features.questions ? (field('kind') as HTMLSelectElement).value || 'none' : 'none';
    const kept = choices.filter((c) => c.bg.trim() || c.en.trim());
    const correct = kept.map((c, i) => (c.correct ? i : -1)).filter((i) => i >= 0);

    // A question with no words. It saved, points and all, and the app - which
    // has nothing to show - left the question off the stop without a word.
    if (kind !== 'none' && !val('questionBg') && !val('questionEn')) {
      fail(S.lang === 'bg' ? 'Напиши въпроса.' : 'Write the question.', 'question');
      return false;
    }
    if (kind === 'choice' && (kept.length < 2 || correct.length === 0)) {
      fail(S.lang === 'bg' ? 'Трябват поне два отговора и поне един верен.'
                           : 'A choice needs at least two options and one ticked as right.', 'question');
      return false;
    }
    if (kind === 'exact' && !val('accepted')) {
      fail(S.lang === 'bg' ? 'Напиши поне един приет отговор.' : 'Write at least one accepted answer.', 'question');
      return false;
    }

    // Checked, and nothing to write. Stepping through a stop must not bump its
    // version each time: a co-editor with the same stop open would be told it
    // had changed when nobody changed it.
    if (chosenShape() === 'model') {
      const problem = modelProblem();
      if (problem) { fail(problem, 'visual'); return false; }
    }

    if (!dirty) { button.disabled = false; text(labelEl, label); return true; }

    const content: Record<string, any> = {
      bg: { title: titleBg, ...(val('bodyBg') && { body: val('bodyBg') }) },
    };
    if (val('titleEn') || val('bodyEn')) {
      content.en = {
        ...(val('titleEn') && { title: val('titleEn') }),
        ...(val('bodyEn') && { body: val('bodyEn') }),
      };
    }
    if (kind !== 'none') {
      if (val('questionBg')) content.bg.question = val('questionBg');
      if (val('questionEn')) {
        content.en = { ...(content.en ?? {}), question: val('questionEn') };
      }
    }

    if (kind === 'choice' && kept.length) {
      content.bg.choices = kept.map((c) => c.bg);
      content.en = { ...(content.en ?? {}), choices: kept.map((c) => c.en || c.bg) };
    }
    if (!features.questions) {
      const was = markers.find((x) => x.id === selected)?.content ?? {};
      for (const l of ['bg', 'en'] as const) {
        for (const k of ['question', 'choices']) {
          if (was[l]?.[k] !== undefined) content[l] = { ...(content[l] ?? {}), [k]: was[l][k] };
        }
      }
    }

    // A sign's words, only on a sign. Kept out of every other shape so that
    // switching away and back does not resurrect text nobody can see.
    const shape = chosenShape();
    if (shape === 'sign') {
      if (val('signBg')) content.bg.sign = val('signBg');
      if (val('signEn')) content.en = { ...(content.en ?? {}), sign: val('signEn') };
    }

    // Only over the version this form was filled from. If somebody else saved
    // the stop in between, the row's version has moved on, nothing matches, and
    // this save is refused rather than silently writing over theirs.
    const saving = selected;
    savingNow = true;
    const { data: wrote, error: upErr } = await client.from('markers')
      .update({
        content,
        radius_m: num('radius') ?? 100,
        colour_hex: hue === null ? DEFAULT_STOP_COLOUR : hueToHex(hue),
        style_key: shape,
        status: 'published',
      })
      .eq('id', saving)
      .eq('version', formVersion ?? -1)
      .select('version');
    if (upErr) { savingNow = false; fail(upErr.message); return false; }
    if (!wrote || wrote.length === 0) {
      savingNow = false;
      showRemoteChange(true);
      fail(S.conflict);
      return false;
    }
    formVersion = wrote[0].version;

    if (shape === 'model') {
      const problem = await saveModel(saving);
      if (problem) { savingNow = false; fail(problem, 'visual'); return false; }
    }

    const before = markers.find((x) => x.id === saving);
    const shifted = !before || before.lat !== lat || before.lng !== lng;
    const moved = await client.rpc('move_marker', { p_marker: selected, p_lat: lat, p_lng: lng });
    if (moved.error) { savingNow = false; fail(moved.error.message, 'place'); return false; }

    if (!features.questions) {
      // Left alone: see above.
    } else if (kind === 'none') {
      await client.rpc('clear_marker_answer', { p_marker: selected });
    } else {
      const accepted = (field('accepted') as HTMLTextAreaElement).value
        .split('\n').map((x) => x.trim()).filter(Boolean);

      // Checked before anything was written - see the top of save.

      const after: Record<string, string> = {};
      if (val('afterBg')) after.bg = val('afterBg');
      if (val('afterEn')) after.en = val('afterEn');

      const { error: aErr } = await client.rpc('set_marker_answer', {
        p_marker: selected,
        p_kind: kind,
        p_accepted: kind === 'exact' ? accepted : null,
        p_correct_choices: kind === 'choice' ? correct : null,
        p_points: num('points') ?? 10,
        p_cooldown_seconds: num('cooldown') ?? (kind === 'free' ? 0 : 15),
        p_on_wrong: (field('onWrong') as HTMLSelectElement)?.value || 'retry',
        p_deduct_points: num('deduct') ?? 0,
        p_after_text: after,
      });
      if (aErr) { savingNow = false; fail(aErr.message, 'question'); return false; }
    }

    button.disabled = false;
    text(labelEl, label);
    await load();
    // move_marker bumped the version again; take whatever the row says now.
    formVersion = markers.find((m) => m.id === saving)?.version ?? formVersion;
    savingNow = false;
    dirty = false;
    if (shifted) void findCity();
    return true;
  }

  q('[data-remote-reload]')?.addEventListener('click', async () => {
    const id = selected;
    await load();
    await select(markers.some((m) => m.id === id) ? id : null);
    q('[data-marker-error]')!.classList.add('hidden');
  });

  q('[data-marker-delete]')?.addEventListener('click', async () => {
    if (!selected) return;
    const { data: files } = await client.rpc('media_paths', { p_world: worldId, p_marker: selected });
    if (files?.length) await client.storage.from('marker-media').remove(files);
    const { error } = await client.from('markers').delete().eq('id', selected);
    if (error) { alert(error.message); return; }
    await select(null);
    await load();
  });

  q('[data-rotate]')?.addEventListener('click', async () => {
    const { data, error } = await client.rpc('rotate_join_code', { p_world: worldId });
    if (error) { alert(error.message); return; }
    text(q('[data-trail-code]'), data);
  });

  q('[data-levels]')?.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement)?.closest('[data-level]') as HTMLButtonElement | null;
    if (!button || button.disabled) return;

    const wanted = button.dataset.level as 'draft' | 'code' | 'public';
    const failed = await setLevel(client, world, wanted, S.pubDrafts);
    if (failed) { alert(failed); return; }

    const { data: again } = await client
      .from('worlds').select('status,visibility,review_note').eq('id', worldId).single();

    if (again) world = { ...world, ...again };
    paintStatus();
  });

  q('[data-copy-code]')?.addEventListener('click', async (event) => {
    const button = event.currentTarget as HTMLElement;
    try {
      await navigator.clipboard.writeText(q('[data-trail-code]')!.textContent!.trim().toUpperCase());
      text(button, S.copied);
      setTimeout(() => text(button, S.copy), 1400);
    } catch { /* the code is on screen; reading it out still works */ }
  });

  // --------------------------------------------------------- review and board
  async function loadReview() {
    const { data, error } = await client.rpc('review_queue', { p_world: worldId });
    const list = q('[data-review]')!;
    const rows = data ?? [];

    text(q('[data-review-count]'), rows.length ? String(rows.length) : '');
    q('[data-review-empty]')!.toggleAttribute('hidden', rows.length > 0);
    if (error || rows.length === 0) { list.innerHTML = ''; return; }

    list.innerHTML = rows.map((r: any) => {
      const title = r.marker_title?.[S.lang]?.title || r.marker_title?.bg?.title || '—';
      return `<li class="card flex flex-wrap items-start justify-between gap-4 p-4">
        <div class="min-w-0 flex-1">
          <p class="eyebrow">${escapeHtml(title)} · ${escapeHtml(r.team_name)}</p>
          <p class="mt-1.5 break-words text-sm">${escapeHtml(r.submitted)}</p>
        </div>
        <div class="flex shrink-0 flex-wrap gap-2">
          <button class="btn btn-primary btn-sm" data-accept="${r.submission_id}">${S.accept}</button>
          <button class="btn btn-danger-quiet btn-sm"
                  data-reject="${r.submission_id}">${S.reject}</button>
          <button class="btn btn-ghost btn-sm" data-block-player="${r.submission_id}"
                  data-team="${escapeHtml(r.team_name)}">${escapeHtml(S.revBlock)}</button>
        </div>
      </li>`;
    }).join('');

    const decide = async (id: string, correct: boolean) => {
      const { error: rErr } = await client.rpc('review_answer', { p_submission: id, p_correct: correct });
      if (rErr) { alert(rErr.message); return; }
      await Promise.all([loadReview(), loadBoard()]);
    };

    list.querySelectorAll('[data-accept]').forEach((b) =>
      b.addEventListener('click', () => decide((b as HTMLElement).dataset.accept!, true)));
    list.querySelectorAll('[data-reject]').forEach((b) =>
      b.addEventListener('click', () => decide((b as HTMLElement).dataset.reject!, false)));

    // The answer stays in the queue to be judged; the person who sent it
    // leaves the trail and cannot come back.
    list.querySelectorAll('[data-block-player]').forEach((b) =>
      b.addEventListener('click', async () => {
        const el = b as HTMLElement;
        if (!confirm(S.revBlockConfirm.replace('{0}', el.dataset.team ?? ''))) return;
        const { error: bErr } = await client.rpc('block_user',
          { p_kind: 'submission', p_target: el.dataset.blockPlayer });
        if (bErr) { alert(bErr.message); return; }
        el.remove();
      }));

    // Keyboard-driven: sixty submissions is not sixty dialogs.
    document.onkeydown = (event) => {
      if (event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement) return;
      const first = rows[0];
      if (!first) return;
      if (event.key === 'a') decide(first.submission_id, true);
      if (event.key === 'd') decide(first.submission_id, false);
    };
  }

  async function loadBoard() {
    const { data, error } = await client.rpc('world_leaderboard', { p_world: worldId });
    const table = q('[data-board]') as HTMLTableElement;
    const rows = data ?? [];

    q('[data-board-empty]')!.toggleAttribute('hidden', rows.length > 0);
    if (error || rows.length === 0) { table.innerHTML = ''; return; }

    table.innerHTML = `
      <thead><tr class="border-b border-[var(--line)] text-left text-xs text-[var(--ink-faint)]">
        <th class="py-2 pr-3">${escapeHtml(S.rank)}</th>
        <th class="py-2 pr-3">${escapeHtml(S.team)}</th>
        <th class="py-2 pr-3 text-right">${escapeHtml(S.bPoints)}</th>
        <th class="py-2 pr-3 text-right">${escapeHtml(S.bSolved)}</th>
        <th class="py-2 text-right">${escapeHtml(S.time)}</th>
      </tr></thead>
      <tbody>${rows.map((r: any) => `
        <tr class="border-b border-[var(--line-soft)]">
          <td class="data py-2 pr-3">${r.rank}</td>
          <td class="py-2 pr-3">${r.team_name ? escapeHtml(r.team_name) : escapeHtml(S.hidden)}${r.is_mine ? ` <span class="eyebrow">${S.you}</span>` : ''}</td>
          <td class="data py-2 pr-3 text-right">${r.points}</td>
          <td class="data py-2 pr-3 text-right text-[var(--ink-dim)]">${r.stops_solved}</td>
          <td class="data py-2 text-right text-[var(--ink-dim)]">${duration(r.elapsed_seconds)}</td>
        </tr>`).join('')}</tbody>`;
  }

  // Not awaited: the page script has to run to its end at once, or a stop
  // opened meanwhile meets constants not defined yet (7 Nov 2026).
  if (features.results) Promise.all([loadReview(), loadBoard()]).catch(() => {});

  // ---------------------------------------------------------------- editors
  const me = (await client.auth.getUser()).data.user;

  async function loadEditors() {
    const { data } = await client.rpc('trail_editors', { p_world: worldId });
    const list = q('[data-editor-list]')!;
    list.innerHTML = (data ?? []).map((e: any) => `
      <li class="flex items-center justify-between gap-3 border-t border-[var(--line-soft)] py-2.5 text-sm">
        <span class="min-w-0 truncate">${escapeHtml(e.name || e.email || '—')}${
          e.name && e.email ? ` <span class="text-[var(--ink-faint)]">${escapeHtml(e.email)}</span>` : ''}${
          e.is_me ? ` <span class="eyebrow">${escapeHtml(S.you)}</span>` : ''}</span>
        <span class="flex shrink-0 items-center gap-2">
          <span class="eyebrow">${escapeHtml(e.role === 'owner' ? S.ownerWord : S.editorWord)}</span>
          ${isOwner && e.role === 'editor'
            ? `<button type="button" class="btn btn-ghost btn-sm" data-remove-editor="${escapeHtml(e.user_id)}">${escapeHtml(S.remove)}</button>`
            : ''}
        </span>
      </li>`).join('');

    list.querySelectorAll('[data-remove-editor]').forEach((b) => b.addEventListener('click', async () => {
      const { error: rErr } = await client.rpc('remove_editor',
        { p_world: worldId, p_user: (b as HTMLElement).dataset.removeEditor });
      if (rErr) { alert(rErr.message); return; }
      await loadEditors();
    }));
  }

  function showInvite(code: string | null) {
    const box = q('[data-invite-box]') as HTMLElement;
    box.classList.toggle('hidden', !code);
    box.classList.toggle('flex', Boolean(code));
    q('[data-invite-make]')!.classList.toggle('hidden', Boolean(code));
    q('[data-invite-new]')!.classList.toggle('hidden', !code);
    q('[data-invite-stop]')!.classList.toggle('hidden', !code);
    if (code) {
      (q('[data-invite-link]') as HTMLInputElement).value =
        `${location.origin}${S.inviteHref}?code=${encodeURIComponent(code)}`;
    }
  }

  if (isOwner) {
    // Shown if one already exists; made only when asked.
    const { data: existing } = await client.from('editor_invites')
      .select('code').eq('world_id', worldId).maybeSingle();
    showInvite(existing?.code ?? null);

    const make = async (fresh: boolean) => {
      const { data, error: iErr } = await client.rpc('editor_invite', { p_world: worldId, p_new: fresh });
      if (iErr) { alert(iErr.message); return; }
      showInvite(data as string);
    };
    q('[data-invite-make]')?.addEventListener('click', () => make(false));
    q('[data-invite-new]')?.addEventListener('click', () => make(true));
    q('[data-invite-stop]')?.addEventListener('click', async () => {
      const { error: sErr } = await client.rpc('stop_editor_invite', { p_world: worldId });
      if (sErr) { alert(sErr.message); return; }
      showInvite(null);
    });
    q('[data-invite-copy]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget as HTMLElement;
      try {
        await navigator.clipboard.writeText((q('[data-invite-link]') as HTMLInputElement).value);
        text(button, S.copied);
        setTimeout(() => text(button, S.copy), 1400);
      } catch { (q('[data-invite-link]') as HTMLInputElement).select(); }
    });
  }

  q('[data-editor-leave]')?.addEventListener('click', async () => {
    if (!confirm(S.leaveConfirm)) return;
    const { error: lErr } = await client.from('world_members').delete()
      .eq('world_id', worldId).eq('user_id', me?.id ?? '');
    if (lErr) { alert(lErr.message); return; }
    location.href = S.myTrailsHref;
  });

  loadEditors().catch(() => {});

  // ------------------------------------------------------------------- live
  //
  // One channel per trail. Postgres changes arrive only for rows this person's
  // own token may read - the trail's owner and editors - because Realtime runs
  // them past the same row-level security as a select. Presence says who else
  // has the editor open, and which stop.
  // A display name, never the email: anybody who knows a trail's id can join
  // this channel's presence, and a public trail's id is on the library page.
  const myName = (me?.user_metadata?.display_name as string) || S.editorWord;
  let refreshTimer: ReturnType<typeof setTimeout> | null = null;

  const refreshSoon = () => {
    if (refreshTimer) clearTimeout(refreshTimer);
    refreshTimer = setTimeout(async () => { refreshTimer = null; await load(); }, 400);
  };

  const ours = (markerId: string | undefined) => Boolean(markerId) && markers.some((m) => m.id === markerId);

  // A key made up per tab, for the same reason as the name: nothing about
  // the account goes out on a channel strangers can join.
  const tabKey = crypto.randomUUID();
  const channel = client.channel(`trail:${worldId}`, { config: { presence: { key: tabKey } } });

  channel
    .on('postgres_changes', { event: '*', schema: 'public', table: 'markers', filter: `world_id=eq.${worldId}` },
      (change: any) => {
        const row = change.new?.id ? change.new : change.old;
        if (row?.id && row.id === selected && !savingNow) {
          // Deleted under us, or saved by somebody else at a newer version.
          if (change.eventType === 'DELETE' || (change.new?.version ?? 0) > (formVersion ?? 0)) {
            showRemoteChange(true);
          }
        }
        refreshSoon();
      })
    .on('postgres_changes', { event: '*', schema: 'public', table: 'marker_hints' },
      (change: any) => {
        const id = change.new?.marker_id ?? change.old?.marker_id;
        if (id && id === selected) loadHints();
        if (ours(id)) refreshSoon();
      })
    .on('postgres_changes', { event: '*', schema: 'public', table: 'marker_media' },
      (change: any) => {
        const id = change.new?.marker_id ?? change.old?.marker_id;
        if (id && id === selected) loadMedia();
        if (ours(id)) refreshSoon();
      })
    .on('postgres_changes', { event: '*', schema: 'public', table: 'marker_answers' },
      (change: any) => {
        if (ours(change.new?.marker_id ?? change.old?.marker_id)) refreshSoon();
      })
    .on('presence', { event: 'sync' }, () => {
      const others = Object.entries(channel.presenceState())
        .filter(([key]) => key !== tabKey)
        .map(([, metas]: [string, any]) => metas[0]);
      const box = q('[data-presence]') as HTMLElement;
      box.classList.toggle('hidden', others.length === 0);
      box.classList.toggle('flex', others.length > 0);
      box.innerHTML = others.length
        ? `<span>${escapeHtml(S.here)}</span>` + others.map((o: any) => {
            const stop = markers.find((m) => m.id === o.stop);
            const title = stop ? (stop.content?.[S.lang]?.title || stop.content?.bg?.title || '') : '';
            return `<span class="badge badge-quiet">${escapeHtml(o.name || '—')}${title ? ` · ${escapeHtml(title)}` : ''}</span>`;
          }).join('')
        : '';
    })
    .subscribe((status: string) => {
      if (status === 'SUBSCRIBED') announce();
    });

  // Which stop this tab has open, for everybody else's presence line.
  announce = () => { channel.track({ name: myName, stop: selected }).catch(() => {}); };

  // Last, not beside load(): everything it reads is declared further down this
  // file, and a const is not readable before its declaration has been reached.
  // (loadUsage is called at the very end of this script.)

  // ------------------------------------------------------------------ colour
  //
  // Hue is the creator's; saturation and lightness are not. The app rings every
  // marker in whichever of black or white shows against it, so the colour never
  // has to carry its own separation from the map - and holding the weight fixed
  // is what stops one marker on a trail shouting over the rest.

  const HUE_SAT = 62;
  const HUE_LIGHT = 52;

  let hue: number | null = null;

  // The colour every stop has until its creator picks one (30 October 2026),
  // the brand blue the app also falls back to. hue stays null while it is the
  // default, so the default is what is saved, not the slider's nearest hue.
  const DEFAULT_STOP_COLOUR = '#0066cc';
  const DEFAULT_HUE = 210;

  /** HSL to the #rrggbb the markers table stores. */
  function hueToHex(h: number) {
    const s = HUE_SAT / 100;
    const l = HUE_LIGHT / 100;
    const c = (1 - Math.abs(2 * l - 1)) * s;
    const x = c * (1 - Math.abs(((h / 60) % 2) - 1));
    const m = l - c / 2;

    const [r, g, b] =
      h < 60 ? [c, x, 0] : h < 120 ? [x, c, 0] : h < 180 ? [0, c, x]
      : h < 240 ? [0, x, c] : h < 300 ? [x, 0, c] : [c, 0, x];

    const two = (v: number) =>
      Math.round((v + m) * 255).toString(16).padStart(2, '0');

    return `#${two(r)}${two(g)}${two(b)}`;
  }

  /** The hue of a stored colour, so reopening a stop finds its own handle. */
  function hexToHue(hex: string | null): number | null {
    if (!hex || !/^#[0-9a-f]{6}$/i.test(hex)) return null;

    const r = parseInt(hex.slice(1, 3), 16) / 255;
    const g = parseInt(hex.slice(3, 5), 16) / 255;
    const b = parseInt(hex.slice(5, 7), 16) / 255;

    const max = Math.max(r, g, b);
    const min = Math.min(r, g, b);
    if (max === min) return null;   // a grey has no hue to point at

    const d = max - min;
    const h = max === r ? ((g - b) / d + (g < b ? 6 : 0))
            : max === g ? (b - r) / d + 2
            : (r - g) / d + 4;

    return Math.round(h * 60) % 360;
  }

  function paintHue() {
    const handle = q('[data-hue-handle]') as HTMLElement;
    const strip = q('[data-hue]') as HTMLElement;
    const light = q('[data-hue-proof-light]') as HTMLElement;
    const dark = q('[data-hue-proof-dark]') as HTMLElement;

    if (!handle || !strip) return;

    const chosen = hue !== null;
    handle.hidden = false;
    strip.setAttribute('aria-valuenow', String(hue ?? DEFAULT_HUE));

    const hex = chosen ? hueToHex(hue!) : DEFAULT_STOP_COLOUR;

    handle.style.left = `${((hue ?? DEFAULT_HUE) / 359) * 100}%`;
    if (light) light.style.background = hex;
    if (dark) dark.style.background = hex;

    // The shape cards take the stop's colour, so the choice reads as "this, in
    // the camera".
    (q('[data-shapes]') as HTMLElement)?.style.setProperty('--shape-tint', hex);

    text(q('[data-hue-value]'), chosen ? hex : `${DEFAULT_STOP_COLOUR} · ${S.colourNone}`);
    const badge = q('[data-wiz-pin]') as HTMLElement | null;
    if (badge) badge.style.background = hex;
  }


  /** The shape the form shows: 'default', empty or unknown all mean the pin. */
  // A stop with a shape no longer offered (sphere, cone) keeps it until the
  // creator picks another: no tile is ticked and a line says what it is.
  let legacyShape: string | null = null;

  function setShape(key: string | null | undefined) {
    const shape = SHAPES.includes(key ?? '') ? key! : 'pin';
    form.querySelectorAll<HTMLInputElement>('input[name="shape"]').forEach((r) => { r.checked = false; });
    const radio = form.querySelector(`input[name="shape"][value="${shape}"]`) as HTMLInputElement | null;
    legacyShape = radio ? null : shape;
    if (radio) radio.checked = true;
    const note = q('[data-shape-legacy]') as HTMLElement;
    note.classList.toggle('hidden', !legacyShape);
    if (legacyShape) text(note, S.shapeLegacy.replace('{0}', S.shapeNames[legacyShape] ?? legacyShape));
    showSignFields();
  }

  /** The tile ticked: pin, cube, sign, ai or model. */
  function chosenTile(): string | null {
    return (form.querySelector('input[name="shape"]:checked') as HTMLInputElement | null)?.value ?? null;
  }

  /** What is saved as the stop's style: an AI model is a model. */
  function chosenShape(): string {
    const tile = chosenTile();
    return tile === 'ai' ? 'model' : tile ?? legacyShape ?? 'pin';
  }

  // ------------------------------------------------------------- the model
  // The stop's own 3D model (0055): the row that is saved, a new file waiting to
  // go up with the step, and what the checks found in it.
  let modelRow: any = null;
  // Which AI made the model in hand, or null for a file the creator brought.
  let modelAi: Ai3dSource | null = null;
  let modelFile: File | null = null;
  let modelInfo: GlbInfo | null = null;
  let modelUrl = '';
  let viewer: HTMLElement | null = null;
  const mq = <T extends HTMLElement = HTMLInputElement>(k: string) => q(`[data-model-${k}]`) as unknown as T;
  const LICENCES = ['CC0', 'CC BY 4.0', 'CC BY-SA 4.0'];

  function modelSay(message: string, bad: boolean) {
    const el = mq<HTMLElement>('check');
    el.hidden = !message;
    el.style.color = bad ? 'var(--alert)' : 'var(--ink-dim)';
    text(el, message);
  }

  function problemText(p: GlbProblem) {
    const n = (x: number) => x.toLocaleString(S.lang === 'bg' ? 'bg-BG' : 'en-GB');
    switch (p.kind) {
      case 'tooBig': return S.mdl.tooBig.replace('{0}', megabytes(p.bytes));
      case 'tooManyTriangles': return S.mdl.tooManyTriangles.replace('{0}', n(p.triangles));
      case 'textureTooBig': return S.mdl.textureTooBig.replace('{0}', `${p.width}×${p.height}`);
      case 'compressed': return S.mdl.compressed.replace('{0}', p.extension);
      case 'external': return S.mdl.external;
      case 'noMesh': return S.mdl.noMesh;
      default: return S.mdl.notGlb;
    }
  }

  function summary(bytes: number, triangles: number, animated: boolean) {
    return S.mdl.ok.replace('{0}', megabytes(bytes))
      .replace('{1}', triangles.toLocaleString(S.lang === 'bg' ? 'bg-BG' : 'en-GB'))
      + (animated ? S.mdl.animated : '');
  }

  /** The preview: Google's model-viewer, loaded the first time a model is shown. */
  async function showPreview(url: string) {
    const empty = mq<HTMLElement>('empty');
    if (!url) { viewer?.remove(); viewer = null; empty.hidden = false; return; }
    await import('@google/model-viewer');
    // A new element for each file: changing src on a live one trips an error
    // inside model-viewer's AR part.
    if (viewer && viewer.getAttribute('src') !== url) { viewer.remove(); viewer = null; }
    if (!viewer) {
      viewer = document.createElement('model-viewer');
      for (const [k, v] of [['camera-controls', ''], ['autoplay', ''], ['shadow-intensity', '0.9'], ['loading', 'eager'],
                            ['interaction-prompt', 'none'], ['camera-orbit', '0deg 72deg auto'],
                            ['alt', S.lang === 'bg' ? 'Моделът на спирката' : 'The stop’s model']]) {
        viewer.setAttribute(k, v);
      }
      mq<HTMLElement>('stage').append(viewer);
    }
    empty.hidden = true;
    if (viewer.getAttribute('src') !== url) viewer.setAttribute('src', url);
    turnPreview();
  }

  /** The preview is seen from the south: a model facing south shows its front. */
  function turnPreview() {
    const deg = ((Number(mq('heading').value) || 0) % 360 + 360) % 360;
    viewer?.setAttribute('orientation', `0deg 0deg ${180 - deg}deg`);
    text(mq<HTMLElement>('compass'), ['N', 'NE', 'E', 'SE', 'S', 'SW', 'W', 'NW'][Math.round(deg / 45) % 8]);
  }

  function creditOther() {
    return (form.querySelector('input[name="modelCredit"]:checked') as HTMLInputElement | null)?.value === 'other';
  }
  function showCredit() {
    const box = mq<HTMLElement>('other');
    box.classList.toggle('hidden', !creditOther());
    box.classList.toggle('grid', creditOther());
    mq<HTMLElement>('licence-other-row').classList.toggle('hidden', (mq<HTMLSelectElement>('licence')).value !== 'other');
  }
  function licence() {
    const v = mq<HTMLSelectElement>('licence').value;
    return v === 'other' ? mq('licence-other').value.trim() : v;
  }

  async function loadModel(m: any) {
    modelFile = null; modelInfo = null;
    mq('file').value = '';
    mq('rights').checked = false;
    modelSay('', false);
    const { data } = await client.from('marker_models').select('*').eq('marker_id', m.id).maybeSingle();
    if (selected !== m.id) return;
    modelRow = data ?? null;
    modelAi = modelRow?.credit_source === 'ai' ? modelRow.ai_source : null;
    if (modelAi && chosenTile() === 'model') {
      (form.querySelector('input[name="shape"][value="ai"]') as HTMLInputElement).checked = true;
      showModelFields();
    }
    paintCredit();
    mq('height').value = modelRow ? String(Math.round(modelRow.height_m * 100) / 100) : '';
    mq('heading').value = mq('heading-num').value = String(modelRow?.heading_deg ?? 0);
    const other = modelRow?.credit_source === 'other';
    (form.querySelector(`input[name="modelCredit"][value="${other ? 'other' : 'own'}"]`) as HTMLInputElement).checked = true;
    mq('author').value = modelRow?.credit_author ?? '';
    mq('link').value = modelRow?.credit_link ?? '';
    const lic = modelRow?.credit_licence ?? 'CC0';
    mq<HTMLSelectElement>('licence').value = LICENCES.includes(lic) ? lic : 'other';
    mq('licence-other').value = LICENCES.includes(lic) ? '' : lic;
    showCredit();
    const current = mq<HTMLElement>('current');
    current.hidden = !modelRow;
    if (modelRow) text(current, S.mdl.current.replace('{0}', summary(modelRow.bytes, modelRow.triangles, modelRow.animated)));
    modelUrl = modelRow ? client.storage.from('marker-media').getPublicUrl(modelRow.path).data.publicUrl : '';
    if (chosenShape() === 'model') showPreview(modelUrl);
    else showPreview('');
  }

  function showModelFields() {
    const on = chosenShape() === 'model';
    mq<HTMLElement>('fields').classList.toggle('hidden', !on);
    form.querySelectorAll<HTMLElement>('[data-src-panel]').forEach((p) => {
      p.hidden = p.dataset.srcPanel !== (chosenTile() === 'ai' ? 'ai' : 'file');
    });
    // The file instructions and "whose model" belong to a file, not to AI.
    const ai = chosenTile() === 'ai';
    mq<HTMLElement>('hint').hidden = ai;
    text(mq<HTMLElement>('empty-label'), ai ? S.ai3d.emptyStage : S.mdl.choose);
    paintCredit();
    if (on) showPreview(modelUrl);
  }

  /** A model in hand - chosen, converted from STL or made by AI - checked and previewed. */
  async function takeModel(file: File, ai: Ai3dSource | null): Promise<boolean> {
    // WebP textures (TRELLIS.2 and many tools) re-saved as JPEG/PNG for the app.
    try { file = await glbForApp(file); } catch { /* not a GLB three.js can read: inspectGlb says why */ }
    const found = inspectGlb(await file.arrayBuffer());
    if (!found.ok) {
      modelFile = null; modelInfo = null;
      modelSay(problemText(found.problem), true);
      return false;
    }
    modelFile = file; modelInfo = found.info; modelAi = ai;
    paintCredit();
    modelSay((ai ? S.ai3d.done + ' ' : '') + summary(file.size, found.info.triangles, found.info.animated), false);
    // Its own size, if it was made at a size that makes sense in a street.
    // An AI model has no real size of its own: it starts at 2 m.
    const h = found.info.height;
    // Gemini sizes its shapes in metres, so its own height is kept; TRELLIS's
    // has no real size and starts at 2 m.
    const ownSize = !ai || ai === 'gemini';
    mq('height').value = String(ownSize && h >= 0.2 && h <= 200 ? Math.round(h * 10) / 10 : ai ? 2 : 1);
    if (modelUrl.startsWith('blob:')) URL.revokeObjectURL(modelUrl);
    modelUrl = URL.createObjectURL(file);
    showPreview(modelUrl);
    dirty = true;
    return true;
  }

  function paintCredit() {
    mq<HTMLElement>('credit').hidden = Boolean(modelAi) || chosenTile() === 'ai';
  }

  mq('file').addEventListener('change', async () => {
    const input = mq('file');
    let file = input.files?.[0];
    if (!file) return;
    // STL: converted to a GLB here, so everything after is the same (7 Nov 2026).
    if (isStl(file)) {
      modelSay(S.mdl.stl, false);
      try {
        const glb = await stlToGlb(file, hue === null ? DEFAULT_STOP_COLOUR : hueToHex(hue));
        file = new File([glb], file.name.replace(/\.stl$/i, '.glb'), { type: 'model/gltf-binary' });
      } catch {
        input.value = ''; modelSay(S.mdl.stlBad, true); return;
      }
    } else {
      modelSay(S.mdl.checking, false);
    }
    if (!(await takeModel(file, null))) input.value = '';
  });

  // ------------------------------------------------- a model made by AI
  // Photos and/or a video, and an optional description (8 Nov 2026). A video
  // gives up a few of its frames as pictures; the creator taps the best one.
  // TRELLIS.2 builds from one picture, so the description is used when there
  // is no picture: it becomes one first (FLUX.1).
  let aiPictures: Blob[] = [];
  let aiChosen = 0;

  /** Six frames spread through a video, as JPEGs. */
  async function videoFrames(file: File, count = 6): Promise<Blob[]> {
    const video = document.createElement('video');
    video.muted = true; video.playsInline = true; video.preload = 'auto';
    video.src = URL.createObjectURL(file);
    await new Promise<void>((ok, bad) => { video.onloadeddata = () => ok(); video.onerror = () => bad(new Error('video')); });
    const canvas = document.createElement('canvas');
    const scale = Math.min(1, 1024 / Math.max(video.videoWidth, video.videoHeight));
    canvas.width = Math.round(video.videoWidth * scale);
    canvas.height = Math.round(video.videoHeight * scale);
    const frames: Blob[] = [];
    for (let i = 0; i < count; i++) {
      video.currentTime = Math.min(video.duration - 0.05, (video.duration * (i + 0.5)) / count);
      await new Promise<void>((ok) => { video.onseeked = () => ok(); });
      canvas.getContext('2d')!.drawImage(video, 0, 0, canvas.width, canvas.height);
      const blob = await new Promise<Blob | null>((ok) => canvas.toBlob(ok, 'image/jpeg', 0.88));
      if (blob) frames.push(blob);
    }
    URL.revokeObjectURL(video.src);
    return frames;
  }

  function drawThumbs() {
    const box = q('[data-ai-thumbs]') as HTMLElement;
    box.replaceChildren(...aiPictures.map((f, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'ai-thumb' + (i === aiChosen ? ' is-on' : '');
      b.title = S.ai3d.pick;
      const img = document.createElement('img');
      img.src = URL.createObjectURL(f); img.alt = '';
      b.append(img);
      b.addEventListener('click', () => { aiChosen = i; drawThumbs(); });
      return b;
    }));
  }

  q('[data-ai-media]')?.addEventListener('change', async (e) => {
    const files = Array.from((e.target as HTMLInputElement).files ?? []);
    const pictures: Blob[] = [];
    for (const f of files) {
      if (f.type.startsWith('video/')) {
        modelSay(S.ai3d.frames, false);
        try { pictures.push(...await videoFrames(f)); } catch { modelSay(S.ai3d.videoBad, true); }
      } else {
        pictures.push(f);
      }
    }
    aiPictures = pictures.slice(0, 12);
    aiChosen = 0;
    if (aiPictures.length) modelSay('', false);
    drawThumbs();
  });

  function aiFail(e: unknown) {
    const reason = e instanceof Ai3dError ? e.reason : 'failed';
    modelSay(S.ai3d[reason] ?? S.ai3d.failed, true);
  }

  q('[data-ai-make]')?.addEventListener('click', async (e) => {
    const button = e.currentTarget as HTMLButtonElement;
    const say = (stage: string) => modelSay(S.ai3d[stage] ?? '', false);
    const words = (q('[data-ai-text]') as HTMLTextAreaElement).value.trim();
    const picture: Blob | null = aiPictures[aiChosen] ?? null;
    if (!picture && words.length < 3) { modelSay(S.ai3d.needInput, true); return; }
    button.disabled = true;
    try {
      let made: { glb: Blob; source: Ai3dSource };
      let note = '';
      if (!picture) {
        // A description: Gemini designs it as shapes (free, 9 Nov 2026).
        made = await describeToShapes(words, null, say);
      } else {
        // A photo: TRELLIS for a realistic model; when its free allowance is
        // used up, Gemini makes a low-poly one from the same photo.
        try {
          made = await photoTo3d(picture, say);
        } catch (err) {
          if (!(err instanceof Ai3dError) || (err.reason !== 'allowance' && err.reason !== 'busy')) throw err;
          made = await describeToShapes(words, picture, say);
          note = S.ai3d.lowpoly;
        }
      }
      await takeModel(new File([made.glb], `ai-${made.source}.glb`, { type: 'model/gltf-binary' }), made.source);
      if (note) modelSay(note + ' ' + (mq<HTMLElement>('check').textContent ?? ''), false);
    } catch (err) {
      aiFail(err);
    } finally {
      button.disabled = false;
    }
  });

  mq('heading').addEventListener('input', () => { mq('heading-num').value = mq('heading').value; turnPreview(); });
  mq('heading-num').addEventListener('input', () => { mq('heading').value = mq('heading-num').value; turnPreview(); });
  form.querySelectorAll('input[name="modelCredit"]').forEach((r) => r.addEventListener('change', showCredit));
  mq<HTMLSelectElement>('licence').addEventListener('change', showCredit);

  /** What is still missing before the model can be saved, or nothing. */
  function modelProblem(): string {
    if (!modelRow && !modelFile) return S.mdl.need;
    const h = Number(mq('height').value);
    if (!(h >= 0.2 && h <= 200)) return S.lang === 'bg' ? 'Височината е между 0,2 и 200 m.' : 'The height is between 0.2 and 200 m.';
    if (creditOther() && (!mq('author').value.trim() || !licence() || !/^https:\/\/\S+$/.test(mq('link').value.trim()))) return S.mdl.needCredit;
    if (modelFile && !modelAi && !mq('rights').checked) return S.mdl.needRights;
    return '';
  }

  /** Uploads a new file if there is one, then writes the row. Null when it worked. */
  async function saveModel(markerId: string): Promise<string | null> {
    const old: string | undefined = modelRow?.path;
    let path = old;
    if (modelFile) {
      modelSay(S.mdl.uploading, false);
      path = `${worldId}/${markerId}/model-${crypto.randomUUID()}.glb`;
      // Typed here: a .glb picked on Windows comes with no type at all, and
      // storage refuses application/octet-stream.
      const body = new Blob([modelFile], { type: 'model/gltf-binary' });
      const up = await client.storage.from('marker-media').upload(path, body, { contentType: 'model/gltf-binary', upsert: false });
      if (up.error) { modelSay('', false); return up.error.message; }
    }
    const other = !modelAi && creditOther();
    const row = {
      marker_id: markerId,
      path,
      triangles: modelInfo?.triangles ?? modelRow.triangles,
      animated: modelInfo?.animated ?? modelRow.animated,
      height_m: Number(mq('height').value),
      heading_deg: ((Math.round(Number(mq('heading').value)) || 0) % 360 + 360) % 360,
      credit_source: modelAi ? 'ai' : other ? 'other' : 'own',
      ai_source: modelAi,
      credit_author: other ? mq('author').value.trim() : null,
      credit_licence: other ? licence() : null,
      credit_link: other ? mq('link').value.trim() : null,
    };
    const { data, error } = await client.from('marker_models').upsert(row, { onConflict: 'marker_id' }).select().single();
    if (error) {
      if (modelFile && path && path !== old) await client.storage.from('marker-media').remove([path]);
      modelSay('', false);
      return error.message;
    }
    // The new file is in; the one it replaced goes.
    if (modelFile && old && old !== path) await client.storage.from('marker-media').remove([old]);
    modelRow = data;
    modelFile = null; modelInfo = null;
    mq('file').value = '';
    mq('rights').checked = false;
    modelSay('', false);
    const current = mq<HTMLElement>('current');
    current.hidden = false;
    text(current, S.mdl.current.replace('{0}', summary(data.bytes, data.triangles, data.animated)));
    loadUsage();
    return null;
  }

  function showSignFields() {
    showModelFields();
    const sign = chosenShape() === 'sign';
    const box = q('[data-sign-fields]') as HTMLElement | null;
    box?.classList.toggle('hidden', !sign);
    box?.classList.toggle('grid', sign);
  }

  form.querySelectorAll('input[name="shape"]').forEach((r) => r.addEventListener('change', () => {
    legacyShape = null;
    (q('[data-shape-legacy]') as HTMLElement).classList.add('hidden');
    showSignFields();
  }));

  function hueFromEvent(event: PointerEvent | MouseEvent) {
    const strip = q('[data-hue]') as HTMLElement;
    const box = strip.getBoundingClientRect();
    const across = Math.min(Math.max(event.clientX - box.left, 0), box.width);

    hue = Math.round((across / Math.max(box.width, 1)) * 359);
    dirty = true;
    paintHue();
  }

  q('[data-hue]')?.addEventListener('pointerdown', (event) => {
    const strip = event.currentTarget as HTMLElement;
    strip.setPointerCapture((event as PointerEvent).pointerId);
    hueFromEvent(event as PointerEvent);
  });

  q('[data-hue]')?.addEventListener('pointermove', (event) => {
    // Only while dragging. buttons is a bitmask and zero means the pointer is
    // over the strip rather than pressed on it.
    if ((event as PointerEvent).buttons !== 0) hueFromEvent(event as PointerEvent);
  });

  // Arrow keys, because a slider that only takes a pointer is not a slider.
  q('[data-hue]')?.addEventListener('keydown', (event) => {
    const key = (event as KeyboardEvent).key;
    const step = key === 'ArrowLeft' ? -5 : key === 'ArrowRight' ? 5 : 0;
    if (!step) return;

    event.preventDefault();
    hue = ((hue ?? DEFAULT_HUE) + step + 360) % 360;
    dirty = true;
    paintHue();
  });

  // ------------------------------------------------------------------ import
  //
  // A spreadsheet is the fastest way anybody has ever entered forty fields, and
  // the builder was asking for them five tabs at a time. One row is one stop.
  //
  // Tab-separated as well as comma-separated, because pasting straight out of
  // Excel gives tabs and telling somebody to "save as CSV first" is a step that
  // exists only to make the parser's life easier.

  const IMPORT_COLUMNS = [
    'name_bg', 'name_en', 'text_bg', 'text_en', 'lat', 'lng', 'radius_m',
    'question_bg', 'question_en', 'kind', 'accepted', 'points',
    'on_wrong', 'deduct', 'wait_seconds', 'hint_bg', 'hint_en', 'hint_cost',
    // Optional, last, so a sheet made before shapes existed still imports.
    'shape', 'sign_bg', 'sign_en',
  ];

  const KINDS = ['none', 'exact', 'choice', 'free'];
  const RULES = ['retry', 'lock', 'deduct', 'skip'];

  /**
   * Splits one delimited line, honouring quotes.
   *
   * Written out rather than pulled in: a CSV library is forty kilobytes to
   * handle a quote and a doubled quote, and those are the only two rules a
   * spreadsheet export actually uses.
   */
  function splitLine(line: string, sep: string): string[] {
    const out: string[] = [];
    let field = '';
    let quoted = false;

    for (let i = 0; i < line.length; i++) {
      const ch = line[i];

      if (quoted) {
        if (ch === '"') {
          if (line[i + 1] === '"') { field += '"'; i++; }
          else quoted = false;
        } else field += ch;
      } else if (ch === '"') {
        quoted = true;
      } else if (ch === sep) {
        out.push(field); field = '';
      } else field += ch;
    }

    out.push(field);
    return out.map((f) => f.trim());
  }

  function parseSheet(raw: string) {
    const lines = raw.replace(/\r\n?/g, '\n').split('\n').filter((l) => l.trim().length);
    if (lines.length === 0) return { error: S.impNoHeader, rows: [] as any[] };

    // Whichever the header line has more of. A name with a comma in it is
    // common; a name with a tab in it is not.
    const sep = (lines[0].split('\t').length > lines[0].split(',').length) ? '\t' : ',';
    const header = splitLine(lines[0], sep).map((h) => h.toLowerCase());

    if (!header.includes('name_bg') || !header.includes('lat')) {
      return { error: S.impNoHeader, rows: [] as any[] };
    }
    if (lines.length === 1) return { error: S.impNoRows, rows: [] as any[] };

    const rows = lines.slice(1).map((line, i) => {
      const cells = splitLine(line, sep);
      const row: Record<string, string> = {};
      header.forEach((h, c) => { row[h] = cells[c] ?? ''; });
      return { line: i + 2, row };
    });

    return { error: null as string | null, rows };
  }

  /** Everything wrong with one row, in the creator's language. */
  function checkRow(row: Record<string, string>, existing: Set<string>) {
    const problems: string[] = [];
    const name = (row.name_bg ?? '').trim();

    if (!name) problems.push(S.impNeedName);
    else if (existing.has(name.toLowerCase())) problems.push(S.impDupe);

    const lat = Number(row.lat);
    const lng = Number(row.lng);
    if (!Number.isFinite(lat) || !Number.isFinite(lng)
        || Math.abs(lat) > 90 || Math.abs(lng) > 180) {
      problems.push(S.impBadCoords);
    }

    const kind = (row.kind ?? '').trim().toLowerCase() || 'none';
    if (!KINDS.includes(kind)) problems.push(S.impBadKind);
    if (kind === 'exact' && !(row.accepted ?? '').trim()) problems.push(S.impNeedAccepted);

    const rule = (row.on_wrong ?? '').trim().toLowerCase() || 'retry';
    if (!RULES.includes(rule)) problems.push(S.impBadOnWrong);

    const shape = (row.shape ?? '').trim().toLowerCase() || 'pin';
    if (shape === 'model') problems.push(S.mdl.imp);
    else if (!IMPORTABLE.includes(shape)) problems.push(S.impBadShape);
    if ((row.sign_bg ?? '').trim().length > 80 || (row.sign_en ?? '').trim().length > 80) {
      problems.push(S.impLongSign);
    }

    return problems;
  }

  let checked: { line: number; row: Record<string, string> }[] = [];

  function impStatus(message: string) {
    text(q('[data-imp-status]'), message);
  }

  q('[data-imp-template]')?.addEventListener('click', () => {
    // One header row and one filled-in example, because an empty template
    // leaves somebody guessing what "exact" or "lock" are supposed to look like.
    const example = [
      'Безистенът', 'The Bezisten', 'Покрит пазар от 15 век', 'A covered market',
      '42.48412', '26.50598', '25',
      'Кой век?', 'Which century?', 'exact', '15,XV,петнайсети', '40',
      'lock', '0', '60', 'Погледни над вратата', 'Look above the door', '5',
      'sign', 'Безистенът · 1509–1510', 'The Bezisten · 1509–1510',
    ];
    const csv = IMPORT_COLUMNS.join(',') + '\n'
      + example.map((v) => (v.includes(',') ? `"${v}"` : v)).join(',') + '\n';

    const url = URL.createObjectURL(new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8' }));
    const a = document.createElement('a');
    a.href = url;
    a.download = 'artrail-stops.csv';
    a.click();
    URL.revokeObjectURL(url);
  });

  (q('[data-imp-file]') as HTMLInputElement)?.addEventListener('change', async (event) => {
    const file = (event.target as HTMLInputElement).files?.[0];
    if (!file) return;
    (q('[data-imp-text]') as HTMLTextAreaElement).value = await file.text();
  });

  q('[data-imp-check]')?.addEventListener('click', () => {
    const raw = (q('[data-imp-text]') as HTMLTextAreaElement).value;
    const report = q('[data-imp-report]')!;
    const go = q('[data-imp-go]') as HTMLButtonElement;

    checked = [];
    report.innerHTML = '';
    go.classList.add('hidden');

    const parsed = parseSheet(raw);
    if (parsed.error) { impStatus(parsed.error); return; }

    // Names already on the trail, so a second paste of the same sheet is caught
    // rather than doubling every stop.
    const existing = new Set(
      markers.map((m: any) => (m.content?.bg?.title ?? '').trim().toLowerCase()).filter(Boolean));

    const bad: string[] = [];

    for (const entry of parsed.rows) {
      const problems = checkRow(entry.row, existing);

      if (problems.length) {
        bad.push(`${S.impRow.replace('{0}', String(entry.line))}: ${problems.join(' · ')}`);
      } else {
        checked.push(entry);
        // A duplicate inside the sheet itself counts too.
        existing.add((entry.row.name_bg ?? '').trim().toLowerCase());
      }
    }

    report.innerHTML = bad
      .map((b) => `<li class="text-[var(--alert)]">${escapeHtml(b)}</li>`).join('');

    impStatus(`${S.impReady.replace('{0}', String(checked.length))}`
      + (bad.length ? ` · ${S.impProblems.replace('{0}', String(bad.length))}` : ''));

    if (checked.length) {
      text(go, S.impImport.replace('{0}', String(checked.length)));
      go.classList.remove('hidden');
    }
  });

  q('[data-imp-go]')?.addEventListener('click', async (event) => {
    const go = event.currentTarget as HTMLButtonElement;
    go.disabled = true;
    impStatus(S.impImporting);

    let made = 0;
    const failed: string[] = [];

    for (const entry of checked) {
      const r = entry.row;
      const kind = (r.kind ?? '').trim().toLowerCase() || 'none';

      const content: Record<string, any> = {
        bg: { title: r.name_bg.trim(), ...(r.text_bg?.trim() && { body: r.text_bg.trim() }) },
      };
      if (r.name_en?.trim() || r.text_en?.trim()) {
        content.en = {
          ...(r.name_en?.trim() && { title: r.name_en.trim() }),
          ...(r.text_en?.trim() && { body: r.text_en.trim() }),
        };
      }
      if (kind !== 'none') {
        if (r.question_bg?.trim()) content.bg.question = r.question_bg.trim();
        if (r.question_en?.trim()) {
          content.en = { ...(content.en ?? {}), question: r.question_en.trim() };
        }
      }

      const shape = (r.shape ?? '').trim().toLowerCase() || 'pin';
      if (shape === 'sign') {
        if (r.sign_bg?.trim()) content.bg.sign = r.sign_bg.trim();
        if (r.sign_en?.trim()) content.en = { ...(content.en ?? {}), sign: r.sign_en.trim() };
      }

      const placed = await client.rpc('place_marker', {
        p_world: worldId, p_lat: Number(r.lat), p_lng: Number(r.lng),
        p_content: content, p_status: 'published', p_style_key: shape,
      });

      const id = Array.isArray(placed.data) ? placed.data[0]?.id : (placed.data as any)?.id;

      if (placed.error || !id) {
        failed.push(`${S.impRow.replace('{0}', String(entry.line))}: `
          + (placed.error?.message ?? S.impFailed));
        continue;
      }

      const radius = Number(r.radius_m);
      if (Number.isFinite(radius) && radius > 0) {
        await client.from('markers').update({ radius_m: radius }).eq('id', id);
      }

      if (kind !== 'none') {
        const accepted = (r.accepted ?? '').split(',').map((x) => x.trim()).filter(Boolean);
        const answer = await client.rpc('set_marker_answer', {
          p_marker: id,
          p_kind: kind,
          p_accepted: kind === 'exact' ? accepted : null,
          p_points: Number(r.points) || 10,
          p_cooldown_seconds: Number(r.wait_seconds) || null,
          p_on_wrong: (r.on_wrong ?? '').trim().toLowerCase() || 'retry',
          p_deduct_points: Number(r.deduct) || 0,
        });

        if (answer.error) {
          failed.push(`${S.impRow.replace('{0}', String(entry.line))}: ${answer.error.message}`);
        }
      }

      const hintBg = (r.hint_bg ?? '').trim();
      const hintEn = (r.hint_en ?? '').trim();

      if (hintBg || hintEn) {
        await client.from('marker_hints').insert({
          marker_id: id, ord: 1, cost: Number(r.hint_cost) || 0,
          body: { ...(hintBg && { bg: hintBg }), ...(hintEn && { en: hintEn }) },
        });
      }

      made++;
    }

    q('[data-imp-report]')!.innerHTML = failed
      .map((f) => `<li class="text-[var(--alert)]">${escapeHtml(f)}</li>`).join('');

    impStatus(S.impDone.replace('{0}', String(made)).replace('{1}', String(failed.length)));

    checked = [];
    go.classList.add('hidden');
    go.disabled = false;
    (q('[data-imp-text]') as HTMLTextAreaElement).value = '';

    await load();
  });
  // Last of all: it reads constants declared all through this file.
  loadUsage().catch(() => {});
  markReady();
</script>

<style>
  /* The builder's pins: a teardrop in the stop's colour with its number, the
     chosen one larger and raised above the rest. */
  :global(.ed-pin) { width: 30px; height: 40px; cursor: grab; display: flex; justify-content: center; }
  :global(.ed-pin.is-on) { z-index: 2; }
  :global(.ed-pin-head) { position: relative; width: 30px; height: 30px; display: grid; place-items: center;
    color: #fff; font: 700 13px/1 system-ui, sans-serif; transform-origin: 50% 130%; transition: transform .18s cubic-bezier(.3,1.4,.5,1); }
  :global(.ed-pin-head)::before { content: ""; position: absolute; inset: 0; border-radius: 50% 50% 50% 0; transform: rotate(-45deg);
    background: var(--pin, #0066cc); border: 2.5px solid #fff; box-shadow: 0 2px 6px rgba(0,0,0,.4); z-index: -1; }
  :global(.ed-pin-head) { isolation: isolate; }
  :global(.ed-pin.is-on .ed-pin-head) { transform: scale(1.25); }
  :global(.ed-pin.is-on .ed-pin-head)::before { box-shadow: 0 0 0 4px rgba(0,102,204,.25), 0 3px 8px rgba(0,0,0,.45); }
  .hints-box { margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--line-soft); }
  .hints-head h4 { font-size: 1.0625rem; font-weight: 600; letter-spacing: -.01em; }
  .hints-head p { margin-top: .25rem; font-size: var(--text-sm); color: var(--ink-dim); }
  .ai-thumbs { display: flex; flex-wrap: wrap; gap: .5rem; }
  .ai-thumbs:empty { display: none; }
  .ai-thumb { width: 64px; height: 64px; padding: 0; border-radius: 12px; overflow: hidden; border: 2px solid transparent; }
  .ai-thumb.is-on { border-color: var(--signal); }
  .ai-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ai-picture { width: 128px; height: 128px; object-fit: cover; border-radius: 14px; border: 1px solid var(--line); }
  .ai-row { display: flex; flex-wrap: wrap; align-items: center; gap: .375rem .875rem; margin-bottom: 1rem; }
  .ai-row .btn svg { margin-right: .375rem; }
  .ai-say { font-size: var(--text-sm); color: var(--ink-dim); }
  .ai-say:empty { display: none; }
  .ai-note { flex-basis: 100%; font-size: var(--text-xs); color: var(--ink-faint); }
  .start-card { display: grid; gap: 1.5rem; padding: 1.5rem; align-items: start; }
  .start-card.hidden { display: none; }
  @media (min-width: 720px) { .start-card { grid-template-columns: minmax(0, 1fr) 11rem; } }
  .start-tips { list-style: none; margin: 1rem 0 0; padding: 0; display: grid; gap: .875rem; }
  .start-tips li { display: grid; grid-template-columns: 26px 1fr; gap: .625rem; font-size: var(--text-sm); color: var(--ink-dim); }
  .start-tips span { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--signal-wash); color: var(--signal); font-size: 12px; font-weight: 600; }
  .start-shot { margin: 0; }
  .start-shot :global(.shot) { width: 11rem; border-width: 5px; border-radius: 26px; }
  .start-shot figcaption { margin-top: .5rem; font-size: var(--text-xs); color: var(--ink-faint); text-align: center; }
  @media (max-width: 719px) { .start-shot { display: none; } }
  :global(.trail-no-points) [data-points-only] { display: none !important; }
  /* ------------------------------------------------------------ the steps */
  .wiz {
    /* clip, not hidden: hidden would make the form its own scroller and the
       Next bar could never stick to the bottom of the screen. */
    display: flex; flex-direction: column; position: relative; overflow: clip;
    border: 1px solid var(--line); border-radius: 26px; background: var(--surface);
  }
  .wiz.hidden { display: none; }
  .wiz-top { padding: 1.375rem 1.5rem 0; }
  .wiz-id { display: flex; align-items: center; gap: .875rem; }
  .wiz-pin {
    flex: none; width: 44px; height: 44px; border-radius: 14px; display: grid; place-items: center;
    background: var(--signal); color: #fff; font-size: 1rem; font-weight: 600;
    transition: background-color .3s ease;
  }
  .wiz-title { margin-top: 3px; font-size: 1.25rem; line-height: 1.2; letter-spacing: -.02em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .wiz-count { flex: none; font-size: .8125rem; color: var(--ink-faint); }

  .stepper { list-style: none; margin: 1.25rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; }
