---
import Loading from './Loading.astro';
import { useTranslations, localise, type Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const href = localise(lang);

/**
 * The stop editor, in steps.
 *
 * It was one column of eighteen fields, then five tabs with one Save button,
 * and in both a creator had to find the parts for themselves. Now the same five
 * parts come in order - Basics, Place, Question, Hints, Media - with Previous
 * and Next, each step saved as it is left. Question and Hints can be skipped,
 * because a plain tour has neither.
 *
 * The map and the stop list stay outside the steps. They are how you choose
 * what you are editing, so they cannot live inside one of the things chosen.
 */
const steps = [
  { id: 'basics',   label: t('tab.basics'),   sub: t('wiz.basics.sub') },
  { id: 'place',    label: t('tab.place'),    sub: t('wiz.place.sub') },
  { id: 'question', label: t('tab.question'), sub: t('wiz.optional') },
  { id: 'hints',    label: t('tab.hints'),    sub: t('wiz.optional') },
  { id: 'media',    label: t('tab.media'),    sub: t('wiz.media.sub') },
];

// What a stop asks, as four choices rather than a dropdown: the choice decides
// which half of the step is shown, so it should be seen whole.
const kinds = [
  { value: 'none',   label: t('ed.answerNone'),   body: t('wiz.kind.none') },
  { value: 'exact',  label: t('ed.answerExact'),  body: t('wiz.kind.exact') },
  { value: 'choice', label: t('ed.answerChoice'), body: t('wiz.kind.choice') },
  { value: 'free',   label: t('ed.answerFree').split(' (')[0], body: t('wiz.kind.free') },
];

/**
 * What stands in the street at a stop. The keys are the ones the database
 * accepts (0054) and the app has a prefab for; 'pin' is also what 'default'
 * and an empty value mean. Drawn in currentColor so each card is the stop's
 * own colour once one is picked.
 */
const shapes = [
  { key: 'pin', label: t('ed.shape.pin'),
    svg: '<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M16 29s-8-8.6-8-15a8 8 0 1 1 16 0c0 6.4-8 15-8 15Z" fill="currentColor" fill-opacity=".25"/><circle cx="16" cy="14" r="3"/></svg>' },
  { key: 'sphere', label: t('ed.shape.sphere'),
    svg: '<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="16" cy="14" r="9" fill="currentColor" fill-opacity=".25"/><path d="M11.5 10.5a5 5 0 0 1 4-2.5"/><ellipse cx="16" cy="28" rx="8" ry="2"/></svg>' },
  { key: 'cone', label: t('ed.shape.cone'),
    svg: '<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M16 4 8 26h16L16 4Z" fill="currentColor" fill-opacity=".25"/><path d="M11 18h10"/><ellipse cx="16" cy="28" rx="10" ry="2"/></svg>' },
  { key: 'cube', label: t('ed.shape.cube'),
    svg: '<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M16 6 26 11v11l-10 5-10-5V11l10-5Z" fill="currentColor" fill-opacity=".25"/><path d="M6 11l10 5 10-5M16 16v11"/></svg>' },
  { key: 'sign', label: t('ed.shape.sign'),
    svg: '<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="24" height="14" rx="2" fill="currentColor" fill-opacity=".25"/><path d="M9 9h14M9 13h9M16 18v11"/></svg>' },
  // The creator's own: a .glb they made or may share (0055).
  { key: 'model', label: t('ed.shape.model'),
    svg: '<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M16 3.5 26.5 9.5v13L16 28.5 5.5 22.5v-13L16 3.5Z" fill="currentColor" fill-opacity=".12"/><path d="M5.5 9.5 16 15.5l10.5-6M16 15.5v13"/><path d="M11 20.5c1.2-1.6 2.6-2.4 4-2.4M21 12.5l1.5 1.5M22.5 12.5 21 14" stroke-linecap="round"/></svg>' },
];

const strings = {
  lang,
  deleteConfirm: t('ed.deleteConfirm'), deleteNotOwner: t('ed.deleteNotOwner'),
  modes: { ctf: t('new.mode.ctf'), freefall: t('new.mode.freefall'),
           guide: t('new.mode.guide'), educational: t('new.mode.educational') },
  saved: t('ed.saved'), saving: t('ed.saving'),
  notYours: t('ed.notYours'), draft: t('ed.draft'), published: t('ed.published'),
  publish: t('ed.publish'), unpublish: t('ed.unpublish'),
  accept: t('ed.accept'), reject: t('ed.reject'), you: t('board.you'),
  rank: t('board.rank'), team: t('board.team'), bPoints: t('board.points'),
  bSolved: t('board.solved'), time: t('board.time'),
  overlap: t('ed.overlap'), remove: t('ed.remove'), hintCost: t('ed.hintCost'),
  uploading: t('ed.uploading'), tooBig: t('ed.tooBig'),
  mediaUsed: t('ed.mediaUsed'), mediaFull: t('ed.mediaFull'),
  mediaWontFit: t('ed.mediaWontFit'),
  reorderFailed: t('ed.reorderFailed'),
  teamSizeHint: t('ed.teamSizeHint'),
  impNoHeader: t('imp.noHeader'), impNoRows: t('imp.noRows'),
  impNeedName: t('imp.needName'), impBadCoords: t('imp.badCoords'),
  impBadKind: t('imp.badKind'), impNeedAccepted: t('imp.needAccepted'),
  impBadOnWrong: t('imp.badOnWrong'), impDupe: t('imp.dupe'),
  impBadShape: t('imp.badShape'), impLongSign: t('imp.longSign'),
  impRow: t('imp.row'), impReady: t('imp.ready'), impProblems: t('imp.problems'),
  impImport: t('imp.import'), impImporting: t('imp.importing'),
  impDone: t('imp.done'), impFailed: t('imp.failed'),
  lvDraft: t('vis.private'), lvDraftHint: t('vis.privateHint'),
  lvCode: t('vis.unlisted'), lvCodeHint: t('vis.unlistedHint'),
  lvPublic: t('vis.public'), lvPublicHint: t('vis.publicHint'),
  lvAsk: t('vis.publicAsk'), lvAskHint: t('vis.publicAskHint'),
  lvWaiting: t('mine.pending'), lvWaitingBody: t('mine.pendingBody'),
  lvNote: t('mine.reviewNote'), copy: t('pub.copy'), copied: t('pub.copied'),
  colourNone: t('ed.colourNone'), pubDrafts: t('pub.drafts'),
  miss: {
    title: t('miss.title'), optional: t('miss.optional'), titleBg: t('miss.titleBg'),
    titleEn: t('miss.titleEn'), place: t('miss.place'), question: t('miss.question'),
    choice: t('miss.choice'), accepted: t('miss.accepted'),
  },
  revealOff: t('ed.revealOff'),
  boardHref: href('/board'),
  hidden: t('board.hidden'), revBlock: t('rev.block'), revBlockConfirm: t('rev.blockConfirm'),
  ownerWord: t('ed.owner'), editorWord: t('ed.editor'), leaveConfirm: t('ed.leaveConfirm'),
  here: t('ed.here'), conflict: t('ed.conflict'), inviteHref: href('/editor-invite'),
  myTrailsHref: href('/my-trails'),
  mdl: {
    checking: t('mdl.checking'), ok: t('mdl.ok'), animated: t('mdl.animated'),
    notGlb: t('mdl.notGlb'), tooBig: t('mdl.tooBig'), tooManyTriangles: t('mdl.tooManyTriangles'),
    textureTooBig: t('mdl.textureTooBig'), compressed: t('mdl.compressed'), external: t('mdl.external'),
    noMesh: t('mdl.noMesh'), current: t('mdl.current'), need: t('mdl.need'), needRights: t('mdl.needRights'),
    needCredit: t('mdl.needCredit'), uploading: t('mdl.uploading'), imp: t('imp.model'),
  },
  wiz: {
    next: t('wiz.next'), done: t('wiz.done'), saved: t('wiz.saved'), skipped: t('wiz.skipped'),
    of: t('wiz.of'), newStop: t('wiz.newStop'), stop: t('wiz.stop'), untitled: t('wiz.untitled'),
    ready: t('wiz.ready'), skippedList: t('wiz.skippedList'),
    names: [t('tab.basics'), t('tab.place'), t('tab.question'), t('tab.hints'), t('tab.media')],
  },
};
---

<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6" hidden data-guarded>
  <header class="flex flex-wrap items-start justify-between gap-4">
    <div class="min-w-0">
      <a class="eyebrow hover:text-[var(--ink)]" href={href('/my-trails')}>← {t('nav.mine')}</a>
      <h1 class="mt-2 truncate text-2xl sm:text-3xl" data-trail-name></h1>
      <p class="mt-1 flex flex-wrap items-center gap-x-3 text-xs">
        <span class="eyebrow" data-trail-mode></span>
        <span class="eyebrow" data-trail-status></span>
      </p>
      <p class="mt-2 hidden max-w-md text-sm text-[var(--ink-dim)]" data-you-edit>{t('ed.youEdit')}</p>
      <!-- Who else has this trail open right now. Realtime presence: gone the
           moment their tab closes, and never stored anywhere. -->
      <p class="mt-2 hidden flex-wrap items-center gap-1.5 text-xs text-[var(--ink-dim)]" data-presence></p>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <div class="card flex items-center gap-2 px-3 py-2">
        <span class="eyebrow">{t('ed.code')}</span>
        <code class="data text-xl font-medium tracking-widest text-[var(--signal)]"
              data-trail-code></code>
        <button class="btn btn-ghost btn-sm" type="button" data-copy-code>{t('pub.copy')}</button>
        <button class="text-xs text-[var(--ink-faint)] underline-offset-2 hover:text-[var(--ink)] hover:underline"
                type="button" data-rotate data-owner-only title={t('ed.rotateHint')}>{t('ed.rotate')}</button>
      </div>
      <!-- Only ordered trails have a next marker to withhold, so this is
           switched off and explained on the two that do not. -->
      <label class="card flex items-center gap-2 px-3 py-2 text-xs" data-reveal-row data-owner-only>
        <input type="checkbox" data-reveal />
        <span>{t('ed.reveal')}</span>
      </label>

      <!-- Beside the code, because both are things you set once for the whole
           trail and then read out to a room. -->
      <label class="card flex items-center gap-2 px-3 py-2 text-xs" data-owner-only
             title={t('ed.teamSizeHint')}>
        <span class="eyebrow">{t('ed.teamSize')}</span>
        <input class="data w-12 bg-transparent text-base font-medium text-[var(--ink)] outline-none"
               data-team-size inputmode="numeric" maxlength="2" />
      </label>

      <!-- The creator's finish bonus (0056): XP for finishing, 0 to 500. -->
      <label class="card flex items-center gap-2 px-3 py-2 text-xs" data-owner-only
             title={t('ed.bonusHint')}>
        <span class="eyebrow">{t('ed.bonus')}</span>
        <input class="data w-14 bg-transparent text-base font-medium text-[var(--ink)] outline-none"
               data-finish-bonus inputmode="numeric" maxlength="3" aria-label={t('ed.bonusHint')} />
      </label>

      <!-- The same three rungs My trails offers. There used to be a Publish
           button here that wrote the same two columns with different words, so a
           trail could be "published" on one screen and "only me" on the other,
           and both were telling the truth about a different column. -->
      <div data-owner-only>
        <div class="tabs" data-levels>
          <button class="tab" type="button" data-level="draft">{t('vis.private')}</button>
          <button class="tab" type="button" data-level="code">{t('vis.unlisted')}</button>
          <button class="tab" type="button" data-level="public"></button>
        </div>
        <p class="mt-1.5 max-w-xs text-xs text-[var(--ink-faint)]" data-level-hint></p>
        <p class="mt-1.5 hidden max-w-xs text-xs text-[var(--lamp)]" data-level-note></p>
      </div>
    </div>
  </header>

  <div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)]">
    <!-- Choosing what to edit. Outside the tabs, because this is how a stop
         gets picked and it cannot live inside one of the things being picked. -->
    <div class="lg:sticky lg:top-20 lg:self-start">
      <div class="card overflow-hidden" style="padding:0">
        <div class="h-[340px] w-full sm:h-[420px]" data-map></div>
      </div>
      <p class="mt-2 text-xs text-[var(--ink-faint)]">{t('ed.placeHint')}</p>

      <p class="mt-3 hidden rounded-lg border border-[var(--lamp)] bg-[var(--lamp-wash)] px-3 py-2 text-xs text-[var(--lamp)]"
         data-overlap></p>

      <h2 class="mt-6 text-sm font-semibold">
        {t('ed.stops')} <span class="data text-[var(--ink-faint)]" data-stop-count></span>
      </h2>
      <p class="mt-2 text-sm text-[var(--ink-dim)]" data-stops-empty hidden>{t('ed.noStops')}</p>
      <ul class="mt-2 space-y-1.5" data-stops></ul>

      <!-- Eight stops with a question each is forty fields typed into five tabs.
           A creator who already has them in a spreadsheet should not have to. -->
      <details class="card mt-6 p-4" data-import>
        <summary class="cursor-pointer text-sm font-semibold">{t('imp.title')}</summary>

        <p class="mt-3 text-xs text-[var(--ink-dim)]">{t('imp.lede')}</p>

        <button class="btn btn-quiet btn-sm mt-3" type="button" data-imp-template>
          {t('imp.template')}
        </button>

        <label class="field-row mt-4">
          <span class="field-name">{t('imp.paste')}</span>
          <textarea class="field data" rows="5" data-imp-text
                    placeholder="name_bg	name_en	text_bg	..."></textarea>
        </label>

        <label class="field-row mt-3">
          <span class="field-name">{t('imp.file')}</span>
          <input class="field" type="file" accept=".csv,text/csv" data-imp-file />
        </label>

        <div class="mt-3 flex flex-wrap gap-2">
          <button class="btn btn-quiet btn-sm" type="button" data-imp-check>{t('imp.check')}</button>
          <button class="btn btn-primary btn-sm hidden" type="button" data-imp-go></button>
          <span class="self-center text-xs text-[var(--ink-dim)]" data-imp-status></span>
        </div>

        <ul class="mt-3 space-y-1 text-xs" data-imp-report></ul>
      </details>
    </div>

    <div>
      <p class="empty" data-no-selection>{t('ed.selectStop')}</p>

      <!-- The stop, one question at a time. It was five tabs and a Save button;
           a creator who had not opened the fourth tab never knew it was there.
           The steps come in order, each saved as it is left, and the two that a
           plain tour does not need can be skipped. Since 30 October any step
           can be opened at any time, as in YambolTrails' builder, and "Still
           missing" at the top says what the stop needs before it is ready. -->
      <form class="wiz hidden" data-marker-form novalidate>
        <div class="wiz-top">
          <div class="wiz-id">
            <span class="wiz-pin data" data-wiz-pin>1</span>
            <div class="min-w-0 flex-1">
              <p class="eyebrow" data-wiz-kind>{t('wiz.newStop')}</p>
              <h2 class="wiz-title" data-wiz-title></h2>
            </div>
            <span class="data wiz-count" data-wiz-count></span>
          </div>

          <ol class="stepper" aria-label={t('wiz.newStop')}>
            {steps.map((st, i) => (
              <li>
                <button type="button" class="st" data-step={i}>
                  <span class="st-bar" aria-hidden="true"></span>
                  <span class="st-row">
                    <span class="st-n" aria-hidden="true">
                      <span class="st-num">{i + 1}</span>
                      <svg class="st-check" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-10" /></svg>
                    </span>
                    <span class="st-l">{st.label}</span>
                    {st.id === 'hints' && <span class="data st-count" data-count-hints></span>}
                    {st.id === 'media' && <span class="data st-count" data-count-media></span>}
                  </span>
                  <span class="st-sub" data-step-sub data-sub={st.sub}>{st.sub}</span>
                </button>
              </li>
            ))}
          </ol>
        </div>

        <div class="note note-lamp mx-5 mt-4 hidden flex-wrap items-center justify-between gap-3 text-sm sm:mx-6" data-remote-change role="status">
          <span>{t('ed.changed')}</span>
          <button type="button" class="btn btn-quiet btn-sm" data-remote-reload>{t('ed.reload')}</button>
        </div>

        <div class="wiz-body">
          <!-- What the stop still needs, each linked to its field. Required items
               are exactly what saving checks; the second language is optional. -->
          <div class="missing" data-missing hidden role="status">
            <p class="missing-title">{t('miss.title')}</p>
            <ul data-missing-list></ul>
          </div>

          <!-- 1 · The basics: words only. -->
          <div class="pane" data-panel="basics">
            <header class="pane-head">
              <h3>{t('wiz.basics.title')}</h3>
              <p>{t('wiz.basics.lede')}</p>
            </header>
            <div class="grid gap-3 sm:grid-cols-2">
              <label class="block text-sm">
                <span class="mb-1.5 block font-medium">{t('ed.titleBg')} *</span>
                <input class="field" name="titleBg" maxlength="80" />
              </label>
              <label class="block text-sm">
                <span class="mb-1.5 block font-medium">{t('ed.titleEn')}</span>
                <input class="field" name="titleEn" maxlength="80" />
              </label>
            </div>
            <div class="grid gap-3 sm:grid-cols-2">
              <label class="block text-sm">
                <span class="mb-1.5 block font-medium">{t('ed.bodyBg')}</span>
                <textarea class="field" name="bodyBg" rows="6" maxlength="900"></textarea>
              </label>
              <label class="block text-sm">
                <span class="mb-1.5 block font-medium">{t('ed.bodyEn')}</span>
                <textarea class="field" name="bodyEn" rows="6" maxlength="900"></textarea>
              </label>
            </div>
            <p class="text-xs text-[var(--ink-faint)]">* {t('ed.required')}</p>
          </div>

          <!-- 2 · The place: where it stands, and what stands there. Shape and
               colour live here rather than with the words, because they are
               what a walker sees on that spot. -->
          <div class="pane hidden" data-panel="place">
            <header class="pane-head">
              <h3>{t('wiz.place.title')}</h3>
              <p>{t('wiz.place.lede')}</p>
            </header>
            <p class="where">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-7.4-7-12a7 7 0 1 1 14 0c0 4.6-7 12-7 12Z" /><circle cx="12" cy="9" r="2.5" /></svg>
              <span>{t('wiz.place.drag')}</span>
            </p>
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
              <label class="block text-sm">
                <span class="mb-1.5 block font-medium">{t('ed.lat')} *</span>
                <input class="field data" name="lat" inputmode="decimal" />
              </label>
              <label class="block text-sm">
                <span class="mb-1.5 block font-medium">{t('ed.lng')} *</span>
                <input class="field data" name="lng" inputmode="decimal" />
              </label>
              <label class="block text-sm">
                <span class="mb-1.5 block font-medium">{t('ed.radius')}</span>
                <input class="field data" name="radius" inputmode="numeric" />
              </label>
            </div>
            <p class="-mt-2 text-xs text-[var(--ink-faint)]">{t('ed.radiusHint')}</p>

            <div>
              <span class="mb-1.5 block text-sm font-medium" id="shape-label">{t('ed.shape')}</span>
              <div class="shape-picker" role="radiogroup" aria-labelledby="shape-label" data-shapes>
                {shapes.map((s) => (
                  <label class="shape-option">
                    <input type="radio" name="shape" value={s.key} class="sr-only" />
                    <Fragment set:html={s.svg} />
                    <span class="text-xs">{s.label}</span>
                  </label>
                ))}
              </div>
              <p class="mt-2 text-xs text-[var(--ink-faint)]">{t('ed.shapeHint')}</p>

              <!-- A sign's words, in both languages. Only for a sign: every
                   other shape has nothing to write on. Empty shows the name. -->
              <div class="mt-3 hidden gap-3 sm:grid-cols-2" data-sign-fields>
                <label class="block text-sm">
                  <span class="mb-1.5 block font-medium">{t('ed.signBg')}</span>
                  <input class="field" name="signBg" maxlength="80" />
                </label>
                <label class="block text-sm">
                  <span class="mb-1.5 block font-medium">{t('ed.signEn')}</span>
                  <input class="field" name="signEn" maxlength="80" />
                </label>
              </div>

              <!-- The creator's own model. Checked in the browser before it is
                   sent (lib/glb.ts), shown turning, sized and faced, and
                   credited. Uploaded when the step is left, like the rest. -->
              <div class="model-box mt-3 hidden" data-model-fields>
                <p class="text-xs text-[var(--ink-dim)]">{t('mdl.hint')}</p>
                <div class="model-grid">
                  <div class="model-stage" data-model-stage>
                    <p class="model-empty" data-model-empty>
                      <svg width="28" height="28" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M16 3.5 26.5 9.5v13L16 28.5 5.5 22.5v-13L16 3.5Z"/><path d="M5.5 9.5 16 15.5l10.5-6M16 15.5v13"/></svg>
                      <span>{t('mdl.choose')}</span>
                    </p>
                  </div>
                  <div class="space-y-3">
                    <label class="block text-sm">
                      <span class="mb-1.5 block font-medium">{t('mdl.choose')}</span>
                      <input class="field" type="file" accept=".glb,model/gltf-binary" data-model-file />
                    </label>
                    <p class="text-xs text-[var(--ink-dim)]" data-model-current hidden></p>
                    <p class="text-xs" data-model-check role="status" aria-live="polite" hidden></p>
                    <div class="grid grid-cols-2 gap-3">
                      <label class="block text-sm">
                        <span class="mb-1.5 block font-medium">{t('mdl.height')}</span>
                        <input class="field data" type="number" min="0.2" max="10" step="0.1" data-model-height />
                      </label>
                      <label class="block text-sm">
                        <span class="mb-1.5 block font-medium">{t('mdl.heading')}</span>
                        <span class="flex items-center gap-2">
                          <input class="field data" type="number" min="0" max="359" step="1" data-model-heading-num aria-label={t('mdl.heading')} />
                          <span class="data text-xs text-[var(--ink-faint)]" data-model-compass>N</span>
                        </span>
                      </label>
                    </div>
                    <input class="w-full accent-[var(--signal)]" type="range" min="0" max="359" step="1" data-model-heading aria-label={t('mdl.heading')} />
                    <p class="text-xs text-[var(--ink-faint)]">{t('mdl.heightHint')}</p>
                  </div>
                </div>

                <fieldset class="mt-2 space-y-3">
                  <legend class="mb-1.5 text-sm font-medium">{t('mdl.credit')}</legend>
                  <div class="flex flex-wrap gap-2">
                    <label class="kind-opt credit-opt"><input class="sr-only" type="radio" name="modelCredit" value="own" checked /><span class="kind-name">{t('mdl.own')}</span></label>
