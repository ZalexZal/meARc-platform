---
import { type Lang } from '../i18n/ui';
import { TERMS_VERSION } from '../lib/terms';

interface Props { lang: Lang; kind: 'terms' | 'privacy'; }
const { lang, kind } = Astro.props;

// The version shown here is the one the app asks people to accept. Changing the
// text means changing this date and SupabaseConfig.termsVersion together, so the
// app shows the new terms again rather than holding an old acceptance.
const VERSION = TERMS_VERSION;

// Who runs the service and how to reach them. A privacy policy has to name both,
// and neither is something to guess - see OPERATOR/CONTACT below.
const OPERATOR = { bg: 'Александър Замов', en: 'Alexander Zamov' };
const CONTACT = 'zalex8623@gmail.com';

// Heading, text, and an optional anchor for the sections other places link to
// (the Play listing's account-deletion link goes to #delete).
type Section = readonly [string, string, string?];

const content: Record<'terms' | 'privacy', Record<Lang, { title: string; draft: string; body: readonly Section[] }>> = {
  terms: {
    bg: {
      title: 'Условия за ползване',
      draft: 'Чернова за тестово ползване. Текстът не е прегледан от юрист.',
      body: [
        ['Какво е това', `AR Trail е платформа за градски маршрути с добавена реалност. Създателите правят маршрути в сайта; участниците ги извървяват с приложението. Услугата се предоставя безплатно от ${OPERATOR.bg}, във вида, в който е, в тестов период.`],
        ['Профил и възраст', 'Един профил работи и в сайта, и в приложението. Можеш да разгледаш демото и водените маршрути като гост, без имейл. За маршрути с точки и класиране е нужен профил. AR Trail е за хора на 13 и повече години, защото без местоположение не работи, а Google Play не позволява приложение с местоположение да е насочено към по-малки деца. При първото отваряне те питаме само за възрастта ти. Ако си на 13, родител или настойник трябва да се съгласи, преди да влизаш в маршрути: изпращаме му линк на имейла, който посочиш, и той решава на страницата, към която води линкът. Родителят може да оттегли съгласието си по всяко време и тогава профилът се изтрива.'],
        ['Отбори, точки и значки', 'В игрите се играе в отбори. Точките принадлежат на отбора. Значките и статистиката в профила ти се изчисляват от сървъра според това, което си извървял, и се виждат само от теб. Организаторът на игра може да прекрати играта, да коригира точки и да дисквалифицира отбор при нарушение на правилата.'],
        ['Честна игра', 'На маршрути с точки всеки отговор носи мястото, от което е изпратен. Сървърът отказва отговор от фалшиво местоположение, от твърде далеч от спирката или след невъзможно бързо придвижване, и отбелязва отказа за организатора. Приложения за фалшиво местоположение и изпращане на заявки в обход на приложението са нарушение на правилата.'],
        ['Какво може и какво не може да се публикува', 'Това важи за маршрути, спирки, снимки, звук, видео, въпроси, имена на отбори и имена за показване. Не публикувай: нищо незаконно; омраза, тормоз или заплахи към човек или група; сексуално съдържание; насилие или призиви към него; чужди лични данни или снимки на хора без тяхно съгласие; спам и реклами; маркери на частна собственост без разрешение или на места, където е опасно да се ходи; чуждо съдържание, за което нямаш права. Ти отговаряш за това, което публикуваш.'],
        ['Сигнали, блокиране и модериране', `От всяка спирка, маршрут или име на отбор в приложението можеш да подадеш сигнал, а в класацията в сайта — за име на отбор. Можеш и да блокираш човека, който го е направил: спираш да виждаш маршрутите и имената на отборите му, а той не може да влиза в твоите маршрути. Блокирането се отменя от настройките. Сигналите ги преглежда ${OPERATOR.bg}. Съдържание, което нарушава тези условия, се скрива или премахва, отбор може да бъде дисквалифициран, а при повторни или тежки нарушения — профилът спрян. Създателят вижда причината за решението при маршрута си. Сигнал за незаконно съдържание, както и възражение срещу решение, може да изпратиш и на ${CONTACT}; отговаряме без неоправдано забавяне.`],
        ['Редактори', 'Собственикът на маршрут може да покани други хора като редактори с линк. Редакторите променят спирките, отговорите, подсказките и медията; името, нивото, кодът и изтриването на маршрута остават на собственика. Собственикът отговаря за маршрута и за това кого кани.'],
        ['Ходенето е твоя отговорност', 'Маршрутите минават по истински улици. Гледай къде вървиш, спазвай правилата за движение, не влизай в частни имоти и не използвай приложението, докато шофираш или караш колело. Приложението чертае права линия до маркера, а не безопасен път.'],
        ['Изтриване на профила', 'Можеш да изтриеш профила си по всяко време, с два натиска: от раздела „Ти“ в приложението или от страницата на профила в сайта. Изтриването е окончателно. Маршрутите, които притежаваш, се изтриват заедно с профила, освен ако не избереш да ги оставиш за другите.'],
        ['Промени', 'Когато променим тези условия, приложението и сайтът ще ти ги покажат отново и ще те помолят да ги приемеш. Версия на условията: ' + VERSION + '.'],
      ],
    },
    en: {
      title: 'Terms of use',
      draft: 'Draft for a test run. This text has not been reviewed by a lawyer.',
      body: [
        ['What this is', `AR Trail is a platform for augmented-reality city trails. Creators build trails on the website; walkers walk them with the app. The service is provided free of charge by ${OPERATOR.en}, as it is, during a test period.`],
        ['Your account and age', 'One account works on both the website and the app. You can try the demo and walk guided trails as a guest, with no email. Trails with points and a leaderboard need an account. AR Trail is for people aged 13 and older, because it does not work without location and Google Play does not allow an app that uses location to be aimed at younger children. The first time you open the app we ask only your age. If you are 13, a parent or guardian has to agree before you join trails: we send a link to the email you give, and they decide on the page it opens. The parent can withdraw their consent at any time, and the account is then deleted.'],
        ['Teams, points and badges', 'Games are played in teams. Points belong to the team. The badges and numbers on your profile are worked out by the server from what you have walked, and only you can see them. The organiser of a game can end it, adjust points and disqualify a team that breaks the rules.'],
        ['Fair play', 'On trails with points, every answer carries where it was sent from. The server refuses an answer from a faked location, from too far from the stop, or after impossibly fast travel, and records the refusal for the organiser. Fake-location apps and sending requests around the app break the rules.'],
        ['What may and may not be published', 'This covers trails, stops, photos, audio, video, questions, team names and display names. Do not publish: anything illegal; hatred, harassment or threats against a person or group; sexual content; violence or calls to it; other people\'s personal data, or photos of people without their consent; spam and advertising; markers on private property without permission, or in places that are dangerous to walk to; other people\'s content you have no rights to. You are responsible for what you publish.'],
        ['Reporting, blocking and moderation', `From any stop, trail or team name in the app you can report it, and on the website you can report a team name from the leaderboard. You can also block whoever made it: you stop seeing their trails and team names, and they cannot join your trails. Blocks are undone in settings. Reports are reviewed by ${OPERATOR.en}. Content that breaks these terms is hidden or removed, a team can be disqualified, and repeated or serious breaches can get an account suspended. A creator sees the reason for a decision on their trail. You can also send a notice of illegal content, or dispute a decision, to ${CONTACT}; we reply without undue delay.`],
        ['Editors', 'A trail\'s owner can invite other people as editors with a link. Editors change stops, answers, hints and media; the trail\'s name, level, code and deleting it stay with the owner. The owner is responsible for the trail and for whom they invite.'],
        ['Walking is your responsibility', 'Trails run along real streets. Watch where you are going, obey traffic rules, stay out of private property, and do not use the app while driving or cycling. The app draws a straight line to a marker, not a safe route.'],
        ['Deleting your account', 'You can delete your account at any time, in two taps: from the You tab in the app, or from your account page on the website. Deleting is permanent. Trails you own are deleted with the account unless you choose to leave them for other people.'],
        ['Changes', 'When these terms change, the app and the website will show them again and ask you to accept them. Terms version: ' + VERSION + '.'],
      ],
    },
  },
  privacy: {
    bg: {
      title: 'Поверителност',
      draft: 'Чернова за тестово ползване. Текстът не е прегледан от юрист.',
      body: [
        ['Кой отговаря за данните', `Администратор на личните данни е ${OPERATOR.bg}. За всеки въпрос или искане относно данните ти пиши на ${CONTACT}. Отговаряме до един месец.`],
        ['Какво пазим', 'Имейл, име за показване, дата на създаване на профила и отговора за възрастта ти — 14 или повече, или 13 (не датата ти на раждане). Паролата се пази само като криптографски отпечатък от доставчика ни и ние не можем да я видим. Кои маршрути и отбори си избрал; кои спирки си достигнал и дали през камерата или по GPS; отговорите, които си изпратил, включително грешните; подсказките, които отборът ти е отключил; точките на отбора; сигналите, които си подал; кого си блокирал; кога и коя версия на условията си приел. Ако правиш маршрути: съдържанието им и кои редактори си поканил.'],
        ['Местоположение', 'Телефонът пита сървъра „какво има близо до тази точка“ и отговорът не се записва. На маршрути с точки всеки отговор носи мястото, от което е изпратен, за да не може да се отговаря отдалеч. Пазим само последното прието място, за един ден. Когато отговор бъде отказан заради мястото, записваме вида на отказа, разстоянието и скоростта, без координати, и ги показваме на организатора на маршрута. Не следим местоположението ти постоянно и не пазим пътя, по който си вървял.'],
        ['Деца', 'AR Trail е за хора на 13 и повече години. Под 14 (чл. 25в от Закона за защита на личните данни) профилът се ползва само със съгласието на родител или настойник. Детето посочва имейл на родителя; изпращаме на този имейл линк за вход и родителят решава на нашата страница. Пазим имейла на родителя, кога е поискано и кога и как е отговорил, и версията на условията, които е видял — докато профилът на детето съществува. Ако родителят откаже или оттегли съгласието си, профилът и всичко в него се изтриват веднага. Демото в приложението работи без да изпраща каквото и да е.'],
        ['Какво не правим', 'Не използваме реклами, проследяващи бисквитки или аналитични услуги и не продаваме данни.'],
        ['Камера и карта', 'Изображението от камерата се обработва на телефона. Това приложение работи с Google Play Services for AR (ARCore), предоставяно от Google и подчинено на Политиката за поверителност на Google. За да постави маркерите точно, ARCore Geospatial изпраща визуални характеристики и приблизително местоположение към Google. В приложението картите се зареждат от Stadia Maps (а ако не отговори — от Esri), в сайта от OpenFreeMap; те виждат IP адреса ти и показваната област.'],
        ['Защо и на какво основание', 'За да работи услугата, която ползваш — профил, маршрути, отбори, класиране, значки (чл. 6, пар. 1, б. „б“ от ОРЗД). За безопасност, модериране, блокиране и за да се хване фалшиво местоположение (законен интерес, б. „е“). За деца под 14 години — съгласието на родителя (б. „а“ и чл. 8). Когато законът ни задължава (б. „в“). Не взимаме автоматизирани решения с правни последици за теб: отказът на отговор заради мястото не е наказание, а решението дали е измама остава на човек.'],
        ['Кой какво вижда', 'Значките и статистиката ти се виждат само от теб. Отборът ти вижда имената на членовете и своите отговори. Създателят и редакторите на маршрута виждат отговорите към него и имената на отборите; собственикът вижда и предупрежденията за местоположение на отборите и имейлите на редакторите, които е поканил. Класирането показва имената на отборите. Правилните отговори не се изпращат към телефоните.'],
        ['Доставчици', 'Supabase (база данни, вход и изпращане на писмата за профила, сървъри в ЕС — Франкфурт), Netlify (сайтът), Stadia Maps и Esri (картите в приложението), OpenFreeMap (картата в сайта), Google (ARCore). Когато данни се предават извън ЕС, това става по стандартните договорни клаузи на ЕС или Рамката за защита на данните ЕС–САЩ.'],
        ['Колко дълго', 'Докато имаш профил. При изтриване профилът, членствата, посещенията, блокиранията, значките и съгласието на родител се изтриват веднага. Отговорите към чужди маршрути остават без име, за да не се разпадне историята на отбора. Последното място на отговор се пази един ден; предупрежденията за местоположение — докато съществува маршрутът. Технически записи при доставчиците (например IP адреси в логовете) се пазят до 90 дни.'],
        ['Твоите права', 'Имаш право на достъп, корекция, изтриване, преносимост, ограничаване и възражение, а когато основанието е съгласие — и да го оттеглиш. Името и имейла си сменяш в профила. Всичко, което пазим за теб, сваляш с бутон в сайта. Имаш право и да подадеш жалба до Комисията за защита на личните данни (cpdp.bg).'],
        ['Изтриване на профила', `В приложението: раздел „Ти“ → „Твоите данни“ → „Изтрий профила ми“ и потвърди. В сайта: влез, отвори „Профил“ → „Поверителност и данни“ → „Изтрий профила“. Или пиши на ${CONTACT} от имейла на профила. Изтриват се профилът и всичко изброено по-горе; отговорите към чужди маршрути остават без име.`, 'delete'],
        ['Сигурност', 'Цялата връзка е криптирана. Всеки ред в базата е достъпен само за онзи, чийто е, чрез правила на самата база данни, а не само в приложението.'],
        ['Съхранение в браузъра и на телефона', 'Сайтът пази сесията ти за вход в хранилището на браузъра, а приложението — на телефона. Това е задължително, за да останеш влязъл, и не служи за проследяване.'],
        ['Промени', 'Когато променим тази политика, приложението и сайтът ще ти я покажат отново. Версия: ' + VERSION + '.'],
      ],
    },
    en: {
      title: 'Privacy',
      draft: 'Draft for a test run. This text has not been reviewed by a lawyer.',
      body: [
        ['Who is responsible', `The controller of your personal data is ${OPERATOR.en}. For any question or request about your data, write to ${CONTACT}. We reply within one month.`],
        ['What we keep', 'Your email, display name, the date your account was made, and your age answer - 14 or older, or 13 (not your date of birth). Your password is held only as a cryptographic hash by our provider, and we cannot see it. Which trails and teams you joined; which stops you reached, and whether through the camera or by GPS; the answers you sent, including wrong ones; the hints your team unlocked; your team\'s points; reports you made; whom you blocked; when you accepted which version of the terms. If you build trails: their content, and which editors you invited.'],
        ['Location', 'The phone asks the server "what is near this point", and the answer is not recorded. On trails with points, every answer carries where it was sent from, so nobody can answer from far away. We keep only the last accepted position, for one day. When an answer is refused because of where it came from, we record the kind of refusal, the distance and the speed - no coordinates - and show them to the trail\'s organiser. We do not track your location continuously and we do not store the path you walked.'],
        ['Children', 'AR Trail is for people aged 13 and older. Under 14 (Art. 25c of the Bulgarian Personal Data Protection Act), an account can only be used with the consent of a parent or guardian. The child gives a parent\'s email; we send that address a sign-in link, and the parent decides on our page. We keep the parent\'s email, when they were asked, when and how they answered, and the version of the terms they saw - for as long as the child\'s account exists. If the parent refuses or withdraws, the account and everything in it is deleted at once. The demo in the app sends nothing anywhere.'],
        ['What we do not do', 'We use no advertising, no tracking cookies and no analytics, and we do not sell data.'],
        ['Camera and map', 'The camera image is processed on the phone. This application runs on Google Play Services for AR (ARCore), which is provided by Google and governed by the Google Privacy Policy. To place markers accurately, ARCore Geospatial sends visual features and your approximate location to Google. In the app, maps load from Stadia Maps (or from Esri if Stadia does not answer); on the website, from OpenFreeMap. They see your IP address and the area being shown.'],
        ['Why, and on what basis', 'To run the service you use: account, trails, teams, leaderboards, badges (GDPR Art. 6(1)(b)). For safety, moderation, blocking and catching faked locations (legitimate interest, Art. 6(1)(f)). For children under 14, their parent\'s consent (Art. 6(1)(a) and Art. 8). Where the law requires it (Art. 6(1)(c)). We make no automated decisions with legal effects on you: refusing an answer because of its location is not a penalty, and whether it was cheating is decided by a person.'],
        ['Who sees what', 'Your badges and numbers are visible only to you. Your team sees its members\' names and its own answers. A trail\'s creator and editors see the answers sent to it and the team names; the owner also sees the teams\' position warnings and the emails of the editors they invited. Leaderboards show team names. Correct answers are never sent to phones.'],
        ['Providers', 'Supabase (database, sign-in and the account emails, servers in the EU, Frankfurt), Netlify (the website), Stadia Maps and Esri (the maps in the app), OpenFreeMap (the map on the website), Google (ARCore). Where data leaves the EU, it does so under the EU Standard Contractual Clauses or the EU–US Data Privacy Framework.'],
        ['How long', 'For as long as you have an account. When you delete it, your profile, memberships, visits, blocks, badges and any parent\'s consent are deleted at once. Answers sent to other people\'s trails stay without your name, so a team\'s history does not fall apart. The last answer position is kept for one day; position warnings for as long as the trail exists. Technical records at our providers (such as IP addresses in logs) are kept for up to 90 days.'],
        ['Your rights', 'You have the right to access, correct, delete and move your data, to restrict or object to its use, and, where the basis is consent, to withdraw it. You change your name and email on your profile. You download everything we hold about you with a button on the website. You can also complain to the Bulgarian Commission for Personal Data Protection (cpdp.bg).'],
        ['Deleting your account', `In the app: the You tab → Your data → Delete my account, then confirm. On the website: sign in, open Account → Privacy and data → Delete account. Or write to ${CONTACT} from the account's email address. The account and everything listed above is deleted; answers sent to other people's trails stay without your name.`, 'delete'],
        ['Security', 'Every connection is encrypted. Each row in the database can be read only by the person it belongs to, enforced by rules in the database itself, not only in the app.'],
        ['Storage in your browser and on your phone', 'The website keeps your sign-in session in the browser\'s storage, and the app on the phone. It is needed to keep you signed in and is not used for tracking.'],
        ['Changes', 'When this policy changes, the app and the website will show it to you again. Version: ' + VERSION + '.'],
      ],
    },
  },
};

const page = content[kind][lang];
---

<article class="mx-auto max-w-2xl px-4 py-20 sm:px-6">
  <h1 class="text-3xl sm:text-4xl">{page.title}</h1>

  <p class="mt-5 rounded-lg border border-[var(--lamp)] bg-[var(--lamp-wash)] px-4 py-3 text-sm text-[var(--lamp)]">
    {page.draft}
  </p>

  <div class="mt-10 space-y-8">
    {page.body.map(([heading, text, id]) => (
      <section id={id}>
        <h2 class="text-lg">{heading}</h2>
        <p class="mt-2 leading-relaxed text-[var(--ink-dim)]">{text}</p>
      </section>
    ))}
  </div>
</article>
