---
import { useTranslations, type Lang } from '../i18n/ui';
import PageBand from './PageBand.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

const strings = {
  sent: t('fb.sent'),
  empty: t('fb.empty'),
  parent: t('fb.parent'),
  tooMany: t('fb.tooMany'),
  failed: t('mine.failed'),
  working: t('rev.working'),
};
---

<!-- Send feedback from the website. The app has the same thing under You. It
     goes to the reviewer's queue on /review, with the page it came from and the
     browser, and nowhere else. -->
<PageBand eyebrow={t('fb.eyebrow')} title={t('fb.title')} lede={t('fb.lede')} />

<section class="mx-auto max-w-xl px-4 pb-20 pt-2 sm:px-6" hidden data-guarded>

  <form class="card mt-8 space-y-5 p-6 sm:p-8" data-fb-form novalidate>
    <div>
      <label for="fb-message" class="mb-1.5 block text-sm font-medium">{t('fb.label')}</label>
      <textarea id="fb-message" class="field" maxlength="2000" rows="7"
                placeholder={t('fb.placeholder')} data-fb-message></textarea>
    </div>

    <p class="text-xs text-[var(--ink-faint)]">{t('fb.attached')}</p>

    <label class="flex items-start gap-3 text-sm" data-fb-reply-row>
      <input type="checkbox" class="mt-0.5 h-4 w-4" data-fb-reply />
      <span>{t('fb.reply')}</span>
    </label>

    <p class="hidden" role="status" data-fb-said></p>
    <button type="submit" class="btn btn-primary" data-fb-send>{t('fb.send')}</button>
  </form>

  <div class="card done-card mt-8 hidden p-6 text-center sm:p-8" data-fb-done>
    <span class="done-tick"><svg viewBox="0 0 20 20" aria-hidden="true"><path class="tick" d="M6 10.4l2.7 2.6L14.2 7.5" /></svg></span>
    <p class="text-lg font-semibold">{t('fb.sent')}</p>
    <button type="button" class="btn btn-quiet btn-sm mt-5" data-fb-again>{t('fb.again')}</button>
  </div>
</section>

<script type="application/json" data-fb-strings set:html={JSON.stringify(strings)}></script>

<script>
  import { db } from '../lib/supabase';
  import { requireUser, reveal } from '../lib/session';
  import { busy, formError, formClear } from '../lib/form';

  const S = JSON.parse(document.querySelector('[data-fb-strings]')!.textContent || '{}');
  const user = await requireUser({ needsReal: false });
  reveal();

  // Only an account with an email can be replied to.
  if (!user.email) document.querySelector('[data-fb-reply-row]')?.classList.add('hidden');

  const form = document.querySelector('[data-fb-form]') as HTMLFormElement;
  const said = document.querySelector('[data-fb-said]') as HTMLElement;
  const done = document.querySelector('[data-fb-done]') as HTMLElement;
  document.querySelector('[data-fb-again]')?.addEventListener('click', () => {
    done.classList.add('hidden');
    form.classList.remove('hidden');
    (form.querySelector('[data-fb-message]') as HTMLElement).focus();
  });

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const field = form.querySelector('[data-fb-message]') as HTMLTextAreaElement;
    const message = field.value.trim();
    if (!message) { formError(said, S.empty, field); return; }

    const send = form.querySelector('[data-fb-send]') as HTMLButtonElement;
    formClear(said);
    busy(send, true);

    const referrer = document.referrer.startsWith(location.origin)
      ? new URL(document.referrer).pathname : '';

    const { error } = await db()!.rpc('send_feedback', {
      p_message: message,
      p_source: 'web',
      p_app_version: null,
      p_device: navigator.userAgent.slice(0, 120),
      p_place: referrer || location.pathname,
      p_reply_ok: (form.querySelector('[data-fb-reply]') as HTMLInputElement).checked,
    });

    if (error) {
      formError(said, /parent needs to agree/.test(error.message) ? S.parent
        : /a lot of feedback/.test(error.message) ? S.tooMany
        : S.failed);
      return;
    }

    busy(send, false);
    field.value = '';
    form.classList.add('hidden');
    done.classList.remove('hidden');
  });
</script>
