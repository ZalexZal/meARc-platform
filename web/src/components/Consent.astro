---
import Loading from './Loading.astro';
import { useTranslations, localise, type Lang } from '../i18n/ui';
import PageBand from './PageBand.astro';
import { TERMS_VERSION } from '../lib/terms';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const href = localise(lang);

const strings = {
  lang, termsVersion: TERMS_VERSION,
  child: t('cons.child'), asked: t('cons.asked'),
  guardian: t('cons.guardian'), agree: t('cons.agree'), refuse: t('cons.refuse'),
  refuseConfirm: t('cons.refuseConfirm'), needGuardian: t('cons.needGuardian'),
  withdraw: t('cons.withdraw'), withdrawConfirm: t('cons.withdrawConfirm'),
  erased: t('cons.erased'), done: t('cons.done'), failed: t('err.generic'),
  linkSent: t('par.linkSent'), signedAs: t('par.signedAs'), none: t('par.none'), needEmail: t('err.email'),
  waiting: t('par.waiting'), agreedOn: t('par.agreedOn'), trails: t('par.trails'),
  teams: t('par.teams'), walked: t('par.walked'), badges: t('par.badges'),
  lastActive: t('par.lastActive'), never: t('par.never'), download: t('par.download'),
  code: t('par.code'), codeHow: t('par.codeHow'), expires: t('par.expires'),
  cancel: t('par.cancel'), needName: t('par.needName'),
};
---

<!-- The parent's side of an under-14's account. A parent lands here from the
     link a child's request sent them, or comes on their own to add a child.
     Everything below the explanation needs a session opened by an emailed
     link: that is the proof the inbox is theirs (0048). -->
<PageBand eyebrow={lang === 'bg' ? 'Родители' : 'Parents'} title={t('par.title')} lede={t('par.lede')} />

<article class="mx-auto max-w-2xl px-4 pb-20 sm:px-6">

  <details class="card mt-8 p-5">
    <summary class="cursor-pointer font-medium">{t('cons.what')}</summary>
    <div class="mt-4 space-y-5 text-sm leading-relaxed text-[var(--ink-dim)]">
      <p>{t('cons.whatBody')}</p>
      <div><h2 class="text-base text-[var(--ink)]">{t('cons.data')}</h2><p class="mt-1">{t('cons.dataBody')}</p></div>
      <div><h2 class="text-base text-[var(--ink)]">{t('cons.see')}</h2><p class="mt-1">{t('cons.seeBody')}</p></div>
      <div><h2 class="text-base text-[var(--ink)]">{t('cons.rights')}</h2><p class="mt-1">{t('cons.rightsBody')}</p></div>
      <p>
        <a class="font-medium text-[var(--signal)] underline-offset-2 hover:underline" href={href('/terms')} target="_blank" rel="noopener">{t('cons.readTerms')}</a>{' · '}<a class="font-medium text-[var(--signal)] underline-offset-2 hover:underline" href={href('/privacy')} target="_blank" rel="noopener">{t('cons.readPrivacy')}</a>
      </p>
    </div>
  </details>

  <Loading label={t('games.loading')} class="mt-10 py-6" data-cons-wait />

  <!-- Not signed in by link: ask for one. -->
  <form class="card mt-10 hidden space-y-3 p-6" data-cons-signin novalidate>
    <p class="text-sm text-[var(--ink-dim)]">{t('par.signIn')}</p>
    <label class="sr-only" for="cons-email">{t('auth.email')}</label>
    <input class="field" id="cons-email" type="email" autocomplete="email" placeholder={t('auth.email')} data-cons-email />
    <p class="hidden" data-cons-sent role="status"></p>
    <button class="btn btn-primary" type="submit" data-cons-send>{t('par.sendLink')}</button>
  </form>

  <!-- Signed in by link: the children, and adding one. -->
  <div class="mt-10 hidden" data-parent>
    <p class="text-sm text-[var(--ink-dim)]" data-signed-as></p>

    <section class="mt-6">
      <h2 class="text-xl">{t('par.children')}</h2>
      <ul class="mt-4 space-y-4" data-cons-list></ul>
    </section>

    <section class="card mt-10 space-y-4 p-6">
      <h2 class="text-xl">{t('par.add')}</h2>
      <p class="text-sm text-[var(--ink-dim)]">{t('par.addLede')}</p>
      <form class="space-y-3" data-add novalidate>
        <label class="block text-sm">
          <span class="mb-1 block font-medium">{t('par.childName')}</span>
          <input class="field" maxlength="40" autocomplete="off" data-add-name />
        </label>
        <label class="flex items-start gap-2.5 text-sm">
          <input class="mt-1 shrink-0" type="checkbox" data-add-guardian />
          <span>{t('cons.guardian')}</span>
        </label>
        <p class="hidden" data-add-said role="status"></p>
        <button class="btn btn-primary" type="submit" data-add-submit>{t('par.makeCode')}</button>
      </form>
      <div class="hidden rounded-xl border border-[var(--line)] p-4" data-new-code>
        <p class="text-sm font-medium" data-new-code-for></p>
        <p class="data mt-2 text-3xl font-semibold tracking-[0.2em] text-[var(--signal)]" data-new-code-value></p>
        <p class="mt-2 text-xs text-[var(--ink-dim)]" data-new-code-expires></p>
        <p class="mt-3 text-sm text-[var(--ink-dim)]">{t('par.codeHow')}</p>
      </div>
      <div class="hidden" data-open>
        <h3 class="text-sm font-semibold">{t('par.openCodes')}</h3>
        <ul class="mt-2" data-open-list></ul>
      </div>
    </section>
  </div>

  <p class="mt-4 hidden" data-cons-said role="status"></p>
</article>

<script type="application/json" data-cons-strings set:html={JSON.stringify(strings)}></script>

<script>
  import { db, landing } from '../lib/supabase';
  import { escapeHtml, text } from '../lib/session';
  import { busy, formError, formOk } from '../lib/form';

  const S = JSON.parse(document.querySelector('[data-cons-strings]')!.textContent || '{}');
  const q = (s: string) => document.querySelector(s) as HTMLElement;
  const client = db()!;

  const { data } = await client.auth.getSession();
  const user = data.session?.user ?? null;
  history.replaceState(null, '', location.pathname);
  q('[data-cons-wait]').classList.add('hidden');

  const say = (message: string, bad = false) =>
    bad ? formError(q('[data-cons-said]'), message) : formOk(q('[data-cons-said]'), message);

  const when = (iso: string | null) => iso
    ? new Date(iso).toLocaleDateString(S.lang === 'bg' ? 'bg-BG' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
    : S.never;

  // Only a session opened by the emailed link counts as the parent: with
  // confirmations off, anybody can make a password account with any address.
  // The server checks the same thing (0048); this only picks the right screen.
  const byLink = (() => {
    try {
      const claims = JSON.parse(atob((data.session?.access_token ?? '').split('.')[1]
        .replace(/-/g, '+').replace(/_/g, '/')));
      return (claims.amr ?? []).some((m: any) => m.method === 'otp' || m.method === 'magiclink');
    } catch { return false; }
  })();

  async function drawChildren() {
    const { data: rows, error } = await client.rpc('my_children');
    const list = q('[data-cons-list]');
    if (error) { list.innerHTML = ''; say(S.failed, true); return; }
    if (!rows?.length) { list.innerHTML = `<li class="text-sm text-[var(--ink-dim)]">${escapeHtml(S.none)}</li>`; return; }

    list.innerHTML = rows.map((r: any) => {
      const who = escapeHtml(r.name || S.child);
      const facts = `
        <dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-2 text-sm sm:grid-cols-4">
          <div><dt class="text-xs text-[var(--ink-faint)]">${escapeHtml(S.walked)}</dt><dd class="data">${Number(r.walked)}</dd></div>
          <div><dt class="text-xs text-[var(--ink-faint)]">${escapeHtml(S.badges)}</dt><dd class="data">${Number(r.badges)}</dd></div>
          <div class="col-span-2"><dt class="text-xs text-[var(--ink-faint)]">${escapeHtml(S.lastActive)}</dt><dd>${escapeHtml(when(r.last_active))}</dd></div>
          <div class="col-span-2 sm:col-span-4"><dt class="text-xs text-[var(--ink-faint)]">${escapeHtml(S.trails)}</dt><dd>${
            r.trails.length ? r.trails.map((x: any) => escapeHtml(x.name)).join(', ') : '—'}</dd></div>
          <div class="col-span-2 sm:col-span-4"><dt class="text-xs text-[var(--ink-faint)]">${escapeHtml(S.teams)}</dt><dd>${
            r.teams.length ? r.teams.map((x: string) => escapeHtml(x)).join(', ') : '—'}</dd></div>
        </dl>`;
      return r.granted
        ? `<li class="card p-6" data-child="${escapeHtml(r.child_id)}">
             <p class="font-medium">${who}</p>
             <p class="mt-1 text-sm text-[var(--ink-dim)]">${escapeHtml(S.agreedOn.replace('{0}', when(r.answered_at)))}</p>
             ${facts}
             <div class="mt-5 flex flex-wrap gap-2">
               <button type="button" class="btn btn-quiet btn-sm" data-download>${escapeHtml(S.download)}</button>
               <button type="button" class="btn btn-danger-quiet btn-sm" data-withdraw>${escapeHtml(S.withdraw)}</button>
             </div>
           </li>`
        : `<li class="card p-6" data-child="${escapeHtml(r.child_id)}">
             <p class="font-medium">${who} <span class="text-sm font-normal" style="color:var(--lamp)">${escapeHtml(S.waiting)}</span></p>
             <p class="mt-1 text-sm text-[var(--ink-dim)]">${escapeHtml(S.asked)} ${escapeHtml(when(r.requested_at))}</p>
             <label class="mt-4 flex items-start gap-2.5 text-sm">
               <input class="mt-1 shrink-0" type="checkbox" data-guardian />
               <span>${escapeHtml(S.guardian)}</span>
             </label>
             <div class="mt-5 flex flex-wrap gap-2">
               <button type="button" class="btn btn-primary" data-agree>${escapeHtml(S.agree)}</button>
               <button type="button" class="btn btn-quiet" data-refuse>${escapeHtml(S.refuse)}</button>
             </div>
           </li>`;
    }).join('');
  }

  async function drawCodes() {
    const { data: codes } = await client.rpc('my_child_invites');
    const box = q('[data-open]');
    box.classList.toggle('hidden', !codes?.length);
    q('[data-open-list]').innerHTML = (codes ?? []).map((c: any) => `
      <li class="flex items-center justify-between gap-3 border-t border-[var(--line-soft)] py-2 text-sm">
        <span><span class="data font-medium tracking-widest">${escapeHtml(c.code)}</span>
          <span class="text-[var(--ink-dim)]"> · ${escapeHtml(c.child_name)} · ${escapeHtml(S.expires.replace('{0}', when(c.expires_at)))}</span></span>
        <button type="button" class="btn btn-ghost btn-sm" data-cancel-code="${escapeHtml(c.code)}">${escapeHtml(S.cancel)}</button>
      </li>`).join('');
  }

  // Bound once on the list, because drawChildren() replaces everything in it.
  q('[data-cons-list]').addEventListener('click', async (event) => {
    const target = event.target as HTMLElement;
    const card = target.closest('[data-child]') as HTMLElement | null;
    if (!card) return;
    const child = card.dataset.child!;

    if (target.closest('[data-agree]')) {
      if (!(card.querySelector('[data-guardian]') as HTMLInputElement).checked) { say(S.needGuardian, true); return; }
      const { error } = await client.rpc('answer_parent_consent',
        { p_child: child, p_agree: true, p_terms_version: S.termsVersion });
      if (error) { say(error.message, true); return; }
      say(S.done);
      await drawChildren();
    } else if (target.closest('[data-refuse]')) {
      if (!confirm(S.refuseConfirm)) return;
      const { error } = await client.rpc('answer_parent_consent',
        { p_child: child, p_agree: false, p_terms_version: S.termsVersion });
      if (error) { say(error.message, true); return; }
      say(S.erased);
      await drawChildren();
    } else if (target.closest('[data-withdraw]')) {
      if (!confirm(S.withdrawConfirm)) return;
      const { error } = await client.rpc('withdraw_parent_consent', { p_child: child });
      if (error) { say(error.message, true); return; }
      say(S.erased);
      await drawChildren();
    } else if (target.closest('[data-download]')) {
      const { data: json, error } = await client.rpc('export_child_data', { p_child: child });
      if (error) { say(error.message, true); return; }
      const url = URL.createObjectURL(new Blob([JSON.stringify(json, null, 2)], { type: 'application/json' }));
      const a = document.createElement('a');
      a.href = url;
      a.download = `artrail-child-data-${new Date().toISOString().slice(0, 10)}.json`;
      a.click();
      URL.revokeObjectURL(url);
    }
  });

  q('[data-open-list]').addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest('[data-cancel-code]') as HTMLElement | null;
    if (!button) return;
    await client.rpc('cancel_child_invite', { p_code: button.dataset.cancelCode });
    await drawCodes();
  });

  q('[data-add]').addEventListener('submit', async (event) => {
    event.preventDefault();
    const name = (q('[data-add-name]') as HTMLInputElement).value.trim();
    const addSaid = q('[data-add-said]');
    if (!name) { formError(addSaid, S.needName, q('[data-add-name]')); return; }
    if (!(q('[data-add-guardian]') as HTMLInputElement).checked) { formError(addSaid, S.needGuardian, q('[data-add-guardian]')); return; }

    busy(q('[data-add-submit]') as HTMLButtonElement, true);
    const { data: made, error } = await client.rpc('create_child_invite',
      { p_child_name: name, p_terms_version: S.termsVersion });
    if (error || !made) { formError(addSaid, error?.message ?? S.failed); return; }
    busy(q('[data-add-submit]') as HTMLButtonElement, false);
    addSaid.classList.add('hidden');

    q('[data-new-code]').classList.remove('hidden');
    text(q('[data-new-code-for]'), S.code.replace('{0}', made.child_name));
    text(q('[data-new-code-value]'), made.code);
    text(q('[data-new-code-expires]'), S.expires.replace('{0}', when(made.expires_at)));
    (q('[data-add-name]') as HTMLInputElement).value = '';
    (q('[data-add-guardian]') as HTMLInputElement).checked = false;
    await drawCodes();
  });

  if (user && user.email && byLink) {
    q('[data-parent]').classList.remove('hidden');
    text(q('[data-signed-as]'), S.signedAs.replace('{0}', user.email));
    await Promise.all([drawChildren(), drawCodes()]);
  } else {
    const form = q('[data-cons-signin]') as HTMLFormElement;
    form.classList.remove('hidden');
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const email = (q('[data-cons-email]') as HTMLInputElement).value.trim();
      if (!email) { formError(q('[data-cons-sent]'), S.needEmail, q('[data-cons-email]')); return; }
      busy(q('[data-cons-send]') as HTMLButtonElement, true);
      // A parent account is made by signing in the first time. The same
      // sentence whether or not the address had one, so the form cannot be
      // used to find out which addresses do.
      await client.auth.signInWithOtp({
        email, options: { shouldCreateUser: true, emailRedirectTo: landing('parent') },
      });
      formOk(q('[data-cons-sent]'), S.linkSent);
    });
  }
</script>
