---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

/**
 * The route the page walks as you scroll.
 *
 * Real coordinates, real places in Yambol, real distances between them - the
 * same three markers that exist in the test trail. A fake route with invented
 * numbers would be the one thing on this page that could not survive somebody
 * checking it.
 */
const stops = [
  { key: 1, name: t('stop.1.name'), body: t('stop.1.body'), lat: 42.48412, lng: 26.50598, from: 0 },
  { key: 2, name: t('stop.2.name'), body: t('stop.2.body'), lat: 42.48397, lng: 26.50340, from: 214 },
  { key: 3, name: t('stop.3.name'), body: t('stop.3.body'), lat: 42.48657, lng: 26.50654, from: 278 },
] as const;
---

<section id="how" class="relative mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-32">
  <header class="max-w-2xl">
    <p class="eyebrow">{t('route.eyebrow')}</p>
    <h2 class="mt-3 text-3xl sm:text-4xl">{t('route.title')}</h2>
    <p class="mt-4 text-lg text-[var(--ink-dim)]">{t('route.lede')}</p>
  </header>

  <div class="relative mt-16" data-route>
    <!-- The line the route draws itself along. It is behind the stops and is
         drawn by scroll progress rather than by a timer, so the reader controls
         the walk. -->
    <div
      class="absolute left-[19px] top-2 bottom-2 w-px bg-[var(--line)] sm:left-[27px]"
      aria-hidden="true"
    >
      <div
        class="absolute inset-x-0 top-0 origin-top bg-[var(--signal)]"
        data-route-line
        style="height: 100%; transform: scaleY(0);"
      ></div>
    </div>

    <ol class="space-y-14 sm:space-y-20">
      {stops.map((stop, index) => (
        <li class="reveal relative grid grid-cols-[40px_1fr] gap-5 sm:grid-cols-[56px_1fr] sm:gap-8" data-stop>
          <div class="relative">
            <span
              class="relative z-10 grid h-10 w-10 place-items-center rounded-full border border-[var(--line)] bg-[var(--surface)] sm:h-14 sm:w-14"
              data-stop-knob
            >
              <span class="data text-xs font-medium text-[var(--ink-dim)] sm:text-sm">{stop.key}</span>
            </span>
          </div>

          <div class="min-w-0 pt-1 sm:pt-3">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <h3 class="text-xl sm:text-2xl">{stop.name}</h3>
              {index > 0 && (
                <span class="data text-xs text-[var(--signal)]">
                  +{stop.from} m
                </span>
              )}
            </div>

            <p class="mt-2 max-w-xl text-[var(--ink-dim)]">{stop.body}</p>

            <p class="data mt-3 text-2xs text-[var(--ink-faint)]">
              {stop.lat.toFixed(5)}° N · {stop.lng.toFixed(5)}° E
            </p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  function build() {
    const scope = document.querySelector('[data-route]');
    if (!scope) return;

    const line = scope.querySelector('[data-route-line]') as HTMLElement | null;
    const stops = Array.from(scope.querySelectorAll('[data-stop]')) as HTMLElement[];

    // Somebody who asked for less motion gets the finished state, not a blank
    // column where an animation was going to be. This is the whole point of the
    // preference: the page still has to be complete.
    if (reduced.matches) {
      if (line) line.style.transform = 'scaleY(1)';
      stops.forEach((s) => s.classList.add('reveal-in'));
      return;
    }

    if (line) {
      gsap.to(line, {
        scaleY: 1,
        ease: 'none',
        scrollTrigger: {
          trigger: scope,
          start: 'top 72%',
          end: 'bottom 78%',
          scrub: 0.4,
        },
      });
    }

    stops.forEach((stop) => {
      const knob = stop.querySelector('[data-stop-knob]');

      gsap.to(stop, {
        opacity: 1,
        y: 0,
        duration: 0.55,
        ease: 'power2.out',
        scrollTrigger: { trigger: stop, start: 'top 82%', once: true },
      });

      // The pin arrives at its stop: the knob takes the signal colour as the
      // line reaches it, which is the moment the app would say "you are here".
      if (knob) {
        gsap.to(knob, {
          borderColor: 'var(--signal)',
          backgroundColor: 'var(--signal-wash)',
          duration: 0.4,
          ease: 'power2.out',
          scrollTrigger: { trigger: stop, start: 'top 70%', once: true },
        });
      }
    });
  }

  build();
  // A reader who turns the preference on mid-page gets the finished state too.
  reduced.addEventListener('change', () => {
    ScrollTrigger.getAll().forEach((t) => t.kill());
    build();
  });
</script>
