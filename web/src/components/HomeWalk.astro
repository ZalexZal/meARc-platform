---
import { useTranslations, localise, type Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const href = localise(lang);

// The three things a trail is, in the order they happen. The town behind them
// acts each one out while its words are on screen.
const beats = [
  { n: 1, label: t('home.b1.label'), title: t('home.b1.title'), body: t('home.b1.body') },
  { n: 2, label: t('home.b2.label'), title: t('home.b2.title'), body: t('home.b2.body') },
  { n: 3, label: t('home.b3.label'), title: t('home.b3.title'), body: t('home.b3.body') },
];
---

<!-- One scene, held in place for the length of the walk. The hero's words, then
     Build, Walk and Find, each shown while the town behind it acts it out, and
     a moment of quiet at the end before the page moves on. Everything here is at
     night in both themes: the pulses only glow on a dark town. -->
<div class="walk night" data-walk data-labels={t('home.labels')}>
  <div class="stage" data-stage>
    <div class="scrim" aria-hidden="true"></div>

    <!-- The app's one-line next-stop card, counting the metres down. -->
    <div class="strip" data-strip aria-hidden="true">
      <span class="badge-n">2</span>
      <span class="strip-name">{t('home.stop')}</span>
      <span class="strip-meta">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8" /></svg>
        <span data-strip-dist>240 m</span>
      </span>
    </div>

    <!-- The phone held up at the stop: an empty frame, so what shows through it
         is the town itself at street level, with the stop standing in it. -->
    <div class="finder" data-finder aria-hidden="true">
      <div class="finder-frame">
        <span class="finder-cam"></span>
        <div class="ar-chip"><span class="num">2</span><span>{t('home.stop')}</span><span class="here">{t('home.here')}</span></div>
        <div class="ar-score">+10</div>
        <div class="ar-q">
          <p class="q-eyebrow">{t('home.q.eyebrow')}</p>
          <p class="q-text">{t('home.q.text')}</p>
          <div class="q-opts"><span>2</span><span>3</span><span class="ok">4</span></div>
        </div>
      </div>
    </div>

    <section class="panel panel-hero" data-panel>
      <div class="inner">
        <div class="hero-copy">
          <p class="live">
            <span class="live-dot" aria-hidden="true"></span>
            <span class="t-mouse">{t('home.live.mouse')}</span>
            <span class="t-touch">{t('home.live.touch')}</span>
          </p>
          <h1 class="display-xl hero-title">{t('home.title')}</h1>
          <p class="lede hero-lede">{t('home.lede')}</p>
          <div class="cta-row">
            <a class="btn btn-primary btn-lg" href={href('/my-trails?new=1')}>{t('home.build')}</a>
            <a class="btn btn-quiet btn-lg" href="#how">{t('home.how')}</a>
          </div>
          <p class="soon">{t('home.soon')}</p>
        </div>
      </div>
      <a class="cue" href="#how">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" /></svg>
        {t('home.scroll')}
      </a>
    </section>

    {beats.map((beat) => (
      <section class="panel panel-beat" data-panel aria-labelledby={`beat-${beat.n}`}>
        <div class="inner">
          <div class="beat-card">
            <p class="eyebrow beat-label">
              <span class="beat-steps" aria-hidden="true">
                {beats.map((b) => <span class:list={['beat-step', { on: b.n <= beat.n }]}></span>)}
              </span>
              <span class="beat-n">{beat.n}</span>{beat.label}
            </p>
            <h2 class="display-lg" id={`beat-${beat.n}`}>{beat.title}</h2>
            <p class="lede beat-body">{beat.body}</p>
          </div>
        </div>
      </section>
    ))}
  </div>
  <!-- "How it works" lands here: where Build is on screen. -->
  <span class="how-at" id="how" aria-hidden="true"></span>
</div>

<script>
  import { startTown } from '../lib/town';

  const walk = document.querySelector<HTMLElement>('[data-walk]');
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  if (walk && stage) {
    startTown({
      host: stage,
      tilt: 54,
      walkers: matchMedia('(max-width: 759px)').matches ? 3 : 5,
      pointer: true,
      labels: (walk.dataset.labels ?? '').split('|').filter(Boolean),
      story: {
        scroller: walk,
        panels: Array.from(stage.querySelectorAll<HTMLElement>('[data-panel]')),
        strip: stage.querySelector<HTMLElement>('[data-strip]'),
        stripDist: stage.querySelector<HTMLElement>('[data-strip-dist]'),
        finder: stage.querySelector<HTMLElement>('[data-finder]'),
        here: stage.querySelector('.ar-chip .here')?.textContent ?? '',
      },
    });
  }
</script>

<style>
  /* Held for 4.4 screens of scrolling: the hero, three steps and a quiet end.
     svh, not vh: on a phone the address bar coming and going must not resize
     the scene mid-walk. Pulled up under the header, so the header floats over
     the town from the first frame. */
  .walk { --stage-h: max(560px, 100svh); position: relative; height: calc(var(--stage-h) * 4.4); margin-top: -64px; background: #080d10; }
  .stage { position: sticky; top: 0; height: var(--stage-h); }
  .how-at { position: absolute; left: 0; top: calc(var(--stage-h) * .7); width: 1px; height: 1px; }
  .scrim {
    position: absolute; inset: 0; pointer-events: none; z-index: -1;
    background:
      linear-gradient(90deg, rgba(8,13,16,.9) 0%, rgba(8,13,16,.7) 26%, rgba(8,13,16,0) 52%),
      linear-gradient(0deg, rgba(8,13,16,.55), rgba(8,13,16,0) 16%);
  }

  /* Above the phone, whose shadow darkens everything under it. */
  .panel { position: absolute; inset: 0; z-index: 3; display: flex; align-items: center; padding-top: 64px; }
  .inner { width: 100%; max-width: 76rem; margin: 0 auto; padding: 0 1.5rem; }
  .panel-beat { visibility: hidden; opacity: 0; }

  .hero-copy { max-width: 40rem; }
  .live {
    display: inline-flex; align-items: center; gap: 10px; margin: 0 0 1.75rem;
    padding: 8px 14px 8px 12px; border-radius: 999px;
    border: 1px solid var(--line); background: rgba(16,26,31,.6);
    -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
    font-size: 13px; color: var(--ink-dim);
  }
  .live-dot { width: 8px; height: 8px; border-radius: 50%; background: #2997ff; animation: ping 2s ease-out infinite; }
  @keyframes ping { 0% { box-shadow: 0 0 0 0 rgba(41,151,255,.6); } 100% { box-shadow: 0 0 0 10px rgba(41,151,255,0); } }
  .t-touch { display: none; }
  @media (hover: none) { .t-mouse { display: none; } .t-touch { display: inline; } }
  .hero-title { text-shadow: 0 2px 30px rgba(8,13,16,.6); }
  .hero-lede { margin-top: 1.5rem; max-width: 33em; }
  .cta-row { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2.25rem; }
  .soon { margin-top: 1.25rem; font-size: 13px; color: var(--ink-faint); }
  .cue {
    position: absolute; left: max(1.5rem, calc((100% - 76rem) / 2 + 1.5rem)); bottom: 2rem;
    display: flex; align-items: center; gap: 10px; color: var(--ink-faint);
    font: 500 12px var(--font-mono); letter-spacing: .12em; text-transform: uppercase;
  }
  .cue:hover { color: var(--ink); }
  .cue svg { animation: nudge 2.2s ease-in-out infinite; }
  @keyframes nudge { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(4px); } }
  .hero-copy > * { animation: rise .9s cubic-bezier(.2,.7,.2,1) both; }
  .hero-copy > :nth-child(2) { animation-delay: .1s; }
  .hero-copy > :nth-child(3) { animation-delay: .22s; }
  .hero-copy > :nth-child(4) { animation-delay: .34s; }
  .hero-copy > :nth-child(5) { animation-delay: .46s; }
  @keyframes rise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }

  .beat-card { max-width: 27rem; }
  .beat-label { display: flex; align-items: center; color: var(--ink-dim); }
  .beat-steps { display: inline-flex; gap: 4px; margin-right: 14px; }
  .beat-step { width: 18px; height: 3px; border-radius: 3px; background: rgba(140,190,215,.25); }
  .beat-step.on { background: #2997ff; }
  .beat-n {
    display: inline-grid; place-items: center; width: 26px; height: 26px; margin-right: 10px;
    border-radius: 50%; background: #2997ff; color: #04182e; font: 600 12px var(--font-mono); letter-spacing: 0;
  }
  .beat-card h2 { margin-top: 1.125rem; }
  .beat-body { margin-top: 1.125rem; }

  .strip {
    position: absolute; left: 66%; bottom: 40px; transform: translate(-50%, 16px); opacity: 0; z-index: 2;
    display: flex; align-items: center; gap: 12px; height: 60px; min-width: 310px; padding: 0 18px 0 10px;
    border-radius: 20px; background: rgba(16,26,31,.86); border: 1px solid rgba(140,190,215,.18);
    -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px);
    color: #e9f2f5; pointer-events: none; box-shadow: 0 18px 40px -18px rgba(0,0,0,.8);
  }
  .badge-n { width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; background: #2997ff; color: #04182e; font: 600 15px var(--font-mono); }
  .strip-name { font-weight: 600; font-size: 16px; flex: 1; white-space: nowrap; }
  .strip-meta { display: flex; align-items: center; gap: 6px; color: #8cc8ff; font: 500 14px var(--font-mono); white-space: nowrap; }

  /* The phone. Its screen is a hole: the dark around it is a shadow spread
     over everything else, so the eye goes to what the camera sees. */
  .finder {
    position: absolute; left: 70%; top: 52%; width: 292px; height: 592px; z-index: 1;
    transform: translate(-50%, -50%) scale(.9); opacity: 0; pointer-events: none; font-size: 13px; color: #e9f2f5;
  }
  .finder-frame {
    position: absolute; inset: 0; border-radius: 48px; border: 11px solid #05080a;
    box-shadow: 0 0 0 1px rgba(140,190,215,.3), 0 0 0 200vmax rgba(5,8,10,.62), 0 40px 90px -20px rgba(0,0,0,.9);
  }
  .finder-frame::after { content: ""; position: absolute; inset: 0; border-radius: 37px; box-shadow: inset 0 0 50px rgba(0,0,0,.55); pointer-events: none; }
  .finder-cam { position: absolute; top: 8px; left: 50%; width: 76px; height: 22px; margin-left: -38px; border-radius: 12px; background: #05080a; }
  .ar-chip {
    position: absolute; top: 44px; left: 50%; transform: translateX(-50%); white-space: nowrap;
    display: flex; align-items: center; gap: .5em; padding: .45em .9em .45em .45em; border-radius: 999px;
    background: rgba(16,26,31,.78); border: 1px solid rgba(140,190,215,.22);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); font-weight: 600;
  }
  .ar-chip .num { width: 1.7em; height: 1.7em; border-radius: 50%; display: grid; place-items: center; background: #2997ff; color: #04182e; font: 600 .9em var(--font-mono); }
  .ar-chip .here { color: #74d96b; font-weight: 500; }
  .ar-q {
    position: absolute; left: 10px; right: 10px; bottom: 10px; padding: 1.1em 1.1em 1.2em; border-radius: 28px;
    background: rgba(12,19,24,.9); border: 1px solid rgba(140,190,215,.18);
    -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
    transform: translateY(115%); opacity: 0; transition: transform .6s cubic-bezier(.2,.8,.2,1), opacity .4s ease;
  }
  .finder:global(.is-asked) .ar-q { transform: none; opacity: 1; }
  .q-eyebrow { font: 500 .78em var(--font-mono); letter-spacing: .12em; text-transform: uppercase; color: #8cc8ff; }
  .q-text { font-weight: 600; font-size: 1.12em; line-height: 1.35; margin: .5em 0 .9em; }
  .q-opts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .5em; }
  .q-opts span { display: grid; place-items: center; height: 2.9em; border-radius: 999px; background: rgba(140,190,215,.12); font: 600 1em var(--font-mono); transition: background-color .3s, color .3s; }
  .finder:global(.is-scored) .q-opts .ok { background: #2997ff; color: #04182e; }
  .ar-score {
    position: absolute; right: 16px; top: 92px; padding: .4em .8em; border-radius: 999px;
    background: #f0a868; color: #2a1604; font: 600 1.1em var(--font-mono);
    opacity: 0; transform: translateY(10px) scale(.8); transition: opacity .4s, transform .5s cubic-bezier(.3,1.6,.5,1);
  }
  .finder:global(.is-scored) .ar-score { opacity: 1; transform: none; }

  @media (max-width: 759px) {
    .inner { padding: 0 1.25rem; }
    .scrim { background: linear-gradient(180deg, rgba(8,13,16,.9) 0%, rgba(8,13,16,.72) 55%, rgba(8,13,16,0) 78%); }
    .panel-hero { align-items: flex-start; padding-top: calc(64px + 1.5rem); }
    .cue { display: none; }
    /* The words sit in a card at the bottom; the town acts in the space above. */
    .panel-beat { align-items: flex-end; padding: 0 0 1rem; }
    .beat-card {
      max-width: none; padding: 1.125rem 1.25rem 1.25rem; border-radius: 22px;
      background: rgba(10,17,21,.88); border: 1px solid rgba(140,190,215,.16);
      -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
    }
    .beat-card h2 { font-size: 1.75rem; margin-top: .75rem; }
    .beat-body { font-size: 1rem; margin-top: .625rem; }
    .strip { left: 50%; top: 76px; bottom: auto; min-width: 0; width: calc(100% - 40px); height: 54px; }
    .finder { left: 50%; top: 34%; width: min(58vw, 230px); height: calc(min(58vw, 230px) * 2.02); font-size: 10px; }
    .finder-frame { border-width: 8px; border-radius: 36px; }
    .finder-frame::after { border-radius: 28px; }
    .finder-cam { width: 56px; height: 16px; margin-left: -28px; top: 6px; }
    .ar-chip { top: 30px; }
    .ar-score { top: 64px; right: 10px; }
    .ar-q { left: 7px; right: 7px; bottom: 7px; border-radius: 20px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-copy > * { animation: none; }
    .live-dot, .cue svg { animation: none; }
  }
</style>
