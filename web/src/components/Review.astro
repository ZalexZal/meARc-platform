---
import { useTranslations, localise, type Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const href = localise(lang);

const strings = {
  modes: { ctf: t('new.mode.ctf'), freefall: t('new.mode.freefall'),
           guide: t('new.mode.guide'), educational: t('new.mode.educational') },
  stop: t('n.stop'), stops: t('n.stops'),
  by: t('rev.by'),
  open: t('rev.open'),
  approve: t('rev.approve'),
  refuse: t('rev.refuse'),
  note: t('rev.note'),
  working: t('rev.working'),
  failed: t('mine.failed'),
  editHref: href('/trail'),

  repTitle: t('rep.title'),
  repLede: t('rep.lede'),
  repEmpty: t('rep.empty'),
  repEmptyBody: t('rep.emptyBody'),
  repMarker: t('rep.marker'),
  repTrail: t('rep.trail'),
  repBy: t('rep.by'),
  repAnon: t('rep.anonymous'),
  repPlaced: t('rep.placed'),
  repGone: t('rep.gone'),
  repRemove: t('rep.remove'),
  repDismiss: t('rep.dismiss'),
  repNote: t('rep.note'),
  repMap: t('rep.map'),
  reasons: {
    private_property: t('rep.reason.private_property'),
    unsafe: t('rep.reason.unsafe'),
    offensive: t('rep.reason.offensive'),
    wrong_place: t('rep.reason.wrong_place'),
    spam: t('rep.reason.spam'),
    other: t('rep.reason.other'),
  },
};
---

<section class="mx-auto max-w-4xl px-4 py-16 sm:px-6" hidden data-guarded>
  <header class="max-w-2xl">
    <p class="eyebrow">{t('rev.eyebrow')}</p>
    <h1 class="mt-3 text-3xl sm:text-4xl">{t('rev.title')}</h1>
    <p class="mt-3 text-[var(--ink-dim)]">{t('rev.lede')}</p>
  </header>

  <!-- Four states. "Not a reviewer" is one of them and is drawn rather than
       redirected: bouncing somebody off a page they navigated to on purpose
       teaches them nothing about why. -->
  <div class="mt-12 hidden" data-rev-denied>
    <div class="card max-w-lg p-8">
      <p class="text-sm text-[var(--ink-dim)]">{t('rev.denied')}</p>
    </div>
  </div>

  <div class="mt-12 hidden" data-rev-empty>
    <div class="card max-w-lg p-8">
      <h2 class="text-lg">{t('rev.empty')}</h2>
      <p class="mt-2 text-sm text-[var(--ink-dim)]">{t('rev.emptyBody')}</p>
    </div>
  </div>

  <div class="mt-12 hidden" data-rev-failed>
    <div class="note note-alert max-w-lg p-8">
      <p class="text-sm text-[var(--alert)]">{t('mine.failed')}</p>
    </div>
  </div>

  <ul class="mt-12 space-y-5" data-rev-list></ul>

  <!-- The second queue. One page, because a reviewer sits down to review and
       the two things they review are listings and reports. -->
  <div class="mt-20 hidden" data-rep-section>
    <header class="max-w-2xl">
      <h2 class="text-2xl sm:text-3xl">{t('rep.title')}</h2>
      <p class="mt-3 text-[var(--ink-dim)]">{t('rep.lede')}</p>
    </header>

    <div class="mt-8 hidden" data-rep-empty>
      <div class="card max-w-lg p-8">
        <h3 class="text-lg">{t('rep.empty')}</h3>
        <p class="mt-2 text-sm text-[var(--ink-dim)]">{t('rep.emptyBody')}</p>
      </div>
    </div>

    <ul class="mt-8 space-y-5" data-rep-list></ul>
  </div>
</section>

<p class="mx-auto max-w-4xl px-4 py-24 text-center text-[var(--ink-dim)]" data-rev-loading>
  {t('rev.loading')}
</p>

<script type="application/json" data-rev-strings set:html={JSON.stringify(strings)}></script>

<script>
  import { db } from '../lib/supabase';
  import { requireUser, reveal, escapeHtml, text, count } from '../lib/session';

  const S = JSON.parse(document.querySelector('[data-rev-strings]')!.textContent || '{}');
  const q = (sel: string) => document.querySelector(sel);

  await requireUser({ needsReal: false });
  const client = db()!;

  function row(w: any) {
    return `<li class="card p-6" data-world="${w.id}">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0">
          <h2 class="text-lg">${escapeHtml(w.name)}</h2>
          <p class="data mt-2 text-xs text-[var(--ink-dim)]">
            ${escapeHtml(count(w.marker_count, S.stop, S.stops))} · ${escapeHtml(S.modes?.[w.mode] ?? w.mode ?? '')}
            · ${escapeHtml(S.by)} ${escapeHtml(w.owner_email ?? '—')}
          </p>
        </div>
        <a class="btn btn-quiet btn-sm shrink-0"
           href="${S.editHref}?id=${encodeURIComponent(w.id)}">${escapeHtml(S.open)}</a>
      </div>

      <!-- The reason sits above both buttons rather than behind the refuse one.
           A reviewer types it before deciding, and hiding it until after the
           click is how a refusal ends up with no sentence attached. -->
      <label class="mt-5 block text-sm">
        <span class="mb-1.5 block font-medium">${escapeHtml(S.note)}</span>
        <textarea class="field" rows="2" maxlength="500" data-note></textarea>
      </label>

      <div class="mt-4 flex flex-wrap gap-2">
        <button class="btn btn-primary btn-sm"
                data-decide="yes" data-id="${w.id}">${escapeHtml(S.approve)}</button>
        <button class="btn btn-quiet btn-sm"
                data-decide="no" data-id="${w.id}">${escapeHtml(S.refuse)}</button>
        <span class="self-center text-xs text-[var(--ink-dim)]" data-status></span>
      </div>
    </li>`;
  }

  function report(r: any) {
    const kind = r.target === 'marker' ? S.repMarker : S.repTrail;
    const reason = S.reasons[r.reason] ?? r.reason;

    // A removed target keeps its report and loses its buttons. The record is
    // the point; offering Remove for something already gone is not.
    const actions = r.gone
      ? `<span class="text-xs text-[var(--ink-dim)]">${escapeHtml(S.repGone)}</span>`
      : `<button class="btn btn-danger btn-sm"
                 data-report="remove" data-id="${r.id}">${escapeHtml(S.repRemove)}</button>
         <button class="btn btn-quiet btn-sm"
                 data-report="dismiss" data-id="${r.id}">${escapeHtml(S.repDismiss)}</button>`;

    const where = r.lat != null && r.lng != null
      ? `<a class="text-xs underline text-[var(--ink-dim)]" target="_blank" rel="noreferrer"
            href="https://www.openstreetmap.org/?mlat=${r.lat}&mlon=${r.lng}#map=19/${r.lat}/${r.lng}"
            >${escapeHtml(S.repMap)}</a>`
      : '';

    return `<li class="card p-6" data-report-id="${r.id}">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0">
          <p class="eyebrow">${escapeHtml(kind)} · ${escapeHtml(reason)}</p>
          <h3 class="mt-1 text-lg">${escapeHtml(r.title ?? r.trail_name ?? '—')}</h3>
          ${r.title && r.trail_name
            ? `<p class="mt-1 text-sm text-[var(--ink-dim)]">${escapeHtml(r.trail_name)}</p>` : ''}
          ${r.detail
            ? `<p class="mt-3 break-words text-sm">${escapeHtml(r.detail)}</p>` : ''}
          <p class="data mt-3 text-xs text-[var(--ink-dim)]">
            ${escapeHtml(S.repBy)} ${escapeHtml(r.reporter ?? S.repAnon)}
            ${r.placed_by ? ` · ${escapeHtml(S.repPlaced)} ${escapeHtml(r.placed_by)}` : ''}
          </p>
          ${where}
        </div>
      </div>

      <label class="mt-5 block text-sm">
        <span class="mb-1.5 block font-medium">${escapeHtml(S.repNote)}</span>
        <textarea class="field" rows="2" maxlength="500" data-report-note></textarea>
      </label>

      <div class="mt-4 flex flex-wrap gap-2">
        ${actions}
        <span class="self-center text-xs text-[var(--ink-dim)]" data-report-status></span>
      </div>
    </li>`;
  }

  async function load() {
    // is_admin first, so a stranger gets the honest answer rather than an empty
    // queue that looks like "nothing to do".
    const { data: admin } = await client.rpc('is_admin');

    q('[data-rev-loading]')?.remove();
    reveal();

    if (admin !== true) {
      q('[data-rev-denied]')!.classList.remove('hidden');
      return;
    }

    const { data, error } = await client.rpc('listing_queue');

    if (error) {
      q('[data-rev-failed]')!.classList.remove('hidden');
      return;
    }

    const rows = data ?? [];

    q('[data-rev-empty]')!.classList.toggle('hidden', rows.length > 0);
    q('[data-rev-list]')!.innerHTML = rows.map(row).join('');

    // --- the second queue
    const { data: reports } = await client.rpc('reports_queue', { p_state: 'open' });
    const open = reports ?? [];

    q('[data-rep-section]')!.classList.remove('hidden');
    q('[data-rep-empty]')!.classList.toggle('hidden', open.length > 0);
    q('[data-rep-list]')!.innerHTML = open.map(report).join('');
  }

  await load();

  document.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement)?.closest('[data-decide]') as HTMLButtonElement | null;
    if (!button || button.disabled) return;

    const id = button.dataset.id!;
    const approve = button.dataset.decide === 'yes';
    const card = document.querySelector(`[data-world="${id}"]`)!;
    const note = (card.querySelector('[data-note]') as HTMLTextAreaElement)?.value.trim();

    card.querySelectorAll('button').forEach((b) => ((b as HTMLButtonElement).disabled = true));
    text(card.querySelector('[data-status]'), S.working);

    const { error } = await client.rpc('decide_listing', {
      p_world: id, p_approve: approve, p_note: note || null,
    });

    if (error) {
      text(card.querySelector('[data-status]'), error.message);
      card.querySelectorAll('button').forEach((b) => ((b as HTMLButtonElement).disabled = false));
      return;
    }

    await load();
  });

  document.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement)?.closest('[data-report]') as HTMLButtonElement | null;
    if (!button || button.disabled) return;

    const id = button.dataset.id!;
    const remove = button.dataset.report === 'remove';
    const card = document.querySelector(`[data-report-id="${id}"]`)!;
    const note = (card.querySelector('[data-report-note]') as HTMLTextAreaElement)?.value.trim();

    card.querySelectorAll('button').forEach((b) => ((b as HTMLButtonElement).disabled = true));
    text(card.querySelector('[data-report-status]'), S.working);

    // Removing closes the report itself, inside remove_marker - so this only
    // has to resolve when it is NOT removing. Doing both would be a second
    // write racing the first over the same row.
    const rows = (await client.rpc('reports_queue', { p_state: 'open' })).data ?? [];
    const target = rows.find((r: any) => r.id === id);

    let error = null;

    if (remove && target) {
      // The pictures before the rows. remove_world deletes the trail outright,
      // and once it has, media_paths has nothing left to answer about - which
      // is how a trail taken down for its photos leaves those photos sitting in
      // a public bucket for anyone who noted the URL.
      const { data: paths } = await client.rpc('media_paths', {
        p_world: target.world_id,
        p_marker: target.target === 'marker' ? target.marker_id : null,
      });

      if (paths?.length) await client.storage.from('marker-media').remove(paths);

      const call = target.target === 'marker'
        ? client.rpc('remove_marker', { p_marker: target.marker_id, p_note: note || null })
        : client.rpc('remove_world', { p_world: target.world_id, p_note: note || null });
      error = (await call).error;
    } else {
      error = (await client.rpc('resolve_report', {
        p_report: id, p_state: 'dismissed', p_note: note || null,
      })).error;
    }

    if (error) {
      text(card.querySelector('[data-report-status]'), error.message);
      card.querySelectorAll('button').forEach((b) => ((b as HTMLButtonElement).disabled = false));
      return;
    }

    await load();
  });
</script>
