---
import { useTranslations, localise, type Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const href = localise(lang);

const strings = {
  stops: t('rev.stops'),
  by: t('rev.by'),
  open: t('rev.open'),
  approve: t('rev.approve'),
  refuse: t('rev.refuse'),
  note: t('rev.note'),
  working: t('rev.working'),
  failed: t('mine.failed'),
  editHref: href('/trail'),
};
---

<section class="mx-auto max-w-4xl px-4 py-16 sm:px-6" hidden data-guarded>
  <header class="max-w-2xl">
    <p class="eyebrow">{t('rev.eyebrow')}</p>
    <h1 class="mt-3 text-3xl sm:text-4xl">{t('rev.title')}</h1>
    <p class="mt-3 text-[var(--ink-dim)]">{t('rev.lede')}</p>
  </header>

  <!-- Four states. "Not a reviewer" is one of them and is drawn rather than
       redirected: bouncing somebody off a page they navigated to on purpose
       teaches them nothing about why. -->
  <div class="mt-12 hidden" data-rev-denied>
    <div class="card max-w-lg p-8">
      <p class="text-sm text-[var(--ink-dim)]">{t('rev.denied')}</p>
    </div>
  </div>

  <div class="mt-12 hidden" data-rev-empty>
    <div class="card max-w-lg p-8">
      <h2 class="text-lg">{t('rev.empty')}</h2>
      <p class="mt-2 text-sm text-[var(--ink-dim)]">{t('rev.emptyBody')}</p>
    </div>
  </div>

  <div class="mt-12 hidden" data-rev-failed>
    <div class="card max-w-lg border-[var(--alert)] p-8">
      <p class="text-sm text-[var(--alert)]">{t('mine.failed')}</p>
    </div>
  </div>

  <ul class="mt-12 space-y-5" data-rev-list></ul>
</section>

<p class="mx-auto max-w-4xl px-4 py-24 text-center text-[var(--ink-dim)]" data-rev-loading>
  {t('rev.loading')}
</p>

<script type="application/json" data-rev-strings set:html={JSON.stringify(strings)}></script>

<script>
  import { db } from '../lib/supabase';
  import { requireUser, reveal, escapeHtml, text } from '../lib/session';

  const S = JSON.parse(document.querySelector('[data-rev-strings]')!.textContent || '{}');
  const q = (sel: string) => document.querySelector(sel);

  await requireUser({ needsReal: false });
  const client = db()!;

  function row(w: any) {
    return `<li class="card p-6" data-world="${w.id}">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0">
          <h2 class="text-lg">${escapeHtml(w.name)}</h2>
          <p class="data mt-2 text-xs text-[var(--ink-dim)]">
            ${w.marker_count} ${escapeHtml(S.stops)} · ${escapeHtml(w.mode ?? '')}
            · ${escapeHtml(S.by)} ${escapeHtml(w.owner_email ?? '—')}
          </p>
        </div>
        <a class="btn btn-quiet shrink-0" style="min-height:38px"
           href="${S.editHref}?id=${encodeURIComponent(w.id)}">${escapeHtml(S.open)}</a>
      </div>

      <!-- The reason sits above both buttons rather than behind the refuse one.
           A reviewer types it before deciding, and hiding it until after the
           click is how a refusal ends up with no sentence attached. -->
      <label class="mt-5 block text-sm">
        <span class="mb-1.5 block font-medium">${escapeHtml(S.note)}</span>
        <textarea class="field" rows="2" maxlength="500" data-note></textarea>
      </label>

      <div class="mt-4 flex flex-wrap gap-2">
        <button class="btn btn-primary" style="min-height:38px"
                data-decide="yes" data-id="${w.id}">${escapeHtml(S.approve)}</button>
        <button class="btn btn-quiet" style="min-height:38px"
                data-decide="no" data-id="${w.id}">${escapeHtml(S.refuse)}</button>
        <span class="self-center text-xs text-[var(--ink-dim)]" data-status></span>
      </div>
    </li>`;
  }

  async function load() {
    // is_admin first, so a stranger gets the honest answer rather than an empty
    // queue that looks like "nothing to do".
    const { data: admin } = await client.rpc('is_admin');

    q('[data-rev-loading]')?.remove();
    reveal();

    if (admin !== true) {
      q('[data-rev-denied]')!.classList.remove('hidden');
      return;
    }

    const { data, error } = await client.rpc('listing_queue');

    if (error) {
      q('[data-rev-failed]')!.classList.remove('hidden');
      return;
    }

    const rows = data ?? [];

    q('[data-rev-empty]')!.classList.toggle('hidden', rows.length > 0);
    q('[data-rev-list]')!.innerHTML = rows.map(row).join('');
  }

  await load();

  document.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement)?.closest('[data-decide]') as HTMLButtonElement | null;
    if (!button || button.disabled) return;

    const id = button.dataset.id!;
    const approve = button.dataset.decide === 'yes';
    const card = document.querySelector(`[data-world="${id}"]`)!;
    const note = (card.querySelector('[data-note]') as HTMLTextAreaElement)?.value.trim();

    card.querySelectorAll('button').forEach((b) => ((b as HTMLButtonElement).disabled = true));
    text(card.querySelector('[data-status]'), S.working);

    const { error } = await client.rpc('decide_listing', {
      p_world: id, p_approve: approve, p_note: note || null,
    });

    if (error) {
      text(card.querySelector('[data-status]'), error.message);
      card.querySelectorAll('button').forEach((b) => ((b as HTMLButtonElement).disabled = false));
      return;
    }

    await load();
  });
</script>
