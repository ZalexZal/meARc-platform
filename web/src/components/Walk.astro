---
/**
 * Web lite: walking a trail on the website, without AR.
 * Design: docs/superpowers/specs/2026-10-30-web-lite-design.md.
 *
 * The way in (a trail id or a code), the guest warning, the lobby (location
 * first, then the team and its captain, and the start on a live event), and
 * the game: a map, the next stop, a stop that opens by itself inside its
 * circle, its contents, question and hints. Every rule is the server's; the
 * page calls what the app calls (join_world, markers_near, record_visit,
 * marker_detail, check_answer, reveal_hint) and draws what it is told.
 */
import { localise, type Lang } from '../i18n/ui';
import Loading from './Loading.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const href = localise(lang);

