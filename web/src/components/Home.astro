---
import { useTranslations, localise, type Lang, type UIKey } from '../i18n/ui';
import HomeWalk from './HomeWalk.astro';
import AppShot from './AppShot.astro';
import GetApp from './GetApp.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const href = localise(lang);

// Who it is for (6 Nov 2026): the three audiences, each with its drawing.
const modes: { label: UIKey; name: UIKey; body: UIKey; glyph: string }[] = [
  { label: 'home.aud.school.label', name: 'home.aud.school.title', body: 'home.aud.school.body', glyph: 'ctf' },
  { label: 'home.aud.tour.label', name: 'home.aud.tour.title', body: 'home.aud.tour.body', glyph: 'guided' },
  { label: 'home.aud.estate.label', name: 'home.aud.estate.title', body: 'home.aud.estate.body', glyph: 'building' },
];

// The builder's five steps, in its own words, so the page and the tool agree.
const steps: { name: UIKey; body: UIKey; optional?: boolean }[] = [
  { name: 'tab.basics', body: 'home.step.1' },
  { name: 'tab.place', body: 'home.step.2' },
  { name: 'tab.question', body: 'home.step.3', optional: true },
  { name: 'tab.hints', body: 'home.step.4', optional: true },
  { name: 'tab.media', body: 'home.step.5' },
];

// What a stop can hold, beside the app showing one (7 Nov 2026: the page
// leads with what the tool does; the game is one use of it, not the point).
const what: { title: UIKey; body: UIKey; icon: string }[] = [
  { title: 'home.what.1.title', body: 'home.what.1.body', icon: 'M4 5h16v14H4z M4 15l5-5 4 4 3-3 4 4' },
  { title: 'home.what.2.title', body: 'home.what.2.body', icon: 'M9 18V6l10 6-10 6Z' },
  { title: 'home.what.3.title', body: 'home.what.3.body', icon: 'M5 21V9l7-5 7 5v12 M9 21v-6h6v6 M9 11h.01 M15 11h.01' },
  { title: 'home.what.4.title', body: 'home.what.4.body', icon: 'M9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.7v.5 M12 17h.01 M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Z' },
];

const safe: { title: UIKey; body: UIKey; icon: string }[] = [
  { title: 'home.safe.1.title', body: 'home.safe.1.body', icon: 'M12 3 4.5 6v5.5c0 4.6 3.2 8.4 7.5 9.5 4.3-1.1 7.5-4.9 7.5-9.5V6L12 3Z M9 12l2.2 2.2L15.5 10' },
  { title: 'home.safe.2.title', body: 'home.safe.2.body', icon: 'M7 11V8a5 5 0 0 1 10 0v3 M5 11h14v9H5z' },
  { title: 'home.safe.3.title', body: 'home.safe.3.body', icon: 'M12 4v11 M7 10l5 5 5-5 M5 20h14' },
  { title: 'home.safe.4.title', body: 'home.safe.4.body', icon: 'M5 21V4 M5 4h11l-2 4 2 4H5' },
];

---

<HomeWalk lang={lang} />

<!-- The walk does not end at the hero. The rest of the page is the same
     map, faint, with a route running down it that lights a marker at each
     section as the reader reaches it. -->
<div class="rest map" data-rest data-map-texture>
  <div class="route" aria-hidden="true"><span data-route-fill></span></div>

  <section class="sec sec-first" id="what">
    <div class="inner what-grid">
      <div>
        <header class="head" data-reveal>
          <span class="knob" aria-hidden="true"></span>
          <p class="eyebrow">{t('home.what.eyebrow')}</p>
          <h2 class="display-lg">{t('home.what.title')}</h2>
        </header>
        <ul class="what" data-reveal-group>
          {what.map((w, i) => (
            <li style={`transition-delay:${i * 60}ms`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={w.icon} /></svg>
              <div>
                <h3>{t(w.title)}</h3>
                <p>{t(w.body)}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
      <div class="what-shots" data-reveal aria-hidden="true">
        <!-- The wrappers turn toward the cursor (lib/tilt.ts); the phones keep
             their own lean inside them. -->
        <div class="tilt w1" data-tilt><AppShot name="sheet" alt="" class="w1-shot" /></div>
        <div class="tilt w2" data-tilt><AppShot name="question" alt="" class="w2-shot" /></div>
      </div>
    </div>
  </section>

  <section class="sec" id="modes">
    <div class="inner">
      <header class="head" data-reveal>
        <span class="knob" aria-hidden="true"></span>
        <p class="eyebrow">{t('home.modes.eyebrow')}</p>
        <h2 class="display-lg">{t('home.modes.title')}</h2>
      </header>
      <div class="modes">
        {modes.map((m, i) => (
          <article class="tile" data-reveal style={`transition-delay:${i * 55}ms`}>
            {m.glyph === 'guided' && (
              <svg class="glyph" viewBox="0 0 160 84" fill="none" aria-hidden="true">
                <path class="draw" pathLength="1" d="M18 64 C 40 30, 60 30, 70 46 S 104 70, 118 40 S 136 18, 146 22" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
                <circle class="pop" style="transition-delay:0.15s" cx="18" cy="64" r="9" fill="currentColor" />
                <circle class="pop" style="transition-delay:0.4s" cx="70" cy="46" r="9" fill="currentColor" />
                <circle class="pop" style="transition-delay:0.65s" cx="146" cy="22" r="9" fill="currentColor" />
                <g font-family="Inter, system-ui, sans-serif" font-size="10" font-weight="600" style="fill:var(--map-blue-ink)" text-anchor="middle">
                  <text class="pop" style="transition-delay:0.15s" x="18" y="68">1</text>
                  <text class="pop" style="transition-delay:0.4s" x="70" y="50">2</text>
                  <text class="pop" style="transition-delay:0.65s" x="146" y="26">3</text>
                </g>
              </svg>
            )}
            {m.glyph === 'freefall' && (
              <svg class="glyph" viewBox="0 0 160 84" fill="none" aria-hidden="true">
                <g fill="currentColor" opacity=".35"><circle cx="30" cy="20" r="6" /><circle cx="130" cy="16" r="6" /><circle cx="138" cy="66" r="6" /><circle cx="22" cy="68" r="6" /></g>
                <circle class="pop" style="transition-delay:0.55s" cx="104" cy="44" r="9" fill="currentColor" />
                <path class="draw" pathLength="1" d="M66 49 L 92 45" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
                <circle cx="60" cy="50" r="8" style="fill:var(--map-ground)" stroke="currentColor" stroke-width="2.4" />
                <circle cx="60" cy="50" r="3.4" fill="currentColor" />
              </svg>
            )}
            {m.glyph === 'educational' && (
              <svg class="glyph" viewBox="0 0 160 84" fill="none" aria-hidden="true">
                <rect x="34" y="14" width="92" height="58" rx="10" stroke="currentColor" stroke-width="2" opacity=".35" />
                <path class="draw" pathLength="1" d="M48 32 H 112 M48 44 H 100 M48 56 H 88" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
                <circle class="pop" style="transition-delay:0.6s" cx="124" cy="16" r="10" fill="currentColor" />
                <path class="pop" style="transition-delay:0.675s" d="M119.5 16 l3 3 5.5-6" style="stroke:var(--map-blue-ink)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
            {m.glyph === 'building' && (
              <svg class="glyph" viewBox="0 0 160 84" fill="none" aria-hidden="true">
                <path d="M14 78 H 146" stroke="currentColor" stroke-width="2" stroke-dasharray="4 5" opacity=".35" />
                <path class="draw" pathLength="1" d="M52 78 V 22 L 80 8 L 108 22 V 78" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" />
                <g class="pop" style="transition-delay:0.55s" fill="currentColor" opacity=".55">
                  <rect x="62" y="30" width="10" height="9" rx="1.5" /><rect x="88" y="30" width="10" height="9" rx="1.5" />
                  <rect x="62" y="46" width="10" height="9" rx="1.5" /><rect x="88" y="46" width="10" height="9" rx="1.5" />
                </g>
                <rect class="pop" style="transition-delay:0.7s" x="74" y="62" width="12" height="16" rx="2" fill="currentColor" />
              </svg>
            )}
            {m.glyph === 'ctf' && (
              <svg class="glyph" viewBox="0 0 160 84" fill="none" aria-hidden="true">
                <rect class="bar" style="transition-delay:0.25s" x="30" y="30" width="28" height="48" rx="6" fill="currentColor" opacity=".55" />
                <rect class="bar" style="transition-delay:0.15s" x="66" y="12" width="28" height="66" rx="6" fill="var(--lamp)" />
                <rect class="bar" style="transition-delay:0.35s" x="102" y="44" width="28" height="34" rx="6" fill="currentColor" opacity=".35" />
                <text class="pop" style="transition-delay:0.55s" x="80" y="32" text-anchor="middle" font-family="Inter, system-ui, sans-serif" font-size="12" font-weight="600" fill="#2a1604">1</text>
              </svg>
            )}
            <p class="eyebrow tile-label">{t(m.label)}</p>
            <h3>{t(m.name)}</h3>
            <p>{t(m.body)}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sec" id="make">
    <div class="inner">
      <header class="head" data-reveal>
        <span class="knob" aria-hidden="true"></span>
        <p class="eyebrow">{t('home.make.eyebrow')}</p>
        <h2 class="display-lg">{t('home.make.title')}</h2>
        <p class="lede">{t('home.make.lede')}</p>
      </header>
      <ol class="steps" data-reveal-group>
        {steps.map((s, i) => (
          <li class="step" style={`transition-delay:${50 + i * 75}ms`}>
            <span class="step-n" style={`transition-delay:${150 + i * 175}ms`}>{i + 1}</span>
            <h3>{t(s.name)}</h3>
            <p>{t(s.body)}</p>
            {s.optional && <span class="opt">{t('home.optional')}</span>}
          </li>
        ))}
      </ol>
      <div class="make-cta" data-reveal>
        <a class="btn btn-primary btn-lg" href={href('/my-trails?new=1')}>{t('home.build')}</a>
        <p>{t('home.make.note')}</p>
      </div>
    </div>
  </section>

  <GetApp lang={lang} />

  <section class="sec" id="safe">
    <div class="inner safe-grid">
      <header class="head" data-reveal>
        <span class="knob" aria-hidden="true"></span>
        <p class="eyebrow">{t('home.safe.eyebrow')}</p>
        <h2 class="display-lg">{t('home.safe.title')}</h2>
        <p class="lede">{t('home.safe.lede')}</p>
      </header>
      <ul class="safe" data-reveal-group>
        {safe.map((s, i) => (
          <li style={`transition-delay:${i * 60}ms`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={s.icon} /></svg>
            <h3>{t(s.title)}</h3>
            <p>{t(s.body)}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</div>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { initTilt } from '../lib/tilt';

  initTilt();

  gsap.registerPlugin(ScrollTrigger);

  // The route draws itself down the page as it is scrolled, tied to the
  // scrollbar rather than a timer, so the reader is the one walking it.
  const rest = document.querySelector<HTMLElement>('[data-rest]');
  const fill = document.querySelector<HTMLElement>('[data-route-fill]');
  if (rest && fill) {
    gsap.to(fill, {
      scaleY: 1, ease: 'none',
      scrollTrigger: { trigger: rest, start: 'top 55%', end: 'bottom 85%', scrub: 0.4 },
    });
  }

</script>

<style>
  /* The home page's sections arrive in half the site's usual time (30 October:
     less waiting while scrolling); other pages keep global.css's timing. */
  :global(.js-reveal) .rest [data-reveal] { transition-duration: .4s; }
  :global(.js-reveal) .rest [data-reveal-group] > * { transition-duration: .3s; }
  .rest { position: relative; background-color: var(--map-ground); background-size: 960px 960px; }
  /* The walk ends on plain ground; the faint streets come up out of it rather
     than starting at a line. */
  .rest::before {
    content: ""; position: absolute; left: 0; right: 0; top: 0; height: 6rem; pointer-events: none;
    background: linear-gradient(180deg, var(--map-ground), rgba(var(--map-ground-rgb), 0));
  }
  .inner { width: 100%; max-width: 76rem; margin: 0 auto; padding: 0 1.5rem; position: relative; }
  .sec { padding: 5.5rem 0; position: relative; }
  /* Straight after the walk: no second screen of empty map before it. */
  .sec-first { padding-top: 2rem; }
  .rest :global(.get) { position: relative; z-index: 1; }

  .what-grid { display: grid; gap: 3rem; align-items: center; }
  @media (min-width: 960px) { .what-grid { grid-template-columns: minmax(0, 1.05fr) minmax(0, .95fr); } }
  .what { list-style: none; margin: 2.5rem 0 0; padding: 0; display: grid; gap: 1.5rem; }
  @media (min-width: 640px) { .what { grid-template-columns: 1fr 1fr; gap: 2rem 1.75rem; } }
  .what li { display: grid; grid-template-columns: 40px 1fr; gap: .875rem; }
  .what svg { width: 40px; height: 40px; padding: 9px; border-radius: 12px; background: var(--signal-wash); color: var(--signal); }
  .what h3 { font-size: 1.0625rem; letter-spacing: -.01em; }
  .what p { margin-top: .25rem; font-size: var(--text-sm); color: var(--ink-dim); line-height: 1.5; }
  .what-shots { position: relative; height: 36rem; display: none; }
  @media (min-width: 960px) { .what-shots { display: block; } }
  .what-shots .tilt { position: absolute; width: 16rem; }
  .what-shots .w1 { left: 6%; top: 1rem; z-index: 1; }
  .what-shots .w2 { right: 4%; top: 4rem; }
  .what-shots :global(.w1-shot) { transform: rotate(-3deg); }
  .what-shots :global(.w2-shot) { transform: rotate(4deg); }

  /* The route, and a marker at every section it passes. Only where there is a
     margin wide enough to carry it; on narrower screens the sections stand on
     their own. */
  .route, .knob { display: none; }
  @media (min-width: 1340px) {
    .route {
      display: block; position: absolute; top: 0; bottom: 18rem; width: 2px;
      left: calc((100% - 76rem) / 2 - 8px);
      background: repeating-linear-gradient(180deg, rgba(var(--map-street-rgb), .22) 0 6px, transparent 6px 12px);
    }
    .route span {
      position: absolute; inset: 0; display: block; transform: scaleY(0); transform-origin: top;
      background: linear-gradient(180deg, rgba(var(--map-blue-rgb), .2), var(--map-blue));
      box-shadow: 0 0 12px rgba(var(--map-blue-rgb), .6);
    }
    .knob {
      display: block; position: absolute; left: calc(-1.5rem - 8px - 8px); top: .25rem;
      width: 18px; height: 18px; border-radius: 50%;
      background: var(--map-ground); border: 2px solid rgba(var(--map-street-rgb), .35);
      transition: border-color .5s ease .2s, background-color .5s ease .2s, box-shadow .5s ease .2s;
    }
    :global(.is-in) > .knob {
      border-color: var(--map-blue); background: var(--map-blue);
      box-shadow: 0 0 0 6px rgba(var(--map-blue-rgb), .18), 0 0 24px rgba(var(--map-blue-rgb), .7);
    }
  }

  .head { position: relative; max-width: 44rem; }
  .head h2 { margin-top: .875rem; }
  .head .lede { margin-top: 1.25rem; }

  .modes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.125rem; margin-top: 3.5rem; }
  @media (max-width: 1099px) { .modes { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .tile-label { margin-bottom: .25rem; }
  @media (max-width: 640px) {
    .modes {
      display: flex; gap: .75rem; margin: 2rem -1.25rem 0; padding: 0 1.25rem .5rem;
      overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding: 0 1.25rem; scrollbar-width: none;
    }
    .modes::-webkit-scrollbar { display: none; }
    .modes > .tile { flex: 0 0 78%; scroll-snap-align: start; padding: 1.25rem; }
    .glyph { height: 64px; }
  }
  .tile {
    padding: 1.75rem; border-radius: 24px;
    background: rgba(var(--map-panel-rgb), .66); border: 1px solid var(--line);
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
    transition: opacity .8s cubic-bezier(.2,.7,.2,1), transform .8s cubic-bezier(.2,.7,.2,1), border-color .25s ease, box-shadow .25s ease;
  }
  .tile:hover { border-color: rgba(var(--map-blue-rgb), .5); box-shadow: 0 0 0 1px rgba(var(--map-blue-rgb), .2), 0 20px 60px -30px rgba(var(--map-blue-rgb), .5); }
  .glyph { width: 100%; height: 84px; color: var(--map-blue); }
  .tile h3, .step h3, .safe h3 { font-size: 1.1875rem; line-height: 1.25; letter-spacing: -.015em; margin-top: 1.375rem; }
  .tile p { margin-top: .625rem; font-size: .96875rem; color: var(--ink-dim); }

  .draw { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.4s cubic-bezier(.6,.1,.2,1) .25s; }
  :global(.is-in) .draw { stroke-dashoffset: 0; }
  .pop { opacity: 0; transform: scale(.4); transform-box: fill-box; transform-origin: center; transition: opacity .2s ease, transform .25s cubic-bezier(.3,1.6,.5,1); }
  :global(.is-in) .pop { opacity: 1; transform: none; }
  .bar { transform: scaleY(0); transform-box: fill-box; transform-origin: bottom; transition: transform .45s cubic-bezier(.2,.8,.2,1); }
  :global(.is-in) .bar { transform: none; }

  .steps { list-style: none; padding: 0; margin: 4rem 0 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1.125rem; position: relative; }
  .steps::before, .steps::after { content: ""; position: absolute; left: 28px; right: 28px; top: 27px; height: 2px; }
  .steps::before { background: rgba(var(--map-street-rgb), .2); }
  .steps::after { background: var(--map-blue); box-shadow: 0 0 10px rgba(var(--map-blue-rgb), .6); transform: scaleX(0); transform-origin: left; transition: transform 1.8s cubic-bezier(.6,.1,.2,1) .2s; }
  .steps:global(.is-in)::after { transform: scaleX(1); }
  .step { position: relative; }
  .step-n {
    position: relative; z-index: 1; width: 56px; height: 56px; border-radius: 50%;
    display: grid; place-items: center; background: var(--map-ground); border: 2px solid rgba(var(--map-street-rgb), .3);
    font: 600 18px var(--font-body); color: var(--ink-dim);
    transition: border-color .4s ease, color .4s ease, box-shadow .4s ease;
  }
  .steps:global(.is-in) .step-n { border-color: var(--map-blue); color: var(--map-blue-soft); box-shadow: 0 0 22px -4px rgba(var(--map-blue-rgb), .7); }
  .step p { margin-top: .5rem; font-size: .9375rem; color: var(--ink-dim); }
  .opt {
    display: inline-block; margin-top: .75rem; padding: 3px 10px; border-radius: 999px;
    background: var(--surface-2); color: var(--ink-dim);
    font: 600 12px var(--font-body); letter-spacing: -.01em;
  }
  .make-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; margin-top: 3.5rem; }
  .make-cta p { font-size: .875rem; color: var(--ink-faint); }
  @media (max-width: 899px) {
    .steps { grid-template-columns: 1fr; gap: 1.75rem; }
    .steps::before, .steps::after { left: 27px; right: auto; top: 28px; bottom: 28px; width: 2px; height: auto; }
    .steps::after { transform: scaleY(0); transform-origin: top; }
    .steps:global(.is-in)::after { transform: scaleY(1); }
    .step { display: grid; grid-template-columns: 56px minmax(0, 1fr); column-gap: 1.125rem; }
    .step > h3, .step > p, .step > .opt { grid-column: 2; }
    .step > h3 { margin-top: .125rem; }
    .step-n { grid-row: 1 / span 3; }
    .opt { justify-self: start; }
  }

  .safe-grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 4rem; align-items: start; }
  @media (max-width: 899px) { .safe-grid { grid-template-columns: 1fr; gap: 2.5rem; } }
  .safe { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  @media (max-width: 640px) { .safe { grid-template-columns: 1fr; } }
  .safe li { padding: 1.5rem; border-radius: 22px; background: rgba(var(--map-panel-rgb), .66); border: 1px solid var(--line); }
  .safe svg { width: 28px; height: 28px; color: var(--map-blue); }
  .safe h3 { font-size: 1rem; margin-top: 1rem; }
  .safe p { margin-top: .5rem; font-size: .9375rem; color: var(--ink-dim); }


  @media (max-width: 759px) {
    .inner { padding: 0 1.25rem; }
    .sec { padding: 5rem 0; }
  }
</style>
