---
import { useTranslations, localise, type Lang, type UIKey } from '../i18n/ui';
import HomeWalk from './HomeWalk.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const href = localise(lang);

const modes: { name: UIKey; body: UIKey; glyph: string }[] = [
  { name: 'new.mode.guide', body: 'home.mode.guide', glyph: 'guided' },
  { name: 'new.mode.freefall', body: 'home.mode.freefall', glyph: 'freefall' },
  { name: 'new.mode.educational', body: 'home.mode.educational', glyph: 'educational' },
  { name: 'new.mode.ctf', body: 'home.mode.ctf', glyph: 'ctf' },
];

// The builder's five steps, in its own words, so the page and the tool agree.
const steps: { name: UIKey; body: UIKey; optional?: boolean }[] = [
  { name: 'tab.basics', body: 'home.step.1' },
  { name: 'tab.place', body: 'home.step.2' },
  { name: 'tab.question', body: 'home.step.3', optional: true },
  { name: 'tab.hints', body: 'home.step.4', optional: true },
  { name: 'tab.media', body: 'home.step.5' },
];

const safe: { title: UIKey; body: UIKey; icon: string }[] = [
  { title: 'home.safe.1.title', body: 'home.safe.1.body', icon: 'M12 3 4.5 6v5.5c0 4.6 3.2 8.4 7.5 9.5 4.3-1.1 7.5-4.9 7.5-9.5V6L12 3Z M9 12l2.2 2.2L15.5 10' },
  { title: 'home.safe.2.title', body: 'home.safe.2.body', icon: 'M7 11V8a5 5 0 0 1 10 0v3 M5 11h14v9H5z' },
  { title: 'home.safe.3.title', body: 'home.safe.3.body', icon: 'M12 4v11 M7 10l5 5 5-5 M5 20h14' },
  { title: 'home.safe.4.title', body: 'home.safe.4.body', icon: 'M5 21V4 M5 4h11l-2 4 2 4H5' },
];

const faq = [
  ['faq.q1', 'faq.a1'], ['faq.q2', 'faq.a2'], ['faq.q3', 'faq.a3'],
  ['faq.q4', 'faq.a4'], ['faq.q5', 'faq.a5'],
] as const;
---

<HomeWalk lang={lang} />

<!-- The walk does not end at the hero. The rest of the page is the same night
     map, faint, with a route running down it that lights a marker at each
     section as the reader reaches it. -->
<div class="rest night" data-rest data-map-texture>
  <div class="route" aria-hidden="true"><span data-route-fill></span></div>

  <section class="sec" id="modes">
    <div class="inner">
      <header class="head" data-reveal>
        <span class="knob" aria-hidden="true"></span>
        <p class="eyebrow">{t('home.modes.eyebrow')}</p>
        <h2 class="display-lg">{t('home.modes.title')}</h2>
      </header>
      <div class="modes">
        {modes.map((m, i) => (
          <article class="tile" data-reveal style={`transition-delay:${i * 110}ms`}>
            {m.glyph === 'guided' && (
              <svg class="glyph" viewBox="0 0 160 84" fill="none" aria-hidden="true">
                <path class="draw" pathLength="1" d="M18 64 C 40 30, 60 30, 70 46 S 104 70, 118 40 S 136 18, 146 22" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
                <circle class="pop" style="transition-delay:.3s" cx="18" cy="64" r="9" fill="currentColor" />
                <circle class="pop" style="transition-delay:.8s" cx="70" cy="46" r="9" fill="currentColor" />
                <circle class="pop" style="transition-delay:1.3s" cx="146" cy="22" r="9" fill="currentColor" />
                <g font-family="JetBrains Mono, monospace" font-size="10" font-weight="600" fill="#04182e" text-anchor="middle">
                  <text class="pop" style="transition-delay:.3s" x="18" y="68">1</text>
                  <text class="pop" style="transition-delay:.8s" x="70" y="50">2</text>
                  <text class="pop" style="transition-delay:1.3s" x="146" y="26">3</text>
                </g>
              </svg>
            )}
            {m.glyph === 'freefall' && (
              <svg class="glyph" viewBox="0 0 160 84" fill="none" aria-hidden="true">
                <g fill="currentColor" opacity=".35"><circle cx="30" cy="20" r="6" /><circle cx="130" cy="16" r="6" /><circle cx="138" cy="66" r="6" /><circle cx="22" cy="68" r="6" /></g>
                <circle class="pop" style="transition-delay:1.1s" cx="104" cy="44" r="9" fill="currentColor" />
                <path class="draw" pathLength="1" d="M66 49 L 92 45" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
                <circle cx="60" cy="50" r="8" fill="#080d10" stroke="currentColor" stroke-width="2.4" />
                <circle cx="60" cy="50" r="3.4" fill="currentColor" />
              </svg>
            )}
            {m.glyph === 'educational' && (
              <svg class="glyph" viewBox="0 0 160 84" fill="none" aria-hidden="true">
                <rect x="34" y="14" width="92" height="58" rx="10" stroke="currentColor" stroke-width="2" opacity=".35" />
                <path class="draw" pathLength="1" d="M48 32 H 112 M48 44 H 100 M48 56 H 88" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
                <circle class="pop" style="transition-delay:1.2s" cx="124" cy="16" r="10" fill="currentColor" />
                <path class="pop" style="transition-delay:1.35s" d="M119.5 16 l3 3 5.5-6" stroke="#04182e" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
            {m.glyph === 'ctf' && (
              <svg class="glyph" viewBox="0 0 160 84" fill="none" aria-hidden="true">
                <rect class="bar" style="transition-delay:.5s" x="30" y="30" width="28" height="48" rx="6" fill="currentColor" opacity=".55" />
                <rect class="bar" style="transition-delay:.3s" x="66" y="12" width="28" height="66" rx="6" fill="var(--lamp)" />
                <rect class="bar" style="transition-delay:.7s" x="102" y="44" width="28" height="34" rx="6" fill="currentColor" opacity=".35" />
                <text class="pop" style="transition-delay:1.1s" x="80" y="32" text-anchor="middle" font-family="JetBrains Mono, monospace" font-size="12" font-weight="600" fill="#2a1604">1</text>
              </svg>
            )}
            <h3>{t(m.name)}</h3>
            <p>{t(m.body)}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="sec" id="make">
    <div class="inner">
      <header class="head" data-reveal>
        <span class="knob" aria-hidden="true"></span>
        <p class="eyebrow">{t('home.make.eyebrow')}</p>
        <h2 class="display-lg">{t('home.make.title')}</h2>
        <p class="lede">{t('home.make.lede')}</p>
      </header>
      <ol class="steps" data-reveal-group>
        {steps.map((s, i) => (
          <li class="step" style={`transition-delay:${100 + i * 150}ms`}>
            <span class="step-n" style={`transition-delay:${300 + i * 350}ms`}>{i + 1}</span>
            <h3>{t(s.name)}</h3>
            <p>{t(s.body)}</p>
            {s.optional && <span class="opt">{t('home.optional')}</span>}
          </li>
        ))}
      </ol>
      <div class="make-cta" data-reveal>
        <a class="btn btn-primary btn-lg" href={href('/my-trails?new=1')}>{t('home.build')}</a>
        <p>{t('home.make.note')}</p>
      </div>
    </div>
  </section>

  <section class="sec" id="safe">
    <div class="inner safe-grid">
      <header class="head" data-reveal>
        <span class="knob" aria-hidden="true"></span>
        <p class="eyebrow">{t('home.safe.eyebrow')}</p>
        <h2 class="display-lg">{t('home.safe.title')}</h2>
        <p class="lede">{t('home.safe.lede')}</p>
      </header>
      <ul class="safe" data-reveal-group>
        {safe.map((s, i) => (
          <li style={`transition-delay:${i * 120}ms`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={s.icon} /></svg>
            <h3>{t(s.title)}</h3>
            <p>{t(s.body)}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec" id="faq">
    <div class="inner">
      <header class="head" data-reveal>
        <span class="knob" aria-hidden="true"></span>
        <p class="eyebrow">{t('faq.eyebrow')}</p>
        <h2 class="display-lg">{t('faq.title')}</h2>
      </header>
      <div class="faq" data-reveal>
        {faq.map(([q, a]) => (
          <details>
            <summary>
              <span>{t(q)}</span>
              <span class="plus" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M8 3v10M3 8h10" /></svg>
              </span>
            </summary>
            <p>{t(a)}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="sec last">
    <div class="inner">
      <div class="final" data-reveal data-final>
        <canvas data-final-canvas aria-hidden="true"></canvas>
        <div class="final-copy">
          <h2 class="display-lg">{t('home.final.title')}</h2>
          <p class="lede">{t('home.final.body')}</p>
          <div class="final-cta">
            <a class="btn btn-primary btn-lg" href={href('/my-trails?new=1')}>{t('home.build')}</a>
            <span class="soon">{t('home.soon')}</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { startNightMap } from '../lib/nightmap';

  gsap.registerPlugin(ScrollTrigger);

  // The route draws itself down the page as it is scrolled, tied to the
  // scrollbar rather than a timer, so the reader is the one walking it.
  const rest = document.querySelector<HTMLElement>('[data-rest]');
  const fill = document.querySelector<HTMLElement>('[data-route-fill]');
  if (rest && fill) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      fill.style.transform = 'scaleY(1)';
    } else {
      gsap.to(fill, {
        scaleY: 1, ease: 'none',
        scrollTrigger: { trigger: rest, start: 'top 55%', end: 'bottom 85%', scrub: 0.4 },
      });
    }
  }

  // The closing card has a small live network of its own.
  const final = document.querySelector<HTMLElement>('[data-final]');
  const finalCanvas = document.querySelector<HTMLCanvasElement>('[data-final-canvas]');
  if (final && finalCanvas) startNightMap({ host: final, canvas: finalCanvas, seed: 29, walker: false });
</script>

<style>
  .rest { position: relative; background-color: #080d10; background-size: 960px 960px; }
  .inner { width: 100%; max-width: 76rem; margin: 0 auto; padding: 0 1.5rem; position: relative; }
  .sec { padding: 7.5rem 0; position: relative; }
  .sec.last { padding-top: 2rem; }

  /* The route, and a marker at every section it passes. Only where there is a
     margin wide enough to carry it; on narrower screens the sections stand on
     their own. */
  .route, .knob { display: none; }
  @media (min-width: 1340px) {
    .route {
      display: block; position: absolute; top: 0; bottom: 18rem; width: 2px;
      left: calc((100% - 76rem) / 2 - 8px);
      background: repeating-linear-gradient(180deg, rgba(140,190,215,.22) 0 6px, transparent 6px 12px);
    }
    .route span {
      position: absolute; inset: 0; display: block; transform: scaleY(0); transform-origin: top;
      background: linear-gradient(180deg, rgba(41,151,255,.2), #2997ff);
      box-shadow: 0 0 12px rgba(41,151,255,.6);
    }
    .knob {
      display: block; position: absolute; left: calc(-1.5rem - 8px - 8px); top: .25rem;
      width: 18px; height: 18px; border-radius: 50%;
      background: #080d10; border: 2px solid rgba(140,190,215,.35);
      transition: border-color .5s ease .2s, background-color .5s ease .2s, box-shadow .5s ease .2s;
    }
    :global(.is-in) > .knob {
      border-color: #2997ff; background: #2997ff;
      box-shadow: 0 0 0 6px rgba(41,151,255,.18), 0 0 24px rgba(41,151,255,.7);
    }
  }

  .head { position: relative; max-width: 44rem; }
  .head h2 { margin-top: .875rem; }
  .head .lede { margin-top: 1.25rem; }

  .modes { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.125rem; margin-top: 3.5rem; }
  @media (max-width: 1099px) { .modes { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .modes { grid-template-columns: 1fr; } }
  .tile {
    padding: 1.75rem; border-radius: 24px;
    background: rgba(16,26,31,.66); border: 1px solid var(--line);
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
    transition: opacity .8s cubic-bezier(.2,.7,.2,1), transform .8s cubic-bezier(.2,.7,.2,1), border-color .25s ease, box-shadow .25s ease;
  }
  .tile:hover { border-color: rgba(41,151,255,.5); box-shadow: 0 0 0 1px rgba(41,151,255,.2), 0 20px 60px -30px rgba(41,151,255,.5); }
  .glyph { width: 100%; height: 84px; color: #2997ff; }
  .tile h3, .step h3, .safe h3 { font-size: 1.1875rem; line-height: 1.25; letter-spacing: -.015em; margin-top: 1.375rem; }
  .tile p { margin-top: .625rem; font-size: .96875rem; color: var(--ink-dim); }

  .draw { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.4s cubic-bezier(.6,.1,.2,1) .25s; }
  :global(.is-in) .draw { stroke-dashoffset: 0; }
  .pop { opacity: 0; transform: scale(.4); transform-box: fill-box; transform-origin: center; transition: opacity .4s ease, transform .5s cubic-bezier(.3,1.6,.5,1); }
  :global(.is-in) .pop { opacity: 1; transform: none; }
  .bar { transform: scaleY(0); transform-box: fill-box; transform-origin: bottom; transition: transform .9s cubic-bezier(.2,.8,.2,1); }
  :global(.is-in) .bar { transform: none; }

  .steps { list-style: none; padding: 0; margin: 4rem 0 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1.125rem; position: relative; }
  .steps::before, .steps::after { content: ""; position: absolute; left: 28px; right: 28px; top: 27px; height: 2px; }
  .steps::before { background: rgba(140,190,215,.2); }
  .steps::after { background: #2997ff; box-shadow: 0 0 10px rgba(41,151,255,.6); transform: scaleX(0); transform-origin: left; transition: transform 1.8s cubic-bezier(.6,.1,.2,1) .2s; }
  .steps:global(.is-in)::after { transform: scaleX(1); }
  .step { position: relative; }
  .step-n {
    position: relative; z-index: 1; width: 56px; height: 56px; border-radius: 50%;
    display: grid; place-items: center; background: #080d10; border: 2px solid rgba(140,190,215,.3);
    font: 600 18px var(--font-mono); color: var(--ink-dim);
    transition: border-color .4s ease, color .4s ease, box-shadow .4s ease;
  }
  .steps:global(.is-in) .step-n { border-color: #2997ff; color: #8cc8ff; box-shadow: 0 0 22px -4px rgba(41,151,255,.7); }
  .step p { margin-top: .5rem; font-size: .9375rem; color: var(--ink-dim); }
  .opt {
    display: inline-block; margin-top: .75rem; padding: 3px 10px; border-radius: 999px;
    background: var(--surface-2); color: var(--ink-dim);
    font: 500 11px var(--font-mono); letter-spacing: .06em; text-transform: uppercase;
  }
  .make-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 1.25rem; margin-top: 3.5rem; }
  .make-cta p { font-size: .875rem; color: var(--ink-faint); }
  @media (max-width: 899px) {
    .steps { grid-template-columns: 1fr; gap: 1.75rem; }
    .steps::before, .steps::after { left: 27px; right: auto; top: 28px; bottom: 28px; width: 2px; height: auto; }
    .steps::after { transform: scaleY(0); transform-origin: top; }
    .steps:global(.is-in)::after { transform: scaleY(1); }
    .step { display: grid; grid-template-columns: 56px minmax(0, 1fr); column-gap: 1.125rem; }
    .step > h3, .step > p, .step > .opt { grid-column: 2; }
    .step > h3 { margin-top: .125rem; }
    .step-n { grid-row: 1 / span 3; }
    .opt { justify-self: start; }
  }

  .safe-grid { display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 4rem; align-items: start; }
  @media (max-width: 899px) { .safe-grid { grid-template-columns: 1fr; gap: 2.5rem; } }
  .safe { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  @media (max-width: 640px) { .safe { grid-template-columns: 1fr; } }
  .safe li { padding: 1.5rem; border-radius: 22px; background: rgba(16,26,31,.66); border: 1px solid var(--line); }
  .safe svg { width: 28px; height: 28px; color: #2997ff; }
  .safe h3 { font-size: 1rem; margin-top: 1rem; }
  .safe p { margin-top: .5rem; font-size: .9375rem; color: var(--ink-dim); }

  .faq { max-width: 52rem; margin-top: 2.5rem; border-top: 1px solid var(--line); }
  .faq details { border-bottom: 1px solid var(--line); }
  .faq summary { list-style: none; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; padding: 1.375rem 0; font-weight: 600; font-size: 1.0625rem; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary:hover .plus { border-color: #2997ff; color: #8cc8ff; }
  .plus { flex: none; width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; border: 1px solid var(--line); color: var(--ink-dim); transition: transform .25s ease, border-color .2s ease, color .2s ease; }
  .faq details[open] .plus { transform: rotate(45deg); }
  .faq details p { margin: 0 0 1.5rem; padding-right: 3rem; color: var(--ink-dim); max-width: 62ch; }

  .final {
    position: relative; overflow: hidden; isolation: isolate; border-radius: 32px;
    border: 1px solid var(--line); padding: 7rem 2rem; text-align: center; min-height: 26rem;
  }
  .final canvas { position: absolute; inset: 0; z-index: -2; display: block; }
  .final::before {
    content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(ellipse 55% 65% at 50% 50%, rgba(8,13,16,.92), rgba(8,13,16,.55) 70%, rgba(8,13,16,.2));
  }
  .final-copy { max-width: 36rem; margin: 0 auto; }
  .final .lede { margin-top: 1.25rem; }
  .final-cta { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: .75rem; margin-top: 2.25rem; }
  .soon { display: inline-flex; align-items: center; min-height: 52px; padding: 0 1.25rem; border-radius: 999px; border: 1px dashed var(--line); font-size: .875rem; color: var(--ink-dim); }

  @media (max-width: 759px) {
    .inner { padding: 0 1.25rem; }
    .sec { padding: 5rem 0; }
    .final { padding: 4.5rem 1.25rem; }
  }
</style>
