---
// One of the app's screens in a phone outline, light or dark with the site.
// The pictures are the app's own preview renders (tools/app-shots.py): the
// sample Yambol trail, never a real phone's location. A real photo from the
// phone (`src`) is the same in both themes and languages.
import { langFromUrl } from '../i18n/ui';
interface Props { name?: string; src?: string; alt: string; class?: string; eager?: boolean; }
const { name, src, alt, class: cls = '', eager = false } = Astro.props;
const lang = langFromUrl(Astro.url);
---
<figure class:list={['shot', cls]}>
  {src ? (
  <img src={src} alt={alt} width="540" height="960" loading={eager ? 'eager' : 'lazy'} decoding="async" />
  ) : (<>
  <img class="shot-light" src={`/app/${name}-${lang}-light.webp`} alt={alt} width="540" height="960"
       loading={eager ? 'eager' : 'lazy'} decoding="async" />
  <img class="shot-dark" src={`/app/${name}-${lang}-dark.webp`} alt="" aria-hidden="true" width="540" height="960"
       loading="lazy" decoding="async" />
  </>)}
</figure>

<style>
  .shot {
    margin: 0; aspect-ratio: 9 / 16; border-radius: 34px; overflow: hidden;
    border: 6px solid var(--ink); background: var(--surface);
    box-shadow: 0 24px 60px -24px rgba(0, 0, 0, .35);
  }
  .shot img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .shot-dark { display: none !important; }
  :global(:root[data-theme="dark"]) .shot .shot-light { display: none !important; }
  :global(:root[data-theme="dark"]) .shot .shot-dark { display: block !important; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .shot .shot-light { display: none !important; }
    :global(:root:not([data-theme="light"])) .shot .shot-dark { display: block !important; }
  }
  :global(:root[data-theme="dark"]) .shot, :global(:root:not([data-theme="light"])) .shot { border-color: #2c2c2e; }
  @media (prefers-color-scheme: light) { :global(:root:not([data-theme="dark"])) .shot { border-color: var(--ink); } }
</style>
