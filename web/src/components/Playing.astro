---
import { useTranslations, type Lang } from '../i18n/ui';
import PageBand from './PageBand.astro';
import AppShot from './AppShot.astro';
import GetApp from './GetApp.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

/**
 * What a walker needs to know, in the order they need it.
 *
 * Numbered because this genuinely is a sequence - you cannot join a team before
 * you have joined the trail - rather than because numbers look tidy. Since
 * the app took either code in one box (Nov 2026) the old "team code is not
 * the trail code" warning is gone, and teams are the last, optional step.
 */
const steps = [1, 2, 3, 4, 5] as const;
// The screen beside each step, on a wide window.
const shots: Record<number, string> = { 1: 'welcome', 2: 'trails', 3: 'map', 4: 'sheet', 5: 'team' };
---

<PageBand eyebrow={t('nav.play')} title={t('play.title')} lede={t('play.lede')}>
  <a class="btn btn-primary" href="/ARTrail.apk" download>{t('app.download')}</a>
</PageBand>

<section class="play-wrap">
  <div class="play-main">
    <p class="note">{t('play.need')}</p>

    <ol class="mt-12 space-y-14">
      {steps.map((n) => (
        <li class="play-step grid grid-cols-[40px_1fr] gap-5 sm:grid-cols-[52px_1fr] sm:gap-7">
          <span
            class="grid h-10 w-10 place-items-center rounded-full border border-[var(--line)] bg-[var(--surface)] sm:h-12 sm:w-12"
            aria-hidden="true"
          >
            <span class="data text-sm font-semibold text-[var(--ink-dim)]">{n}</span>
          </span>
          <div class="min-w-0 pt-1.5 sm:pt-2.5">
            <h2 class="text-xl sm:text-2xl">{t(`play.${n}.title` as any)}</h2>
            <p class="mt-2 text-[var(--ink-dim)]">{t(`play.${n}.body` as any)}</p>
          </div>
          <div class="play-shot" data-tilt><AppShot name={shots[n]} alt="" /></div>
        </li>
      ))}
    </ol>

    <!-- Last, and deliberately outside the numbered list: it is not a step in
         the walk, it is the thing you do when the walk goes wrong. -->
    <div class="mt-16 border-t border-[var(--line)] pt-10">
      <h2 class="text-xl sm:text-2xl">{t('play.report.title')}</h2>
      <p class="mt-2 text-[var(--ink-dim)]">{t('play.report.body')}</p>
    </div>
  </div>
</section>

<GetApp lang={lang} />

<style>
  /* Each step with its own screen beside it on a wide window, so the page is
     the app explained rather than a narrow column in a wide one (website
     sweep, 7 Nov 2026). On a phone the screens would only repeat the phone. */
  .play-wrap { max-width: 64rem; margin: 0 auto; padding: 1rem 1rem 5rem; }
  @media (min-width: 640px) { .play-wrap { padding: 1rem 1.5rem 6rem; } }
  .play-main { max-width: 64rem; }
  .play-step .play-shot { display: none; }
  @media (min-width: 960px) {
    .play-step { grid-template-columns: 52px minmax(0, 1fr) 13rem !important; align-items: start; column-gap: 2.5rem !important; }
    .play-step .play-shot { display: block; width: 13rem; }
  }
</style>

<script>
  // Each screen turns a little toward the cursor (lib/tilt.ts).
  import { initTilt } from '../lib/tilt';
  initTilt();
</script>
