---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

/**
 * What a walker needs to know, in the order they need it.
 *
 * Numbered because this genuinely is a sequence - you cannot join a team before
 * you have joined the trail - rather than because numbers look tidy. The two
 * codes get their own warning, because they are the one thing everybody mixes
 * up: both are six characters, both are called a code, and typing one into the
 * other's box is the most common way to be stuck at the start.
 */
const steps = [1, 2, 3, 4, 5, 6] as const;
---

<section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
  <header class="max-w-2xl">
    <p class="eyebrow">{t('nav.play')}</p>
    <h1 class="mt-3 text-3xl sm:text-4xl">{t('play.title')}</h1>
    <p class="mt-4 text-lg text-[var(--ink-dim)]">{t('play.lede')}</p>
  </header>

  <p class="mt-8 rounded-lg border border-[var(--line)] bg-[var(--surface)] px-4 py-3 text-sm">
    {t('play.need')}
  </p>

  <ol class="mt-14 space-y-12">
    {steps.map((n) => (
      <li class="grid grid-cols-[40px_1fr] gap-5 sm:grid-cols-[52px_1fr] sm:gap-7">
        <span
          class="grid h-10 w-10 place-items-center rounded-full border border-[var(--line)] bg-[var(--surface)] sm:h-12 sm:w-12"
          aria-hidden="true"
        >
          <span class="data text-sm font-medium text-[var(--ink-dim)]">{n}</span>
        </span>

        <div class="min-w-0 pt-1.5 sm:pt-2.5">
          <h2 class="text-xl sm:text-2xl">{t(`play.${n}.title` as any)}</h2>
          <p class="mt-2 text-[var(--ink-dim)]">{t(`play.${n}.body` as any)}</p>

          {n === 3 && (
            <p class="mt-4 rounded-lg border border-[var(--lamp)] bg-[var(--lamp-wash)] px-4 py-3 text-sm text-[var(--lamp)]">
              {t('play.3.warn')}
            </p>
          )}
        </div>
      </li>
    ))}
  </ol>

  <!-- Last, and deliberately outside the numbered list: it is not a step in
       the walk, it is the thing you do when the walk goes wrong. -->
  <div class="mt-16 border-t border-[var(--line)] pt-10">
    <h2 class="text-xl sm:text-2xl">{t('play.report.title')}</h2>
    <p class="mt-2 text-[var(--ink-dim)]">{t('play.report.body')}</p>
  </div>
</section>
