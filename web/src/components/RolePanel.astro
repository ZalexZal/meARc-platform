---
/**
 * The left panel of the role choice: the seal, and what the choice so far
 * means. Server-rendered in the "nothing chosen" state; lib/rolepick.ts
 * repaints it from sealState as the reader picks.
 */
import Seal from './Seal.astro';
import { sealState } from '../lib/role';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const s = sealState(null, null, lang);
---
<aside class="role-panel" data-role-panel data-lang={lang}>
  <div class="role-panel-in">
  <p class="role-brand">AR Trail</p>
  <div class="role-panel-head">
    <Seal shape={s.shape} glyph={s.glyph} pip={s.pip} />
    <h2 class="role-title" data-role-title aria-live="polite">{s.title}</h2>
  </div>
  <p class="role-body" data-role-body>{s.body}</p>
  <ul class="role-gets" data-role-gets aria-label={t('role.gets')} hidden></ul>
  <p class="role-foot">{t('role.footer')}</p>
  </div>
</aside>
