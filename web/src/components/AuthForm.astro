---
import { useTranslations, localise, type Lang } from '../i18n/ui';

interface Props { lang: Lang; mode: 'signin' | 'signup'; }
const { lang, mode } = Astro.props;
const t = useTranslations(lang);
const href = localise(lang);
const up = mode === 'signup';
---

<section class="mx-auto flex max-w-md flex-col px-4 py-20 sm:px-6">
  <h1 class="text-3xl">{up ? t('auth.signup.title') : t('auth.signin.title')}</h1>

  <form class="card mt-8 space-y-5 p-6" data-auth-form data-mode={mode}
        data-agree-error={t("err.mustAgree")} novalidate
        data-errors={JSON.stringify({
          fill: t('err.fill'), weak: t('err.weakPassword'), generic: t('err.generic'),
          network: t('err.network'), bad: t('err.badCredentials'), taken: t('err.emailTaken'),
          age: t('err.age'), parentEmail: t('err.parentEmail'), unconfirmed: t('err.unconfirmed'),
          tooYoung: t('err.tooYoung'),
          slowDown: t('err.slowDown'), resent: t('auth.resent'), parentSentBody: t('auth.parentSentBody'),
        })}>
    {up && (
      <div>
        <label class="mb-1.5 block text-sm font-medium" for="name">{t('auth.name')}</label>
        <input class="field" id="name" name="name" type="text" autocomplete="nickname" maxlength="40" />
        <p class="mt-1.5 text-xs text-[var(--ink-faint)]">{t('auth.nameHelp')}</p>
      </div>
    )}

    <div>
      <label class="mb-1.5 block text-sm font-medium" for="email">{t('auth.email')}</label>
      <input class="field" id="email" name="email" type="email" required autocomplete="email" />
    </div>

    <div>
      <label class="mb-1.5 block text-sm font-medium" for="password">{t('auth.password')}</label>
      <input
        class="field" id="password" name="password" type="password" required minlength="8"
        autocomplete={up ? 'new-password' : 'current-password'}
      />
      {!up && (
        <a class="mt-1.5 inline-block text-xs text-[var(--signal)] underline-offset-2 hover:underline"
           href={href('/reset')}>{t('auth.forgotLink')}</a>
      )}
    </div>

    <!-- Errors sit next to the control that produced them, not in a banner at
         the top of a form the reader has already scrolled past. -->
    <p
      class="hidden rounded-lg border border-[var(--alert)] bg-[var(--alert-wash)] px-3 py-2.5 text-sm text-[var(--alert)]"
      data-auth-error role="alert"
    ></p>

    {up && (
      <fieldset class="space-y-2" data-age>
        <legend class="mb-1.5 block text-sm font-medium">{t('auth.age')}</legend>
        <div class="flex flex-wrap gap-x-5 gap-y-2">
          <label class="flex items-center gap-2 text-sm">
            <input type="radio" name="age" value="14+" /> {t('auth.age14')}
          </label>
          <label class="flex items-center gap-2 text-sm">
            <input type="radio" name="age" value="under14" /> {t('auth.ageUnder')}
          </label>
          <label class="flex items-center gap-2 text-sm">
            <input type="radio" name="age" value="under13" /> {t('auth.age12')}
          </label>
        </div>
        <div class="hidden pt-2" data-parent>
          <label class="mb-1.5 block text-sm font-medium" for="parent">{t('auth.parentEmail')}</label>
          <input class="field" id="parent" name="parent" type="email" autocomplete="off" />
          <p class="mt-1.5 text-xs text-[var(--ink-faint)]">{t('auth.parentHelp')}</p>
        </div>
      </fieldset>
    )}

    {up && (
      <div class="space-y-2">
        <label class="flex items-start gap-2.5 text-sm">
          <input class="mt-1 shrink-0" id="agree" name="agree" type="checkbox" data-auth-agree />
          <span>
            {t('auth.agreeRead')}{' '}
            <a class="font-medium text-[var(--signal)] underline-offset-2 hover:underline"
               href={href('/terms')} target="_blank" rel="noopener">{t('auth.agreeTerms')}</a>{' '}
            {t('auth.agreeAnd')}{' '}
            <a class="font-medium text-[var(--signal)] underline-offset-2 hover:underline"
               href={href('/privacy')} target="_blank" rel="noopener">{t('auth.agreePrivacy')}</a>.
          </span>
        </label>
        <p class="text-xs text-[var(--ink-faint)]">{t('auth.agreeAge')}</p>
      </div>
    )}

    <button class="btn btn-primary w-full" type="submit" data-auth-submit>
      {up ? t('auth.submitUp') : t('auth.submitIn')}
    </button>

    <p class="text-center text-sm text-[var(--ink-dim)]">
      {up ? t('auth.haveAccount') : t('auth.noAccount')}
      <a class="ml-1 font-medium text-[var(--signal)] underline-offset-2 hover:underline"
         href={href(up ? '/signin' : '/signup')}>
        {up ? t('auth.submitIn') : t('auth.submitUp')}
      </a>
    </p>
  </form>

  <div class="card mt-6 hidden p-6 text-center" data-auth-done>
    <h2 class="text-xl">{t('auth.checkInbox')}</h2>
    <p class="mt-2 text-sm text-[var(--ink-dim)]">{t('auth.checkInboxBody')}</p>
    <button class="btn btn-quiet btn-sm mt-5" type="button" data-auth-resend>{t('auth.resend')}</button>
    <p class="mt-3 hidden text-xs text-[var(--ink-dim)]" data-auth-resent role="status"></p>
    <p class="data mt-4 hidden text-xs text-[var(--ink-faint)]" data-auth-ids></p>
  </div>

  <!-- An under-14 whose account is live: the parent has been written to. -->
  <div class="card mt-6 hidden p-6 text-center" data-auth-parent>
    <h2 class="text-xl">{t('auth.parentSent')}</h2>
    <p class="mt-2 text-sm text-[var(--ink-dim)]" data-auth-parent-body></p>
  </div>
</section>

<script>
  import { signUp, signIn, acceptTerms, askParent, resendConfirmation, configured } from '../lib/supabase';
  import { TERMS_VERSION } from '../lib/terms';

  const form = document.querySelector('[data-auth-form]') as HTMLFormElement | null;
  if (form) {
    const mode = form.dataset.mode;
    const errorBox = document.querySelector('[data-auth-error]') as HTMLElement;
    const submit = document.querySelector('[data-auth-submit]') as HTMLButtonElement;
    const done = document.querySelector('[data-auth-done]') as HTMLElement;
    const ids = document.querySelector('[data-auth-ids]') as HTMLElement;

    // The page's own language. These were English on both sites, and the
    // server's messages went through untranslated ("Invalid login credentials").
    const said = JSON.parse(form.dataset.errors ?? '{}');
    const translate = (raw: string) =>
      /invalid login credentials/i.test(raw) ? said.bad
      : /already (registered|been registered)|already exists/i.test(raw) ? said.taken
      : /password/i.test(raw) && /(at least|short|weak)/i.test(raw) ? said.weak
      : /fetch|network/i.test(raw) ? said.network
      : /not confirmed/i.test(raw) ? said.unconfirmed
      : /rate limit|too many/i.test(raw) ? said.slowDown
      : raw === 'not-configured' ? said.generic
      : raw;   // rare and specific (a rate limit, say): the server's words beat a shrug

    // Back to the page that sent the reader here, when it is one of ours.
    // requireUser adds ?next=, and this ignored it, so opening My trails
    // signed out meant signing in and then finding My trails again by hand.
    const next = new URLSearchParams(location.search).get('next');
    const home = location.pathname.startsWith('/en/') ? '/en/' : '/';
    const onward = next && next.startsWith('/') && !next.startsWith('//') ? next : home;

    form.querySelectorAll('input[name="age"]').forEach((radio) => radio.addEventListener('change', () => {
      const young = (form.querySelector('input[name="age"]:checked') as HTMLInputElement)?.value === 'under14';
      form.querySelector('[data-parent]')?.classList.toggle('hidden', !young);
    }));

    const show = (message: string) => {
      errorBox.textContent = message;
      errorBox.classList.remove('hidden');
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      errorBox.classList.add('hidden');

      if (!configured()) {
        show('The site was built without Supabase credentials, so accounts are not available here.');
        return;
      }

      const data = new FormData(form);
      const email = String(data.get('email') ?? '').trim();
      const password = String(data.get('password') ?? '');
      const name = String(data.get('name') ?? '').trim();
      const age = String(data.get('age') ?? '');
      const parent = String(data.get('parent') ?? '').trim();
      const under14 = age === 'under14';

      if (!email || !password) { show(said.fill); return; }

      // Asked of everybody, kept as nothing more than the answer.
      if (mode === 'signup' && !age) { show(said.age); return; }
      // Google Play will not let an app with location be aimed at under-13s,
      // and this app is nothing without location.
      if (mode === 'signup' && age === 'under13') { show(said.tooYoung); return; }
      if (mode === 'signup' && under14
          && (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(parent) || parent.toLowerCase() === email.toLowerCase())) {
        show(said.parentEmail);
        return;
      }

      // Agreeing is an act, not a link somebody walked past.
      const agree = form.querySelector('[data-auth-agree]') as HTMLInputElement | null;
      if (mode === 'signup' && agree && !agree.checked) {
        show(form.dataset.agreeError ?? 'You need to accept the terms.');
        return;
      }
      if (mode === 'signup' && password.length < 8) {
        show(said.weak);
        return;
      }

      submit.disabled = true;
      const label = submit.textContent;
      submit.textContent = '…';

      // The age and the parent ride along in the account's metadata, so that
      // when confirmation holds the account back, the confirmed page can finish
      // the job once there is a session to finish it with.
      const result = mode === 'signup'
        ? await signUp(email, password, name || undefined, {
            terms_version: TERMS_VERSION,
            age_band: under14 ? 'under14' : '14+',
            ...(under14 && { parent_email: parent }),
          })
        : await signIn(email, password);

      submit.disabled = false;
      submit.textContent = label;

      if (result.error) { show(translate(result.error)); return; }

      const held = mode === 'signup' && 'needsConfirmation' in result && result.needsConfirmation;

      // Recorded against the account, so the acceptance survives the tick box.
      // Only with a session: a held account has none yet, and the confirmed
      // page records it from the metadata above.
      if (mode === 'signup' && !held) {
        await acceptTerms(TERMS_VERSION, under14);
        if (under14) {
          const asked = await askParent(parent, location.pathname.startsWith('/en/') ? 'en' : 'bg');
          if (asked.error) { show(translate(asked.error)); return; }
          form.classList.add('hidden');
          const box = document.querySelector('[data-auth-parent]') as HTMLElement;
          box.classList.remove('hidden');
          (box.querySelector('[data-auth-parent-body]') as HTMLElement).textContent =
            said.parentSentBody.replace('{0}', parent);
          return;
        }
      }

      // Only promise an email when one is actually coming. signUp reports that,
      // and this form ignored it: with confirmations off the account is live at
      // once, but everybody was still told to open a link that was never sent.
      // The first real tester sat waiting for it.
      if (held) {
        form.classList.add('hidden');
        done.classList.remove('hidden');

        const upgraded = 'upgraded' in result && Boolean(result.upgraded);
        document.querySelector('[data-auth-resend]')?.addEventListener('click', async (e) => {
          const button = e.currentTarget as HTMLButtonElement;
          button.disabled = true;
          const again = await resendConfirmation(email, upgraded);
          const note = document.querySelector('[data-auth-resent]') as HTMLElement;
          note.textContent = again.error ? translate(again.error) : said.resent;
          note.classList.remove('hidden');
          setTimeout(() => { button.disabled = false; }, 30000);
        });

        // The claim that matters, printed rather than asserted: an upgrade keeps
        // the id, so the progress hanging off it survives.
        if ('upgraded' in result && result.upgraded) {
          ids.textContent = `${result.idBefore} -> ${result.idAfter}`;
          ids.classList.remove('hidden');
        }
      } else {
        window.location.href = onward;
      }
    });
  }
</script>
