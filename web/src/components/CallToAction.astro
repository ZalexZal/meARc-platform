---
import { useTranslations, localise, type Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const href = localise(lang);
---

<section class="mx-auto max-w-6xl px-4 pb-8 sm:px-6">
  <div class="map-grid-fine relative overflow-hidden rounded-2xl border border-[var(--line)] bg-[var(--surface)] px-6 py-14 text-center sm:px-12 sm:py-20">
    <div
      class="pointer-events-none absolute inset-0"
      style="background: radial-gradient(ellipse 60% 70% at 50% 0%, var(--signal-wash), transparent 70%)"
      aria-hidden="true"
    ></div>

    <div class="relative mx-auto max-w-xl">
      <h2 class="text-3xl sm:text-4xl">{t('cta.title')}</h2>
      <p class="mx-auto mt-4 max-w-md text-[var(--ink-dim)]">{t('cta.body')}</p>
      <a href={href('/signup')} class="btn btn-primary mt-8">{t('cta.button')}</a>
    </div>
  </div>
</section>
