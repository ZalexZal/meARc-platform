---
import Loading from './Loading.astro';
import { useTranslations, localise, type Lang } from '../i18n/ui';
import PageBand from './PageBand.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const href = localise(lang);

const strings = {
  lang,
  rank: t('board.rank'), team: t('board.team'), points: t('board.points'),
  solved: t('board.solved'), time: t('board.time'), you: t('board.you'),
  provisional: t('board.provisional'), empty: t('ed.boardEmpty'),
  failed: t('games.failed'), pending: t('acct.pending'),
  code: t('board.code'), noTeams: t('board.noTeams'), alone: t('board.alone'),
  point: t('n.point'), pointN: t('n.points'),
  hidden: t('board.hidden'), report: t('board.report'), reportConfirm: t('board.reportConfirm'),
  reported: t('board.reported'), block: t('board.block'), blockConfirm: t('board.blockConfirm'),
  blocked: t('board.blocked'),
  stop: t('n.stop'), stopN: t('n.stops'),

  modOpen: t('mod.open'), modClose: t('mod.close'), modLede: t('mod.lede'),
  skip: t('mod.skip'), skipDo: t('mod.skipDo'), skipHelp: t('mod.skipHelp'),
  skipPick: t('mod.skipPick'), skipAlready: t('mod.skipAlready'),
  amount: t('mod.amount'), reason: t('mod.reason'), reasonNeeded: t('mod.reasonNeeded'),
  pointsLabel: t('mod.points'), pointsDo: t('mod.pointsDo'), pointsHelp: t('mod.pointsHelp'),
  adjustedBy: t('mod.adjustedBy'),
  dqDo: t('mod.dqDo'), dqHelp: t('mod.dqHelp'), dqOn: t('mod.dqOn'),
  undq: t('mod.undq'), modFailed: t('mod.failed'),
  warnings: t('mod.warnings'), warnHelp: t('mod.warnHelp'),
  warn: { mock: t('mod.warn.mock'), far: t('mod.warn.far'), fast: t('mod.warn.fast') },

  // Ending a trail is new enough to keep its words here rather than in ui.ts.
  ...(lang === 'bg' ? {
    live: 'Маршрутът тече. Точките се менят, докато отборите отговарят.',
    endDo: 'Приключи маршрута',
    endConfirm: 'Да приключим ли маршрута? Отговорите, подсказките и промените в отборите спират, а класирането става окончателно. Може да го отвориш отново.',
    ended: 'Маршрутът приключи в',
    reopen: 'Отвори отново',
    startManual: 'Маршрутът чака старта. Отборите се събират и проверяват GPS.',
    startAuto: 'Маршрутът започва сам в {0}. Можеш да го пуснеш и по-рано.',
    startDo: 'Старт',
    startConfirm: 'Да започне ли маршрутът сега? Спирките се появяват и отговорите започват да се броят.',
    ready: 'Готови телефони: {0} от {1}', notReady: 'Без GPS', readyAll: 'Всички телефони са готови.',
    gaveUp: 'Отборът се отказа', webAnswers: '{0} от {1} отговора са от сайта',
  } : {
    live: 'The trail is on. Points move while teams are answering.',
    endDo: 'End the trail',
    endConfirm: 'End the trail? Answers, hints and team changes stop, and the board becomes final. You can reopen it.',
    ended: 'The trail ended at',
    reopen: 'Reopen',
    startManual: 'The trail waits for its start. Teams are gathering and checking GPS.',
    startAuto: 'The trail starts by itself at {0}. You can start it earlier.',
    startDo: 'Start',
    startConfirm: 'Start the trail now? The stops appear and answers start to count.',
    ready: 'Phones ready: {0} of {1}', notReady: 'No GPS', readyAll: 'Every phone is ready.',
    gaveUp: 'The team gave up', webAnswers: '{0} of {1} answers from the website',
  }),
};
---

<PageBand eyebrow={t('ed.board')} title={t('ed.board')} h1={{ 'data-board-title': '' }} />

<section class="mx-auto max-w-3xl px-4 pb-20 pt-4 sm:px-6">

  <!-- A score that a human can still change has to say so. A board that quietly
       reorders an hour later reads as broken rather than as careful. -->
  <p class="note note-lamp mt-5 hidden" data-board-provisional></p>

  <Loading label={t('games.loading')} class="mt-8 py-10" data-board-loading />
  <p class="text-left mt-8 hidden text-[var(--ink-dim)]" data-board-empty>{t('ed.boardEmpty')}</p>
  <p class="text-left mt-8 hidden text-sm text-[var(--alert)]" data-board-failed>{t('games.failed')}</p>
  <!-- No trail in the address. It used to say the connection had failed. -->
  <p class="text-left mt-8 hidden text-[var(--ink-dim)]" data-board-none>
    {t('board.none')} <a class="text-[var(--signal)] underline-offset-2 hover:underline" href={href('/my-trails')}>{t('nav.mine')}</a>
  </p>

  <div class="scroll-x mt-8"><table class="table" data-board></table></div>
  <p class="text-left mt-3 hidden text-sm" data-board-said role="status"></p>

  <!-- Only the owner is served this, so the section is drawn after the call
       comes back rather than hidden behind a second permission check. -->
  <div class="mt-20 hidden" data-teams-section>
    <h2 class="text-2xl">{t('board.teams')}</h2>
    <p class="mt-2 text-sm text-[var(--ink-dim)]">{t('board.teamsLede')}</p>

    <!-- The whistle. It freezes the board, which is what makes first place a
         result rather than a moment. -->
    <!-- The start of a live event (0058), and which phones are ready for it. -->
    <div class="card mt-6 hidden p-4" data-start-box>
      <div class="flex flex-wrap items-center justify-between gap-4">
        <p class="text-sm text-[var(--ink-dim)]" data-start-text></p>
        <button type="button" class="btn btn-primary btn-sm" data-start-do></button>
      </div>
      <p class="mt-3 text-sm font-semibold" data-ready-count></p>
      <ul class="mt-2 space-y-1 text-sm text-[var(--ink-dim)]" data-ready-list></ul>
    </div>
    <div class="card mt-6 hidden flex-wrap items-center justify-between gap-4 p-4" data-endgame>
      <p class="text-sm text-[var(--ink-dim)]" data-endgame-text></p>
      <button type="button" class="btn btn-quiet btn-sm" data-endgame-do></button>
    </div>
    <div class="mt-8 grid items-start gap-4 sm:grid-cols-2" data-teams></div>
  </div>
</section>

<script type="application/json" data-board-strings set:html={JSON.stringify(strings)}></script>

<script>
  import { db, configured } from '../lib/supabase';
  import { param, escapeHtml, text, duration, count } from '../lib/session';

  const S = JSON.parse(document.querySelector('[data-board-strings]')!.textContent || '{}');
  const q = (s: string) => document.querySelector(s);
  const worldId = param('id');

  const only = (which: string | null) => {
    ['[data-board-loading]', '[data-board-empty]', '[data-board-failed]', '[data-board-none]'].forEach((sel) =>
      q(sel)?.classList.add('hidden'));
    if (which) q(which)?.classList.remove('hidden');
  };

  if (!worldId) { only('[data-board-none]'); }
  else if (!configured()) { only('[data-board-failed]'); }
  else {
    const client = db()!;

    // Asked once, up front: whether to offer Report and Block on the rows.
    // Both need somebody signed in to say who is reporting or blocking.
    const { data: session } = await client.auth.getSession();
    const signedIn = Boolean(session.session);

    const summary = await client.rpc('trail_summary', { p_world: worldId });
    const trail = Array.isArray(summary.data) ? summary.data[0] : summary.data;
    if (trail?.name) text(q('[data-board-title]'), trail.name);

    // Drawn as a function because the moderator controls below can change what
    // it says. A board that keeps the old numbers after somebody has just moved
    // them is worse than no board: the moderator reads it, sees nothing changed,
    // and does it again.
    const drawBoard = async () => {
      const { data, error } = await client.rpc('world_leaderboard', { p_world: worldId });

      if (error) { only('[data-board-failed]'); return; }
      if (!data || data.length === 0) {
        only('[data-board-empty]');
        (q('[data-board]') as HTMLTableElement).innerHTML = '';
        return;
      }

      only(null);

      const waiting = data.reduce((n: number, r: any) => n + Number(r.pending || 0), 0);
      const banner = q('[data-board-provisional]')!;
      banner.classList.toggle('hidden', waiting === 0);
      if (waiting > 0) text(banner, `${S.provisional} (${waiting} ${S.pending})`);

      (q('[data-board]') as HTMLTableElement).innerHTML = `
        <thead><tr>
          <th>${escapeHtml(S.rank)}</th>
          <th>${escapeHtml(S.team)}</th>
          <th class="num">${escapeHtml(S.points)}</th>
          <th class="num">${escapeHtml(S.solved)}</th>
          <th class="num">${escapeHtml(S.time)}</th>
          ${signedIn ? '<th></th>' : ''}
        </tr></thead>
        <tbody>${data.map((r: any) => `
          <tr class="${r.is_mine ? 'is-mine' : ''}">
            <td class="data text-[var(--ink-dim)]">${r.rank}</td>
            <td>${r.team_name ? escapeHtml(r.team_name) : `<span class="text-[var(--ink-faint)]">${escapeHtml(S.hidden)}</span>`}${
              r.is_mine ? ` <span class="eyebrow">${escapeHtml(S.you)}</span>` : ''}${
              Number(r.pending) > 0 ? ` <span class="data text-xs" style="color:var(--lamp)">+${r.pending}?</span>` : ''}</td>
            <td class="num font-medium">${r.points}</td>
            <td class="num text-[var(--ink-dim)]">${r.stops_solved}</td>
            <td class="num text-[var(--ink-dim)]">${duration(r.elapsed_seconds)}</td>
            ${signedIn ? `<td class="whitespace-nowrap text-right text-xs">${
              r.is_mine || !r.team_name ? '' :
              `<button type="button" class="row-act" data-report-team="${escapeHtml(r.team_id)}" data-name="${escapeHtml(r.team_name)}">${escapeHtml(S.report)}</button>
               <button type="button" class="row-act" data-block-team="${escapeHtml(r.team_id)}" data-name="${escapeHtml(r.team_name)}">${escapeHtml(S.block)}</button>`}</td>` : ''}
          </tr>`).join('')}</tbody>`;
    };

    // Once, on the table, because drawBoard replaces the rows it would be on.
    q('[data-board]')!.addEventListener('click', async (event) => {
      const target = event.target as HTMLElement;
      const said = q('[data-board-said]') as HTMLElement;
      const tell = (message: string, bad = false) => {
        text(said, message);
        said.style.color = bad ? 'var(--alert)' : 'var(--signal)';
        said.classList.remove('hidden');
      };

      const report = target.closest('[data-report-team]') as HTMLElement | null;
      if (report) {
        if (!confirm(S.reportConfirm.replace('{0}', report.dataset.name ?? ''))) return;
        const { error } = await client.rpc('report_team',
          { p_team: report.dataset.reportTeam, p_reason: 'offensive' });
        tell(error ? (error.message || S.modFailed) : S.reported, Boolean(error));
        return;
      }

      const block = target.closest('[data-block-team]') as HTMLElement | null;
      if (block) {
        if (!confirm(S.blockConfirm.replace('{0}', block.dataset.name ?? ''))) return;
        const { error } = await client.rpc('block_user',
          { p_kind: 'team', p_target: block.dataset.blockTeam });
        if (error) { tell(error.message || S.modFailed, true); return; }
        tell(S.blocked);
        await drawBoard();
      }
    });

    await drawBoard();

    // world_teams answers the owner and refuses everybody else, so the error
    // IS the permission check - a walker reading a public board simply never
    // sees the section.
    // Not asked at all without a session: a stranger's refusal still landed in
    // the console as a red 401 on every public board.
    const teams = signedIn
      ? await client.rpc('world_teams', { p_world: worldId })
      : { error: true, data: null };

    if (!teams.error && teams.data) {
      q('[data-teams-section]')!.classList.remove('hidden');

      // ended_at arrives with migration 0038. Until then the select fails and
      // the control simply is not offered.
      const endBox = q('[data-endgame]') as HTMLElement;
      const drawEnd = (endedAt: string | null) => {
        endBox.classList.remove('hidden');
        endBox.classList.add('flex');
        if (endedAt) {
          const at = new Date(endedAt).toLocaleString(S.lang === 'bg' ? 'bg-BG' : 'en-GB',
            { hour: '2-digit', minute: '2-digit', day: 'numeric', month: 'short' });
          text(q('[data-endgame-text]'), `${S.ended} ${at}.`);
          text(q('[data-endgame-do]'), S.reopen);
        } else {
          text(q('[data-endgame-text]'), S.live);
          text(q('[data-endgame-do]'), S.endDo);
        }
        endBox.dataset.ended = endedAt ? '1' : '';
      };

      // select('*') rather than naming the column: before 0038 there is no
      // ended_at, and naming it would be a failed request on every board an
      // organiser opens. Whether the key is there says whether the server can
      // end games at all.
      const state = await client.from('worlds').select('*').eq('id', worldId).maybeSingle();
      if (!state.error && state.data && 'ended_at' in state.data) {
        drawEnd(state.data.ended_at);

        q('[data-endgame-do]')!.addEventListener('click', async (event) => {
          const button = event.currentTarget as HTMLButtonElement;
          const ending = !endBox.dataset.ended;
          if (ending && !confirm(S.endConfirm)) return;

          button.disabled = true;
          const { data, error } = await client.rpc('moderator_end_game',
            { p_world: worldId, p_ended: ending });
          button.disabled = false;

          if (error) { alert(error.message || S.modFailed); return; }
          drawEnd(ending ? (data as string) : null);
          await drawBoard();
        });
      }

      // The start (0058): a Start button and the GPS-ready panel while a live
      // event waits, looked at again every 5 s until it has started.
      const startBox = q('[data-start-box]') as HTMLElement;
      const drawStart = async () => {
        const { data: st } = await client.rpc('trail_start', { p_world: worldId });
        if (!st || st.start_mode === 'none' || st.started) { startBox.classList.add('hidden'); return false; }
        startBox.classList.remove('hidden');
        const at = st.starts_at ? new Date(st.starts_at).toLocaleString(S.lang === 'bg' ? 'bg-BG' : 'en-GB',
          { hour: '2-digit', minute: '2-digit', day: 'numeric', month: 'short' }) : null;
        text(q('[data-start-text]'), st.start_mode === 'auto' && at ? S.startAuto.replace('{0}', at) : S.startManual);
        text(q('[data-start-do]'), S.startDo);
        const { data: r } = await client.rpc('world_readiness', { p_world: worldId });
        if (r) {
          text(q('[data-ready-count]'), S.ready.replace('{0}', r.ready).replace('{1}', r.phones));
          const missing = (r.teams ?? []).filter((t: any) => !t.gave_up)
            .map((t: any) => ({ name: t.name, who: (t.members ?? []).filter((m: any) => !m.gps).map((m: any) => m.name) }))
            .filter((t: any) => t.who.length);
          q('[data-ready-list]')!.innerHTML = missing.length
            ? missing.map((t: any) => `<li><b>${escapeHtml(t.name)}</b> · ${escapeHtml(S.notReady)}: ${t.who.map(escapeHtml).join(', ')}</li>`).join('')
            : (r.phones ? `<li>${escapeHtml(S.readyAll)}</li>` : '');
        }
        return true;
      };
      if (await drawStart()) {
        const again = window.setInterval(async () => { if (!(await drawStart())) clearInterval(again); }, 5000);
      }
      q('[data-start-do]')!.addEventListener('click', async (event) => {
        if (!confirm(S.startConfirm)) return;
        const button = event.currentTarget as HTMLButtonElement;
        button.disabled = true;
        const { error } = await client.rpc('moderator_start_game', { p_world: worldId });
        button.disabled = false;
        if (error) { alert(error.message || S.modFailed); return; }
        await drawStart();
      });

      // Each team's answers from the website (0059) and whether it gave up
      // (0058), shown on its card.
      const extra = async () => {
        const [web, ready] = await Promise.all([
          client.rpc('world_web_answers', { p_world: worldId }),
          client.rpc('world_readiness', { p_world: worldId }),
        ]);
        const byTeam: Record<string, { web: number; total: number; gaveUp: boolean }> = {};
        for (const w of (web.data ?? []) as any[]) byTeam[w.team_id] = { web: Number(w.web), total: Number(w.total), gaveUp: false };
        for (const t of (ready.data?.teams ?? []) as any[]) {
          byTeam[t.id] = { ...(byTeam[t.id] ?? { web: 0, total: 0 }), gaveUp: !!t.gave_up };
        }
        return byTeam;
      };
      let marks = await extra();

      // The stop list, for the skip control. Fetched once, and only here: a
      // walker reading a public board never gets past the error above, so the
      // route is not handed out for the sake of a dropdown.
      const stops = await client.rpc('trail_markers', { p_world: worldId });
      const stopList = (stops.data ?? [])
        .slice()
        .sort((a: any, b: any) => (a.step ?? 0) - (b.step ?? 0))
        .map((m: any) => ({
          id: m.id,
          label: `${m.step ? m.step + '. ' : ''}${
            m.content?.[S.lang]?.title || m.content?.bg?.title || m.content?.en?.title || '—'}`,
        }));

      const drawTeams = (rows: any[]) => {
        q('[data-teams]')!.innerHTML = rows.length === 0
          ? `<p class="text-sm text-[var(--ink-dim)]">${escapeHtml(S.noTeams)}</p>`
          : rows.map((t: any) => {
              const names = (t.members ?? []).map((m: any) => escapeHtml(m.name));
              const moved = Number(t.adjusted ?? 0);
              const out = !!t.disqualified_at;

              return `<article class="card p-5" data-team="${escapeHtml(t.id)}">
                <div class="flex items-baseline justify-between gap-3">
                  <h3 class="text-base">${escapeHtml(t.name)}</h3>
                  <!-- Big and monospaced: this gets read out across a schoolyard
                       to somebody who has lost it. -->
                  <span class="code shrink-0 text-sm tracking-widest">${escapeHtml(t.invite_code)}</span>
                </div>
                <p class="mt-3 text-sm text-[var(--ink-dim)]">${
                  names.length > 1 ? names.join(' · ')
                                   : `${names[0] ?? ''} <span class="eyebrow">${escapeHtml(S.alone)}</span>`}</p>
                <p class="data mt-3 text-xs text-[var(--ink-faint)]">
                  ${escapeHtml(count(t.points, S.point, S.pointN))} · ${escapeHtml(count(t.solved, S.stop, S.stopN))}${
                  // Shown beside the earned total rather than folded into it, so
                  // a moderator can see their own thumb on the scale.
                  moved !== 0
                    ? ` · <span style="color:var(--lamp)">${moved > 0 ? '+' : ''}${moved} ${escapeHtml(S.adjustedBy)}</span>`
                    : ''}
                </p>
                ${Object.keys(t.warnings ?? {}).length
                  ? `<p class="note note-lamp mt-4 text-sm" title="${escapeHtml(S.warnHelp)}"><strong>${escapeHtml(S.warnings)}:</strong> ${
                      Object.entries(t.warnings).map(([k, n]) => `${Number(n)} ${escapeHtml(S.warn[k] ?? k)}`).join(' · ')}</p>`
                  : ''}
                ${marks[t.id]?.gaveUp ? `<p class="note note-lamp mt-4 text-sm"><strong>${escapeHtml(S.gaveUp)}</strong></p>` : ''}
                ${marks[t.id]?.web ? `<p class="data mt-2 text-xs text-[var(--ink-faint)]">${escapeHtml(
                  S.webAnswers.replace('{0}', String(marks[t.id].web)).replace('{1}', String(marks[t.id].total)))}</p>` : ''}
                ${out ? `<p class="note note-alert mt-4 text-sm"><strong>${escapeHtml(S.dqOn)}</strong>${
                  t.disqualified_reason ? ` — ${escapeHtml(t.disqualified_reason)}` : ''}</p>` : ''}

                <button type="button" class="btn btn-quiet mt-4" data-mod-toggle>${escapeHtml(S.modOpen)}</button>

                <div class="mt-4 hidden border-t border-[var(--rule)] pt-4" data-mod-panel>
                  <p class="text-xs text-[var(--ink-faint)]">${escapeHtml(S.modLede)}</p>

                  <div class="mt-4">
                    <label class="block text-sm">
                      <span class="mb-1 block font-medium">${escapeHtml(S.skip)}</span>
                      <select class="field" data-mod-stop>
                        <option value="">${escapeHtml(S.skipPick)}</option>
                        ${stopList.map((m: any) =>
                          `<option value="${escapeHtml(m.id)}">${escapeHtml(m.label)}</option>`).join('')}
                      </select>
                    </label>
                    <p class="mt-1 text-xs text-[var(--ink-faint)]">${escapeHtml(S.skipHelp)}</p>
                    <button type="button" class="btn btn-quiet mt-2" data-mod-skip>${escapeHtml(S.skipDo)}</button>
                  </div>

                  <div class="mt-6">
                    <label class="block text-sm">
                      <span class="mb-1 block font-medium">${escapeHtml(S.pointsLabel)}</span>
                      <input class="field" type="number" step="1" placeholder="${escapeHtml(S.amount)}" data-mod-amount />
                    </label>
                    <input class="field mt-2" type="text" maxlength="200" placeholder="${escapeHtml(S.reason)}" data-mod-reason />
                    <p class="mt-1 text-xs text-[var(--ink-faint)]">${escapeHtml(S.pointsHelp)}</p>
                    <button type="button" class="btn btn-quiet mt-2" data-mod-adjust>${escapeHtml(S.pointsDo)}</button>
                  </div>

                  <div class="mt-6">
                    ${out
                      ? `<p class="text-xs text-[var(--ink-faint)]">${escapeHtml(S.dqHelp)}</p>
                         <button type="button" class="btn btn-quiet mt-2" data-mod-undq>${escapeHtml(S.undq)}</button>`
                      : `<label class="block text-sm">
                           <span class="mb-1 block font-medium">${escapeHtml(S.dqDo)}</span>
                           <input class="field" type="text" maxlength="200" placeholder="${escapeHtml(S.reason)}" data-mod-dq-reason />
                         </label>
                         <p class="mt-1 text-xs text-[var(--ink-faint)]">${escapeHtml(S.dqHelp)}</p>
                         <button type="button" class="btn btn-danger mt-2" data-mod-dq>${escapeHtml(S.dqDo)}</button>`}
                  </div>

                  <p class="mt-4 hidden text-sm" data-mod-said></p>
                </div>
              </article>`;
            }).join('');
      };

      drawTeams(teams.data);

      // Bound once on the container, not on the buttons: every action redraws
      // the cards, and handlers hung on the buttons would be redrawn away.
      q('[data-teams]')!.addEventListener('click', async (event) => {
        const target = event.target as HTMLElement;
        const card = target.closest('[data-team]') as HTMLElement | null;
        if (!card) return;

        const teamId = card.dataset.team!;
        const panel = card.querySelector('[data-mod-panel]') as HTMLElement;
        const said = card.querySelector('[data-mod-said]') as HTMLElement;

        const say = (message: string) => {
          text(said, message);
          said.style.color = 'var(--alert)';
          said.classList.remove('hidden');
        };

        if (target.closest('[data-mod-toggle]')) {
          const shut = panel.classList.toggle('hidden');
          text(target, shut ? S.modOpen : S.modClose);
          return;
        }

        // The panel is redrawn from the server after every action rather than
        // from what the page assumes happened, so a refused write shows as a
        // card that did not change instead of one that lies.
        const refresh = async () => {
          const again = await client.rpc('world_teams', { p_world: worldId });
          if (!again.error && again.data) { marks = await extra(); drawTeams(again.data); }
          await drawBoard();
        };

        if (target.closest('[data-mod-skip]')) {
          const pick = card.querySelector('[data-mod-stop]') as HTMLSelectElement;
          if (!pick.value) { say(S.skipPick); return; }

          const { data, error } = await client.rpc('moderator_skip',
            { p_team: teamId, p_marker: pick.value });

          if (error) { say(error.message || S.modFailed); return; }
          if (data && data.skipped === false) { say(S.skipAlready); return; }
          await refresh();
          return;
        }

        if (target.closest('[data-mod-adjust]')) {
          const amount = Number((card.querySelector('[data-mod-amount]') as HTMLInputElement).value);
          const reason = (card.querySelector('[data-mod-reason]') as HTMLInputElement).value.trim();

          if (!amount) { say(S.amount); (card.querySelector('[data-mod-amount]') as HTMLInputElement).focus(); return; }
          if (!reason) { say(S.reasonNeeded); (card.querySelector('[data-mod-reason]') as HTMLInputElement).focus(); return; }

          const { error } = await client.rpc('moderator_adjust',
            { p_team: teamId, p_points: Math.trunc(amount), p_reason: reason });

          if (error) { say(error.message || S.modFailed); return; }
          await refresh();
          return;
        }

        if (target.closest('[data-mod-dq]')) {
          const box = card.querySelector('[data-mod-dq-reason]') as HTMLInputElement;
          const reason = box.value.trim();
          // Focused, not just refused. The message is at the bottom of a long
          // panel and the field it is about is halfway up it.
          if (!reason) { say(S.reasonNeeded); box.focus(); return; }

          const { error } = await client.rpc('moderator_disqualify',
            { p_team: teamId, p_reason: reason, p_on: true });

          if (error) { say(error.message || S.modFailed); return; }
          await refresh();
          return;
        }

        if (target.closest('[data-mod-undq]')) {
          const { error } = await client.rpc('moderator_disqualify',
            { p_team: teamId, p_reason: null, p_on: false });

          if (error) { say(error.message || S.modFailed); return; }
          await refresh();
        }
      });
    }
  }
</script>

<style>
  /* The organiser panels are cards of short status lines (about 300 px wide,
     rows of names and counts): ragged-right reads better than justified. */
  [data-teams-section] :global(p), [data-teams-section] :global(li) { text-align: left; hyphens: manual; }
  :global(.row-act) {
    color: var(--ink-faint); padding: 4px 6px; border-radius: 6px;
  }
  :global(.row-act:hover) { color: var(--alert); background: var(--alert-wash); }
  :global(.row-act:focus-visible) { outline: 2px solid var(--signal); outline-offset: 1px; }
</style>
