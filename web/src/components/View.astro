---
/**
 * A trail, seen from the website. The website does not play: the game happens
 * in the app, where the stops stand in the street. This page is the window on
 * a trail for whoever is not walking it - a parent, a teacher, a judge, someone
 * deciding whether to go - and the door into the app for whoever will.
 *
 * It shows what the app shows before you set off and nothing more: the stops
 * the server reveals to a stranger (markers_near respects the start of a live
 * event and one-at-a-time), their titles, and, on a trail with points, the
 * live board. No question and no answer is ever fetched here.
 */
import { localise, type Lang } from '../i18n/ui';
import Loading from './Loading.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const href = localise(lang);

const copy = {
  bg: {
    loading: 'Зареждам маршрута…',
    noTrail: 'Няма такъв маршрут', noTrailBody: 'Провери линка. Маршрутите с код се отварят в приложението, с кода.',
    play: 'Играе се в приложението', playBody: 'На всяка спирка телефонът показва знак или 3D модел точно на мястото. Въпросите се отговарят там, на място.',
    openApp: 'Отвори в приложението', qr: 'QR код', qrHint: 'Сканирай с телефона, после „Отвори в приложението“.',
    stops: 'Спирки', stopsHidden: 'Още {0} спирки се появяват по пътя.', noStops: 'Спирките се появяват, когато играта започне.',
    teams: '{0} отбора', stopN: '{0} спирки',
    startAuto: 'Започва на {0}', startManual: 'Започва, когато организаторът даде старт.', started: 'Играта тече',
    ended: 'Играта приключи',
    board: 'Класиране', boardFull: 'Цялото класиране', boardEmpty: 'Още няма отбори.', live: 'Обновява се само',
    pts: 'т.', noMap: 'Картата се показва само за публични маршрути.',
  },
  en: {
    loading: 'Loading the trail…',
    noTrail: 'No such trail', noTrailBody: 'Check the link. Trails with a code open in the app, with the code.',
    play: 'Played in the app', playBody: 'At every stop the phone shows a sign or a 3D model standing right there. The questions are answered on the spot.',
    openApp: 'Open in the app', qr: 'QR code', qrHint: 'Scan it with a phone, then tap Open in the app.',
    stops: 'Stops', stopsHidden: '{0} more stops appear along the way.', noStops: 'The stops appear when the game starts.',
    teams: '{0} teams', stopN: '{0} stops',
    startAuto: 'Starts at {0}', startManual: 'Starts when the organiser says go.', started: 'The game is on',
    ended: 'The game has ended',
    board: 'Standings', boardFull: 'Full standings', boardEmpty: 'No teams yet.', live: 'Updates by itself',
    pts: 'pts', noMap: 'The map is shown for public trails only.',
  },
}[lang];

const strings = { ...copy, lang, boardHref: href('/board'), listHref: href('/trails') };
---

<section class="mx-auto max-w-5xl px-4 pb-24 pt-28 sm:px-6">
  <Loading label={copy.loading} class="py-16" data-v-loading />

  <div hidden data-v-none class="card max-w-lg p-6">
    <h1 class="text-2xl">{copy.noTrail}</h1>
    <p class="mt-2 text-[var(--ink-dim)]">{copy.noTrailBody}</p>
  </div>

  <div hidden data-v-trail>
    <p class="eyebrow" data-v-mode></p>
    <h1 class="display-lg mt-2" data-v-name></h1>
    <p class="mt-3 text-[var(--ink-dim)]" data-v-meta></p>
    <p class="note note-lamp mt-4" hidden data-v-start></p>

    <div class="card mt-8 p-6 view-play">
      <div>
        <h2 class="text-xl">{copy.play}</h2>
        <p class="mt-2 text-[var(--ink-dim)]">{copy.playBody}</p>
      </div>
      <div class="view-actions">
        <a class="btn btn-primary" data-v-app>{copy.openApp}</a>
        <button type="button" class="btn btn-quiet" aria-expanded="false" data-v-qr>{copy.qr}</button>
      </div>
      <div hidden data-v-qrbox class="view-qr">
        <canvas></canvas>
        <p class="text-sm text-[var(--ink-dim)]">{copy.qrHint}</p>
      </div>
    </div>

    <div class="view-grid mt-10">
      <div>
        <div class="view-map" data-v-map></div>
        <p class="mt-2 text-sm text-[var(--ink-dim)]" hidden data-v-nomap>{copy.noMap}</p>
      </div>
      <div>
        <h2 class="text-xl">{copy.stops}</h2>
        <ol class="view-stops mt-3" data-v-stops></ol>
        <p class="mt-3 text-sm text-[var(--ink-dim)]" hidden data-v-hidden></p>
      </div>
    </div>

    <div class="mt-12" hidden data-v-board>
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h2 class="text-xl">{copy.board}</h2>
        <span class="text-sm text-[var(--ink-dim)]"><span class="view-dot" aria-hidden="true"></span>{copy.live}</span>
      </div>
      <ol class="view-board mt-3" data-v-rows></ol>
      <a class="mt-4 inline-block text-[var(--signal)] underline-offset-2 hover:underline" data-v-boardlink>{copy.boardFull}</a>
    </div>
  </div>
</section>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/maplibre-gl/5.6.0/maplibre-gl.css" />
<script type="application/json" data-v-strings set:html={JSON.stringify(strings)}></script>

<script>
  import QRCode from 'qrcode';
  import { db, configured } from '../lib/supabase';
  import { param, text } from '../lib/session';
  import { isScored, isOrdered, modeLine } from '../lib/modes';

  const S = JSON.parse(document.querySelector('[data-v-strings]')!.textContent || '{}');
  const q = <T extends Element = HTMLElement>(s: string) => document.querySelector(s) as T | null;
  const fmt = (s: string, ...a: (string | number)[]) => a.reduce<string>((r, v, i) => r.replace(`{${i}}`, String(v)), s);
  const show = (sel: string, on = true) => { const el = q(sel); if (el) el.hidden = !on; };
  const loc = (c: any) => c?.[S.lang] ?? c?.bg ?? c?.en ?? {};

  function none() { show('[data-v-loading]', false); show('[data-v-none]'); }

  const worldId = param('id');
  if (!worldId || !configured()) none();
  else load(worldId).catch(none);

  async function load(id: string) {
    const client = db()!;
    const summary = ((await client.rpc('trail_summary', { p_world: id })).data ?? [])[0];
    if (!summary) return none();

    const scored = isScored(summary.mode), ordered = isOrdered(summary.mode);
    text(q('[data-v-mode]'), modeLine(summary.mode, S.lang));
    text(q('[data-v-name]'), summary.name);
    document.title = `${summary.name} — AR Trail`;
    text(q('[data-v-meta]'), [fmt(S.stopN, summary.stop_count), scored ? fmt(S.teams, summary.team_count) : '']
      .filter(Boolean).join(' · '));

    // The app link, and a QR code of this page for the phone that has the app.
    const app = q<HTMLAnchorElement>('[data-v-app]')!;
    app.href = `intent://join/${id}#Intent;scheme=artrail;package=com.alex.artrail;` +
      `S.browser_fallback_url=${encodeURIComponent(`${location.origin}${S.listHref}?t=${id}&noapp=1`)};end`;
    q('[data-v-qr]')!.addEventListener('click', async (e) => {
      const box = q('[data-v-qrbox]')!; box.hidden = !box.hidden;
      (e.currentTarget as HTMLElement).setAttribute('aria-expanded', String(!box.hidden));
      if (!box.hidden) await QRCode.toCanvas(box.querySelector('canvas'), location.href, { width: 200, margin: 1 });
    });

    // A live event: when it starts.
    const start = (await client.rpc('trail_start', { p_world: id })).data;
    if (start && start.start_mode && start.start_mode !== 'none') {
      const at = start.starts_at ? new Date(start.starts_at) : null;
      const when = at?.toLocaleString(S.lang === 'bg' ? 'bg-BG' : 'en-GB', { dateStyle: 'medium', timeStyle: 'short' });
      text(q('[data-v-start]'), start.ended ? S.ended : start.started ? S.started
        : start.start_mode === 'auto' && when ? fmt(S.startAuto, when) : S.startManual);
      show('[data-v-start]');
    }

    show('[data-v-loading]', false);
    show('[data-v-trail]');

    await drawStops(client, id, summary, ordered);
    if (scored) liveBoard(client, id);
  }

  async function drawStops(client: any, id: string, summary: any, ordered: boolean) {
    // Where to look from: the first stop of a public trail, which the list
    // already publishes. The server then hands out only what a stranger may see.
    const listed = ((await client.rpc('public_trails')).data ?? []).find((t: any) => t.id === id);
    let stops: any[] = [];
    if (listed?.start_lat != null) {
      const { data } = await client.rpc('markers_near', { p_world_id: id, p_lat: listed.start_lat, p_lng: listed.start_lng, p_radius_m: 5000 });
      stops = (data ?? []).filter((m: any) => m.status === 'published');
    } else {
      show('[data-v-nomap]');
    }
    stops.sort((a, b) => ordered ? (a.step ?? 1e9) - (b.step ?? 1e9) : (a.distance_m ?? 0) - (b.distance_m ?? 0));

    const list = q('[data-v-stops]')!;
    list.replaceChildren(...stops.map((m) => {
      const li = document.createElement('li');
      const b = document.createElement('b'); b.textContent = loc(m.content).title || '—';
      li.append(b);
      return li;
    }));
    const hidden = Number(summary.stop_count) - stops.length;
    if (!stops.length) { text(q('[data-v-hidden]'), S.noStops); show('[data-v-hidden]'); }
    else if (hidden > 0) { text(q('[data-v-hidden]'), fmt(S.stopsHidden, hidden)); show('[data-v-hidden]'); }

    if (!stops.length && listed?.start_lat == null) { show('[data-v-map]', false); return; }
    const ml = await loadMapLibre();
    const centre = stops[0] ?? { lat: listed.start_lat, lng: listed.start_lng };
    const map = new ml.Map({ container: q('[data-v-map]'), style: 'https://tiles.openfreemap.org/styles/liberty',
      center: [centre.lng, centre.lat], zoom: 15, attributionControl: { compact: true }, cooperativeGestures: true });
    stops.forEach((m, i) => {
      const el = document.createElement('div');
      el.className = 'view-pin'; el.style.setProperty('--pin', m.colour_hex || '#0066cc');
      if (ordered) el.dataset.n = String(i + 1);
      el.title = loc(m.content).title || '';
      new ml.Marker({ element: el, anchor: 'bottom' }).setLngLat([m.lng, m.lat]).addTo(map);
    });
    if (stops.length > 1) {
      const b = new ml.LngLatBounds();
      stops.forEach((m) => b.extend([m.lng, m.lat]));
      map.fitBounds(b, { padding: 48, maxZoom: 17, duration: 0 });
    }
  }

  function liveBoard(client: any, id: string) {
    show('[data-v-board]');
    q<HTMLAnchorElement>('[data-v-boardlink]')!.href = `${S.boardHref}?id=${encodeURIComponent(id)}`;
    const paint = async () => {
      if (document.hidden) return;
      const { data } = await client.rpc('world_leaderboard', { p_world: id });
      const rows = (data ?? []).slice(0, 10);
      const ol = q('[data-v-rows]')!;
      if (!rows.length) { const li = document.createElement('li'); li.className = 'is-empty'; li.textContent = S.boardEmpty; ol.replaceChildren(li); return; }
      ol.replaceChildren(...rows.map((r: any) => {
        const li = document.createElement('li');
        const n = document.createElement('span'); n.className = 'view-rank'; n.textContent = String(r.rank);
        const name = document.createElement('span'); name.className = 'view-team'; name.textContent = r.team_name;
        const p = document.createElement('b'); p.textContent = `${r.points} ${S.pts}`;
        li.append(n, name, p);
        return li;
      }));
    };
    paint();
    setInterval(paint, 20000);
    document.addEventListener('visibilitychange', paint);
  }

  // MapLibre from the CDN: the bundler breaks its tile worker without a word.
  async function loadMapLibre(): Promise<any> {
    if ((window as any).maplibregl) return (window as any).maplibregl;
    await new Promise<void>((resolve, reject) => {
      const tag = document.createElement('script');
      tag.src = 'https://cdnjs.cloudflare.com/ajax/libs/maplibre-gl/5.6.0/maplibre-gl.js'; tag.crossOrigin = 'anonymous';
      tag.onload = () => resolve(); tag.onerror = () => reject(new Error('maplibre failed to load'));
      document.head.appendChild(tag);
    });
    return (window as any).maplibregl;
  }
</script>

<style>
  .view-play { display: grid; gap: 1.25rem; }
  @media (min-width: 720px) { .view-play { grid-template-columns: 1fr auto; align-items: center; } }
  .view-actions { display: flex; flex-wrap: wrap; gap: .75rem; }
  .view-qr { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; grid-column: 1 / -1; }
  .view-qr canvas { border-radius: 12px; background: #fff; }
  .view-grid { display: grid; gap: 2rem; }
  @media (min-width: 900px) { .view-grid { grid-template-columns: 3fr 2fr; } }
  .view-map { height: 420px; border-radius: 18px; overflow: hidden; border: 1px solid var(--line); background: var(--surface-2); }
  .view-stops { display: grid; gap: .5rem; counter-reset: s; }
  .view-stops :global(li) { counter-increment: s; display: flex; gap: .75rem; align-items: baseline; padding: .625rem .875rem; border-radius: 14px; background: var(--surface-2); }
  .view-stops :global(li)::before { content: counter(s); min-width: 1.5rem; color: var(--ink-faint); font-variant-numeric: tabular-nums; }
  .view-stops :global(b) { font-weight: 600; }
  .view-board { display: grid; gap: .375rem; }
  .view-board :global(li) { display: flex; gap: .875rem; align-items: center; padding: .625rem .875rem; border-radius: 14px; background: var(--surface-2); }
  .view-board :global(li.is-empty) { color: var(--ink-dim); }
  .view-board :global(.view-rank) { min-width: 1.5rem; color: var(--ink-faint); font-variant-numeric: tabular-nums; }
  .view-board :global(.view-team) { flex: 1; }
  .view-dot { display: inline-block; width: .5rem; height: .5rem; margin-right: .4rem; border-radius: 50%; background: var(--tier-1, #2a9d5c);
    animation: view-pulse 2s ease-in-out infinite; }
  @keyframes view-pulse { 50% { opacity: .3; } }
  @media (prefers-reduced-motion: reduce) { .view-dot { animation: none; } }
  :global(.view-pin) { position: relative; width: 26px; height: 34px; }
  :global(.view-pin)::before { content: ""; display: block; width: 26px; height: 26px; border-radius: 50% 50% 50% 0; transform: rotate(-45deg);
    background: var(--pin, #0066cc); border: 2px solid #fff; box-shadow: 0 2px 6px rgba(0,0,0,.35); }
  :global(.view-pin[data-n])::after { content: attr(data-n); position: absolute; top: 0; left: 0; width: 26px; height: 26px; display: grid; place-items: center;
    color: #fff; font: 600 12px/1 system-ui, sans-serif; }
</style>
