---
/**
 * The A5 "living scene" beside sign-up and choose-role, and the layout around
 * it: the stage on the left (on top below 1024px, a hero with the form as a
 * sheet over it on a phone), the form on the right.
 *
 * Every state - the five roles and "nothing chosen" - is rendered here, on the
 * server, each piece marked data-stage-for="<key>". lib/rolepick.ts only sets
 * data-stage-role on the stage and stage.css shows the matching pieces: no
 * client templating, no layout shift. The words come from stageFor (role.ts),
 * the colours from lib/stage.ts, the drawings from RoleScene and PhoneAR.
 *
 * Decoration is aria-hidden. The headline is the one live region, so a
 * screen reader hears the new headline when the choice changes.
 */
import RoleScene from './RoleScene.astro';
import PhoneAR from './PhoneAR.astro';
import { stageFor, sealMarkup, ICONS, type StageKey } from '../lib/role';
import { STAGE_KEYS, stagePaletteCss } from '../lib/stage';
import { useTranslations, type Lang } from '../i18n/ui';
import '../styles/stage.css';

interface Props { lang: Lang; heading: string; }
const { lang, heading } = Astro.props;
const t = useTranslations(lang);

const stageOf = (k: StageKey) =>
  stageFor(k === 'viewer' ? 'viewer' : k === 'none' ? null : 'creator', k === 'viewer' || k === 'none' ? null : k, lang);
const states = STAGE_KEYS.map(stageOf);
const creatorTag = stageFor('creator', null, lang).tag;

// The sample card's little route: up to four numbered stops (A5).
const STOPS = [[16, 44], [74, 18], [134, 40], [192, 16]];
const route = (n: number) => {
  const p = STOPS.slice(0, Math.max(1, n));
  return { d: p.length > 1 ? 'M' + p.map(([x, y]) => `${x} ${y}`).join(' L') : '', dots: p };
};
const PIN = 'M13 1a12 12 0 0 1 12 12c0 9-12 20-12 20S1 22 1 13A12 12 0 0 1 13 1z';
---
<Fragment set:html={`<style>${stagePaletteCss()}</style>`} />

<div class="stage-layout">
  <aside class="stage" data-stage data-role-panel data-lang={lang} data-stage-role="none" data-stage-creator="false">
    <div class="stage-in">
      <!-- The sky: sun by day, moon and stars by night (desktop and phone drawings). -->
      <div class="stage-sky stage-sky-d" aria-hidden="true">
      <svg class="stage-day" viewBox="0 0 480 860" width="480" height="860">
        <circle cx="404" cy="112" r="40" fill="#fff6d6" />
        <circle cx="404" cy="112" r="56" fill="none" stroke="#fff6d6" stroke-opacity="0.6" stroke-width="2" />
      </svg>
      <svg class="stage-night" viewBox="0 0 480 860" width="480" height="860">
        <!-- The design's moon (inner arc r28 across a 68 chord) has no area: a radius under half
             the chord is scaled up to the outer circle. The inner arc is r40, the other way, so the crescent shows. -->
        <path fill="#f3eccb" d="M420 80a34 34 0 1 0 0 68a40 40 0 0 1 0-68z" />
        <circle class="stage-star" cx="300" cy="60" r="1.6" fill="#fff" />
        <circle class="stage-star" cx="352" cy="200" r="1.3" fill="#fff" style="animation-delay: .8s;" />
        <circle class="stage-star" cx="236" cy="128" r="1.2" fill="#fff" style="animation-delay: 1.6s;" />
        <circle class="stage-star" cx="452" cy="250" r="1.5" fill="#fff" style="animation-delay: .4s;" />
        <circle class="stage-star" cx="190" cy="330" r="1.2" fill="#fff" style="animation-delay: 2.1s;" />
        <circle class="stage-star" cx="420" cy="380" r="1.1" fill="#fff" style="animation-delay: 1.1s;" />
      </svg>
      </div>
      <div class="stage-sky stage-sky-p" aria-hidden="true">
      <svg class="stage-day" viewBox="0 0 390 392" width="390" height="392">
        <circle cx="336" cy="70" r="28" fill="#fff6d6" />
      </svg>
      <svg class="stage-night" viewBox="0 0 390 392" width="390" height="392">
        <path fill="#f3eccb" d="M346 46a24 24 0 1 0 0 48a28 28 0 0 1 0-48z" />
        <circle class="stage-star" cx="260" cy="40" r="1.4" fill="#fff" />
        <circle class="stage-star" cx="300" cy="130" r="1.2" fill="#fff" style="animation-delay: 1s;" />
        <circle class="stage-star" cx="210" cy="96" r="1.1" fill="#fff" style="animation-delay: 2s;" />
      </svg>
      </div>
      <svg class="stage-cloud stage-cloud-d" aria-hidden="true" viewBox="0 0 160 50" width="160" height="50">
        <path d="M20 50a20 20 0 0 1 4-39.6A26 26 0 0 1 72 6a22 22 0 0 1 38 10 18 18 0 0 1 30 18 16 16 0 0 1 0 16Z" />
      </svg>
      <svg class="stage-cloud stage-cloud-p" aria-hidden="true" viewBox="0 0 120 40" width="110" height="36">
        <path d="M16 40a16 16 0 0 1 3-31.7A21 21 0 0 1 58 5a18 18 0 0 1 31 8 14 14 0 0 1 24 15 12 12 0 0 1 0 12Z" />
      </svg>

      <div class="stage-text">
        <span class="stage-chip">
          <Fragment set:html={sealMarkup({ shape: 'ask', glyph: 'ask', pip: false })} />
          {states.map((s) => s.key === 'none'
            ? <Fragment>
                <span data-stage-tag data-stage-for="none" data-none="ask">{s.tag}</span>
                <span data-stage-tag data-stage-for="none" data-none="creator">{creatorTag}</span>
              </Fragment>
            : <span data-stage-tag data-stage-for={s.key}>{s.tag}</span>)}
        </span>
        <div class="stage-heads" aria-live="polite">
          {states.map((s) => <p class="stage-head" data-stage-head data-stage-for={s.key}>{s.head}</p>)}
        </div>
        {states.map((s) => <p class="stage-sub" data-stage-for={s.key}>{s.sub}</p>)}
        {states.filter((s) => s.signs.length).map((s) => (
          <ul class="stage-signs" data-stage-for={s.key}>
            {s.signs.map((g) => (
              <li class="stage-sign">
                <svg aria-hidden="true" viewBox="0 0 24 24"><path d={ICONS[g.glyph]} /></svg>
                {g.label}
              </li>
            ))}
          </ul>
        ))}
      </div>

      <div class="stage-art">
        <div class="stage-ground" aria-hidden="true">
          {STAGE_KEYS.map((k) => <RoleScene role={k} />)}
          <!-- Trail and pins for the hero layouts (below 1024px), in the scene's own coordinates. -->
          <svg class="stage-route-p" viewBox="0 0 480 200" preserveAspectRatio="xMidYMax slice">
            <path class="stage-p5-trail" fill="none" stroke="#0066cc" stroke-width="2.95" stroke-linecap="round"
                  d="M17.2 204.9C56.6 168 78.8 143.4 118.2 136S196.9 140.9 216.6 106.5S270.8 81.8 307.7 89.2" />
            <g transform="translate(105.8 99.1) scale(1.0415)"><g class="stage-p5-pin"><path fill="#0066cc" d={PIN} /><circle cx="13" cy="13" r="5" fill="#fff" /></g></g>
            <g transform="translate(204.3 69.5) scale(1.0415)"><g class="stage-p5-pin" style="animation-delay: .6s;"><path fill="#0066cc" d={PIN} /><circle cx="13" cy="13" r="5" fill="#fff" /></g></g>
          </svg>
        </div>

        {states.filter((s) => s.card).map((s) => {
          const r = route(s.card!.stops);
          return (
            <div class="stage-card" data-stage-card data-stage-for={s.key}>
              <div class="stage-card-label">{t('stage.sample')}</div>
              <div class="stage-card-title">{s.card!.title}</div>
              <svg aria-hidden="true" viewBox="0 0 208 64" width="208" height="64" class="stage-card-map">
                {r.d && <path class="stage-card-route" fill="none" stroke-width="2" stroke-dasharray="3 5" stroke-linecap="round" d={r.d} />}
                {r.dots.map(([x, y], i) => (
                  <g>
                    <circle cx={x} cy={y} r="11" fill="#0066cc" />
                    <text x={x} y={y + 4} text-anchor="middle" font-size="11" font-weight="600" fill="#fff">{i + 1}</text>
                  </g>
                ))}
              </svg>
              <div class="stage-card-meta">{s.card!.meta}</div>
            </div>
          );
        })}

        {states.filter((s) => s.moment).map((s) => (
          <span class="stage-moment" data-stage-moment data-stage-for={s.key}>
            <span class="stage-moment-dot"><svg aria-hidden="true" viewBox="0 0 24 24"><path d={ICONS[s.moment!.glyph]} /></svg></span>
            {s.moment!.text}
          </span>
        ))}

        <!-- Trail and pins for the desktop stage, in its 480 x 860 coordinates. -->
        <svg class="stage-route-d" aria-hidden="true" viewBox="0 0 480 860" width="480" height="860">
          <path class="stage-a5-trail" fill="none" stroke="#0066cc" stroke-width="2.6" stroke-linecap="round" d="M20 846C60 812 84 780 120 770S196 776 214 742S262 716 286 724" />
        </svg>
        <svg class="stage-pin-d stage-a5-pin" aria-hidden="true" width="26" height="34" viewBox="0 0 26 34" style="left: 107px; top: 734px;"><path fill="#0066cc" d={PIN} /><circle cx="13" cy="13" r="5" fill="#fff" /></svg>
        <svg class="stage-pin-d stage-a5-pin" aria-hidden="true" width="26" height="34" viewBox="0 0 26 34" style="left: 201px; top: 706px; animation-delay: 0.6s;"><path fill="#0066cc" d={PIN} /><circle cx="13" cy="13" r="5" fill="#fff" /></svg>

        <div class="stage-phone" aria-hidden="true">
          <div class="stage-phone-scale">
            <div class="phone-frame">
              <div class="phone-glass">
                <span class="phone-notch"></span>
                {STAGE_KEYS.map((k) => <PhoneAR role={k} lang={lang} />)}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </aside>

  <div class="stage-main" data-stage-sheet>
    <div class="stage-main-in">
      <h1 class="stage-h1">{heading}</h1>
      <slot />
    </div>
  </div>
</div>
