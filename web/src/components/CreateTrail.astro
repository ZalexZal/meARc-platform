---
import { useTranslations, localise, type Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const href = localise(lang);

// Grouped by what they are, not listed flat. A game keeps score and a walk
// does not, and that is the first thing a creator is actually choosing between.
const modes = [
  { value: 'ctf', kind: 'games', label: t('new.mode.ctf'), body: t('new.mode.ctf.body') },
  { value: 'freefall', kind: 'games', label: t('new.mode.freefall'), body: t('new.mode.freefall.body') },
  { value: 'guide', kind: 'guides', label: t('new.mode.guide'), body: t('new.mode.guide.body') },
  { value: 'educational', kind: 'guides', label: t('new.mode.educational'), body: t('new.mode.educational.body') },
];
---

<section class="mx-auto max-w-lg px-4 py-16 sm:px-6" hidden data-guarded>
  <h1 class="text-3xl">{t('new.title')}</h1>

  <form class="card mt-8 space-y-5 p-6" data-create novalidate>
    <div>
      <label class="mb-1.5 block text-sm font-medium" for="name">{t('new.name')}</label>
      <input class="field" id="name" name="name" type="text" required maxlength="80"
             placeholder={t('new.namePlaceholder')} />
    </div>

    <fieldset>
      <legend class="mb-2 block text-sm font-medium">{t('new.mode')}</legend>

      {['games', 'guides'].map((kind) => (
        <div class="mb-4">
          <p class="eyebrow mb-2">{kind === 'games' ? t('new.kind.games') : t('new.kind.guides')}</p>

          <div class="space-y-2">
            {modes.filter((m) => m.kind === kind).map((m) => (
              <label class="flex cursor-pointer items-start gap-3 rounded-lg border border-[var(--line)] p-3 transition-colors hover:bg-[var(--surface-2)]">
                <input class="mt-1" type="radio" name="mode" value={m.value}
                       checked={m.value === 'ctf'} />
                <span class="min-w-0">
                  <span class="block text-sm font-medium">{m.label}</span>
                  <span class="mt-0.5 block text-xs text-[var(--ink-dim)]">{m.body}</span>
                </span>
              </label>
            ))}
          </div>
        </div>
      ))}
    </fieldset>

    <p class="hidden rounded-lg border border-[var(--alert)] bg-[var(--alert-wash)] px-3 py-2.5 text-sm text-[var(--alert)]"
       data-create-error role="alert"></p>

    <button class="btn btn-primary w-full" type="submit" data-create-submit>{t('new.create')}</button>
  </form>
</section>

<p class="mx-auto max-w-lg px-4 py-24 text-center text-[var(--ink-dim)]" data-create-loading>
  {t('games.loading')}
</p>

<script
  type="application/json"
  data-create-strings
  set:html={JSON.stringify({ editHref: href('/trail'), busy: t('new.creating'), lang })}
></script>

<script>
  import { db } from '../lib/supabase';
  import { requireUser, reveal } from '../lib/session';

  const conf = JSON.parse(document.querySelector('[data-create-strings]')!.textContent || '{}');

  // A trail needs a real account, so this page asks for one rather than letting
  // create_world refuse after the form has been filled in.
  await requireUser({ needsReal: true });

  document.querySelector('[data-create-loading]')?.remove();
  reveal();

  const form = document.querySelector('[data-create]') as HTMLFormElement;
  const errorBox = document.querySelector('[data-create-error]') as HTMLElement;
  const submit = document.querySelector('[data-create-submit]') as HTMLButtonElement;

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorBox.classList.add('hidden');

    const data = new FormData(form);
    const name = String(data.get('name') ?? '').trim();
    const mode = String(data.get('mode') ?? 'guide');

    if (!name) {
      errorBox.textContent = conf.lang === 'bg' ? 'Дай име на маршрута.' : 'Give the trail a name.';
      errorBox.classList.remove('hidden');
      return;
    }

    const label = submit.textContent;
    submit.disabled = true;
    submit.textContent = conf.busy;

    const { data: world, error } = await db()!.rpc('create_world', {
      p_name: name, p_mode: mode, p_language: conf.lang,
    });

    if (error) {
      submit.disabled = false;
      submit.textContent = label;
      errorBox.textContent = error.message;
      errorBox.classList.remove('hidden');
      return;
    }

    // Straight into the editor. A creator who just named a trail wants to place
    // its first stop, not read a confirmation.
    const id = Array.isArray(world) ? world[0]?.id : (world as any)?.id;
    location.href = `${conf.editHref}?id=${encodeURIComponent(id)}`;
  });
</script>
