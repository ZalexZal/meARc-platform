---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

// Ordered by how much they ask of the walker: nothing, then a choice, then an
// account and a connection.
const modes = [
  { name: 'modes.guide.name',    body: 'modes.guide.body',    tone: 'ink'    },
  { name: 'modes.freefall.name', body: 'modes.freefall.body', tone: 'ink'    },
  { name: 'modes.ctf.name',      body: 'modes.ctf.body',      tone: 'signal' },
] as const;
---

<section class="border-y border-[var(--line-soft)] bg-[var(--ground-deep)]">
  <div class="mx-auto max-w-6xl px-4 py-24 sm:px-6 sm:py-28">
    <header class="max-w-2xl">
      <p class="eyebrow">{t('modes.eyebrow')}</p>
      <h2 class="mt-3 text-3xl sm:text-4xl">{t('modes.title')}</h2>
    </header>

    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {modes.map((m, i) => (
        <article
          class="card flex flex-col p-6"
          style={m.tone === 'signal' ? 'border-color: var(--signal)' : undefined}
        >
          <span class="data text-2xs text-[var(--ink-faint)]">0{i + 1}</span>
          <h3 class="mt-3 text-xl">{t(m.name)}</h3>
          <p class="mt-3 text-sm leading-relaxed text-[var(--ink-dim)]">{t(m.body)}</p>
        </article>
      ))}
    </div>
  </div>
</section>
