---
import { useTranslations, localise, type Lang } from '../i18n/ui';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const href = localise(lang);

// Handed over as data rather than through define:vars. define:vars forces the
// script inline, and an inline script is never bundled - so the imports below
// would silently become a syntax error and the whole page would render nothing.
const strings = {
  stops: t('mine.stops'),
  code: t('mine.code'),
  edit: t('mine.edit'),
  board: t('mine.board'),
  published: t('ed.published'),
  draft: t('ed.draft'),
  pending: t('acct.pending'),
  saving: t('mine.saving'),
  editorOnly: t('mine.editorOnly'),
  roleEditor: t('mine.roleEditor'),
  failed: t('mine.failed'),
  visLabel: t('vis.label'),
  visPrivate: t('vis.private'),
  visPrivateHint: t('vis.privateHint'),
  visUnlisted: t('vis.unlisted'),
  visUnlistedHint: t('vis.unlistedHint'),
  visPublic: t('vis.public'),
  visPublicHint: t('vis.publicHint'),
  editHref: href('/trail'),
  boardHref: href('/board'),
};
---

<section class="mx-auto max-w-5xl px-4 py-16 sm:px-6" hidden data-guarded>
  <header class="flex flex-wrap items-end justify-between gap-4">
    <div class="max-w-2xl">
      <p class="eyebrow">{t('mine.eyebrow')}</p>
      <h1 class="mt-3 text-3xl sm:text-4xl">{t('mine.title')}</h1>
      <p class="mt-3 text-[var(--ink-dim)]">{t('mine.lede')}</p>
    </div>
    <a class="btn btn-primary shrink-0" href={href('/create')}>{t('mine.new')}</a>
  </header>

  <!-- Three states, all of them drawn. A list that can only render rows shows a
       blank rectangle for the two cases that happen most on a young account:
       nothing made yet, and no connection. -->
  <div class="mt-12 hidden" data-mine-empty>
    <div class="card max-w-lg p-8">
      <h2 class="text-lg">{t('mine.empty')}</h2>
      <p class="mt-2 text-sm text-[var(--ink-dim)]">{t('mine.emptyBody')}</p>
    </div>
  </div>

  <div class="mt-12 hidden" data-mine-failed>
    <div class="card max-w-lg border-[var(--alert)] p-8">
      <p class="text-sm text-[var(--alert)]">{t('mine.failed')}</p>
    </div>
  </div>

  <ul class="mt-12 grid gap-5 sm:grid-cols-2" data-mine></ul>
</section>

<p class="mx-auto max-w-5xl px-4 py-24 text-center text-[var(--ink-dim)]" data-mine-loading>
  {t('mine.loading')}
</p>

<script type="application/json" data-mine-strings set:html={JSON.stringify(strings)}></script>

<script>
  import { db } from '../lib/supabase';
  import { requireUser, reveal, escapeHtml, text } from '../lib/session';

  const S = JSON.parse(document.querySelector('[data-mine-strings]')!.textContent || '{}');
  const q = (sel: string) => document.querySelector(sel);

  await requireUser({ needsReal: false });
  const client = db()!;

  const LEVELS = [
    { value: 'private',  label: S.visPrivate,  hint: S.visPrivateHint },
    { value: 'unlisted', label: S.visUnlisted, hint: S.visUnlistedHint },
    { value: 'public',   label: S.visPublic,   hint: S.visPublicHint },
  ];

  function card(w: any) {
    // Only the owner may change this. worlds_update_owner is an owner-only
    // policy, so an editor pressing these would get a silent no-op - PostgREST
    // reports a row that RLS filtered out as a successful update of nothing.
    // Better to show the state and say who can move it.
    const owner = w.role === 'owner';

    const buttons = LEVELS.map((l) => {
      const on = w.visibility === l.value;
      return `<button type="button"
        data-vis="${l.value}" data-world="${w.id}"
        ${owner ? '' : 'disabled'}
        title="${escapeHtml(l.hint)}"
        aria-pressed="${on}"
        class="flex-1 rounded-lg border px-2 py-2 text-xs font-medium transition-colors ${
          on ? 'border-[var(--signal)] bg-[var(--signal)] text-[var(--signal-ink)]'
             : 'border-[var(--line)] text-[var(--ink-dim)] hover:bg-[var(--surface-2)]'
        } ${owner ? '' : 'cursor-not-allowed opacity-60'}">${escapeHtml(l.label)}</button>`;
    }).join('');

    const hint = LEVELS.find((l) => l.value === w.visibility)?.hint ?? '';

    return `<li class="card flex flex-col p-5" data-card="${w.id}">
      <div class="flex items-start justify-between gap-3">
        <h2 class="text-lg">${escapeHtml(w.name)}</h2>
        <span class="eyebrow shrink-0">${w.status === 'published' ? S.published : S.draft}</span>
      </div>

      <p class="data mt-3 text-xs text-[var(--ink-dim)]">
        ${w.marker_count} ${escapeHtml(S.stops)}
        ${w.join_code ? ` · ${escapeHtml(S.code)} ${escapeHtml(w.join_code)}` : ''}
        ${Number(w.pending) > 0
          ? ` · <span style="color:var(--lamp)">${w.pending} ${escapeHtml(S.pending)}</span>` : ''}
        ${owner ? '' : ` · ${escapeHtml(S.roleEditor)}`}
      </p>

      <div class="mt-5">
        <p class="eyebrow">${escapeHtml(S.visLabel)}</p>
        <div class="mt-2 flex gap-1.5">${buttons}</div>
        <p class="mt-2 min-h-8 text-xs text-[var(--ink-faint)]" data-vis-hint>${escapeHtml(
          owner ? hint : S.editorOnly)}</p>
      </div>

      <div class="mt-5 flex gap-2 pt-1">
        <a class="btn btn-primary flex-1" style="min-height:38px"
           href="${S.editHref}?id=${encodeURIComponent(w.id)}">${escapeHtml(S.edit)}</a>
        <a class="btn btn-quiet flex-1" style="min-height:38px"
           href="${S.boardHref}?id=${encodeURIComponent(w.id)}">${escapeHtml(S.board)}</a>
      </div>
    </li>`;
  }

  let worlds: any[] = [];

  async function load() {
    const { data, error } = await client.rpc('my_worlds');
    q('[data-mine-loading]')?.remove();
    reveal();

    if (error) {
      q('[data-mine-failed]')!.classList.remove('hidden');
      return;
    }

    worlds = data ?? [];
    if (worlds.length === 0) {
      q('[data-mine-empty]')!.classList.remove('hidden');
      return;
    }

    q('[data-mine]')!.innerHTML = worlds.map(card).join('');
  }

  await load();

  // Delegated, so it survives the list being redrawn after every change.
  document.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement)?.closest('[data-vis]') as HTMLElement | null;
    if (!button || (button as HTMLButtonElement).disabled) return;

    const id = button.dataset.world!;
    const wanted = button.dataset.vis!;
    const world = worlds.find((w) => w.id === id);
    if (!world || world.visibility === wanted) return;

    const hint = document.querySelector(`[data-card="${id}"] [data-vis-hint]`);
    text(hint, S.saving);

    // Status moves with it, because the two together are what the app and the
    // public list actually read: markers_near and the trails page both ask for
    // status = 'published' AND visibility in ('unlisted','public'). Setting one
    // without the other makes a trail that says Public and opens for nobody.
    const status = wanted === 'private' ? 'draft' : 'published';

    const { error } = await client.from('worlds')
      .update({ visibility: wanted, status })
      .eq('id', id)
      .select('id');

    if (error) {
      text(hint, error.message);
      return;
    }

    world.visibility = wanted;
    world.status = status;
    q('[data-mine]')!.innerHTML = worlds.map(card).join('');
  });
</script>
