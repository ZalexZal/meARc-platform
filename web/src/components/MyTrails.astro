---
import Loading from './Loading.astro';
import { useTranslations, localise, type Lang } from '../i18n/ui';
import PageBand from './PageBand.astro';
import { CATEGORIES } from '../lib/work';
import BecomeCreator from './BecomeCreator.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const href = localise(lang);

// Handed over as data rather than through define:vars. define:vars forces the
// script inline, and an inline script is never bundled - so the imports below
// would silently become a syntax error and the whole page would render nothing.
const strings = {
  stop: t('n.stop'), stops: t('n.stops'),
  code: t('mine.code'), copyCode: t('mine.copyCode'), codeCopied: t('mine.codeCopied'), copyManual: t('copy.manual'),
  edit: t('mine.edit'),
  board: t('mine.board'),
  viewLabel: lang === 'bg' ? 'Страница' : 'Trail page', viewHref: href('/view'),
  pending: t('acct.pending'),
  saving: t('mine.saving'), pubDrafts: t('pub.drafts'),
  editorOnly: t('mine.editorOnly'),
  roleEditor: t('mine.roleEditor'),
  failed: t('mine.failed'),
  newBody: t('mine.newBody'), newBodyPlain: t('mine.newBodyPlain'),
  visLabel: t('vis.label'),
  visUnlisted: t('vis.unlisted'),
  visUnlistedHint: t('vis.unlistedHint'),
  visPublic: t('vis.public'),
  visPublicHint: t('vis.publicHint'),
  makePublic: t('vis.makePublic'),
  makePublicHint: t('vis.makePublicHint'),
  reviewNote: t('mine.reviewNote'),
  review: t('mine.review'),
  editHref: href('/trail'),
  creating: t('new.creating'),
  signinHref: href('/signin'),
  boardHref: href('/board'),
  lang, saveFailed: t('err.generic'), viewerName: t('role.nameViewer'), creatorName: t('mine.eyebrow'),
  rmTitle: t('rm.title'), rmTrail: t('rm.trail'), rmStop: t('rm.stop'), rmReasons: t('rm.reasons'),
  rmNote: t('rm.note'), rmGround: t('rm.ground'), rmContest: t('rm.contest'), rmSeen: t('rm.seen'),
  reasons: {
    private_property: t('rep.reason.private_property'), unsafe: t('rep.reason.unsafe'),
    offensive: t('rep.reason.offensive'), wrong_place: t('rep.reason.wrong_place'),
    spam: t('rep.reason.spam'), other: t('rep.reason.other'),
  },
};

// Grouped by what they are: a game keeps score and a walk does not, which is
// the first thing a creator is actually choosing between.
// The mode is two questions (lib/modes.ts), asked as two questions.
const ask = lang === 'bg' ? {
  scored: 'Отбори и класиране?', scoredYes: 'С отбори', scoredYesBody: 'За уроци и състезания: отбори, въпроси за точки, подсказки и класиране на живо.',
  scoredNo: 'Без отбори', scoredNoBody: 'Разходка, обиколка или показ на сграда. Всеки върви сам, нищо не се брои.',
  ordered: 'Спирките по ред ли са?', orderedYes: 'По ред', orderedYesBody: 'Всяка спирка води към следващата.',
  orderedNo: 'Свободен ред', orderedNoBody: 'Всеки тръгва откъдето му е удобно.',
} : {
  scored: 'Teams and standings?', scoredYes: 'With teams', scoredYesBody: 'For lessons and competitions: teams, questions for points, hints and live standings.',
  scoredNo: 'No teams', scoredNoBody: 'A walk, a tour or a building on show. Everyone walks alone, nothing is counted.',
  ordered: 'Do the stops go in order?', orderedYes: 'In order', orderedYesBody: 'Each stop leads to the next.',
  orderedNo: 'Any order', orderedNoBody: 'Everyone starts wherever suits them.',
};
const questions = [
  { name: 'scored', legend: ask.scored, opts: [['yes', ask.scoredYes, ask.scoredYesBody], ['no', ask.scoredNo, ask.scoredNoBody]] },
  { name: 'ordered', legend: ask.ordered, opts: [['yes', ask.orderedYes, ask.orderedYesBody], ['no', ask.orderedNo, ask.orderedNoBody]] },
];
---

<PageBand eyebrow={t('mine.eyebrow')} title={t('mine.title')} lede={t('mine.lede')}>
  <!-- Only for a reviewer. is_admin() decides, and the link is revealed by the
       script rather than rendered conditionally, because this page is static
       and the answer is per-session. -->
  <a class="btn btn-quiet hidden" href={href('/review')} data-review-link>{t('mine.review')}</a>
</PageBand>

<section class="mx-auto max-w-6xl px-4 pb-20 pt-10 sm:px-6" hidden data-guarded>
  <!-- What a reviewer took down, and why: the statement of reasons the Digital
       Services Act asks for (art. 17). Shown until the creator says they have
       read it, and kept in their data download after. -->
  <div class="mb-10 hidden space-y-3" data-notices role="status"></div>

  <div class="hidden" data-mine-failed>
    <div class="card max-w-lg border-[var(--alert)] p-8">
      <p class="text-sm text-[var(--alert)]">{t('mine.failed')}</p>
    </div>
  </div>

  <!-- The one way in for a new trail. It used to be a page of its own behind a
       header button; the name and the mode are two questions, so they are asked
       here, where the trails already are, and the answer opens the builder. -->
  <div class="mine-grid" data-mine-grid>
    <!-- A viewer is offered this instead of the New trail tile: picking a job
         makes them a creator of that kind, and the tile's form opens. -->
    <div class="become-slot" hidden data-become-slot>
      <BecomeCreator lang={lang} />
    </div>
    <div class="new-slot" data-new-slot>
      <button type="button" class="new-tile" data-new-open aria-expanded="false" aria-controls="new-trail">
        <span class="new-plus" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14" /></svg>
        </span>
        <span class="new-title">{t('mine.newTile')}</span>
        <span class="new-body" data-new-body>{t('mine.newBody')}</span>
      </button>

      <form class="new-form" id="new-trail" hidden data-create novalidate>
        <div class="new-form-head">
          <h2 class="text-xl">{t('mine.newTile')}</h2>
          <button type="button" class="btn btn-ghost btn-sm" data-new-close>{t('mine.cancel')}</button>
        </div>
        <div>
          <label class="field-name" for="new-name">{t('new.name')}</label>
          <input class="field" id="new-name" name="name" type="text" required maxlength="80"
                 placeholder={t('new.namePlaceholder')} data-new-name />
        </div>
        <!-- Which of the two questions are asked depends on the line of work, so
             they live in a template and the script puts in only those that apply.
             A question that is not shown is not in the page at all. -->
        <div class="contents" data-questions></div>
        <template data-question-template>
        {questions.map((qn) => (
          <fieldset data-question={qn.name}>
            <legend class="field-name">{qn.legend}</legend>
            <div class="mode-grid">
              {qn.opts.map(([value, label, body]) => (
                <label class="mode-opt">
                  <input class="sr-only" type="radio" name={qn.name} value={value} checked={qn.name === 'scored' ? value === 'no' : value === 'yes'} />
                  <span class="mode-name">{label}</span>
                  <span class="mode-body">{body}</span>
                </label>
              ))}
            </div>
          </fieldset>
        ))}
        </template>
        <div>
          <label class="field-name" for="new-category">{t('cat.label')}</label>
          <select class="field" id="new-category" name="category" data-new-category>
            {CATEGORIES.map((c) => <option value={c}>{t(`cat.${c}`)}</option>)}
          </select>
        </div>
        <p class="hidden" data-create-error role="alert"></p>
        <div class="flex flex-wrap items-center gap-3">
          <button class="btn btn-primary btn-lg" type="submit" data-create-submit>{t('mine.createGo')}</button>
        </div>
      </form>
    </div>

    <ul class="contents" data-mine></ul>
  </div>
</section>

<Loading label={t('mine.loading')} class="mx-auto max-w-5xl px-4 py-24" data-mine-loading />

<script type="application/json" data-mine-strings set:html={JSON.stringify(strings)}></script>

<script>
  import { db } from '../lib/supabase';
  import { modeFrom, trailLine, isScored } from '../lib/modes';
  import { featuresFor, defaultCategory, loadWork, CATEGORIES } from '../lib/work';
  import { requireUser, reveal, escapeHtml, text, count, who, gateAnswers } from '../lib/session';
  import { wireBecome } from '../lib/become';
  import { levelOf, setLevel } from '../lib/publishing';
  import { busy, formError, formClear } from '../lib/form';
  import { copyOrSelect } from '../lib/copytext';

  const S = JSON.parse(document.querySelector('[data-mine-strings]')!.textContent || '{}');
  const q = (sel: string) => document.querySelector(sel);

  await requireUser({ needsReal: false });
  const client = db()!;
  // Null until the person has said what they do; features treat it as "other".
  const loaded = await loadWork(client as any);
  // undefined means the read failed: treated as "other".
  let work = loaded ?? null;

  // A viewer builds nothing yet: the New trail tile gives way to "Become a
  // creator" before the page shows. Their own trails, if they have any, still
  // list as usual. The role comes from the gate's read: no extra request.
  const viewer = (await gateAnswers())?.role === 'viewer';
  if (viewer) {
    // Only a creator's work matters: a viewer's own trails show everything.
    work = null;
    // The band's eyebrow says "Creator"; for a viewer it says what they are.
    const eyebrow = q('.band-eyebrow')?.lastChild;
    if (eyebrow) eyebrow.textContent = S.viewerName;
    (q('[data-new-slot]') as HTMLElement).hidden = true;
    (q('[data-become-slot]') as HTMLElement).hidden = false;
  }

  // ---------------------------------------------------------------- removals
  const drawNotices = async () => {
    const { data: notices } = await client.from('moderation_notices')
      .select('id,kind,title,trail_name,reasons,note,created_at')
      .is('seen_at', null).order('created_at', { ascending: false });
    const box = document.querySelector('[data-notices]') as HTMLElement;
    const rows = notices ?? [];
    box.classList.toggle('hidden', rows.length === 0);
    const day = (iso: string) => new Date(iso).toLocaleDateString(S.lang === 'bg' ? 'bg-BG' : 'en-GB',
      { day: 'numeric', month: 'long', year: 'numeric' });

    box.innerHTML = rows.map((n: any) => {
      const what = n.kind === 'trail'
        ? S.rmTrail.replace('{0}', n.title ?? '—').replace('{1}', day(n.created_at))
        : S.rmStop.replace('{0}', n.title ?? '—').replace('{1}', n.trail_name ?? '—').replace('{2}', day(n.created_at));
      const reasons = (n.reasons ?? []).map((r: string) => S.reasons[r] ?? r).join(', ');
      return `<article class="note note-alert p-5 text-sm">
        <p class="font-semibold">${escapeHtml(S.rmTitle)}</p>
        <p class="mt-2">${escapeHtml(what)}</p>
        ${reasons ? `<p class="mt-1">${escapeHtml(S.rmReasons.replace('{0}', reasons))}</p>` : ''}
        ${n.note ? `<p class="mt-1">${escapeHtml(S.rmNote.replace('{0}', n.note))}</p>` : ''}
        <p class="mt-2 text-[var(--ink-dim)]">${escapeHtml(S.rmGround)}</p>
        <p class="mt-1 text-[var(--ink-dim)]">${escapeHtml(S.rmContest)}</p>
        <button type="button" class="btn btn-quiet btn-sm mt-3" data-seen="${escapeHtml(n.id)}">${escapeHtml(S.rmSeen)}</button>
      </article>`;
    }).join('');

    box.querySelectorAll('[data-seen]').forEach((b) => b.addEventListener('click', async () => {
      await client.rpc('notice_seen', { p_notice: (b as HTMLElement).dataset.seen });
      await drawNotices();
    }));
  };
  drawNotices();

  // Two choices, both the owner's, both instant (12 Nov 2026): with the code, or
  // public. Public used to be a request that a reviewer granted.
  function card(w: any) {
    // worlds_update_owner is owner-only, so an editor pressing these would get a
    // silent success updating nothing - PostgREST reports a row RLS filtered out
    // no differently from one that was written.
    const owner = w.role === 'owner';
    const here = levelOf(w);
    const isPublic = here === 'public';

    const buttons = `<button type="button" class="tab" data-vis="code" data-world="${w.id}"
        ${owner ? '' : 'disabled'} title="${escapeHtml(S.visUnlistedHint)}"
        aria-selected="${!isPublic}">${escapeHtml(S.visUnlisted)}</button>
      <button type="button" class="tab" data-vis="public" data-world="${w.id}"
        ${owner ? '' : 'disabled'} title="${escapeHtml(isPublic ? S.visPublicHint : S.makePublicHint)}"
        aria-selected="${isPublic}">${escapeHtml(isPublic ? S.visPublic : S.makePublic)}</button>`;

    const noteRow = w.review_note
      ? `<p class="mt-3 text-xs text-[var(--ink-dim)]"><span class="eyebrow">${escapeHtml(S.reviewNote)}</span> ${escapeHtml(w.review_note)}</p>`
      : '';

    const hint = isPublic ? S.visPublicHint : S.visUnlistedHint;

    return `<li class="card flex flex-col p-5" data-card="${w.id}">
      <div class="flex items-start justify-between gap-3">
        <h2 class="text-lg">${escapeHtml(w.name)}</h2>
        <span class="eyebrow shrink-0">${escapeHtml(isPublic ? S.visPublic : S.visUnlisted)}</span>
      </div>

      ${w.join_code ? `<div class="code-row mt-3">
        <div class="code-text">
          <span class="eyebrow">${escapeHtml(S.code)}</span>
          <code class="code code-big">${escapeHtml(String(w.join_code).toUpperCase())}</code>
        </div>
        <button type="button" class="copy-code" data-copy="${escapeHtml(String(w.join_code).toUpperCase())}">
          <svg class="ic-copy" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2.5" /><path d="M5 15V6.5A2.5 2.5 0 0 1 7.5 4H15" /></svg>
          <svg class="ic-done" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>
          <span data-copy-label>${escapeHtml(S.copyCode)}</span>
        </button>
      </div>` : ''}

      <p class="data mt-3 text-xs text-[var(--ink-dim)]">
        ${escapeHtml(trailLine(w.mode, w.category ?? 'other', w.city ?? null, S.lang, featuresFor(work).teams || featuresFor(work).order))} \u00b7 ${escapeHtml(count(w.marker_count, S.stop, S.stops))}
        ${Number(w.pending) > 0 ? ` \u00b7 <span style="color:var(--lamp)">${w.pending} ${escapeHtml(S.pending)}</span>` : ''}
        ${owner ? '' : ` \u00b7 ${escapeHtml(S.roleEditor)}`}
      </p>

      <div class="mt-5">
        <p class="eyebrow">${escapeHtml(S.visLabel)}</p>
        <div class="tabs mt-2">${buttons}</div>
        <p class="mt-2 min-h-8 text-xs text-[var(--ink-faint)]" data-vis-hint>${escapeHtml(owner ? hint : S.editorOnly)}</p>
        ${noteRow}
      </div>

      <div class="mt-5 flex gap-2 pt-1">
        <a class="btn btn-primary btn-sm flex-1" href="${S.editHref}?id=${encodeURIComponent(w.id)}">${escapeHtml(S.edit)}</a>
        ${isScored(w.mode) && featuresFor(work).results ? `<a class="btn btn-quiet btn-sm flex-1" href="${S.boardHref}?id=${encodeURIComponent(w.id)}">${escapeHtml(S.board)}</a>` : ''}
        <a class="btn btn-quiet btn-sm flex-1" href="${S.viewHref}?id=${encodeURIComponent(w.id)}">${escapeHtml(S.viewLabel)}</a>
      </div>
    </li>`;
  }

  let worlds: any[] = [];

  async function load() {
    const { data, error } = await client.rpc('my_worlds');
    q('[data-mine-loading]')?.remove();
    reveal();

    if (error) {
      q('[data-mine-failed]')!.classList.remove('hidden');
      return;
    }

    // No trails yet is not a separate page state any more: the New trail tile
    // is always first, and on an empty account it is the whole grid.
    worlds = data ?? [];
    drawList();
  }

  function drawList() {
    q('[data-mine]')!.innerHTML = worlds.map(card).join('');
  }

  await load();

  // ------------------------------------------------------------- a new trail
  const slot = q('[data-new-slot]') as HTMLElement;
  const opener = q('[data-new-open]') as HTMLButtonElement;
  const form = q('[data-create]') as HTMLFormElement;
  const nameField = q('[data-new-name]') as HTMLInputElement;
  const errorBox = q('[data-create-error]') as HTMLElement;
  const submit = q('[data-create-submit]') as HTMLButtonElement;
  // A trail needs a real account. A guest is sent to sign in first and comes
  // straight back here with the form open, rather than filling it in to be
  // refused at the end.
  const { anonymous } = await who();
  const newBody = q('[data-new-body]') as HTMLElement;
  const questionsBox = q('[data-questions]') as HTMLElement;
  const questionTpl = q('[data-question-template]') as HTMLTemplateElement;
  const categoryField = q('[data-new-category]') as HTMLSelectElement;

  // Puts in the questions this line of work is asked, and the category it
  // starts from. An unanswered question is fixed: no teams, and no order for
  // a broker. The words "teams" and "order" are not in the page for them.
  function drawForm() {
    const f = featuresFor(work);
    questionsBox.replaceChildren();
    for (const fs of Array.from(questionTpl.content.querySelectorAll('[data-question]'))) {
      const shown = fs.getAttribute('data-question') === 'scored' ? f.teams : f.order;
      if (shown) questionsBox.append(fs.cloneNode(true));
    }
    categoryField.value = defaultCategory(work);
    // The tile's sentence mentions teams only for a line of work that has them.
    text(newBody, f.teams ? S.newBody : S.newBodyPlain);
  }
  drawForm();

  function openForm(open: boolean) {
    if (open && anonymous) {
      const back = encodeURIComponent(location.pathname + '?new=1');
      location.href = `${S.signinHref}?next=${back}`;
      return;
    }
    slot.classList.toggle('is-open', open);
    opener.hidden = open;
    form.hidden = !open;
    opener.setAttribute('aria-expanded', String(open));
    if (open) nameField.focus(); else opener.focus();
  }
  opener.addEventListener('click', () => openForm(true));
  q('[data-new-close]')?.addEventListener('click', () => openForm(false));
  form.addEventListener('keydown', (e) => { if (e.key === 'Escape') openForm(false); });

  if (viewer) {
    const becomeSlot = q('[data-become-slot]') as HTMLElement;
    wireBecome(becomeSlot.querySelector('[data-become]') as HTMLFormElement, client as any, S.saveFailed, (picked) => {
      work = picked;
      const eyebrow = q('.band-eyebrow')?.lastChild;
      if (eyebrow) eyebrow.textContent = S.creatorName;
      drawForm();
      drawList();
      becomeSlot.hidden = true;
      slot.hidden = false;
      openForm(true);
    });
  }

  // Arrived from "Build a trail" on the home page: the form is already open.
  // A viewer is shown "Become a creator" instead; the flag goes either way.
  if (new URLSearchParams(location.search).get('new') === '1') {
    if (!viewer) openForm(true);
    history.replaceState(null, '', location.pathname);
  }

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    formClear(errorBox);
    const data = new FormData(form);
    const name = String(data.get('name') ?? '').trim();
    // A question that was not asked has a fixed answer: no teams, no order.
    const mode = modeFrom(data.get('scored') === 'yes', data.get('ordered') === 'yes');
    const picked = String(data.get('category') ?? '');
    const category = (CATEGORIES as string[]).includes(picked) ? picked : defaultCategory(work);
    if (!name) {
      formError(errorBox, S.lang === 'bg' ? 'Дай име на маршрута.' : 'Give the trail a name.', nameField);
      return;
    }
    busy(submit, true);
    const { data: world, error } = await client.rpc('create_world', { p_name: name, p_mode: mode, p_language: S.lang, p_category: category });
    if (error) {
      formError(errorBox, /parent needs to agree/i.test(error.message)
        ? (S.lang === 'bg' ? 'Родител или настойник трябва първо да се съгласи.' : 'A parent or guardian has to agree first.')
        : error.message);
      return;
    }
    // Straight into the builder: somebody who just named a trail wants to
    // place its first stop, not read a confirmation.
    const id = Array.isArray(world) ? world[0]?.id : (world as any)?.id;
    location.href = `${S.editHref}?id=${encodeURIComponent(id)}`;
  });

  // The reviewer's own door, shown only to a reviewer. A non-admin gets false
  // rather than an error, so this is safe to call for everybody.
  {
    const { data } = await client.rpc('is_admin');
    if (data === true) q('[data-review-link]')?.classList.remove('hidden');
  }

  function say(id: string, message: string) {
    text(document.querySelector(`[data-card="${id}"] [data-vis-hint]`), message);
  }

  // Delegated, so it survives the list being redrawn after every change.
  document.addEventListener('click', async (event) => {
    const target = event.target as HTMLElement;
    if (!target) return;

    // ------------------------------------------------- with the code, or public
    const level = target.closest('[data-vis]') as HTMLButtonElement | null;
    if (level && !level.disabled) {
      const id = level.dataset.world!;
      const wanted = level.dataset.vis as 'code' | 'public';
      const world = worlds.find((w) => w.id === id);
      if (!world || levelOf(world) === wanted) return;

      say(id, S.saving);

      // Public is instant (make_public) and so is going back (make_code), and
      // each moves status and visibility together. Public is refused here, with a
      // sentence, while a stop is still a draft.
      const failed = await setLevel(client, world, wanted, S.pubDrafts);
      if (failed) { say(id, failed); return; }

      // Reloaded rather than guessed: what the row says afterwards is the
      // server's business.
      await load();
      return;
    }

    // ------------------------------------------------------------ the code
    const copy = target.closest('[data-copy]') as HTMLElement | null;
    if (copy) {
      // A page served without https has no clipboard at all, and a silent failure
      // there would look like a dead button. So: select the code and say so.
      const label = copy.querySelector('[data-copy-label]');
      const done = await copyOrSelect(copy.dataset.copy!, copy.closest('.code-row')?.querySelector('code') ?? null);
      if (done) copy.classList.add('is-done');
      text(label, done ? S.codeCopied : S.copyManual);
      setTimeout(() => { copy.classList.remove('is-done'); text(label, S.copyCode); }, 1400);
    }
  });
</script>

<style>
  /* Two across: a trail card carries a row of visibility choices and the join
     code with its copy button, which need the width. */
  .mine-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
  @media (max-width: 760px) { .mine-grid { grid-template-columns: minmax(0, 1fr); } }
  .new-slot.is-open, .become-slot { grid-column: 1 / -1; }
  .new-tile {
    width: 100%; height: 100%; min-height: 15rem; padding: 1.5rem; text-align: left; cursor: pointer;
    display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: .875rem;
    border: 1.5px dashed var(--line); border-radius: 22px;
    background: color-mix(in srgb, var(--signal-wash) 55%, transparent); color: var(--ink);
    transition: border-color .2s ease, background-color .2s ease, transform .16s ease;
  }
  .new-tile:hover { border-color: var(--signal); background: var(--signal-wash); }
  .new-tile:active { transform: scale(.98); }
  .new-plus { width: 52px; height: 52px; border-radius: 16px; display: grid; place-items: center; background: var(--signal); color: var(--signal-ink); }
