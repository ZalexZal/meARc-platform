---
import Loading from './Loading.astro';
import { useTranslations, localise, type Lang } from '../i18n/ui';
import PageBand from './PageBand.astro';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

---

<PageBand eyebrow={t('games.eyebrow')} title={t('games.title')}>
  <!-- Asked for, never taken: the browser only asks where you are when this
       is pressed, and the position never leaves the page. -->
  <button type="button" class="btn btn-quiet hidden" data-trails-near>{t('games.nearMe')}</button>
</PageBand>

<section class="mx-auto max-w-6xl px-4 pb-20 pt-6 sm:px-6">

  <p class="mt-4 hidden text-sm text-[var(--ink-dim)]" data-trails-where></p>

  <div class="card mt-8 hidden max-w-lg p-6" data-trails-noapp>
    <p class="text-sm">{t('games.noApp')}</p>
    <a class="btn btn-primary mt-4" href="/ARTrail.apk" download>{t('app.download')}</a>
  </div>

  <!-- Three states, all of them designed. A list that can only render rows is a
       list that shows a blank rectangle for the two cases that actually happen
       most often on a young platform: nothing published, and no connection. -->
  <Loading label={t('games.loading')} class="mt-10 py-6" data-trails-loading />

  <div class="mt-10 hidden" data-trails-empty>
    <div class="card max-w-lg p-8">
      <h2 class="text-lg">{t('games.empty')}</h2>
      <p class="mt-2 text-sm text-[var(--ink-dim)]">{t('games.emptyBody')}</p>
    </div>
  </div>

  <div class="mt-10 hidden" data-trails-failed>
    <div class="card max-w-lg border-[var(--alert)] p-8">
      <p class="text-sm text-[var(--alert)]">{t('games.failed')}</p>
    </div>
  </div>

  <ul class="mt-10 hidden grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3" data-trails-list></ul>

  <!-- The words this component needs, handed over as data rather than through
       define:vars. define:vars forces the script inline, and an inline script is
       never bundled - so the import below silently became a syntax error and the
       whole list stopped rendering. -->
  <script
    type="application/json"
    data-trails-strings
    set:html={JSON.stringify({ lang,
      stop: t('n.stop'), stops: t('n.stops'),
      team: t('n.team'), teams: t('n.teams'),
      openApp: t('games.openApp'), walkWeb: t('games.walkWeb'), walkHref: localise(lang)('/view'),
      map: t('games.map'), qr: t('games.qr'),
      qrHint: t('games.qrHint'), away: t('games.away'),
      locating: t('games.locating'), sorted: t('games.sorted'),
      denied: t('games.denied'), report: t('games.report'), reportSubject: t('games.reportSubject') })}
  ></script>
</section>

<script>
  import { db, configured } from '../lib/supabase';
  import { count } from '../lib/session';
  import { modeLine, isScored } from '../lib/modes';

  const strings = JSON.parse(
    document.querySelector('[data-trails-strings]')?.textContent || '{}'
  );
  const labels = {
    stop: strings.stop ?? '', stops: strings.stops ?? '',
    team: strings.team ?? '', teams: strings.teams ?? '',
  };

  const loading = document.querySelector('[data-trails-loading]');
  const empty = document.querySelector('[data-trails-empty]');
  const failed = document.querySelector('[data-trails-failed]');
  const list = document.querySelector('[data-trails-list]');
  const nearButton = document.querySelector('[data-trails-near]');
  const where = document.querySelector('[data-trails-where]');

  const params = new URLSearchParams(location.search);
  const wanted = params.get('t');
  if (params.get('noapp')) document.querySelector('[data-trails-noapp]')?.classList.remove('hidden');

  let trails = [];
  let here = null;

  const only = (el) => {
    [loading, empty, failed, list].forEach((n) => n && n.classList.add('hidden'));
    if (el === list) { list.classList.remove('hidden'); list.classList.add('grid'); }
    else if (el) el.classList.remove('hidden');
  };

  // The page a trail's QR code opens: this list, scrolled to that trail.
  const pageFor = (id) => `${location.origin}${location.pathname}?t=${encodeURIComponent(id)}`;

  // Opens the app on the trail. Without the app installed, Chrome follows the
  // fallback back here with a note, instead of to a Play Store page that does
  // not exist yet.
  const appLink = (id) =>
    `intent://join/${id}#Intent;scheme=artrail;package=com.alex.artrail;` +
    `S.browser_fallback_url=${encodeURIComponent(pageFor(id) + '&noapp=1')};end`;

  // Great-circle distance, in metres. The page does the arithmetic itself so
  // the reader's position is never sent anywhere.
  function metres(a, b) {
    const r = (d) => (d * Math.PI) / 180;
    const dLat = r(b.lat - a.lat), dLng = r(b.lng - a.lng);
    const h = Math.sin(dLat / 2) ** 2 +
      Math.cos(r(a.lat)) * Math.cos(r(b.lat)) * Math.sin(dLng / 2) ** 2;
    return 6371000 * 2 * Math.asin(Math.sqrt(h));
  }

  function distance(m) {
    if (m < 1000) return `${Math.round(m / 10) * 10} m`;
    const km = m / 1000;
    return `${km < 10 ? km.toFixed(1) : Math.round(km)} km`;
  }

  function render() {
    const rows = trails.map((trail) => {
      const hasStart = trail.start_lat != null && trail.start_lng != null;
      const away = here && hasStart
        ? metres(here, { lat: trail.start_lat, lng: trail.start_lng })
        : null;
      return { trail, hasStart, away };
    });

    if (here) rows.sort((a, b) => (a.away ?? Infinity) - (b.away ?? Infinity));

    list.innerHTML = rows.map(({ trail, hasStart, away }) => {
      const id = escapeHtml(trail.id);
      return `
      <li class="card flex flex-col p-6 ${trail.id === wanted ? 'ring-2 ring-[var(--signal)]' : ''}" id="trail-${id}">
        <span class="eyebrow">${modeLine(trail.mode, strings.lang)}</span>
        <h2 class="mt-2 text-xl">${escapeHtml(trail.name)}</h2>
        <p class="data mt-4 text-xs text-[var(--ink-dim)]">
          ${count(trail.stop_count, labels.stop, labels.stops)}${isScored(trail.mode) && Number(trail.team_count) > 0 ? ` · ${count(trail.team_count, labels.team, labels.teams)}` : ''}${away != null ? ` · ${strings.away.replace('{0}', distance(away))}` : ''}
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          <a class="btn btn-primary touch-only" href="${appLink(trail.id)}">${strings.openApp}</a>
          <a class="btn btn-quiet" href="${strings.walkHref}?id=${encodeURIComponent(trail.id)}">${strings.walkWeb}</a>
          <a class="ml-auto self-center text-xs text-[var(--ink-faint)] underline-offset-2 hover:text-[var(--alert)] hover:underline"
             href="mailto:zalex8623@gmail.com?subject=${encodeURIComponent(`${strings.reportSubject}: ${trail.name} (${trail.id})`)}">${strings.report}</a>
        </div>
      </li>`;
    }).join('');


    only(list);
  }

  async function load() {
    const client = configured() ? db() : null;
    if (!client) { only(empty); return; }

    const { data, error } = await client.rpc('public_trails');

    // A missing function is not a failure of the network. Until migration 0009
    // is applied there is nothing to list, and saying "check your connection"
    // would send somebody to look in the wrong place.
    if (error) {
      const notYet = /PGRST202|could not find|does not exist/i.test(error.message || '');
      only(notYet ? empty : failed);
      return;
    }

    if (!data || data.length === 0) { only(empty); return; }

    trails = data;
    render();

    if ('geolocation' in navigator) nearButton?.classList.remove('hidden');

    if (wanted) document.getElementById(`trail-${wanted}`)?.scrollIntoView({ block: 'center' });
  }

  nearButton?.addEventListener('click', () => {
    where.textContent = strings.locating;
    where.classList.remove('hidden');
    navigator.geolocation.getCurrentPosition(
      (p) => {
        here = { lat: p.coords.latitude, lng: p.coords.longitude };
        where.textContent = strings.sorted;
        render();
      },
      () => { where.textContent = strings.denied; },
      { enableHighAccuracy: false, timeout: 10000, maximumAge: 300000 }
    );
  });

  // Trail names are written by other people. They go in as text, never as markup.
  function escapeHtml(value) {
    return String(value).replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }

  load().catch(() => only(failed));
</script>
