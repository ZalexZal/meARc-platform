    <path class="f-tree" d="M36 124a34 34 0 1 0 68 0a34 34 0 1 0-68 0z" />
    <path class="f-trunk" d="M66 150h8v44h-8z" />
    <path class="s-line" fill="none" stroke-width="1.5" stroke-linecap="round" d="M70 150v-18M70 140l-10-8M70 136l9-7" />
    <path class="s-line" fill="none" stroke-width="1.6" stroke-linecap="round" d="M412 196V60" />
    <path class="f-accent" d="M412 62h30l-8 9 8 9h-30z" />
    <path class="s-line" fill="none" stroke-width="1.5" stroke-linecap="round" d="M0 196H480" />
  </Fragment>}

  {role === 'broker' && <Fragment>
    <path class="f-fill" fill-rule="evenodd" d={block} />
