---
/**
 * One role's place, drawn flat along the bottom of the stage (A5 Scene,
 * "colour" mode): the old town for a guide, the school for a teacher, the
 * plot with its crane for a broker, a small town for "other", the hills and
 * the path for a viewer, and a dashed ground line before any choice.
 *
 * The paths are the design's, unchanged. Colours are not in the markup: each
 * shape names its role (f-far, s-line, ...) and stage.css gives the role's day
 * and night palette through --sc-* variables, so one drawing serves both themes.
 */
import type { StageKey } from '../lib/role';

interface Props { role: StageKey; }
const { role } = Astro.props;

// The broker's block of flats: the body, twelve windows, the roof plant.
let block = 'M40 194V70H170V194Z';
for (const y of [92, 118, 144, 170]) for (const x of [56, 96, 136]) block += `M${x} ${y}h20v16h-20z`;
block += 'M60 54h90v16h-90z';
---
<svg class="scene" data-scene={role} data-stage-for={role} aria-hidden="true" viewBox="0 0 480 200" preserveAspectRatio="xMidYMax slice">
  {role === 'guide' && <Fragment>
    <path class="f-far" d="M0 200V150C70 132 150 140 230 146S390 128 480 140V200Z" />
    <path class="f-fill" fill-rule="evenodd" d="M0 200V110H16V94H36V110H56V96H76V110H96V100L104 106H120V78H134V66H150V78H166V66H182V78H196V110H214V96H234V110H254V100L262 110H282V94H302V110H322V98H336L346 110H366V94H386V110H406V102L414 110H434V96H454V110H480V200ZM210 200V156A30 30 0 0 1 270 156V200ZM155 86h6v14h-6zM40 122h4v12h-4zM100 122h4v12h-4zM376 122h4v12h-4zM436 122h4v12h-4z" />
    <path class="s-line" fill="none" stroke-width="1.5" stroke-linecap="round" d="M0 136H200M280 136H480M0 166H205M275 166H480M40 110V136M70 136V166M110 136V166M160 110V136M330 110V136M400 136V166M60 166V200M150 166V200M350 166V200M440 166V200M134 78V110M182 78V110M298 110l6 10-4 9M422 110l-5 8 4 6M205 150A35 35 0 0 1 275 150" />
    <path class="s-line" fill="none" stroke-width="1.5" d="M142 66V46" />
    <path class="f-line" d="M142 46h14l-4 4 4 4h-14z" />
    <path class="f-fill" d="M300 200l4-7h10l3 7zM320 200l2-4h8l2 4zM470 200l2-5h6l2 5z" />
    <path class="s-grass" fill="none" stroke-width="1.8" stroke-linecap="round" d="M8 200l3-8M14 200l1-10M20 200l-2-7M226 200l2-6M232 200v-8M366 200l3-7M372 200v-9M378 200l-2-6" />
  </Fragment>}

  {role === 'teacher' && <Fragment>
    <path class="f-far" d="M0 200V170C100 160 200 166 300 162S420 158 480 166V200Z" />
    <path class="f-fill" fill-rule="evenodd" d="M120 192V104H110L240 52L370 104H360V192ZM140 120h22v24h-22zM176 120h22v24h-22zM140 156h22v24h-22zM176 156h22v24h-22zM282 120h22v24h-22zM318 120h22v24h-22zM282 156h22v24h-22zM318 156h22v24h-22zM224 192V160a16 16 0 0 1 32 0V192zM230 84a10 10 0 1 0 20 0a10 10 0 1 0-20 0z" />
    <path class="f-fill" fill-rule="evenodd" d="M224 62V30H256V62ZM232 56V44a8 8 0 0 1 16 0V56Z" />
    <path class="f-fill" d="M218 30L240 12L262 30Z" />
