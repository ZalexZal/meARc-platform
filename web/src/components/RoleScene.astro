    <path class="f-crane" d="M342 194V34H350V194ZM262 34H472V42H262ZM338 44h16v12h-16zM452 42h18v16h-18z" />
    <path class="s-line" fill="none" stroke-width="1.3" d="M342 50l8 12-8 12 8 12-8 12 8 12-8 12 8 12-8 12 8 12M270 34l8 8 8-8 8 8 8-8 8 8 8-8 8 8 8-8 8 8 8-8 8 8M346 34L262 34M346 26L272 34M346 26L466 34M346 26V34" />
