    <path class="s-line" fill="none" stroke-width="1.5" stroke-linecap="round" d="M0 194H480" />
    <path class="f-tree" d="M412 172a14 14 0 1 0 28 0a14 14 0 1 0-28 0z" />
    <path class="f-trunk" d="M424 182h4v12h-4z" />
  </Fragment>}

  {role === 'other' && <Fragment>
    <path class="f-far" d="M0 200V164C120 150 240 160 360 154S450 156 480 160V200Z" />
    <path class="f-fill" d="M10 194V124H22V112H38V124H54V114H70V124H86V118L92 124H108V194Z" />
    <path class="f-fill" fill-rule="evenodd" d="M140 194V132H132L190 98L248 132H240V194ZM174 194V170a16 16 0 0 1 32 0V194Z" />
    <path class="f-fill" d="M280 194V146L314 120L348 146V194Z" />
    <path class="f-fill" fill-rule="evenodd" d="M372 194V84H456V194ZM386 98h14v12h-14zM414 98h14v12h-14zM386 122h14v12h-14zM414 122h14v12h-14zM386 146h14v12h-14zM414 146h14v12h-14zM400 194v-20h16v20z" />
