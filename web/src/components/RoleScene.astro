    <path class="s-accent" fill="none" stroke-width="2" stroke-dasharray="2 6" stroke-linecap="round" d="M70 198C120 182 160 176 200 166S292 140 338 112" />
    <path class="f-accent" d="M340 78a12 12 0 0 1 12 12c0 10-12 21-12 21s-12-11-12-21a12 12 0 0 1 12-12z" />
    <path class="f-bg" d="M335 90a5 5 0 1 0 10 0a5 5 0 1 0-10 0z" />
    <path class="s-line" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="M110 196V150M98 156h26l5 5-5 5H98zM122 170H96l-5 5 5 5h26z" />
    <path class="s-line" fill="none" stroke-width="1.4" stroke-linecap="round" d="M30 190l3-8M36 190v-10M42 190l-2-7M420 186l3-8M426 186v-9" />
  </Fragment>}

  {role === 'none' &&
    <path class="s-line" fill="none" stroke-width="1.5" stroke-dasharray="4 6" stroke-linecap="round" d="M0 194H480" />}
</svg>
